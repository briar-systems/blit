# the draw list, a growable buffer of colored, textured triangle vertices
#
# widgets accumulate vertices here; each frame the consumer uploads data()/count()
# to a dynamic vertex buffer and renders them as GL_TRIANGLES. positions are in
# pixel space, u/v index the sampled texture in [0, 1], and rgba is straight
# (not premultiplied) with each channel in [0, 1].
#
# a vertex samples either the font atlas or a texture the consumer owns. the
# consumer's texture is named by an opaque integer handle blit only passes
# through: it never creates, owns or binds a texture, and ATLAS (0) is reserved
# for the atlas. the context records which handle each span of the list samples
# (see blit.context.Run).

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use allo: std.allocator;
use std.allocator.page;
use std.math.float;

# vertex capacity allocated by init before any growth
pub val INIT_CAP: usize = 1024;

# the texture handle naming blit's own font atlas, never a consumer texture
pub val ATLAS: u64 = 0;

# sample the texel nearest each fragment, for crisp cells and pixel art
pub val FILTER_NEAREST: u32 = 0;

# blend the four texels around each fragment, for smooth scaling
pub val FILTER_LINEAR: u32 = 1;

# a region of a consumer texture and how to sample it
#
# the source rect is in uv, [0, 1] across the texture, since blit never learns
# a texture's size. region builds one from a rect in texels.
# ---
# tex:    consumer texture handle, never ATLAS
# u0:     left u of the region
# v0:     top v of the region
# u1:     right u of the region
# v1:     bottom v of the region
# filter: FILTER_NEAREST or FILTER_LINEAR
pub rec Image {
    tex:    u64;
    u0:     f32;
    v0:     f32;
    u1:     f32;
    v1:     f32;
    filter: u32;
}

# a region of a consumer texture given as a rect in texels
# ---
# tex:    consumer texture handle, never ATLAS
# tw:     texture width in texels
# th:     texture height in texels
# x:      region left in texels
# y:      region top in texels
# w:      region width in texels
# h:      region height in texels
# filter: FILTER_NEAREST or FILTER_LINEAR
# ret:    the region with its rect in uv
pub fun region(tex: u64, tw: f32, th: f32, x: f32, y: f32, w: f32, h: f32, filter: u32) Image {
    ret Image{tex: tex, u0: x / tw, v0: y / th, u1: (x + w) / tw, v1: (y + h) / th, filter: filter};
}

# the whole of a consumer texture
# ---
# tex:    consumer texture handle, never ATLAS
# filter: FILTER_NEAREST or FILTER_LINEAR
# ret:    the region covering uv [0, 1] on both axes
pub fun whole(tex: u64, filter: u32) Image {
    ret Image{tex: tex, u0: 0.0::f32, v0: 0.0::f32, u1: 1.0::f32, v1: 1.0::f32, filter: filter};
}

# straight (non-premultiplied) rgba, each channel in [0, 1]
# ---
# r: red channel
# g: green channel
# b: blue channel
# a: alpha channel
pub rec Color {
    r: f32;
    g: f32;
    b: f32;
    a: f32;
}

# construct a Color from four channel values
# ---
# r:   red channel in [0, 1]
# g:   green channel in [0, 1]
# b:   blue channel in [0, 1]
# a:   alpha channel in [0, 1]
# ret: the color
pub fun rgba(r: f32, g: f32, b: f32, a: f32) Color {
    var c: Color;
    c.r = r;
    c.g = g;
    c.b = b;
    c.a = a;
    ret c;
}

# the fifth root of a in [0, 1], by newton's method from the fourth root
fun root5(a: f64) f64 {
    if (a <= 0.0) { ret 0.0; }
    var y: f64   = float.sqrt_f32(float.sqrt_f32(a::f32))::f64;
    var i: usize = 0;
    for (i < 32) {
        val y4:   f64 = y * y * y * y;
        val step: f64 = (y4 * y - a) / (5.0 * y4);
        y = y - step;
        if (step < 0.000000001 && step > -0.000000001) { brk; }
        i = i + 1;
    }
    ret y;
}

# an sRGB-encoded channel in linear light
# ---
# c:   channel in [0, 1] as authored, sRGB-encoded
# ret: the same channel in linear light, in [0, 1]
pub fun srgb_to_linear(c: f32) f32 {
    if (c <= 0.0::f32)     { ret 0.0::f32; }
    if (c >= 1.0::f32)     { ret 1.0::f32; }
    if (c <= 0.04045::f32) { ret c / 12.92::f32; }
    val x: f64 = (c::f64 + 0.055) / 1.055;
    # x^2.4 is x^2 times the fifth root of x^2
    ret (x * x * root5(x * x))::f32;
}

# a color as authored in sRGB, converted to linear light with alpha untouched
#
# for a target that encodes sRGB on write, which expects linear values and
# would otherwise display authored colors too bright.
# ---
# c:   color as authored
# ret: the color in linear light
pub fun linear(c: Color) Color {
    ret rgba(srgb_to_linear(c.r), srgb_to_linear(c.g), srgb_to_linear(c.b), c.a);
}

# slots in a LinearCache, a power of two
pub val LINEAR_SLOTS: usize = 64;

# authored colors and their linear() conversions, so an sRGB painter converts
# each distinct color once rather than once per quad
#
# direct-mapped on the color's exact bits, so a hit returns exactly what linear
# returned for those bits. a zeroed cache is valid: its slots hold transparent
# black, which linear maps to itself.
# ---
# keys: authored colors
# vals: linear(keys[i]) for each slot
pub rec LinearCache {
    keys: [LINEAR_SLOTS]Color;
    vals: [LINEAR_SLOTS]Color;
}

# the slot a color's bits hash to
fun slot(c: Color) usize {
    var h: u64 = c.r:~u32::u64;
    h = (h ^ c.g:~u32::u64) * 0x9E3779B97F4A7C15;
    h = (h ^ c.b:~u32::u64) * 0x9E3779B97F4A7C15;
    h = (h ^ c.a:~u32::u64) * 0x9E3779B97F4A7C15;
    ret (h >> 40)::usize & (LINEAR_SLOTS - 1);
}

# whether two colors have the same bits in every channel
fun same(x: Color, y: Color) bool {
    ret x.r:~u32 == y.r:~u32 && x.g:~u32 == y.g:~u32 && x.b:~u32 == y.b:~u32 && x.a:~u32 == y.a:~u32;
}

# linear(c), converted once per distinct color held in the cache
# ---
# lc:  the cache, updated on a miss
# c:   color as authored
# ret: the color in linear light, identical to linear(c)
pub fun linear_cached(lc: *LinearCache, c: Color) Color {
    val i: usize = slot(c);
    if (same(lc.keys[i], c)) { ret lc.vals[i]; }
    val l: Color = linear(c);
    lc.keys[i] = c;
    lc.vals[i] = l;
    ret l;
}

# a single vertex: pixel-space position, atlas uv, and color
# ---
# x: pixel-space x
# y: pixel-space y
# u: atlas u in [0, 1]
# v: atlas v in [0, 1]
# r: red channel
# g: green channel
# b: blue channel
# a: alpha channel
pub rec Vert {
    x: f32;
    y: f32;
    u: f32;
    v: f32;
    r: f32;
    g: f32;
    b: f32;
    a: f32;
}

# a growable vertex buffer accumulated over one frame
# ---
# verts: backing buffer (nil before init)
# cap:   capacity in vertices
# len:   vertices currently used
# a:     allocator backing the buffer
pub rec DrawList {
    verts: *Vert;
    cap:   usize;
    len:   usize;
    a:     *allo.Allocator;
}

# allocate a draw list's initial backing buffer
# ---
# dl:  draw list to initialize
# a:   allocator to back the buffer
# ret: ok, or the allocator's refusal with the draw list left empty
pub fun init(dl: *DrawList, a: *allo.Allocator) err[allo.Error] {
    dl.a     = a;
    dl.len   = 0;
    dl.cap   = 0;
    dl.verts = nil;

    val r: res[*Vert, allo.Error] = allo.allocate[Vert](a, INIT_CAP);
    if (sel r.err) { ret err[allo.Error].err{r.err}; }
    dl.verts = r.ok;
    dl.cap   = INIT_CAP;
    ret err[allo.Error].ok{};
}

# release the backing buffer and reset the draw list to empty
# ---
# dl:  draw list to free
# ret: ok, or the allocator's refusal with the draw list still owning its buffer
pub fun free(dl: *DrawList) err[allo.Error] {
    if (dl == nil) { ret err[allo.Error].ok{}; }

    val freed: err[allo.Error] = allo.deallocate[Vert](dl.a, dl.verts, dl.cap);
    if (sel freed.err) { ret freed; }
    dl.verts = nil;
    dl.cap   = 0;
    dl.len   = 0;
    ret err[allo.Error].ok{};
}

# clear the draw list for a new frame, keeping allocated capacity
# ---
# dl: draw list to reset
pub fun reset(dl: *DrawList) {
    if (dl == nil) { ret; }
    dl.len = 0;
}

# number of vertices currently in the draw list
# ---
# dl:  draw list to query
# ret: vertex count
pub fun count(dl: *DrawList) usize {
    ret dl.len;
}

# pointer to the first vertex, for upload (nil if never grown)
# ---
# dl:  draw list to query
# ret: pointer to the vertex buffer
pub fun data(dl: *DrawList) *Vert {
    ret dl.verts;
}

# ensure room for at least one more vertex, doubling capacity when full
# ---
# dl:  draw list to grow
# ret: ok, or the allocator's refusal with the buffer left as it was
fun grow(dl: *DrawList) err[allo.Error] {
    if (dl.len < dl.cap) { ret err[allo.Error].ok{}; }

    var new_cap: usize = dl.cap * 2;
    if (new_cap == 0) { new_cap = INIT_CAP; }

    val r: res[*Vert, allo.Error] = allo.reallocate[Vert](dl.a, dl.verts, dl.cap, new_cap);
    if (sel r.err) { ret err[allo.Error].err{r.err}; }
    dl.verts = r.ok;
    dl.cap   = new_cap;
    ret err[allo.Error].ok{};
}

# ensure capacity for at least n vertices in total
# ---
# dl:  draw list to grow
# n:   vertex count the buffer must hold
# ret: ok, or the allocator's refusal with the buffer left as it was
pub fun reserve(dl: *DrawList, n: usize) err[allo.Error] {
    if (n <= dl.cap) { ret err[allo.Error].ok{}; }

    var new_cap: usize = dl.cap * 2;
    if (new_cap < n) { new_cap = n; }

    val r: res[*Vert, allo.Error] = allo.reallocate[Vert](dl.a, dl.verts, dl.cap, new_cap);
    if (sel r.err) { ret err[allo.Error].err{r.err}; }
    dl.verts = r.ok;
    dl.cap   = new_cap;
    ret err[allo.Error].ok{};
}

# append one vertex, growing the buffer if full
# ---
# dl:  draw list to append to
# v:   vertex to append
# ret: ok, or the allocator's refusal with the vertex not appended
pub fun push_vert(dl: *DrawList, v: Vert) err[allo.Error] {
    val g: err[allo.Error] = grow(dl);
    if (sel g.err) { ret g; }
    dl.verts[dl.len] = v;
    dl.len           = dl.len + 1;
    ret err[allo.Error].ok{};
}

# append an axis-aligned quad as two triangles (6 vertices)
#
# (x0, y0) is the top-left corner and (x1, y1) the bottom-right, with (u0, v0)
# and (u1, v1) the matching atlas corners. all six vertices share color c.
# ---
# dl:  draw list to append to
# x0:  left x in pixels
# y0:  top y in pixels
# x1:  right x in pixels
# y1:  bottom y in pixels
# u0:  left atlas u
# v0:  top atlas v
# u1:  right atlas u
# v1:  bottom atlas v
# c:   fill color
# ret: ok, or the allocator's refusal after the vertices that fit
pub fun push_quad(dl: *DrawList, x0: f32, y0: f32, x1: f32, y1: f32, u0: f32, v0: f32, u1: f32, v1: f32, c: Color) err[allo.Error] {
    var tl: Vert;
    tl.x = x0;
    tl.y = y0;
    tl.u = u0;
    tl.v = v0;
    tl.r = c.r;
    tl.g = c.g;
    tl.b = c.b;
    tl.a = c.a;
    var tr: Vert;
    tr.x = x1;
    tr.y = y0;
    tr.u = u1;
    tr.v = v0;
    tr.r = c.r;
    tr.g = c.g;
    tr.b = c.b;
    tr.a = c.a;
    var br: Vert;
    br.x = x1;
    br.y = y1;
    br.u = u1;
    br.v = v1;
    br.r = c.r;
    br.g = c.g;
    br.b = c.b;
    br.a = c.a;
    var bl: Vert;
    bl.x = x0;
    bl.y = y1;
    bl.u = u0;
    bl.v = v1;
    bl.r = c.r;
    bl.g = c.g;
    bl.b = c.b;
    bl.a = c.a;

    val e0: err[allo.Error] = push_vert(dl, tl);
    if (sel e0.err) { ret e0; }
    val e1: err[allo.Error] = push_vert(dl, tr);
    if (sel e1.err) { ret e1; }
    val e2: err[allo.Error] = push_vert(dl, br);
    if (sel e2.err) { ret e2; }
    val e3: err[allo.Error] = push_vert(dl, tl);
    if (sel e3.err) { ret e3; }
    val e4: err[allo.Error] = push_vert(dl, br);
    if (sel e4.err) { ret e4; }
    val e5: err[allo.Error] = push_vert(dl, bl);
    if (sel e5.err) { ret e5; }
    ret err[allo.Error].ok{};
}

test push_quad__six_verts_at_corners {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }

    var dl: DrawList;
    val ie: err[allo.Error] = init(?dl, ?a);
    if (sel ie.err) { ret 1; }

    val c:  Color           = rgba(1.0::f32, 0.5::f32, 0.25::f32, 1.0::f32);
    val pe: err[allo.Error] = push_quad(?dl, 10.0::f32, 20.0::f32, 30.0::f32, 40.0::f32, 0.0::f32, 0.0::f32, 1.0::f32, 1.0::f32, c);
    if (sel pe.err) { ret 1; }

    if (count(?dl) != 6) { ret 1; }

    val p: *Vert = data(?dl);
    if (p[0].x != 10.0::f32) { ret 1; }
    if (p[0].y != 20.0::f32) { ret 1; }
    if (p[1].x != 30.0::f32) { ret 1; }
    if (p[1].y != 20.0::f32) { ret 1; }
    if (p[2].x != 30.0::f32) { ret 1; }
    if (p[2].y != 40.0::f32) { ret 1; }
    if (p[5].x != 10.0::f32) { ret 1; }
    if (p[5].y != 40.0::f32) { ret 1; }
    if (p[0].r != 1.0::f32)  { ret 1; }
    if (p[0].a != 1.0::f32)  { ret 1; }

    val freed: err[allo.Error] = free(?dl);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test push_vert__growth_keeps_earlier_verts {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }

    var dl: DrawList;
    val ie: err[allo.Error] = init(?dl, ?a);
    if (sel ie.err) { ret 1; }

    var i: usize = 0;
    for (i < INIT_CAP + 10) {
        var v: Vert;
        v.x = i::f32;
        v.y = 0.0::f32;
        val e: err[allo.Error] = push_vert(?dl, v);
        if (sel e.err) { ret 1; }
        i = i + 1;
    }

    if (count(?dl) != INIT_CAP + 10) { ret 1; }
    if (dl.cap <= INIT_CAP)          { ret 1; }

    val p: *Vert = data(?dl);
    if (p[0].x != 0.0::f32)                       { ret 1; }
    if (p[INIT_CAP - 1].x != (INIT_CAP - 1)::f32) { ret 1; }
    if (p[INIT_CAP + 9].x != (INIT_CAP + 9)::f32) { ret 1; }

    val freed: err[allo.Error] = free(?dl);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test reserve__grows_only_past_capacity {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }

    var dl: DrawList;
    val ie: err[allo.Error] = init(?dl, ?a);
    if (sel ie.err) { ret 1; }

    var v: Vert;
    v.x = 3.0::f32;
    val pe: err[allo.Error] = push_vert(?dl, v);
    if (sel pe.err) { ret 1; }

    val small: err[allo.Error] = reserve(?dl, 10);
    if (sel small.err || dl.cap != INIT_CAP) { ret 2; }
    val big: err[allo.Error] = reserve(?dl, INIT_CAP * 3);
    if (sel big.err || dl.cap < INIT_CAP * 3)          { ret 3; }
    if (count(?dl) != 1 || data(?dl)[0].x != 3.0::f32) { ret 4; }

    val freed: err[allo.Error] = free(?dl);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test linear__decodes_srgb_and_keeps_alpha {
    val c: Color = linear(rgba(0.5::f32, 0.0::f32, 1.0::f32, 0.5::f32));
    # 0.5 encoded is about 0.2140 linear
    if (c.r < 0.2139::f32 || c.r > 0.2141::f32) { ret 1; }
    if (c.g != 0.0::f32 || c.b != 1.0::f32)     { ret 2; }
    if (c.a != 0.5::f32)                        { ret 3; }
    # the linear segment near black
    if (srgb_to_linear(0.02::f32) != 0.02::f32 / 12.92::f32) { ret 4; }
    ret 0;
}

test linear_cached__matches_linear_bit_for_bit {
    var lc: LinearCache;
    var n:  usize = 0;
    # two passes over more colors than slots, so misses and evictions run
    for (n < 2) {
        var i: usize = 0;
        for (i < 300) {
            val f: f32   = i::f32 / 299.0::f32;
            val c: Color = rgba(f, 1.0::f32 - f, f * f, 0.5::f32 + f / 2.0::f32);
            val l: Color = linear(c);
            # the first call converts or reads an older slot, the second hits
            if (!same(linear_cached(?lc, c), l)) { ret 1; }
            if (!same(linear_cached(?lc, c), l)) { ret 1; }
            i = i + 1;
        }
        n = n + 1;
    }
    # a zeroed cache answers transparent black correctly
    var fresh: LinearCache;
    val z:     Color = rgba(0.0::f32, 0.0::f32, 0.0::f32, 0.0::f32);
    if (!same(linear_cached(?fresh, z), linear(z))) { ret 2; }
    ret 0;
}
