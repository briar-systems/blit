    0x6E, 0x3B, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 # U+007E (~)
};

# process-lifetime RGBA8 atlas pixels, nil until build_atlas runs
var atlas_buf: *u8 = nil;

# rasterize the embedded font into the RGBA8 atlas buffer
#
# idempotent: a second call with an already-built atlas is a no-op. the buffer
# lives for the process lifetime and is shared by every consumer.
# ---
# a:   allocator for the atlas buffer (ATLAS_W * ATLAS_H * 4 bytes)
# ret: ok, or the allocator's refusal with no atlas built
pub fun build_atlas(a: *allo.Allocator) err[allo.Error] {
    if (atlas_buf != nil) { ret err[allo.Error].ok{}; }

    val npx:    usize                = ATLAS_W * ATLAS_H;
    val nbytes: usize                = npx * 4;
    val r:      res[*u8, allo.Error] = allo.allocate[u8](a, nbytes);
    if (sel r.err) { ret err[allo.Error].err{r.err}; }
    val buf: *u8 = r.ok;

    # white rgb everywhere with zero alpha, lit pixels turn alpha on below,
    # so linear filtering never bleeds a dark fringe into glyph edges
    var i: usize = 0;
    for (i < npx) {
        buf[i * 4 + 0] = 255;
        buf[i * 4 + 1] = 255;
        buf[i * 4 + 2] = 255;
        buf[i * 4 + 3] = 0;
        i              = i + 1;
    }

    var g: usize = 0;
    for (g < GLYPH_COUNT) {
        val ox: usize = (g % ATLAS_COLS) * GLYPH_PX;
        val oy: usize = (g / ATLAS_COLS) * GLYPH_PX;
        var ry: usize = 0;
        for (ry < GLYPH_PX) {
            val bits: u8    = FONT[g * 8 + ry];
            var rx:   usize = 0;
            for (rx < GLYPH_PX) {
                if (((bits >> rx) & 1) != 0) {
                    val px: usize = (oy + ry) * ATLAS_W + (ox + rx);
                    buf[px * 4 + 3] = 255;
                }
                rx = rx + 1;
            }
            ry = ry + 1;
        }
        g = g + 1;
    }

    # the dedicated white cell: a fully opaque block for solid quads
    val wox: usize = (WHITE_CELL % ATLAS_COLS) * GLYPH_PX;
    val woy: usize = (WHITE_CELL / ATLAS_COLS) * GLYPH_PX;
    var wy:  usize = 0;
    for (wy < GLYPH_PX) {
        var wx: usize = 0;
        for (wx < GLYPH_PX) {
            val px: usize = (woy + wy) * ATLAS_W + (wox + wx);
            buf[px * 4 + 3] = 255;
            wx              = wx + 1;
        }
        wy = wy + 1;
    }

    atlas_buf = buf;
    ret err[allo.Error].ok{};
}

# pointer to the RGBA8 atlas (ATLAS_W * ATLAS_H * 4 bytes)
# ---
# ret: atlas pixels, or nil if build_atlas has not run
pub fun atlas_pixels() *u8 {
    ret atlas_buf;
}

# atlas uv of the solid-white cell's center, for tinting solid quads
# ---
# u: receives the white u in [0, 1]
# v: receives the white v in [0, 1]
pub fun white_uv(u: *f32, v: *f32) {
    val wx: usize = (WHITE_CELL % ATLAS_COLS) * GLYPH_PX + GLYPH_PX / 2;
    val wy: usize = (WHITE_CELL / ATLAS_COLS) * GLYPH_PX + GLYPH_PX / 2;
    @u = wx::f32 / ATLAS_W::f32;
    @v = wy::f32 / ATLAS_H::f32;
}

# atlas uv rect covering a character's 8x8 cell
#
# non-printable characters (outside 32..126) map to the space glyph.
# ---
# c:  character
# u0: receives the left u
# v0: receives the top v
# u1: receives the right u
# v1: receives the bottom v
pub fun glyph_uv(c: u8, u0: *f32, v0: *f32, u1: *f32, v1: *f32) {
    var idx: usize = 0;
    if (c >= 32 && c <= 126) { idx = (c - 32)::usize; }
    val col: usize = idx % ATLAS_COLS;
    val row: usize = idx / ATLAS_COLS;
    @u0 = (col * GLYPH_PX)::f32 / ATLAS_W::f32;
    @v0 = (row * GLYPH_PX)::f32 / ATLAS_H::f32;
    @u1 = ((col + 1) * GLYPH_PX)::f32 / ATLAS_W::f32;
    @v1 = ((row + 1) * GLYPH_PX)::f32 / ATLAS_H::f32;
}

# pixel width of a string laid out at one glyph advance per character
# ---
# s:   string to measure
# ret: width in pixels
pub fun text_width(s: str) f32 {
    ret str_len(s)::f32 * GLYPH_W;
}

test "font: text_width counts glyphs" {
    if (text_width("") != 0.0::f32)                       { ret 1; }
    if (text_width("ABC") != 3.0::f32 * GLYPH_W)          { ret 1; }
    if (text_width("hello world") != 11.0::f32 * GLYPH_W) { ret 1; }
    ret 0;
}

test "font: glyph_uv in range for 'A', space, and non-printable" {
    var u0: f32;
    var v0: f32;
    var u1: f32;
    var v1: f32;

    glyph_uv('A', ?u0, ?v0, ?u1, ?v1);
    if (u0 < 0.0::f32 || u1 > 1.0::f32) { ret 1; }
    if (v0 < 0.0::f32 || v1 > 1.0::f32) { ret 1; }
    if (u1 <= u0)                       { ret 1; }
    if (v1 <= v0)                       { ret 1; }

    var su0: f32;
    var sv0: f32;
    var su1: f32;
    var sv1: f32;
    glyph_uv(' ', ?su0, ?sv0, ?su1, ?sv1);
    if (su0 < 0.0::f32 || su1 > 1.0::f32) { ret 1; }

    # tab is non-printable and must fold onto the space glyph
    var tu0: f32;
    var tv0: f32;
    var tu1: f32;
    var tv1: f32;
    glyph_uv(9, ?tu0, ?tv0, ?tu1, ?tv1);
    if (tu0 != su0 || tv0 != sv0) { ret 1; }
    ret 0;
}

test "font: white_uv lies inside the atlas" {
    var u: f32;
    var v: f32;
    white_uv(?u, ?v);
    if (u < 0.0::f32 || u > 1.0::f32) { ret 1; }
    if (v < 0.0::f32 || v > 1.0::f32) { ret 1; }
    ret 0;
}

test "font: build_atlas fills consistent dimensions and an opaque white texel" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }

    val e: err[allo.Error] = build_atlas(?a);
    if (sel e.err)             { ret 1; }
    if (atlas_pixels() == nil) { ret 1; }

    if (ATLAS_W != ATLAS_COLS * GLYPH_PX) { ret 1; }
    if (ATLAS_H != 6 * GLYPH_PX)          { ret 1; }

    var u: f32;
    var v: f32;
    white_uv(?u, ?v);
    val px_x: usize = (u * ATLAS_W::f32)::usize;
    val px_y: usize = (v * ATLAS_H::f32)::usize;
    val idx:  usize = (px_y * ATLAS_W + px_x) * 4;
    val p:    *u8   = atlas_pixels();
    if (p[idx + 0] != 255) { ret 1; }
    if (p[idx + 3] != 255) { ret 1; }
    ret 0;
}
