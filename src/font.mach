# text: a glyph source, the glyph cache over it and the atlas its bitmaps live in
#
# a Font lays out utf-8 text through a blit.glyph source. it decodes text by
# codepoint, asks the source for each codepoint's metrics once per scale and
# caches them, and rasterises a glyph into the atlas the first time it is
# drawn, never when it is only measured. a codepoint the source lacks draws as
# U+FFFD, or as '?' when the source lacks that too, and one neither has keeps
# no advance. control codepoints take no space, and a newline breaks the line.
#
# the built-in bitmap font is the default source, so a Font needs no
# configuration. set_source swaps in any other, such as a TrueType face.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use blit.atlas;
use blit.bitmap;
use blit.glyph;
use allo: std.allocator;
use std.allocator.page;
use gmap: std.collections.map;
use std.text.utf8;

# the codepoint drawn for one the source lacks
pub val REPLACEMENT: u32 = 0xFFFD;

# the one control codepoint layout acts on
pub val NEWLINE: u32 = 10;

# a glyph resolved at one scale, ready to lay out and draw
# ---
# g:     the source's metrics for the glyph drawn, after any fallback
# drawn: 1 if the glyph has a bitmap in the atlas, else 0
# page:  atlas page holding the bitmap
# u0:    left u of the bitmap
# v0:    top v of the bitmap
# u1:    right u of the bitmap
# v1:    bottom v of the bitmap
pub rec Placed {
    g:     glyph.Glyph;
    drawn: u8;
    page:  u32;
    u0:    f32;
    v0:    f32;
    u1:    f32;
    v1:    f32;
}

# one cached codepoint at one scale
# ---
# placed: its metrics and, once drawn, its atlas cell
# drawn:  the codepoint the source rasterises for it, after fallback
# state:  0 until first drawn, 1 once packed or blank, 2 when packing failed
rec Entry {
    placed: Placed;
    drawn:  u32;
    state:  u8;
}

# a glyph source with its cache and atlas
# ---
# a:       allocator for the cache, the atlas and raster scratch
# src:     the glyph source
# atlas:   the pages glyph bitmaps are packed into
# cache:   (scale bits << 32 | codepoint) to entry
# scratch: coverage buffer a glyph is rasterised into before packing
# cap:     bytes scratch holds
# missing: glyphs that could not be rasterised or packed, which draw blank
pub rec Font {
    a:       *allo.Allocator;
    src:     glyph.GlyphSource;
    atlas:   atlas.Atlas;
    cache:   gmap.Map[u64, Entry];
    scratch: *u8;
    cap:     usize;
    missing: usize;
}

# open a font over the built-in bitmap source
# ---
# f:   font to initialize
# a:   allocator for the cache, the atlas and raster scratch
# ret: ok, or the allocator's refusal with nothing allocated
pub fun init(f: *Font, a: *allo.Allocator) err[allo.Error] {
    f.a       = a;
    f.src     = bitmap.source();
    f.cache   = gmap.init[u64, Entry](a);
    f.scratch = nil;
    f.cap     = 0;
    f.missing = 0;
    ret atlas.init(?f.atlas, a);
}

# release the cache, the atlas and the scratch buffer
# ---
# f:   font to free
# ret: ok, or the first refusal
pub fun free(f: *Font) err[allo.Error] {
    val c: err[allo.Error] = gmap.dnit[u64, Entry](?f.cache);
    if (sel c.err) { ret c; }
    if (f.scratch != nil) {
        val s: err[allo.Error] = allo.deallocate[u8](f.a, f.scratch, f.cap);
        if (sel s.err) { ret s; }
        f.scratch = nil;
        f.cap     = 0;
    }
    ret atlas.free(?f.atlas);
}

# draw text from another source from now on
#
# the cache is dropped and the atlas pages cleared, so every page is dirty and
# must be uploaded again. call it between frames: vertices already emitted
# point at cells the reset reuses.
# ---
# f:   font
# src: the new source
pub fun set_source(f: *Font, src: glyph.GlyphSource) {
    f.src = src;
    gmap.clear[u64, Entry](?f.cache);
    atlas.reset(?f.atlas);
    f.missing = 0;
}

# the line metrics at a scale
# ---
# f:     font
# scale: interface scale
# ret:   line metrics in pixels
pub fun line(f: *Font, scale: f32) glyph.LineMetrics {
    ret f.src.line(f.src.self, scale);
}

# the height of one line box at a scale
# ---
# f:     font
# scale: interface scale
# ret:   line height in pixels
pub fun line_height(f: *Font, scale: f32) f32 {
    ret glyph.line_height(line(f, scale));
}

# decode the codepoint at a byte offset, always making progress
#
# a malformed sequence decodes to U+FFFD and consumes one byte, so a bad byte
# costs one replacement glyph and never the text after it.
# ---
# s:   utf-8 text
# i:   byte offset below n
# n:   byte length of s
# cp:  receives the codepoint
# ret: bytes consumed, at least one
pub fun next(s: str, i: usize, n: usize, cp: *u32) usize {
    val used: usize = utf8.decode(?s[i], n - i, cp);
    if (used == 0) {
        @cp = REPLACEMENT;
        ret 1;
    }
    ret used;
}

# whether layout skips a codepoint: every control but the newline
# ---
# cp:  codepoint
# ret: true for a control codepoint that takes no space
pub fun is_control(cp: u32) bool {
    if (cp == NEWLINE) { ret false; }
    ret cp < 0x20 || cp == 0x7F;
}

# the pen adjustment between two codepoints, 0 without kerning
# ---
# f:     font
# left:  the codepoint before, 0 at the start of a line
# right: the codepoint after
# scale: interface scale
# ret:   adjustment in pixels
pub fun kern(f: *Font, left: u32, right: u32, scale: f32) f32 {
    if (left == 0 || f.src.kern == nil) { ret 0.0::f32; }
    ret f.src.kern(f.src.self, left, right, scale);
}

# how far the pen moves over one codepoint after another, kerning included
#
# for layout built outside blit, such as a caret walking a text field.
# ---
# f:     font
# left:  the codepoint before on the line, 0 for none
# cp:    the codepoint
# scale: interface scale
# ret:   pen movement in pixels, 0 for a control codepoint
pub fun advance(f: *Font, left: u32, cp: u32, scale: f32) f32 {
    if (is_control(cp) || cp == NEWLINE) { ret 0.0::f32; }
    ret kern(f, left, cp, scale) + glyph_of(f, cp, scale).g.advance;
}

# width of the widest line of a string
# ---
# f:     font
# s:     utf-8 text
# scale: interface scale
# ret:   width in pixels
pub fun measure(f: *Font, s: str, scale: f32) f32 {
    if (s == nil) { ret 0.0::f32; }
    val n:      usize = str_len(s);
    var widest: f32   = 0.0::f32;
    var w:      f32   = 0.0::f32;
    var prev:   u32   = 0;
    var i:      usize = 0;
    for (i < n) {
        var cp: u32 = 0;
        i = i + next(s, i, n, ?cp);
        if (cp == NEWLINE) {
            if (w > widest) { widest = w; }
            w    = 0.0::f32;
            prev = 0;
        }
        or (!is_control(cp)) {
            w    = w + advance(f, prev, cp, scale);
            prev = cp;
        }
    }
    if (w > widest) { widest = w; }
    ret widest;
}

# the cache key of a codepoint at a scale
fun key(cp: u32, scale: f32) u64 {
    ret ((scale:~u32)::u64 << 32) | cp::u64;
}

# resolve a codepoint's metrics, falling back to the replacement glyph
fun resolve(f: *Font, cp: u32, scale: f32) Entry {
    var e: Entry;
    var g: glyph.Glyph;
    if (f.src.glyph(f.src.self, cp, scale, ?g)) {
        e.placed.g = g;
        e.drawn    = cp;
        ret e;
    }
    if (f.src.glyph(f.src.self, REPLACEMENT, scale, ?g)) {
        e.placed.g = g;
        e.drawn    = REPLACEMENT;
        ret e;
    }
    if (f.src.glyph(f.src.self, '?', scale, ?g)) {
        e.placed.g = g;
        e.drawn    = '?';
        ret e;
    }
    # nothing to draw it with: no advance and no bitmap
    e.state = 1;
    ret e;
}

# the cached entry for a codepoint at a scale, resolving it the first time
#
# returned by value: resolving can grow the map, which moves its entries.
fun entry(f: *Font, cp: u32, scale: f32) Entry {
    var k:     u64         = key(cp, scale);
    val known: opt[*Entry] = gmap.get[u64, Entry](?f.cache, ?k);
    if (sel known.some) { ret @known.some; }
    val e:    Entry                 = resolve(f, cp, scale);
    val kept: res[bool, allo.Error] = gmap.insert[u64, Entry](?f.cache, k, e);
    ret e;
}

# a codepoint's metrics at a scale, without rasterising it
fun glyph_of(f: *Font, cp: u32, scale: f32) Placed {
    ret entry(f, cp, scale).placed;
}

# make sure scratch holds at least n bytes
fun reserve(f: *Font, n: usize) u8 {
    if (n <= f.cap) { ret 1; }
    if (f.scratch != nil) {
        val freed: err[allo.Error] = allo.deallocate[u8](f.a, f.scratch, f.cap);
        f.scratch = nil;
        f.cap     = 0;
        if (sel freed.err) { ret 0; }
    }
    val r: res[*u8, allo.Error] = allo.allocate[u8](f.a, n);
    if (sel r.err) { ret 0; }
    f.scratch = r.ok;
    f.cap     = n;
    ret 1;
}

# rasterise an entry's glyph and pack it, leaving it blank on failure
fun rasterise(f: *Font, e: *Entry, scale: f32) {
    e.state = 1;
    val w: usize = e.placed.g.w::usize;
    val h: usize = e.placed.g.h::usize;
    if (w == 0 || h == 0) { ret; }
    if (reserve(f, w * h) == 0 || !f.src.raster(f.src.self, e.drawn, scale, f.scratch, w)) {
        e.state   = 2;
        f.missing = f.missing + 1;
        ret;
    }
    val slot: opt[atlas.Slot] = atlas.pack(?f.atlas, f.scratch, w, w, h);
    if (sel slot.none) {
        e.state   = 2;
        f.missing = f.missing + 1;
        ret;
    }
    val side: f32 = atlas.PAGE_SIDE::f32;
    e.placed.drawn = 1;
    e.placed.page  = slot.some.page;
    e.placed.u0    = slot.some.x::f32 / side;
    e.placed.v0    = slot.some.y::f32 / side;
    e.placed.u1    = (slot.some.x::usize + w)::f32 / side;
    e.placed.v1    = (slot.some.y::usize + h)::f32 / side;
}

# a codepoint ready to draw at a scale, rasterising it into the atlas the first
# time it is asked for
#
# a glyph that could not be rasterised or packed keeps its advance and draws
# nothing, counted in missing.
# ---
# f:     font
# cp:    codepoint
# scale: interface scale
# ret:   its metrics and atlas cell
pub fun place(f: *Font, cp: u32, scale: f32) Placed {
    var e: Entry = entry(f, cp, scale);
    if (e.state != 0) { ret e.placed; }
    # a fallback shares the cell of the glyph it falls back to
    if (e.drawn != cp) { ret place(f, e.drawn, scale); }
    rasterise(f, ?e, scale);
    val kept: res[bool, allo.Error] = gmap.insert[u64, Entry](?f.cache, key(cp, scale), e);
    ret e.placed;
}

# glyphs that could not be rasterised or packed since the source was set
# ---
# f:   font
# ret: count of glyphs drawing blank
pub fun missing(f: *Font) usize {
    ret f.missing;
}

# a test face: fractional advances, a kerned pair, only 'A' and 'V', and a
# 3x5 bitmap for each that is taller at a larger scale
#[testing]
fun test_line(self: ptr, scale: f32) glyph.LineMetrics {
    ret glyph.LineMetrics{ascent: 7.5::f32 * scale, descent: 2.25::f32 * scale, gap: 1.0::f32 * scale};
}

#[testing]
fun test_glyph(self: ptr, cp: u32, scale: f32, out: *glyph.Glyph) bool {
    if (cp != 'A' && cp != 'V') { ret false; }
    out.advance = 5.5::f32 * scale;
    out.x0      = 0.5::f32;
    out.y0      = -5.0::f32 * scale;
    out.x1      = 3.5::f32 * scale;
    out.y1      = 0.0::f32;
    out.w       = 3;
    out.h       = (5.0::f32 * scale)::u32;
    ret true;
}

#[testing]
fun test_kern(self: ptr, left: u32, right: u32, scale: f32) f32 {
    if (left == 'A' && right == 'V') { ret -1.25::f32 * scale; }
    ret 0.0::f32;
}

#[testing]
fun test_raster(self: ptr, cp: u32, scale: f32, cov: *u8, stride: usize) bool {
    @(self::*u64) = @(self::*u64) + 1;
    val h: usize = (5.0::f32 * scale)::usize;
    var y: usize = 0;
    for (y < h) {
        cov[y * stride + 0] = 255;
        cov[y * stride + 1] = 128;
        cov[y * stride + 2] = 0;
        y                   = y + 1;
    }
    ret true;
}

test font__fractional_kerned_utf8_with_fallback {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var f:  Font;
    val ie: err[allo.Error] = init(?f, ?a);
    if (sel ie.err) { ret 1; }

    var rasters: u64 = 0;
    set_source(?f, glyph.GlyphSource{
        self: (?rasters)::ptr, line: test_line, glyph: test_glyph, kern: test_kern, raster: test_raster
    });

    if (line_height(?f, 1.0::f32) != 10.75::f32) { ret 2; }
    # fractional advances and the AV pair kerned
    if (measure(?f, "AV", 1.0::f32) != 9.75::f32) { ret 3; }
    if (measure(?f, "VA", 1.0::f32) != 11.0::f32) { ret 4; }
    # the widest line wins, and a control takes no space
    if (measure(?f, "A\nAVA\t", 1.0::f32) != 15.25::f32) { ret 5; }
    # the face lacks U+FFFD, so 'é' (two utf-8 bytes) falls back to '?', which
    # it lacks too, and takes no space
    if (measure(?f, "A\xC3\xA9", 1.0::f32) != 5.5::f32) { ret 6; }
    # metrics scale with the interface scale
    if (measure(?f, "AV", 2.0::f32) != 19.5::f32) { ret 7; }
    # measuring never rasterises
    if (rasters != 0) { ret 8; }

    # drawing rasterises once per glyph and scale, into distinct cells
    val p1: Placed = place(?f, 'A', 1.0::f32);
    val p2: Placed = place(?f, 'A', 1.0::f32);
    val p3: Placed = place(?f, 'A', 2.0::f32);
    if (rasters != 2)                                   { ret 9; }
    if (p1.drawn != 1 || p1.u0 != p2.u0)                { ret 10; }
    if (p3.g.h != 10 || p3.v1 - p3.v0 <= p1.v1 - p1.v0) { ret 11; }
    val px: *u8   = atlas.page_pixels(?f.atlas, 0);
    val tx: usize = (p1.u0 * atlas.PAGE_SIDE::f32)::usize + 1;
    val ty: usize = (p1.v0 * atlas.PAGE_SIDE::f32)::usize;
    if (px[(ty * atlas.PAGE_SIDE + tx) * 4 + 3] != 128) { ret 12; }

    val freed: err[allo.Error] = free(?f);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test font__bitmap_default_replaces_missing {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var f:  Font;
    val ie: err[allo.Error] = init(?f, ?a);
    if (sel ie.err) { ret 1; }

    if (line_height(?f, 1.0::f32) != 8.0::f32)    { ret 2; }
    if (measure(?f, "ok", 1.0::f32) != 16.0::f32) { ret 3; }
    # U+00E9 is missing from the bitmap font and draws as its replacement box
    val miss: Placed = place(?f, 0x00E9, 1.0::f32);
    val box:  Placed = place(?f, REPLACEMENT, 1.0::f32);
    if (miss.drawn != 1 || miss.g.advance != 8.0::f32) { ret 4; }
    if (miss.u0 != box.u0 || miss.v0 != box.v0)        { ret 5; }

    val freed: err[allo.Error] = free(?f);
    if (sel freed.err) { ret 1; }
    ret 0;
}
