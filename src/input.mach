# per-frame input the consumer fills before calling widgets
#
# the mouse: position, primary button and wheel. the consumer writes
# mx/my/down/wheel each frame; the context carries the previous frame's button
# state into prev_down so press and release edges can be detected.
#
# the keyboard: this frame's typed codepoints and key presses, in the order
# they arrived, as one list of events (see type_text and press_key). the
# consumer empties it each frame with clear_keys before filling it. blit never
# reads a window, so a key is a plain code: a key that types a printable ascii
# character is that character, letters in uppercase ('A', '7', ' '), and every
# other key is one of the KEY_* constants. a press carries the modifiers held
# with it as MOD_* bits. only presses and repeats are events, never releases.
#
# the clipboard is a hand-off the consumer fulfils. a widget that copies puts
# its text on the context (see context.copied), which the consumer moves to
# the system clipboard after the frame. a widget that pastes asks for it (see
# context.wants_paste), and the consumer answers with the clipboard's text in
# the next frame's paste.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

# most keyboard events one frame holds
pub val EVENT_CAP: usize = 32;

# key codes for keys that type no printable ascii character
pub val KEY_ENTER:     u32 = 0x100;
pub val KEY_ESCAPE:    u32 = 0x101;
pub val KEY_BACKSPACE: u32 = 0x102;
pub val KEY_DELETE:    u32 = 0x103;
pub val KEY_TAB:       u32 = 0x104;
pub val KEY_LEFT:      u32 = 0x105;
pub val KEY_RIGHT:     u32 = 0x106;
pub val KEY_UP:        u32 = 0x107;
pub val KEY_DOWN:      u32 = 0x108;
pub val KEY_HOME:      u32 = 0x109;
pub val KEY_END:       u32 = 0x10A;
pub val KEY_PAGE_UP:   u32 = 0x10B;
pub val KEY_PAGE_DOWN: u32 = 0x10C;
pub val KEY_INSERT:    u32 = 0x10D;

# modifier bits a key press carries, combined with |
pub val MOD_SHIFT: u8 = 1;
pub val MOD_CTRL:  u8 = 2;
pub val MOD_ALT:   u8 = 4;
pub val MOD_SUPER: u8 = 8;

# one key press or repeat
# ---
# code: the key, a printable ascii character or a KEY_* constant
# mods: the MOD_* bits held with it
pub rec Key {
    code: u32;
    mods: u8;
}

# one keyboard event: a typed codepoint or a key press
pub tag Event: u8 {
    text: u32;
    key:  Key;
}

# input for a single frame
# ---
# mx:         cursor x in pixels
# my:         cursor y in pixels
# down:       1 if the primary button is down this frame, else 0
# prev_down:  1 if the primary button was down last frame, else 0
# wheel:      vertical wheel travel this frame in pixels, positive when turned away from the user
# events:     this frame's keyboard events in arrival order, the first events_len of them
# events_len: how many events this frame holds
# paste:      the clipboard's utf-8 text in answer to last frame's paste request, else nil
pub rec Input {
    mx:         f32;
    my:         f32;
    down:       u8;
    prev_down:  u8;
    wheel:      f32;
    events:     [32]Event;
    events_len: usize;
    paste:      str;
}

# 1 on the frame the primary button transitions from up to down
# ---
# in:  input state
# ret: 1 if pressed this frame, else 0
pub fun pressed(in: Input) u8 {
    if (in.down != 0 && in.prev_down == 0) { ret 1; }
    ret 0;
}

# 1 on the frame the primary button transitions from down to up
# ---
# in:  input state
# ret: 1 if released this frame, else 0
pub fun released(in: Input) u8 {
    if (in.down == 0 && in.prev_down != 0) { ret 1; }
    ret 0;
}

# test whether the cursor lies in the half-open rect [x0, x1) x [y0, y1)
# ---
# in:  input state
# x0:  left edge in pixels (inclusive)
# y0:  top edge in pixels (inclusive)
# x1:  right edge in pixels (exclusive)
# y1:  bottom edge in pixels (exclusive)
# ret: 1 if the cursor is inside, else 0
pub fun in_rect(in: Input, x0: f32, y0: f32, x1: f32, y1: f32) u8 {
    if (in.mx >= x0 && in.mx < x1 && in.my >= y0 && in.my < y1) { ret 1; }
    ret 0;
}

# add a typed codepoint to the frame's keyboard events
# ---
# in:  input being filled
# cp:  the codepoint typed
# ret: false when the frame already holds EVENT_CAP events and it was dropped
pub fun type_text(in: *Input, cp: u32) bool {
    if (in.events_len >= EVENT_CAP) { ret false; }
    in.events[in.events_len] = Event.text{cp};
    in.events_len            = in.events_len + 1;
    ret true;
}

# add a key press or repeat to the frame's keyboard events
# ---
# in:   input being filled
# code: the key, a printable ascii character (letters uppercase) or a KEY_* constant
# mods: the MOD_* bits held with it
# ret:  false when the frame already holds EVENT_CAP events and it was dropped
pub fun press_key(in: *Input, code: u32, mods: u8) bool {
    if (in.events_len >= EVENT_CAP) { ret false; }
    in.events[in.events_len] = Event.key{Key{code: code, mods: mods}};
    in.events_len            = in.events_len + 1;
    ret true;
}

# empty the keyboard events and the paste, ready to fill a new frame
# ---
# in: input being filled
pub fun clear_keys(in: *Input) {
    in.events_len = 0;
    in.paste      = nil;
}

# whether modifiers make a key a shortcut: ctrl, or super as darwin's command,
# without alt, which some layouts hold with ctrl to type a character
# ---
# mods: MOD_* bits
# ret:  true for a shortcut
pub fun shortcut(mods: u8) bool {
    if ((mods & MOD_ALT) != 0) { ret false; }
    ret (mods & (MOD_CTRL | MOD_SUPER)) != 0;
}

test keys__fill_in_order_until_full {
    var in: Input;
    if (!type_text(?in, 0xE9) || !press_key(?in, KEY_LEFT, MOD_SHIFT)) { ret 1; }
    if (in.events_len != 2)                                            { ret 2; }
    val first: Event = in.events[0];
    if (!(sel first.text && first.text == 0xE9)) { ret 3; }
    val second: Event = in.events[1];
    if (!sel second.key)                                             { ret 4; }
    if (second.key.code != KEY_LEFT || second.key.mods != MOD_SHIFT) { ret 4; }

    var i: usize = 2;
    for (i < EVENT_CAP) {
        type_text(?in, 'a');
        i = i + 1;
    }
    if (type_text(?in, 'b') || press_key(?in, KEY_ENTER, 0)) { ret 5; }
    in.paste = "x";
    clear_keys(?in);
    if (in.events_len != 0 || in.paste != nil) { ret 6; }

    if (!shortcut(MOD_CTRL) || !shortcut(MOD_SUPER | MOD_SHIFT)) { ret 7; }
    if (shortcut(MOD_CTRL | MOD_ALT) || shortcut(MOD_SHIFT))     { ret 8; }
    ret 0;
}
