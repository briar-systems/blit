# drives a full blit frame without a GL backend, hosting the library's tests
# under a bin artifact (a static lib carries no _start, so the tests must be
# built and run through a bin)
#
# exercises the public surface end to end and prints the resulting vertex count.

use std.runtime;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use print: std.print;
use allo:  std.allocator;
use page:  std.allocator.page;

use blit.blit;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var a: allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { print.println("allocator init failed"); ret 1; }

    val ae: err[allo.Error] = blit.font.build_atlas(?a);
    if (sel ae.err) { print.println("atlas build failed"); ret 1; }

    var ctx: blit.context.Context;
    val ce: err[allo.Error] = blit.context.init(?ctx, ?a);
    if (sel ce.err) { print.println("context init failed"); ret 1; }

    var checked: u8 = 1;
    var amount:  f32 = 0.5::f32;
    var picked:  usize = 0;
    var opts:    [3]str;
    opts[0] = "add"; opts[1] = "sub"; opts[2] = "mul";

    var win: blit.widget.Window;
    win.x = 380.0::f32; win.y = 8.0::f32; win.w = 180.0::f32; win.open = 1; win.title = "tools";

    var in: blit.input.Input;
    in.mx = 20.0::f32; in.my = 30.0::f32; in.down = 0; in.prev_down = 0;

    blit.context.begin(?ctx, in, 800.0::f32, 600.0::f32);
    val panel: usize = blit.widget.begin_panel(?ctx, 8.0::f32, 8.0::f32, 200.0::f32);
    blit.widget.text(?ctx, "blit headless smoke");
    blit.widget.button(?ctx, "step");
    blit.widget.checkbox(?ctx, "running", ?checked);
    blit.widget.slider_f(?ctx, "rate", ?amount, 0.0::f32, 1.0::f32);
    blit.widget.end_panel(?ctx, panel);

    # sub-surface: a 4x4 grid drawn in local coords, clipped to a short region
    val cell: blit.draw.Color = blit.draw.rgba(0.4::f32, 0.6::f32, 0.9::f32, 1.0::f32);
    val surf: blit.context.Surface = blit.context.begin_surface(?ctx, 240.0::f32, 8.0::f32, 120.0::f32, 80.0::f32, 0.0::f32, 0.0::f32);
    var gy: usize = 0;
    for (gy < 4) {
        var gx: usize = 0;
        for (gx < 4) {
            val px: f32 = gx::f32 * 28.0::f32;
            val py: f32 = gy::f32 * 28.0::f32;
            blit.context.quad(?ctx, px, py, px + 24.0::f32, py + 24.0::f32, cell);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    blit.context.end_surface(?ctx, surf);

    # an accordion dropdown in its own panel
    val p2: usize = blit.widget.begin_panel(?ctx, 8.0::f32, 220.0::f32, 200.0::f32);
    blit.widget.dropdown(?ctx, "op", ?picked, ?opts[0], 3);
    blit.widget.end_panel(?ctx, p2);

    # a draggable, collapsible window with a couple of widgets
    val wh: usize = blit.widget.begin_window(?ctx, ?win);
    blit.widget.text(?ctx, "drag me");
    blit.widget.button(?ctx, "go");
    blit.widget.end_window(?ctx, ?win, wh);

    blit.context.end(?ctx);

    print.printf("blit {}: {} vertices, ok={}\n",
                 blit.VERSION,
                 blit.context.draw_count(?ctx),
                 blit.context.ok(?ctx)::u64);

    val freed: err[allo.Error] = blit.context.free(?ctx);
    if (sel freed.err) { print.println("context free failed"); ret 1; }
    ret 0;
}
