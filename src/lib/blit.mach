# an immediate-mode GUI library
#
# widgets accumulate a draw list of textured, colored triangles and report
# interaction; the consumer feeds input each frame, calls widget functions,
# then uploads and renders the draw list. project id is `blit`, so `use blit;`
# reaches each submodule under its short name, e.g. blit.widget.button.

use std.types.string.str;
# links the startup entrypoint so `mach test` over this library produces a binary.
use std.runtime;

fwd blit.atlas;
fwd blit.bitmap;
fwd blit.draw;
fwd blit.path;
fwd blit.font;
fwd blit.glyph;
fwd blit.input;
fwd blit.layout;
fwd blit.hit;
fwd blit.interact;
fwd blit.id;
fwd blit.field;
fwd blit.edit;
fwd blit.theme;
fwd blit.context;
fwd blit.state;
fwd blit.text;
fwd blit.widget;
fwd blit.tree;
fwd blit.textarea;
fwd blit.chart;
fwd blit.controls;
fwd blit.driver;

# blit library version
pub val VERSION: str = "0.9.0";
