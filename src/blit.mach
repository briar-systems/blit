# an immediate-mode GUI library
#
# widgets accumulate a draw list of textured, colored triangles and report
# interaction; the consumer feeds input each frame, calls widget functions,
# then uploads and renders the draw list. project id is `blit`, so `use blit;`
# reaches each submodule under its short name, e.g. blit.widget.button.

use std.types.string.str;

fwd blit.draw;
fwd blit.font;
fwd blit.input;
fwd blit.context;
fwd blit.widget;

# blit library version
pub val VERSION: str = "0.2.1";
