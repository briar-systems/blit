# drag and drop: any widget can be a source or a target of a typed payload
#
# both ends work on the widget's own blit.interact.Hit, so a widget that
# already takes the pointer becomes a source or a target by passing its hit
# along. a source pressed and moved past a small threshold (set_threshold)
# starts a drag and hands the context a payload: a type tag naming what is
# dragged, such as "list-item" or "window", and bytes the context copies, such
# as an index or a window's id. the drag belongs to the context from then on
# (see blit.payload), so it outlives its source and reaches targets in other
# windows, docks, popups and surfaces alike.
#
# a target names the type it accepts over its rect. while a drag of that
# type is over it, the topmost claimant under the pointer as for any hover, it
# draws the theme's accept highlight and reports the payload, and on release
# it takes the drop. a target accepting several types asks once per type with
# the same hit. Escape cancels a drag, and so does a release over no target.
#
# the source draws the preview: begin_preview opens a layer in the drag band,
# above every other band (see blit.band), and hands back the rect the source
# grabbed, following the pointer, and the source paints whatever it wants
# there before end_preview.
# the preview claims nothing, so targets beneath it still see the pointer.
#
# a source learns how its drag ended in the frames after: dropped on a target,
# missed (released over none) or cancelled, so a dragged tab can float off as
# a window when no tab bar took it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use allo: std.allocator;

use blit.band;
use blit.context;
use blit.draw;
use blit.input;
use blit.interact;
use blit.payload;
use blit.theme;

# what a source's drag is doing this frame
# ---
# on:        true while its drag is in flight
# dropped:   true through the frame after a target took its drag
# missed:    true through the frame after its drag was released over no target
# cancelled: true through the frame after Escape cancelled its drag
pub rec Drag {
    on:        bool;
    dropped:   bool;
    missed:    bool;
    cancelled: bool;
}

# a drag over a target this frame
# ---
# over:    true while a drag of the accepted type is over the target
# dropped: true on the frame it was released over the target, which takes it
# source:  the id of the widget the drag started on
# data:    the payload bytes, valid until the next drag starts
# n:       payload byte count
# mx:      pointer x in the target's local space
# my:      pointer y in the target's local space
pub rec Drop {
    over:    bool;
    dropped: bool;
    source:  u64;
    data:    *u8;
    n:       usize;
    mx:      f32;
    my:      f32;
}

# the drag in flight
# ---
# kind:     its type tag
# source:   the id of the widget it started on
# data:     the payload bytes, valid until the next drag starts
# n:        payload byte count
# released: true on the frame its button came up, the one a target takes it in
pub rec Payload {
    kind:     str;
    source:   u64;
    data:     *u8;
    n:        usize;
    released: bool;
}

# where the preview draws, in screen pixels on the preview layer
# ---
# on: true when a drag is in flight and the preview layer is open
# x0: left edge of the grabbed rect, following the pointer
# y0: top edge
# x1: right edge
# y1: bottom edge
pub rec Preview {
    on: bool;
    x0: f32;
    y0: f32;
    x1: f32;
    y1: f32;
}

# the context's drag, with an Escape this frame already applied
fun session(ctx: *context.Context) *payload.Session {
    payload.check_escape(?ctx.drag, ctx.in);
    ret ?ctx.drag;
}

# make a widget a drag source
#
# call it every frame with the widget's hit. once the widget holds the pointer
# and has moved past the threshold, the drag starts with the payload given,
# which is copied in again each frame the drag is on, so it can change while
# it is dragged. the rect is the widget's, in the current local space: the
# preview follows the pointer at the place in it the press grabbed.
# ---
# ctx:  context
# h:    the widget's hit this frame (see blit.interact.hit)
# kind: the payload's type tag
# data: the payload bytes, copied; nil when n is 0
# n:    payload byte count
# x0:   the widget's left x in pixels
# y0:   top y in pixels
# x1:   right x in pixels
# y1:   bottom y in pixels
# ret:  what its drag is doing
pub fun source(ctx: *context.Context, h: interact.Hit, kind: str, data: ptr, n: usize, x0: f32, y0: f32, x1: f32, y1: f32) Drag {
    var d: Drag;
    if (h.id == 0) { ret d; }
    val s: *payload.Session = session(ctx);
    if (s.ended != payload.ENDED_NONE && s.ended_src == h.id) {
        d.dropped   = s.ended == payload.ENDED_DROPPED;
        d.missed    = s.ended == payload.ENDED_MISSED;
        d.cancelled = s.ended == payload.ENDED_CANCELLED;
    }
    if (s.live != 0 && s.source == h.id) {
        val e: err[allo.Error] = payload.put(s, kind, data, n);
        if (sel e.err) { ctx.oom = 1; }
        d.on = true;
        ret d;
    }
    if (s.live != 0 || !h.held || s.spent == h.id) { ret d; }
    val t: f32 = context.px(ctx, s.threshold);
    if (h.dx * h.dx + h.dy * h.dy < t * t) { ret d; }

    val e: err[allo.Error] = payload.put(s, kind, data, n);
    if (sel e.err) {
        ctx.oom = 1;
        ret d;
    }
    s.live      = 1;
    s.source    = h.id;
    s.button    = h.button;
    s.delivered = 0;
    s.gx        = h.mx - h.dx - x0;
    s.gy        = h.my - h.dy - y0;
    s.w         = x1 - x0;
    s.h         = y1 - y0;
    d.on        = true;
    d.dropped   = false;
    d.missed    = false;
    d.cancelled = false;
    ret d;
}

# open the drag preview band, above every other band (see blit.band)
fun open_layer(ctx: *context.Context) {
    context.push_band(ctx, band.DRAG, 0);
}

# close the band open_layer opened
fun close_layer(ctx: *context.Context) {
    context.pop_band(ctx);
}

# open the drag preview, when a drag is in flight
#
# the source calls it while its drag is on and draws the preview in the rect
# it hands back, in screen pixels: the rect the source grabbed, kept under
# the pointer where the press caught it. the layer claims nothing.
# ---
# ctx: context
# ret: the preview's rect, on when the layer is open and end_preview must close it
pub fun begin_preview(ctx: *context.Context) Preview {
    var p: Preview;
    val s: *payload.Session = session(ctx);
    if (s.live == 0) { ret p; }
    open_layer(ctx);
    p.on = true;
    p.x0 = ctx.in.mx - s.gx;
    p.y0 = ctx.in.my - s.gy;
    p.x1 = p.x0 + s.w;
    p.y1 = p.y0 + s.h;
    ret p;
}

# close the drag preview begin_preview opened
# ---
# ctx: context
# p:   the value begin_preview returned
pub fun end_preview(ctx: *context.Context, p: Preview) {
    if (p.on) { close_layer(ctx); }
}

# make a widget a drop target for one type of payload
#
# call it with the widget's hit after drawing the widget, so the accept
# highlight lies over it. a target with no other interaction claims its rect
# with interact.hit and no buttons.
# ---
# ctx:  context
# h:    the widget's hit this frame
# kind: the type tag it accepts
# x0:   left x of the highlight in pixels
# y0:   top y in pixels
# x1:   right x in pixels
# y1:   bottom y in pixels
# ret:  the drag over it, if any
pub fun target(ctx: *context.Context, h: interact.Hit, kind: str, x0: f32, y0: f32, x1: f32, y1: f32) Drop {
    var d: Drop;
    val s: *payload.Session = session(ctx);
    if (!h.hot || !payload.is_kind(s, kind)) { ret d; }
    d.over   = true;
    d.source = s.source;
    d.data   = payload.data(s);
    d.n      = s.n;
    d.mx     = h.mx;
    d.my     = h.my;
    highlight(ctx, x0, y0, x1, y1);
    if (input.held(ctx.in, s.button) == 0) {
        d.dropped   = true;
        s.delivered = 1;
    }
    ret d;
}

# the accept highlight, in the drop target style
fun highlight(ctx: *context.Context, x0: f32, y0: f32, x1: f32, y1: f32) {
    context.box(ctx, theme.DROP_TARGET, theme.HOT, x0, y0, x1, y1);
}

# the drag in flight, when its type is kind
#
# for widgets that react to a drag anywhere, such as a dock showing where a
# dragged window would land.
# ---
# ctx:  context
# kind: the type tag asked about
# ret:  the payload, or none when no drag of that type is in flight
pub fun carried(ctx: *context.Context, kind: str) opt[Payload] {
    val s: *payload.Session = session(ctx);
    if (!payload.is_kind(s, kind)) { ret opt[Payload].none{}; }
    val up: bool = input.held(ctx.in, s.button) == 0;
    ret opt[Payload].some{Payload{kind: payload.kind(s), source: s.source, data: payload.data(s), n: s.n, released: up}};
}

# take the drag released this frame as dropped, for a target that works out
# where it lands from the pointer rather than from a hit of its own, such as a
# dock whose drop zones lie beneath the window being dragged
#
# the source learns its drag was dropped, as with target. nothing happens
# unless a drag is in flight and its button came up this frame.
# ---
# ctx: context
# ret: true when it took the drag
pub fun take(ctx: *context.Context) bool {
    val s: *payload.Session = session(ctx);
    if (s.live == 0 || input.held(ctx.in, s.button) != 0) { ret false; }
    s.delivered = 1;
    ret true;
}

# set how far the pointer moves from a press on a source before a drag starts
# ---
# ctx:  context
# dist: unscaled pixels, multiplied by the interface scale, payload.THRESHOLD by default
pub fun set_threshold(ctx: *context.Context, dist: f32) {
    ctx.drag.threshold = dist;
}
