# the rightmost composed vertex x
#[testing]
fun right_edge(ctx: *context.Context) f32 {
    val p: *draw.Vert = context.draw_verts(ctx);
    val n: usize      = context.draw_count(ctx);
    var x: f32        = 0.0::f32;
    var i: usize      = 0;
    for (i < n) {
        x = maxf(x, p[i].x);
        i = i + 1;
    }
    ret x;
}

test note__wraps_at_spaces_to_the_column {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # lines of 8 pixels and a 4 pixel gap below the note
    if (frame_note(?ctx, "aa bb", 40.0::f32) != 12.0::f32)       { ret 2; }
    if (frame_note(?ctx, "aa bb cc dd", 40.0::f32) != 20.0::f32) { ret 3; }
    if (right_edge(?ctx) > 40.0::f32)                            { ret 4; }
    # a word wider than the column breaks where it overflows
    if (frame_note(?ctx, "abcdefghij", 40.0::f32) != 20.0::f32) { ret 5; }
    if (right_edge(?ctx) > 40.0::f32)                           { ret 6; }
    # a newline starts a line, and an empty note still takes one
    if (frame_note(?ctx, "a\nb", 40.0::f32) != 20.0::f32) { ret 7; }
    if (frame_note(?ctx, "", 40.0::f32) != 12.0::f32)     { ret 8; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

