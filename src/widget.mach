# the widgets: panel, window, popup, dock, scroll region, section, text, note,
# button, button rows and grids, segmented choice, checkbox, toggle, slider,
# dropdown, list, image, grid, text field
#
# layout is the context's stack of frames (see blit.layout). every container
# pushes the frame its content is laid out in and pops it at its end, and
# begin_stack opens a horizontal or vertical stack as an item of the current
# frame. a widget asks the top frame for its rect with its own size rules and
# the size its content needs, which size_next and a stack's item rules
# override. same_line puts an item beside the last one. the helpers place rows
# by hand: space and advance move the pen, cell_x0 and cell_x1 split the
# column into equal cells for widgets that take a rect (button_at), and
# begin_columns lays whole widgets side by side. the gaps and padding come
# from the theme through gap and pad.
#
# each widget places itself in the current frame, which moves the pen on for
# the next one, emits its geometry through the context painter, and claims its
# interactive rect through interact.hit, the same call a custom control makes,
# so hover, press, click and drag mean the same thing everywhere. a widget is
# hot while it is the topmost claimant under the cursor (see blit.context), and
# active while it owns the pointer after a press on it, until the button
# releases.
#
# a widget's id is its label hashed in the current id scope (see blit.id and
# context.id_of), so widgets appearing or vanishing before it never move it.
# text after "##" in a label is hashed but not drawn, and "###" keys a label by
# what follows alone. widgets without a label (text fields, regions, popups,
# scroll regions, docks, lists, charts) take a key the same way. windows,
# open popups and scroll regions (so docks and lists too) open an id scope of
# their own for what is placed inside them, and a widget's parts (a window's
# collapse box, a scrollbar thumb, a dropdown's options) take ids derived from
# its id.
#
# containers (panels, windows, popups) claim their whole rect beneath their
# children, so input over their empty areas stops at them instead of reaching
# whatever they cover. a popup paints and claims on a layer above everything
# drawn so far. a press of any button outside an open popup dismisses it, and
# that press is consumed rather than delivered to what lies beneath. menus,
# menu bars and context menus are popups too, in blit.menu.
#
# a text field takes the keyboard (see context.focus) when pressed and edits a
# blit.field.Field with the frame's keyboard events while it holds it.
#
# alongside floating windows, a dock attaches a panel to a screen edge and
# takes it from the free area (see context.carve) the rest of the screen is
# laid out in. a dock's body is a scroll region, which clips its column and
# scrolls it by wheel and scrollbar when it is taller than the region, and a
# section is a collapsible heading that groups the rows beneath it.
#
# every color and length a widget draws with comes from the context's theme
# (see blit.theme), each length multiplied by the context's interface scale,
# so a theme or a scale changes the whole interface and no widget holds a
# color or a size of its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use blit.context;
use blit.draw;
use blit.driver;
use blit.edit;
use blit.field;
use blit.font;
use gly: blit.glyph;
use blit.hit;
use bid: blit.id;
use blit.input;
use blit.interact;
use blit.layout;
use blit.state;
use rich_text: blit.text;
use blit.theme;
use allo: std.allocator;
use std.allocator.page;

# the theme's space inside chrome, at the context's scale
#
# with gap, the one place layout reads its spacing from the look.
fun pad(ctx: *context.Context) f32 {
    ret context.px(ctx, ctx.theme.pad);
}

# the theme's space between layout items, at the context's scale
fun gap(ctx: *context.Context) f32 {
    ret context.px(ctx, ctx.theme.gap);
}

# the theme's corner radius, at the context's scale
fun corner(ctx: *context.Context) f32 {
    ret context.px(ctx, ctx.theme.corner);
}

# height of an interactive row: the theme's row height, grown to fit a line of
# text with padding above and below
fun row_h(ctx: *context.Context) f32 {
    ret maxf(context.px(ctx, ctx.theme.row), context.line_height(ctx) + pad(ctx) * 2.0::f32);
}

# vertical space consumed by one text row, including the following gap
pub fun text_row_height(ctx: *context.Context) f32 {
    ret context.line_height(ctx) + gap(ctx);
}

# vertical space consumed by one control row, including the following gap
pub fun control_row_height(ctx: *context.Context) f32 {
    ret row_h(ctx) + gap(ctx);
}

# spacing between adjacent layout rows, at the context's theme and scale
pub fun row_gap(ctx: *context.Context) f32 {
    ret gap(ctx);
}

# spacing between adjacent layout rows in the default theme at scale 1.0
#[deprecated("use row_gap(ctx), which follows the theme and scale")]
pub fun layout_gap() f32 {
    ret theme.default().gap;
}

# a control-shaped fill: rounded to the theme's corner on every side
fun face(ctx: *context.Context, x0: f32, y0: f32, x1: f32, y1: f32, c: draw.Color) {
    context.fill(ctx, x0, y0, x1, y1, corner(ctx), context.CORNERS_ALL, c);
}

# the drawn part of a label, everything before "##", at (x, y)
fun label_at(ctx: *context.Context, label: str, x: f32, y: f32, c: draw.Color) {
    context.text_span(ctx, label, bid.shown(label), x, y, c);
}

# the width of the drawn part of a label
fun label_width(ctx: *context.Context, label: str) f32 {
    ret context.text_width_n(ctx, label, bid.shown(label));
}

# clamp v to [lo, hi]
fun clampf(v: f32, lo: f32, hi: f32) f32 {
    if (v < lo) { ret lo; }
    if (v > hi) { ret hi; }
    ret v;
}

# the larger of two f32 values
fun maxf(a: f32, b: f32) f32 {
    if (a > b) { ret a; }
    ret b;
}

# the smaller of two f32 values
fun minf(a: f32, b: f32) f32 {
    if (a < b) { ret a; }
    ret b;
}

# the frame widgets place themselves in, a column over the screen when no
# container is open
fun top(ctx: *context.Context) *layout.Frame {
    if (context.layout_depth(ctx) == 0) {
        context.push_layout(ctx, layout.column(0.0::f32, 0.0::f32, ctx.sw, ctx.sh, gap(ctx)));
    }
    ret context.top_layout(ctx);
}

# the default width of a widget that spans the space it is given
fun wide() layout.Size {
    ret layout.fill(1.0::f32);
}

# the rules the next item in f takes: size_next's, then the frame's, then the
# widget's own
fun rule_w(f: *layout.Frame, own: layout.Size) layout.Size {
    ret layout.pick(f.next_w, f.item_w, own);
}

fun rule_h(f: *layout.Frame, own: layout.Size) layout.Size {
    ret layout.pick(f.next_h, f.item_h, own);
}

# a placed item's rect
fun area(it: layout.Item) context.Area {
    ret context.Area{x0: it.x, y0: it.y, x1: it.x + it.w, y1: it.y + it.h};
}

# the rect the next item would take, without placing it
fun peek(ctx: *context.Context, dw: layout.Size, dh: layout.Size, nat_w: f32, nat_h: f32) layout.Item {
    val f: *layout.Frame = top(ctx);
    ret layout.resolve(f, rule_w(f, dw), rule_h(f, dh), nat_w, nat_h);
}

# place the next item in the current frame and return its rect
#
# every widget places itself through this, and a control built outside blit
# takes part in the layout the same way. dw and dh are the item's own rules,
# which size_next and the frame's item rules override, and nat_w and nat_h the
# size its content needs.
# ---
# ctx:   context
# dw:    the item's own width rule
# dh:    the item's own height rule
# nat_w: natural width in pixels
# nat_h: natural height in pixels
# ret:   the item's rect in local pixels
pub fun place(ctx: *context.Context, dw: layout.Size, dh: layout.Size, nat_w: f32, nat_h: f32) context.Area {
    val f:  *layout.Frame = top(ctx);
    val it: layout.Item   = layout.resolve(f, rule_w(f, dw), rule_h(f, dh), nat_w, nat_h);
    f.next_w = layout.auto();
    f.next_h = layout.auto();
    layout.commit(f, it);
    ret area(it);
}

# open a frame for a container's content, laid out down a w-wide column from
# (x, y) that grows with its content, or is h tall when h is positive
fun open_column(ctx: *context.Context, x: f32, y: f32, w: f32, h: f32) {
    context.push_layout(ctx, layout.column(x, y, w, h, gap(ctx)));
}

# size the next item placed in the current frame, overriding its own rules and
# the frame's
#
# layout.auto() for a side leaves that side to the item. a nested stack is an
# item too, so this sizes the next begin_stack.
# ---
# ctx: context
# w:   width rule
# h:   height rule
pub fun size_next(ctx: *context.Context, w: layout.Size, h: layout.Size) {
    val f: *layout.Frame = top(ctx);
    f.next_w = w;
    f.next_h = h;
}

# place the next item beside the last one, on the same line, with the gap
# between them
#
# for quick inline rows in a column. the line is as tall as its tallest item,
# and the item after it starts below the line. in a horizontal stack, whose
# items share a line already, it does nothing.
# ---
# ctx: context
pub fun same_line(ctx: *context.Context) {
    layout.same_line(top(ctx));
}

# the space the next item may take, from the pen to the current frame's far
# edges
#
# y1 is the frame's bottom when its height is a limit, and y0 when the frame
# grows with its content.
# ---
# ctx: context
# ret: the space, in local pixels
pub fun avail(ctx: *context.Context) context.Area {
    val f:  *layout.Frame = top(ctx);
    var y0: f32           = f.y;
    if (f.inline != 0 && !layout.across(f)) { y0 = f.line_y0; }
    var y1: f32 = y0;
    if ((f.open & layout.OPEN_H) == 0) { y1 = f.y0 + f.h; }
    ret context.Area{x0: f.x, y0: y0, x1: f.x0 + f.w, y1: y1};
}

# a stack's options, at the theme's gap: start-aligned, filling its parent's
# width and fitting its content's height
# ---
# ctx:  context
# axis: the direction its items advance in
# ret:  options to adjust and pass to begin_stack
pub fun stack(ctx: *context.Context, axis: layout.Axis) layout.Stack {
    ret layout.stack(axis, gap(ctx));
}

# what a stack measured of its content, kept under its id for the next frame
# ---
# w:      natural width of its content
# h:      natural height of its content
# fixed:  pixels along its axis taken by items not filling, and the gaps
# weight: fill weight along its axis
# seen:   1 once a frame has measured it
rec Measure {
    w:      f32;
    h:      f32;
    fixed:  f32;
    weight: f32;
    seen:   u8;
}

# whether a stack opening at it, never measured, would place anything by a
# guess: shares along a known axis need last frame's totals, a side fitted to
# its content has no length to fill, stretch or align across, and centering or
# end-aligning the stack in its parent needs its size
fun guessing(f: *layout.Frame, s: layout.Stack, it: layout.Item) bool {
    var main: u8 = it.fit_h;
    var over: u8 = it.fit_w;
    if (sel s.axis.horizontal) {
        main = it.fit_w;
        over = it.fit_h;
    }
    if (main == 0 || over != 0) { ret true; }
    var cross: u8 = it.fit_w;
    if (layout.across(f)) { cross = it.fit_h; }
    ret cross != 0 && f.inline == 0 && ((sel f.align.center) || (sel f.align.end));
}

# open a stack as the next item of the current frame
#
# the stack's items advance along s.axis, s.gap apart, and sit across it as
# s.align says. the stack itself is sized in its parent by size_next, else by
# s.w and s.h, else by the parent's item rules, else filling the width and
# fitting the content's height. a side fitted to the content, and an
# alignment of the stack in its parent, use the size the stack measured last
# frame, kept in the state store under its id, and its fill shares come from
# last frame's totals the same way. a stack that would place anything by such a
# measure before it has one lays out its first frame only to measure, drawing
# and claiming nothing (see context.push_measure), and asks for the next frame
# at once, as Dear ImGui hides an auto-fit window's first frame. after that, a
# change of content settles one frame late. stacks nest. pair it with
# end_stack.
# ---
# ctx: context
# key: the stack's key in the current id scope
# s:   its options (see stack)
pub fun begin_stack(ctx: *context.Context, key: str, s: layout.Stack) {
    val id: u64           = context.id_of(ctx, key);
    val m:  *Measure      = state.get[Measure](ctx, id);
    val f:  *layout.Frame = top(ctx);
    val rw: layout.Size   = layout.pick(f.next_w, s.w, layout.pick(f.item_w, wide(), wide()));
    val rh: layout.Size   = layout.pick(f.next_h, s.h, layout.pick(f.item_h, layout.fit(), layout.fit()));
    val it: layout.Item   = layout.resolve(f, rw, rh, m.w, m.h);
    f.next_w = layout.auto();
    f.next_h = layout.auto();

    var c: layout.Frame = layout.column(it.x, it.y, it.w, it.h, s.gap);
    c.open = 0;
    if (it.fit_w != 0) { c.open = c.open | layout.OPEN_W; }
    if (it.fit_h != 0) { c.open = c.open | layout.OPEN_H; }
    c.axis        = s.axis;
    c.align       = s.align;
    c.item_w      = s.item_w;
    c.item_h      = s.item_h;
    c.prev_fixed  = m.fixed;
    c.prev_weight = m.weight;
    c.id          = id;
    c.slot        = it;
    c.rule_w      = rw;
    c.rule_h      = rh;
    if (m.seen == 0 && guessing(f, s, it)) { c.hidden = 1; }
    context.push_layout(ctx, c);
    if (c.hidden != 0) {
        context.push_measure(ctx);
        context.wake_at(ctx, ctx.in.time);
    }
}

# close the stack begin_stack opened and place it in its parent
#
# a side fitted to the content takes the size measured this frame, so the
# parent continues below or beside what the stack holds.
# ---
# ctx: context
pub fun end_stack(ctx: *context.Context) {
    val c: layout.Frame = @context.top_layout(ctx);
    context.pop_layout(ctx);
    if (c.hidden != 0) { context.pop_measure(ctx); }
    if (c.id == 0)     { ret; }

    val m: *Measure = state.get[Measure](ctx, c.id);
    m.seen   = 1;
    m.w      = c.need_w;
    m.h      = c.need_h;
    m.fixed  = c.fixed;
    m.weight = c.weight;

    var it: layout.Item = c.slot;
    it.nat_w = layout.natural(c.rule_w, c.need_w);
    it.nat_h = layout.natural(c.rule_h, c.need_h);
    if (it.fit_w != 0) { it.w = it.nat_w; }
    if (it.fit_h != 0) { it.h = it.nat_h; }
    layout.commit(top(ctx), it);
}

# move the pen past an item len pixels long along the current frame's axis,
# and the gap after it
#
# every widget ends with this through its placement. call it after placing a
# row by hand, such as cells of button_at. in a column, len is the row's height.
# ---
# ctx: context
# h:   the row's length in pixels
pub fun advance(ctx: *context.Context, h: f32) {
    layout.skip(top(ctx), h, true);
}

# leave h pixels of space along the current frame's axis
# ---
# ctx: context
# h:   space in pixels, context.px scales an authored length to match
pub fun space(ctx: *context.Context, h: f32) {
    layout.skip(top(ctx), h, false);
}

# the width of one of n equal cells across w pixels, g pixels between them
fun cell_width(w: f32, g: f32, n: usize) f32 {
    if (n == 0) { ret 0.0::f32; }
    ret maxf((w - g * (n - 1)::f32) / n::f32, 0.0::f32);
}

# the left edge of cell i of n equal cells across w pixels from x
fun cell_left(x: f32, w: f32, g: f32, i: usize, n: usize) f32 {
    ret x + i::f32 * (cell_width(w, g, n) + g);
}

# the left edge of cell i of n equal cells across the column, with the theme's
# gap between cells
# ---
# ctx: context
# i:   the cell, from 0 at the left
# n:   how many cells share the column
# ret: the cell's left x in local pixels
pub fun cell_x0(ctx: *context.Context, i: usize, n: usize) f32 {
    val f: *layout.Frame = top(ctx);
    ret cell_left(f.x0, f.w, gap(ctx), i, n);
}

# the right edge of cell i of n equal cells across the column
# ---
# ctx: context
# i:   the cell, from 0 at the left
# n:   how many cells share the column
# ret: the cell's right x in local pixels
pub fun cell_x1(ctx: *context.Context, i: usize, n: usize) f32 {
    ret cell_x0(ctx, i, n) + cell_width(top(ctx).w, gap(ctx), n);
}

# the handle begin_columns returns for next_column and end_columns
# ---
# n:      how many columns share the row
# i:      the column being laid out
# top:    the y the columns start at
# bottom: the lowest bottom a finished column reached
# need:   the widest natural width a finished column measured
# row:    the rect the row takes in its parent, before its height is known
pub rec Columns {
    n:      usize;
    i:      usize;
    top:    f32;
    bottom: f32;
    need:   f32;
    row:    layout.Item;
}

# split the next item of the current frame into the first of n equal columns
#
# widgets placed until next_column lay out in that column. next_column moves
# to the next one, back at the top, and end_columns places the row in the
# parent as tall as the tallest column. pair it with end_columns.
# ---
# ctx: context
# n:   how many columns share the row, at least 1
# ret: a handle for next_column and end_columns
pub fun begin_columns(ctx: *context.Context, n: usize) Columns {
    var c: Columns;
    c.n = n;
    if (c.n == 0) { c.n = 1; }
    val f: *layout.Frame = top(ctx);
    c.row    = layout.resolve(f, rule_w(f, wide()), rule_h(f, layout.fit()), 0.0::f32, 0.0::f32);
    f.next_w = layout.auto();
    f.next_h = layout.auto();
    c.top    = c.row.y;
    c.bottom = c.row.y;
    enter_column(ctx, ?c);
    ret c;
}

# open the frame of column c.i of the row
fun enter_column(ctx: *context.Context, c: *Columns) {
    val g: f32 = gap(ctx);
    open_column(ctx, cell_left(c.row.x, c.row.w, g, c.i, c.n), c.top, cell_width(c.row.w, g, c.n), 0.0::f32);
}

# close the open column, noting how far it reached
fun leave_column(ctx: *context.Context, c: *Columns) {
    val f: *layout.Frame = context.top_layout(ctx);
    if (f.items > 0) { c.bottom = maxf(c.bottom, f.line_y1); }
    c.need = maxf(c.need, f.need_w);
    context.pop_layout(ctx);
}

# move to the next column, back at the columns' top
#
# past the last column it stays in the last one.
# ---
# ctx: context
# c:   the handle begin_columns returned
pub fun next_column(ctx: *context.Context, c: *Columns) {
    leave_column(ctx, c);
    if (c.i + 1 < c.n) { c.i = c.i + 1; }
    enter_column(ctx, c);
}

# close the columns and place the row in the parent, below the tallest column
# ---
# ctx: context
# c:   the handle begin_columns returned
pub fun end_columns(ctx: *context.Context, c: *Columns) {
    leave_column(ctx, c);
    var it: layout.Item = c.row;
    it.h     = c.bottom - c.top;
    it.nat_h = it.h;
    it.nat_w = c.need * c.n::f32 + gap(ctx) * (c.n - 1)::f32;
    layout.commit(top(ctx), it);
}

# ask for the hand pointer over a clickable widget while it is hovered
fun hand(ctx: *context.Context, h: interact.Hit) {
    if (h.hot) { context.set_cursor(ctx, input.CURSOR_HAND); }
}

# the handle begin_panel and begin_window return for their matching end
# ---
# ch:    the channels the body's background and children draw in
# claim: the container's reserved claim, context.NO_CLAIM when refused
pub rec Block {
    ch:    context.Channels;
    claim: usize;
}

# start a layout column at (x, y) of width w
#
# the background height is unknown until the panel's widgets are placed, so
# the widgets draw in a channel above the background's, which end_panel paints
# once it knows the height. the panel's claim is reserved now, beneath its
# widgets, and given its rect then.
# ---
# ctx: context
# x:   panel left in pixels
# y:   panel top in pixels
# w:   panel width in pixels
# ret: a handle for end_panel
pub fun begin_panel(ctx: *context.Context, x: f32, y: f32, w: f32) Block {
    open_column(ctx, x, y, w, 0.0::f32);

    var b: Block;
    b.claim = context.reserve_claim(ctx, 0);
    b.ch    = context.split(ctx, 2);
    context.set_channel(ctx, b.ch, 1);
    ret b;
}

# paint the panel background beneath, and give the claim the rect of, every
# widget placed since begin_panel
# ---
# ctx: context
# b:   the value returned by begin_panel
pub fun end_panel(ctx: *context.Context, b: Block) {
    val f:  *layout.Frame = context.top_layout(ctx);
    val x0: f32           = f.x0;
    val y0: f32           = f.y0;
    val x1: f32           = f.x0 + f.w;
    val y1: f32           = f.y + pad(ctx);
    context.pop_layout(ctx);
    context.set_channel(ctx, b.ch, 0);
    context.fill(ctx, x0, y0, x1, y1, corner(ctx), context.CORNERS_ALL, ctx.theme.panel);
    context.merge(ctx, b.ch);
    context.fill_claim(ctx, b.claim, x0, y0, x1, y1);
}

# draw a line of text at the cursor and advance to the next row
# ---
# ctx: context
# s:   string to draw
pub fun text(ctx: *context.Context, s: str) {
    val r: context.Area = place(ctx, layout.fit(), layout.fit(), context.text_width(ctx, s), context.line_height(ctx));
    context.text_at(ctx, s, r.x0, r.y0, ctx.theme.text);
}

# draw a rich line of spans at the cursor and advance to the next row
#
# each span draws in its own style and color, all on one baseline (see
# blit.text.Span).
# ---
# ctx: context
# sp:  the spans
# n:   how many
pub fun rich(ctx: *context.Context, sp: *rich_text.Span, n: usize) {
    val m: gly.LineMetrics = rich_text.spans_line(ctx, sp, n);
    val r: context.Area    = place(ctx, layout.fit(), layout.fit(), rich_text.spans_width(ctx, sp, n), m.ascent + m.descent + m.gap);
    val w: f32             = rich_text.spans_at(ctx, sp, n, r.x0, r.y0);
}

# where the line of s starting at byte i ends when wrapped to w pixels
#
# a line breaks at a newline, else after the last space that keeps it within
# w, else before the codepoint that would overflow, so a word wider than the
# column is split rather than drawn past it. a line always takes at least one
# codepoint.
# ---
# ret: the byte the line ends at, with @resume set to where the next line starts
fun wrap_line(ctx: *context.Context, s: str, n: usize, i: usize, w: f32, resume: *usize) usize {
    var width: f32   = 0.0::f32;
    var prev:  u32   = 0;
    var space: usize = n;
    var j:     usize = i;
    for (j < n) {
        var cp:   u32   = 0;
        val used: usize = font.next(s, j, n, ?cp);
        if (cp == font.NEWLINE) {
            @resume = j + used;
            ret j;
        }
        val adv: f32 = context.glyph_advance(ctx, prev, cp);
        if (width + adv > w && j > i) {
            if (cp == ' ') {
                @resume = j + used;
                ret j;
            }
            if (space < n) {
                @resume = space + 1;
                ret space;
            }
            @resume = j;
            ret j;
        }
        if (cp == ' ') { space = j; }
        width = width + adv;
        prev  = cp;
        j     = j + used;
    }
    @resume = n;
    ret n;
}

# dim text wrapped at spaces to the column's width, and advance past it
#
# a newline starts a new line, and a word wider than the column breaks where
# it overflows.
# ---
# ctx: context
# s:   utf-8 text
pub fun note(ctx: *context.Context, s: str) {
    val lh: f32   = context.line_height(ctx);
    var n:  usize = 0;
    if (s != nil) { n = str_len(s); }
    val nat:   f32   = context.text_width(ctx, s);
    val w:     f32   = peek(ctx, wide(), layout.fit(), nat, lh).w;
    var lines: usize = 0;
    var i:     usize = 0;
    for (i < n || lines == 0) {
        var next: usize = n;
        val end:  usize = wrap_line(ctx, s, n, i, w, ?next);
        lines = lines + 1;
        i     = next;
    }
    val r: context.Area = place(ctx, wide(), layout.fit(), nat, lh * lines::f32);
    var y: f32          = r.y0;
    i = 0;
    var k: usize = 0;
    for (k < lines) {
        var next: usize = n;
        val end:  usize = wrap_line(ctx, s, n, i, w, ?next);
        if (end > i) { context.text_span(ctx, ?s[i], end - i, r.x0, y, ctx.theme.text_dim); }
        y = y + lh;
        i = next;
        k = k + 1;
    }
}

# a clickable button filling a rect, with a centered label
#
# the rect is in local coordinates, so rows and grids of buttons place it
# with cell_x0 and cell_x1. it does not move the layout. returns true
# on the frame the button is released while hovered, after having been
# pressed on it.
# ---
# ctx:   context
# label: button text, and its key (see context.id_of)
# x0:    left x in pixels
# y0:    top y in pixels
# x1:    right x in pixels
# y1:    bottom y in pixels
# on:    true to draw the button chosen, in the theme's accent
# ret:   true if the button was clicked this frame
pub fun button_at(ctx: *context.Context, label: str, x0: f32, y0: f32, x1: f32, y1: f32, on: bool) bool {
    val h: interact.Hit = interact.hit(ctx, context.id_of(ctx, label), x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, h);

    var bg:  draw.Color = ctx.theme.control;
    var ink: draw.Color = ctx.theme.text;
    if (h.hot)    { bg = ctx.theme.control_hot; }
    if (h.active) { bg = ctx.theme.control_on; }
    if (on) {
        bg  = ctx.theme.accent;
        ink = ctx.theme.accent_text;
    }
    face(ctx, x0, y0, x1, y1, bg);

    val tw: f32 = label_width(ctx, label);
    val tx: f32 = x0 + (x1 - x0 - tw) / 2.0::f32;
    val ty: f32 = y0 + (y1 - y0 - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, tx, ty, ink);
    ret h.clicked;
}

# a full-width clickable button with a centered label
#
# returns true on the frame the button is released while hovered, after having
# been pressed on it.
# ---
# ctx:   context
# label: button text
# ret:   true if the button was clicked this frame
pub fun button(ctx: *context.Context, label: str) bool {
    val r: context.Area = place(ctx, wide(), layout.fit(), label_width(ctx, label) + pad(ctx) * 2.0::f32, row_h(ctx));
    ret button_at(ctx, label, r.x0, r.y0, r.x1, r.y1, false);
}

# a grid of n buttons, cols to a row, filling the column
#
# each button is keyed by its label, so labels that repeat need "##" to tell
# them apart.
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many buttons
# cols:   buttons to a row, at least 1
# on:     the button drawn chosen, n for none
# ret:    the index clicked this frame, n for none
pub fun button_grid(ctx: *context.Context, labels: *str, n: usize, cols: usize, on: usize) usize {
    var per: usize = cols;
    if (per == 0) { per = 1; }
    val h:    f32   = row_h(ctx);
    val g:    f32   = gap(ctx);
    var cell: f32   = 0.0::f32;
    var i:    usize = 0;
    for (i < n) {
        cell = maxf(cell, label_width(ctx, labels[i]) + pad(ctx) * 2.0::f32);
        i    = i + 1;
    }
    var row: context.Area;
    var got: usize = n;
    i = 0;
    for (i < n) {
        val c: usize = i % per;
        if (c == 0) { row = place(ctx, wide(), layout.fit(), cell * per::f32 + g * (per - 1)::f32, h); }
        val x0: f32 = cell_left(row.x0, row.x1 - row.x0, g, c, per);
        if (button_at(ctx, labels[i], x0, row.y0, x0 + cell_width(row.x1 - row.x0, g, per), row.y1, i == on)) { got = i; }
        i = i + 1;
    }
    ret got;
}

# a row of n buttons sharing the column equally
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many buttons
# ret:    the index clicked this frame, n for none
pub fun buttons(ctx: *context.Context, labels: *str, n: usize) usize {
    ret button_grid(ctx, labels, n, n, n);
}

# a row choosing one of n options, the chosen one drawn in the accent
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many options
# choice: pointer to the chosen index, updated in place
# ret:    true if the choice changed this frame
pub fun segmented(ctx: *context.Context, labels: *str, n: usize, choice: *usize) bool {
    val got: usize = button_grid(ctx, labels, n, n, @choice);
    if (got >= n || got == @choice) { ret false; }
    @choice = got;
    ret true;
}

# a labeled toggle that flips @state when clicked
# ---
# ctx:   context
# label: text drawn to the right of the box
# state: pointer to the 0/1 toggle state, updated in place
# ret:   true if the state changed this frame
pub fun checkbox(ctx: *context.Context, label: str, state: *u8) bool {
    val id:  u64          = context.id_of(ctx, label);
    val box: f32          = row_h(ctx);
    val tw:  f32          = label_width(ctx, label);
    val r:   context.Area = place(ctx, layout.fit(), layout.fit(), box + pad(ctx) + tw, box);
    val x0:  f32          = r.x0;
    val y0:  f32          = r.y0;
    val bx1: f32          = x0 + box;
    val y1:  f32          = y0 + box;
    val rx1: f32          = bx1 + pad(ctx) + tw;
    val hc:  interact.Hit = interact.hit(ctx, id, x0, y0, rx1, y1, input.BUTTON_LEFT);
    hand(ctx, hc);

    var toggled: bool = false;
    if (hc.clicked) {
        var nv: u8 = 1;
        if (@state != 0) { nv = 0; }
        @state  = nv;
        toggled = true;
    }

    var bg: draw.Color = ctx.theme.control;
    if (hc.hot) { bg = ctx.theme.control_hot; }
    face(ctx, x0, y0, bx1, y1, bg);
    if (@state != 0) {
        val in: f32 = pad(ctx);
        face(ctx, x0 + in, y0 + in, bx1 - in, y1 - in, ctx.theme.accent);
    }

    val ty: f32 = y0 + (box - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, bx1 + pad(ctx), ty, ctx.theme.text);
    ret toggled;
}

# a labeled on/off switch across the column that flips @state when clicked
#
# the label sits on the left and the switch on the right, its knob at the
# right end on an accent track when on. the whole row takes the click.
# ---
# ctx:   context
# label: text drawn on the left
# state: pointer to the 0/1 switch state, updated in place
# ret:   true if the state changed this frame
pub fun toggle(ctx: *context.Context, label: str, state: *u8) bool {
    val id: u64          = context.id_of(ctx, label);
    val rh: f32          = row_h(ctx);
    val nw: f32          = label_width(ctx, label) + pad(ctx) + maxf(rh - pad(ctx), 0.0::f32) * 2.0::f32;
    val r:  context.Area = place(ctx, wide(), layout.fit(), nw, rh);
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, hs);

    var flipped: bool = false;
    if (hs.clicked) {
        var nv: u8 = 1;
        if (@state != 0) { nv = 0; }
        @state  = nv;
        flipped = true;
    }

    val ty: f32 = y0 + (h - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, x0, ty, ctx.theme.text);

    # the switch is a track twice as wide as it is tall, inset from the row by pad
    val in: f32        = pad(ctx);
    val sh: f32        = maxf(h - in, 0.0::f32);
    val sw: f32        = sh * 2.0::f32;
    val sx: f32        = x1 - sw;
    val sy: f32        = y0 + (h - sh) / 2.0::f32;
    var tc: draw.Color = ctx.theme.track;
    var kc: draw.Color = ctx.theme.handle;
    if (hs.hot) {
        tc = ctx.theme.control_hot;
        kc = ctx.theme.handle_on;
    }
    if (@state != 0) {
        tc = ctx.theme.accent;
        kc = ctx.theme.accent_text;
    }
    face(ctx, sx, sy, sx + sw, sy + sh, tc);

    val ki: f32 = in / 2.0::f32;
    val k:  f32 = maxf(sh - ki * 2.0::f32, 0.0::f32);
    var kx: f32 = sx + ki;
    if (@state != 0) { kx = sx + sw - ki - k; }
    face(ctx, kx, sy + ki, kx + k, sy + ki + k, kc);
    ret flipped;
}

# a horizontal slider mapping @v linearly onto [lo, hi]
#
# while the handle is held, @v tracks the cursor's x within the track, wherever
# the cursor goes. the label is drawn on the left of the track.
# ---
# ctx:   context
# label: slider text
# v:     pointer to the value, updated in place while dragging
# lo:    minimum value (left end)
# hi:    maximum value (right end)
# ret:   true if the value changed this frame
pub fun slider_f(ctx: *context.Context, label: str, v: *f32, lo: f32, hi: f32) bool {
    ret slider(ctx, label, nil, v, lo, hi);
}

# a horizontal slider mapping @v linearly onto [lo, hi], with a reading of its
# value beside the label
#
# like slider_f, and the reading, which the caller formats from @v however it
# likes (a unit, a percentage, "off"), is drawn dim at the right end of the
# track. format it before the call from the value as it stands, and the next
# frame shows a drag's result.
# ---
# ctx:     context
# label:   slider text, drawn on the left
# reading: the value as text, drawn on the right, nil for none
# v:       pointer to the value, updated in place while dragging
# lo:      minimum value (left end)
# hi:      maximum value (right end)
# ret:     true if the value changed this frame
pub fun slider(ctx: *context.Context, label: str, reading: str, v: *f32, lo: f32, hi: f32) bool {
    val id: u64 = context.id_of(ctx, label);
    var nw: f32 = label_width(ctx, label) + pad(ctx) * 4.0::f32 + context.px(ctx, ctx.theme.handle_w);
    if (reading != nil) { nw = nw + context.text_width(ctx, reading); }
    val r:  context.Area = place(ctx, wide(), layout.fit(), nw, row_h(ctx));
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);

    var changed: bool = false;
    if (hs.held) {
        val track: f32 = x1 - x0;
        var t:     f32 = 0.0::f32;
        if (track > 0.0::f32) { t = clampf((hs.mx - x0) / track, 0.0::f32, 1.0::f32); }
        val nv: f32 = lo + t * (hi - lo);
        if (nv != @v) {
            @v      = nv;
            changed = true;
        }
    }

    face(ctx, x0, y0, x1, y1, ctx.theme.track);

    var t_out: f32 = 0.0::f32;
    if (hi != lo) { t_out = clampf((@v - lo) / (hi - lo), 0.0::f32, 1.0::f32); }
    val hw:   f32 = context.px(ctx, ctx.theme.handle_w);
    var span: f32 = (x1 - x0) - hw;
    if (span < 0.0::f32) { span = 0.0::f32; }
    val hx: f32 = x0 + t_out * span;

    var hc: draw.Color = ctx.theme.handle;
    if (hs.active) { hc = ctx.theme.handle_on; }
    face(ctx, hx, y0, hx + hw, y1, hc);

    val ty: f32 = y0 + (h - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, x0 + pad(ctx), ty, ctx.theme.text);
    if (reading != nil) {
        val rw: f32 = context.text_width(ctx, reading);
        context.text_at(ctx, reading, x1 - pad(ctx) - rw, ty, ctx.theme.text_dim);
    }
    ret changed;
}

# the handle begin_popup returns for end_popup
# ---
# open:      1 if the popup is drawn this frame, else 0
# dismissed: 1 if a press outside the popup dismissed it this frame
# ch:        the channels the body's background and children draw in
# claim:     the popup body's reserved claim
pub rec Popup {
    open:      u8;
    dismissed: u8;
    ch:        context.Channels;
    claim:     usize;
}

# open a popup column at (x, y) of width w on a layer above everything drawn so
# far, when @open is nonzero
#
# (x, y) is in the caller's local coordinates. inside the popup the layout
# is in screen pixels, so widgets placed between begin_popup and end_popup land in
# the popup and paint and claim above what they overlap. the popup also claims
# the whole screen beneath its body: a press of any button outside the body
# sets `dismissed` and is consumed, so it never activates what lies under it.
# the caller owns the open state and closes it on dismissal. while open, the
# popup is an id scope for the widgets inside it. pair every begin_popup with
# an end_popup.
# ---
# ctx:  context
# key:  the popup's key in the current id scope
# open: nonzero to draw the popup this frame
# x:    popup left in local pixels
# y:    popup top in local pixels
# w:    popup width in pixels
# ret:  a handle for end_popup
pub fun begin_popup(ctx: *context.Context, key: str, open: u8, x: f32, y: f32, w: f32) Popup {
    ret popup_at(ctx, context.id_of(ctx, key), open, x, y, w, true);
}

# begin_popup for a popup whose id is already known, such as a part of a widget
# ---
# ctx:  context
# id:   the popup's id, which is also the id scope of what it holds
# open: nonzero to draw the popup this frame
# x:    popup left in local pixels
# y:    popup top in local pixels
# w:    popup width in pixels
# ret:  a handle for end_popup
pub fun begin_popup_id(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32) Popup {
    ret popup_at(ctx, id, open, x, y, w, true);
}

# open a popup nested in an open popup, which closes with it rather than on a
# press outside itself
#
# it claims nothing beyond its body, so what the enclosing popup holds stays
# under the pointer while it is open, as a submenu needs. `dismissed` is never
# set: the enclosing popup's outside claim takes every press outside both.
# ---
# ctx:  context
# id:   the popup's id, which is also the id scope of what it holds
# open: nonzero to draw the popup this frame
# x:    popup left in local pixels
# y:    popup top in local pixels
# w:    popup width in pixels
# ret:  a handle for end_popup
pub fun begin_popup_nested(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32) Popup {
    ret popup_at(ctx, id, open, x, y, w, false);
}

# a popup at (x, y), claiming the screen beneath its body when outside is true
fun popup_at(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32, outside: bool) Popup {
    var p: Popup;
    p.claim = context.NO_CLAIM;
    if (open == 0) { ret p; }
    p.open = 1;

    val sx: f32 = x + ctx.lx;
    val sy: f32 = y + ctx.ly;
    context.push_layer(ctx);
    context.push_id(ctx, id);

    if (outside) {
        val every: u8           = input.BUTTON_LEFT | input.BUTTON_RIGHT | input.BUTTON_MIDDLE | input.BUTTON_X1 | input.BUTTON_X2;
        val out:   interact.Hit = interact.hit(ctx, bid.child(id, "#outside"), 0.0::f32, 0.0::f32, ctx.sw, ctx.sh, every);
        if (out.pressed) { p.dismissed = 1; }
    }

    p.claim = context.reserve_claim(ctx, 0);
    open_column(ctx, sx, sy, w, 0.0::f32);
    p.ch = context.split(ctx, 2);
    context.set_channel(ctx, p.ch, 1);
    ret p;
}

# close a popup opened by begin_popup: paint its background beneath its
# widgets, give its claim their rect, leave its layer and restore the parent
# layout
# ---
# ctx: context
# p:   the value returned by begin_popup
pub fun end_popup(ctx: *context.Context, p: Popup) {
    if (p.open == 0) { ret; }

    val f:  *layout.Frame = context.top_layout(ctx);
    val x0: f32           = f.x0;
    val y0: f32           = f.y0;
    val x1: f32           = f.x0 + f.w;
    val y1: f32           = f.y + pad(ctx);
    context.pop_layout(ctx);
    context.set_channel(ctx, p.ch, 0);
    context.fill(ctx, x0, y0, x1, y1, corner(ctx), context.CORNERS_ALL, ctx.theme.window);
    context.merge(ctx, p.ch);
    context.fill_claim(ctx, p.claim, x0, y0, x1, y1);
    context.pop_id(ctx);
    context.pop_layer(ctx);
}

# the state a dropdown keeps in the context's store under its header's id
# ---
# open: 1 while the option list is shown, else 0
pub rec DropdownState {
    open: u8;
}

# a select: shows the current option and, while open, lists the options in a
# popup directly beneath it
#
# clicking the header opens it. the open state is a DropdownState the context's
# state store keeps under the header's id (see blit.state), so each dropdown
# opens and closes on its own. clicking an option sets @selected and closes it,
# and a press anywhere else closes it without reaching what lies beneath. the
# option list overlays later widgets rather than pushing them down.
# ---
# ctx:      context
# label:    text drawn on the left of the header, and its key
# selected: pointer to the selected index, updated in place
# options:  pointer to an array of option strings (pass ?opts[0])
# count:    number of options
# ret:      1 if the selection changed this frame, else 0
pub fun dropdown(ctx: *context.Context, label: str, selected: *usize, options: *str, count: usize) u8 {
    val id: u64            = context.id_of(ctx, label);
    val st: *DropdownState = state.get[DropdownState](ctx, id);
    var wo: f32            = 0.0::f32;
    var k:  usize          = 0;
    for (k < count) {
        wo = maxf(wo, context.text_width(ctx, options[k]));
        k  = k + 1;
    }
    val rh: f32          = row_h(ctx);
    val r:  context.Area = place(ctx, wide(), layout.fit(), label_width(ctx, label) + wo + pad(ctx) * 3.0::f32, rh);
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hd: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, hd);
    if (hd.clicked) {
        if (st.open != 0) { st.open = 0; }
        or                { st.open = 1; }
    }

    var bg: draw.Color = ctx.theme.control;
    if (hd.hot)       { bg = ctx.theme.control_hot; }
    if (st.open != 0) { bg = ctx.theme.control_on; }
    face(ctx, x0, y0, x1, y1, bg);

    val ty: f32 = y0 + (h - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, x0 + pad(ctx), ty, ctx.theme.text);
    if (@selected < count) {
        val cur: str = options[@selected];
        val cw:  f32 = context.text_width(ctx, cur);
        context.text_at(ctx, cur, x1 - pad(ctx) - cw, ty, ctx.theme.text);
    }

    val pid: u64   = bid.child(id, "#popup");
    val pop: Popup = popup_at(ctx, pid, st.open, x0, y1 + gap(ctx), x1 - x0, true);

    var changed: u8    = 0;
    var i:       usize = 0;
    for (i < count) {
        val oid: u64 = bid.child_int(pid, i::u64);
        if (pop.open != 0) {
            val o:   context.Area = place(ctx, wide(), layout.fit(), x1 - x0, rh);
            val ox0: f32          = o.x0;
            val oy0: f32          = o.y0;
            val ox1: f32          = o.x1;
            val oy1: f32          = o.y1;

            val ho: interact.Hit = interact.hit(ctx, oid, ox0, oy0, ox1, oy1, input.BUTTON_LEFT);
            hand(ctx, ho);
            if (ho.clicked) {
                @selected = i;
                st.open   = 0;
                changed   = 1;
            }

            var obg: draw.Color = ctx.theme.track;
            if (ho.hot) { obg = ctx.theme.control_hot; }
            face(ctx, ox0, oy0, ox1, oy1, obg);
            context.text_at(ctx, options[i], ox0 + pad(ctx), oy0 + (oy1 - oy0 - context.line_height(ctx)) / 2.0::f32, ctx.theme.text);
        }
        i = i + 1;
    }
    end_popup(ctx, pop);

    if (pop.dismissed != 0) { st.open = 0; }
    ret changed;
}

# width of the utf-8 bytes [lo, hi) of s laid out on one line in the current style
fun bytes_width(ctx: *context.Context, s: *u8, lo: usize, hi: usize) f32 {
    if (hi <= lo) { ret 0.0::f32; }
    ret context.text_width_n(ctx, ?s[lo], hi - lo);
}

# width of the field's bytes [lo, hi) laid out on one line in the current style
fun span(ctx: *context.Context, f: *field.Field, lo: usize, hi: usize) f32 {
    ret edit.width(ctx, f, lo, hi);
}

# scroll the field's shown text so the caret is in view in w pixels, showing
# as much of the text as fits
fun keep_in_view(ctx: *context.Context, f: *field.Field, w: f32) {
    if (f.first > f.caret) { f.first = f.caret; }
    for (f.first < f.caret && span(ctx, f, f.first, f.caret) > w) { f.first = field.after(f, f.first); }
    for (f.first > 0 && span(ctx, f, field.before(f, f.first), f.len) <= w) { f.first = field.before(f, f.first); }
}

# the character boundary nearest x pixels right of the field's shown text
# start, one before it when x is left of it so a drag scrolls back
fun caret_at(ctx: *context.Context, f: *field.Field, x: f32) usize {
    if (x < 0.0::f32) { ret field.before(f, f.first); }
    var at: f32   = 0.0::f32;
    var i:  usize = f.first;
    for (i < f.len) {
        val n: usize = field.after(f, i);
        val w: f32   = span(ctx, f, i, n);
        if (x < at + w / 2.0::f32) { brk; }
        at = at + w;
        i  = n;
    }
    ret i;
}

# a full-width, one-line text field editing @f
#
# a press on it gives it the keyboard (see context.focus) and puts the caret
# under the cursor, or extends the selection to it with shift held; a double
# click selects the word and a triple click the line (see blit.edit.click),
# and dragging extends the selection by the same unit. a press elsewhere, or
# a frame it is not drawn in, takes the keyboard back. while it holds the
# keyboard it takes the frame's typed text and editing keys (see field.key)
# in order: shortcut C and X copy and cut the selection to the clipboard
# hand-off (see context.copied), shortcut V asks for the clipboard (see
# context.wants_paste) and takes the next frame's input.paste, and enter or
# escape end the edit and give the keyboard back. the text scrolls to keep
# the caret in view, and the caret blinks (see edit.caret_on). while it holds
# the keyboard it shows the IME's composition (see context.preedit) inline at
# the caret, underlined, and places the IME's candidate window at the caret
# (see context.ime_rect). it asks for the text pointer while hovered.
#
# the field's flags shape it: a MASKED field draws edit.MASK_GLYPH for each
# character, never copies and takes no composition, a READ_ONLY one moves and
# selects but takes no edit or composition, and a COUNT one shows its length
# (see edit.count_text) at its right end.
# ---
# ctx:  context
# key:  the field's key in the current id scope, so id_of(ctx, key) gives it the
#       keyboard with context.focus
# f:    the field's state, edited in place
# hint: dim text shown while it is empty and unfocused, nil for none
# ret:  this frame's outcome bits: field.EDITED, field.ENTERED, field.ESCAPED
pub fun text_field(ctx: *context.Context, key: str, f: *field.Field, hint: str) u8 {
    val id: u64          = context.id_of(ctx, key);
    val nw: f32          = context.text_width(ctx, hint) + pad(ctx) * 2.0::f32 + context.px(ctx, ctx.theme.caret_w);
    val r:  context.Area = place(ctx, wide(), layout.fit(), nw, row_h(ctx));
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;
    val tx: f32          = x0 + pad(ctx);
    var tw: f32          = maxf(x1 - x0 - pad(ctx) * 2.0::f32, 0.0::f32);

    var counted: [42]u8;
    var count:   str = nil;
    var count_w: f32 = 0.0::f32;
    if (field.has(f, field.COUNT)) {
        count   = edit.count_text(f, ?counted[0]);
        count_w = context.text_width(ctx, count);
        tw      = maxf(tw - count_w - pad(ctx), 0.0::f32);
    }

    val hf: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    if (hf.hot) { context.set_cursor(ctx, input.CURSOR_TEXT); }
    if (hf.pressed) {
        context.focus(ctx, id);
        keep_in_view(ctx, f, tw);
        edit.press(ctx, id, f, caret_at(ctx, f, hf.mx - tx), hf.clicks);
    }
    or (hf.held && ctx.focus == id) {
        keep_in_view(ctx, f, tw);
        edit.drag(ctx, id, f, caret_at(ctx, f, hf.mx - tx));
    }
    var out: u8 = 0;
    if (context.focused(ctx, id)) { out = edit.feed(ctx, id, f); }
    val on:    bool = ctx.focus == id;
    val quiet: bool = field.has(f, field.MASKED) || field.has(f, field.READ_ONLY);

    var bg: draw.Color = ctx.theme.track;
    if (hf.hot && !on) { bg = ctx.theme.control_hot; }
    if (on) {
        val ew: f32 = context.px(ctx, ctx.theme.edge_w);
        face(ctx, x0, y0, x1, y1, ctx.theme.accent);
        face(ctx, x0 + ew, y0 + ew, x1 - ew, y1 - ew, bg);
    }
    or { face(ctx, x0, y0, x1, y1, bg); }

    keep_in_view(ctx, f, tw);
    val lh: f32 = context.line_height(ctx);
    val ty: f32 = y0 + (h - lh) / 2.0::f32;
    if (count != nil) { context.text_at(ctx, count, x1 - pad(ctx) - count_w, ty, ctx.theme.text_faint); }
    context.push_clip(ctx, tx, y0, tx + tw, y1);
    if (f.len == 0 && !on) { context.text_at(ctx, hint, tx, ty, ctx.theme.text_faint); }
    if (on && field.selected(f)) {
        var lo: usize = field.sel_lo(f);
        if (lo < f.first) { lo = f.first; }
        val sx0: f32 = tx + span(ctx, f, f.first, lo);
        val sx1: f32 = tx + span(ctx, f, f.first, field.sel_hi(f));
        context.quad(ctx, sx0, ty, sx1, ty + lh, ctx.theme.select);
    }
    val cw:  f32 = context.px(ctx, ctx.theme.caret_w);
    var pre: str = nil;
    if (!quiet) { pre = context.preedit(ctx, id); }
    var cx: f32 = tx + span(ctx, f, f.first, f.caret);
    if (pre == nil) { edit.draw_text(ctx, f, f.first, f.len, tx, ty, ctx.theme.text); }
    or {
        val pw: f32 = bytes_width(ctx, pre, 0, str_len(pre));
        edit.draw_text(ctx, f, f.first, f.caret, tx, ty, ctx.theme.text);
        context.text_at(ctx, pre, cx, ty, ctx.theme.text);
        context.quad(ctx, cx, ty + lh - cw, cx + pw, ty + lh, ctx.theme.text);
        edit.draw_text(ctx, f, f.caret, f.len, cx + pw, ty, ctx.theme.text);
        cx = cx + bytes_width(ctx, pre, 0, context.preedit_caret(ctx));
    }
    context.pop_clip(ctx);
    if (on) {
        if (edit.caret_on(ctx, id)) { context.quad(ctx, cx, ty, cx + cw, ty + lh, ctx.theme.text); }
        if (!quiet)                 { context.set_ime_rect(ctx, cx, ty, cx + cw, ty + lh); }
    }
    ret out;
}

# hit-test an arbitrary rect with button click semantics
#
# returns 1 on the frame the primary button releases while the rect is hovered,
# after being pressed on it. emits no geometry, the consumer draws the affordance
# (an icon, a corner toggle) itself. the rect is in local coordinates and is
# clipped and layered like geometry.
# ---
# ctx: context
# key: the region's key in the current id scope
# x0:  left x in pixels
# y0:  top y in pixels
# x1:  right x in pixels
# y1:  bottom y in pixels
# ret: 1 if the rect was clicked this frame, else 0
pub fun region_clicked(ctx: *context.Context, key: str, x0: f32, y0: f32, x1: f32, y1: f32) u8 {
    val h: interact.Hit = interact.hit(ctx, context.id_of(ctx, key), x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, h);
    if (h.clicked) { ret 1; }
    ret 0;
}

# draw a region of a consumer texture w by h at the cursor and advance to the
# next row
#
# the region stretches to fill the rect, drawn with its texels as they are.
# see context.image_at to draw one into an arbitrary rect or tinted.
# ---
# ctx: context
# img: the texture region and its sampling filter
# w:   width in pixels
# h:   height in pixels
pub fun image(ctx: *context.Context, img: draw.Image, w: f32, h: f32) {
    val white: draw.Color   = draw.rgba(1.0::f32, 1.0::f32, 1.0::f32, 1.0::f32);
    val r:     context.Area = place(ctx, layout.fit(), layout.fit(), w, h);
    context.image_at(ctx, img, r.x0, r.y0, r.x1, r.y1, white);
}

# colors that values from lo to hi map onto in count equal steps
# ---
# colors: the steps, lowest value first
# count:  number of colors
# lo:     value mapped to the first color, and everything below it
# hi:     value mapped to the last color, and everything above it
pub rec Palette {
    colors: *draw.Color;
    count:  usize;
    lo:     f32;
    hi:     f32;
}

# the palette step a value falls in
#
# the range divides into count equal steps, clamped at both ends, so a value
# never blends between colors. an empty palette gives transparent black.
# ---
# p:   palette
# v:   value
# ret: the step's color
pub fun palette_color(p: Palette, v: f32) draw.Color {
    if (p.count == 0 || p.colors == nil) { ret draw.rgba(0.0::f32, 0.0::f32, 0.0::f32, 0.0::f32); }
    var i: usize = 0;
    if (p.hi > p.lo) {
        val t: f32 = (v - p.lo) / (p.hi - p.lo);
        if (t >= 1.0::f32) { i = p.count - 1; }
        or (t > 0.0::f32)  { i = (t * p.count::f32)::usize; }
    }
    if (i >= p.count) { i = p.count - 1; }
    ret p.colors[i];
}

# a discrete field of cols by rows cells, stored row-major from the top left
#
# each cell's color is the consumer's colors[i] when colors is set, else
# values[i] mapped through palette. a field with neither draws nothing.
# ---
# cols:    cells across
# rows:    cells down
# colors:  cols * rows consumer-mapped colors, or nil to map values
# values:  cols * rows values mapped through palette when colors is nil
# palette: the steps values map onto
pub rec Grid {
    cols:    usize;
    rows:    usize;
    colors:  *draw.Color;
    values:  *f32;
    palette: Palette;
}

# draw a field as solid colored cells filling a rect
#
# cells tile the rect edge to edge with no seams and sample the atlas, so a
# small field needs no consumer texture. a field too large to draw cell by
# cell belongs in a texture drawn with image and FILTER_NEAREST instead.
# ---
# ctx: context
# g:   the field
# x0:  left x in pixels
# y0:  top y in pixels
# x1:  right x in pixels
# y1:  bottom y in pixels
pub fun grid_at(ctx: *context.Context, g: Grid, x0: f32, y0: f32, x1: f32, y1: f32) {
    if (g.cols == 0 || g.rows == 0)         { ret; }
    if (g.colors == nil && g.values == nil) { ret; }
    val w: f32   = x1 - x0;
    val h: f32   = y1 - y0;
    var r: usize = 0;
    for (r < g.rows) {
        val cy0: f32   = y0 + h * r::f32 / g.rows::f32;
        val cy1: f32   = y0 + h * (r + 1)::f32 / g.rows::f32;
        var c:   usize = 0;
        for (c < g.cols) {
            val cx0: f32   = x0 + w * c::f32 / g.cols::f32;
            val cx1: f32   = x0 + w * (c + 1)::f32 / g.cols::f32;
            val i:   usize = r * g.cols + c;
            var col: draw.Color;
            if (g.colors != nil) { col = g.colors[i]; }
            or                   { col = palette_color(g.palette, g.values[i]); }
            context.quad(ctx, cx0, cy0, cx1, cy1, col);
            c = c + 1;
        }
        r = r + 1;
    }
}

# draw a field w by h at the cursor and advance to the next row
# ---
# ctx: context
# g:   the field
# w:   width in pixels
# h:   height in pixels
pub fun grid(ctx: *context.Context, g: Grid, w: f32, h: f32) {
    val r: context.Area = place(ctx, layout.fit(), layout.fit(), w, h);
    grid_at(ctx, g, r.x0, r.y0, r.x1, r.y1);
}

# consumer-owned state for a draggable, collapsible titled window
# ---
# x:     window left in local pixels, updated while dragging the titlebar
# y:     window top in local pixels, updated while dragging the titlebar
# w:     window width in pixels
# open:  1 if the body is expanded, 0 if collapsed to the titlebar
# title: titlebar text, and the window's key (see context.id_of)
pub rec Window {
    x:     f32;
    y:     f32;
    w:     f32;
    open:  u8;
    title: str;
}

# where a dragged part stood when the press on it began, kept in the state
# store under the part's id
# ---
# x: the window's x, unused by a scrollbar thumb
# y: the window's y, or the scroll offset under a scrollbar thumb
rec Grab {
    x: f32;
    y: f32;
}

# draw a window's titlebar and, when open, start its body column
#
# the titlebar drags the window (press and move updates win.x/win.y) and carries a
# collapse box on the left that toggles win.open. when open, the body's column is
# opened below the titlebar so the consumer's widgets fill the body, which
# end_window paints beneath it. windows stack by call order: a later window paints
# over, and takes input from, an earlier one, and its whole rect stops input to
# what it covers. the window is an id scope, keyed by its title, for the
# widgets inside it until end_window. returns a handle to pass to end_window.
# ---
# ctx: context
# win: pointer to the window state, mutated by dragging and collapsing
# ret: a handle for end_window
pub fun begin_window(ctx: *context.Context, win: *Window) Block {
    val th:      f32 = row_h(ctx);
    val id:      u64 = context.id_of(ctx, win.title);
    val drag_id: u64 = bid.child(id, "#drag");
    val col_id:  u64 = bid.child(id, "#collapse");

    var b: Block;
    b.claim = context.reserve_claim(ctx, 0);

    # follow a drag before claiming, so the claims match where the window paints
    val grab: *Grab = state.get[Grab](ctx, drag_id);
    var dx:   f32;
    var dy:   f32;
    if (interact.drag(ctx, drag_id, ?dx, ?dy)) {
        win.x = grab.x + dx;
        win.y = grab.y + dy;
    }

    val bx1: f32 = win.x + th;
    val ty0: f32 = win.y;
    val ty1: f32 = win.y + th;
    val dx1: f32 = win.x + win.w;

    val hc: interact.Hit = interact.hit(ctx, col_id, win.x, ty0, bx1, ty1, input.BUTTON_LEFT);
    hand(ctx, hc);
    if (hc.clicked) {
        if (win.open == 0) { win.open = 1; }
        or                 { win.open = 0; }
    }

    val hd: interact.Hit = interact.hit(ctx, drag_id, bx1, ty0, dx1, ty1, input.BUTTON_LEFT);
    if (hd.pressed) {
        grab.x = win.x;
        grab.y = win.y;
    }
    if (hd.hot || hd.active) { context.set_cursor(ctx, input.CURSOR_MOVE); }

    var tbg: draw.Color = ctx.theme.header;
    if (hd.hot || hc.hot) { tbg = ctx.theme.header_hot; }
    var ends: u8 = context.CORNERS_ALL;
    if (win.open != 0) { ends = context.CORNERS_TOP; }
    context.fill(ctx, win.x, win.y, win.x + win.w, win.y + th, corner(ctx), ends, tbg);

    val gy:  f32 = win.y + (th - context.line_height(ctx)) / 2.0::f32;
    var gch: u32 = '+';
    if (win.open != 0) { gch = '-'; }
    context.glyph(ctx, gch, win.x + pad(ctx), gy, ctx.theme.text_dim);
    label_at(ctx, win.title, win.x + th + pad(ctx), gy, ctx.theme.text);

    context.push_id(ctx, id);
    if (win.open == 0) { ret b; }

    open_column(ctx, win.x, win.y + th, win.w, 0.0::f32);

    b.ch = context.split(ctx, 2);
    context.set_channel(ctx, b.ch, 1);
    ret b;
}

# paint the window body beneath its widgets, like end_panel, and give the
# window's claim its rect (the titlebar alone when collapsed)
# ---
# ctx: context
# win: pointer to the window state
# b:   the value returned by begin_window
pub fun end_window(ctx: *context.Context, win: *Window, b: Block) {
    context.pop_id(ctx);
    val th: f32 = row_h(ctx);
    val x0: f32 = win.x;
    val x1: f32 = win.x + win.w;
    var y1: f32 = win.y + th;
    if (win.open != 0) {
        y1 = context.top_layout(ctx).y + pad(ctx);
        context.pop_layout(ctx);
        context.set_channel(ctx, b.ch, 0);
        context.fill(ctx, x0, win.y + th, x1, y1, corner(ctx), context.CORNERS_BOTTOM, ctx.theme.window);
        context.merge(ctx, b.ch);
    }
    context.fill_claim(ctx, b.claim, x0, win.y, x1, y1);
}

# consumer-owned state of a scroll region, kept across frames
# ---
# offset:  content scrolled out above the region, in pixels
# content: content height measured when the region last ended, in pixels
pub rec Scroll {
    offset:  f32;
    content: f32;
}

# the handle begin_scroll returns for end_scroll
# ---
# id:    the region's id, which its empty area claims
# thumb: the scrollbar thumb's id
# seen:  the context's hover_seen when the region opened
# claim: the region's reserved claim
# surf:  the clipped, scrolled surface the content is laid out in
# x:     region left in the parent's local pixels
# y:     region top in the parent's local pixels
# w:     region width in pixels
# h:     region height in pixels
pub rec ScrollArea {
    id:    u64;
    thumb: u64;
    seen:  u64;
    claim: usize;
    surf:  context.Surface;
    x:     f32;
    y:     f32;
    w:     f32;
    h:     f32;
}

# the most a region of height h can scroll over content of height content
fun scroll_most(content: f32, h: f32) f32 {
    ret maxf(content - h, 0.0::f32);
}

# open a scroll region h tall as the next item of the layout, spanning the column
#
# widgets placed until end_scroll lay out in a column inside it, clipped to
# it and shifted up by s.offset. when the content measured last frame is
# taller than the region, the column narrows to leave room for a scrollbar.
# the region's empty area claims input beneath its widgets, which is how the
# wheel finds it. the region is an id scope for its widgets. pair every
# begin_scroll with an end_scroll.
# ---
# ctx: context
# key: the region's key in the current id scope
# s:   the region's state, clamped to its content here
# h:   region height in pixels
# ret: a handle for end_scroll
pub fun begin_scroll(ctx: *context.Context, key: str, s: *Scroll, h: f32) ScrollArea {
    ret scroll_at(ctx, context.id_of(ctx, key), s, h);
}

# begin_scroll for a region whose id is already known
fun scroll_at(ctx: *context.Context, id: u64, s: *Scroll, h: f32) ScrollArea {
    val bar: f32          = context.px(ctx, ctx.theme.bar_w) + pad(ctx);
    val m:   *Measure     = state.get[Measure](ctx, id);
    val a:   context.Area = place(ctx, wide(), layout.fit(), m.w + bar, maxf(h, 0.0::f32));
    ret scroll_in(ctx, id, s, a);
}

# open a scroll region over a rect already placed, such as one from place
#
# like begin_scroll, but the region takes a, in local pixels, and leaves the
# layout alone. pair it with end_scroll.
# ---
# ctx: context
# key: the region's key in the current id scope
# s:   the region's state, clamped to its content here
# a:   the region's rect
# ret: a handle for end_scroll
pub fun begin_scroll_at(ctx: *context.Context, key: str, s: *Scroll, a: context.Area) ScrollArea {
    ret scroll_in(ctx, context.id_of(ctx, key), s, a);
}

# a scroll region over the rect a, whose id is already known
fun scroll_in(ctx: *context.Context, id: u64, s: *Scroll, a: context.Area) ScrollArea {
    val bar: f32 = context.px(ctx, ctx.theme.bar_w) + pad(ctx);
    var r:   ScrollArea;
    r.id    = id;
    r.thumb = bid.child(id, "#thumb");
    r.seen  = ctx.hover_seen;
    r.x     = a.x0;
    r.y     = a.y0;
    r.w     = a.x1 - a.x0;
    r.h     = a.y1 - a.y0;

    r.claim = context.reserve_claim(ctx, r.id);
    context.fill_claim(ctx, r.claim, r.x, r.y, r.x + r.w, r.y + r.h);
    context.push_id(ctx, r.id);

    s.offset = clampf(s.offset, 0.0::f32, scroll_most(s.content, r.h));
    r.surf   = context.begin_surface(ctx, r.x, r.y, r.w, r.h, 0.0::f32, s.offset);

    var cw: f32 = r.w;
    if (s.content > r.h) { cw = maxf(r.w - bar, 0.0::f32); }
    open_column(ctx, 0.0::f32, 0.0::f32, cw, 0.0::f32);
    ret r;
}

# close a scroll region: measure its content, take the wheel, draw and drag
# its scrollbar and close its column
#
# the wheel goes to the innermost region holding the topmost claim under the
# cursor, so a region under a popup or a window does not scroll, and a region
# nested in another scrolls before its parent. scrolling applies from the next
# frame, like all input.
# ---
# ctx: context
# s:   the region's state, updated with its content, the wheel and any drag
# r:   the value returned by begin_scroll
pub fun end_scroll(ctx: *context.Context, s: *Scroll, r: ScrollArea) {
    context.pop_id(ctx);
    val f: *layout.Frame = context.top_layout(ctx);
    s.content = f.y;
    val m: *Measure = state.get[Measure](ctx, r.id);
    m.w = f.need_w;
    context.pop_layout(ctx);
    context.end_surface(ctx, r.surf);

    # the hovered widget claimed inside this region, or the region itself
    if (ctx.wheel_taken == 0 && ctx.in.wheel != 0.0::f32 && ctx.hover_seen > r.seen) {
        s.offset        = s.offset - ctx.in.wheel;
        ctx.wheel_taken = 1;
    }
    val most: f32 = scroll_most(s.content, r.h);
    s.offset = clampf(s.offset, 0.0::f32, most);

    if (most > 0.0::f32) {
        val tx0:     f32   = r.x + r.w - context.px(ctx, ctx.theme.bar_w);
        val tx1:     f32   = r.x + r.w;
        val thumb_h: f32   = clampf(r.h * r.h / s.content, context.px(ctx, ctx.theme.thumb_min), r.h);
        val travel:  f32   = r.h - thumb_h;
        val grab:    *Grab = state.get[Grab](ctx, r.thumb);
        var dx:      f32;
        var dy:      f32;

        if (interact.drag(ctx, r.thumb, ?dx, ?dy) && travel > 0.0::f32) {
            s.offset = clampf(grab.y + dy * most / travel, 0.0::f32, most);
        }
        val ty: f32          = r.y + travel * s.offset / most;
        val ht: interact.Hit = interact.hit(ctx, r.thumb, tx0, ty, tx1, ty + thumb_h, input.BUTTON_LEFT);
        if (ht.pressed) { grab.y = s.offset; }

        var tc: draw.Color = ctx.theme.handle;
        if (ht.active) { tc = ctx.theme.handle_on; }
        face(ctx, tx0, r.y, tx1, r.y + r.h, ctx.theme.track);
        face(ctx, tx0, ty, tx1, ty + thumb_h, tc);
    }
}

# a collapsible heading across the column that toggles @open when clicked
#
# the rows that belong to the section are the caller's to place, and only
# while this returns true.
# ---
# ctx:   context
# title: heading text, and its key
# open:  pointer to the 0/1 open state, updated in place
# ret:   true while the section is open
pub fun section(ctx: *context.Context, title: str, open: *u8) bool {
    val id: u64          = context.id_of(ctx, title);
    val lh: f32          = context.line_height(ctx);
    val r:  context.Area = place(ctx, wide(), layout.fit(), label_width(ctx, title) + lh + pad(ctx) * 3.0::f32, row_h(ctx));
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, hs);
    if (hs.clicked) {
        if (@open == 0) { @open = 1; }
        or              { @open = 0; }
    }

    var bg:  draw.Color = ctx.theme.header;
    var ink: draw.Color = ctx.theme.text_dim;
    if (hs.hot) {
        bg  = ctx.theme.header_hot;
        ink = ctx.theme.text;
    }
    face(ctx, x0, y0, x1, y1, bg);

    val gy: f32 = y0 + (h - lh) / 2.0::f32;
    caret(ctx, x0 + pad(ctx), gy, lh, @open != 0, ink);
    label_at(ctx, title, x0 + pad(ctx) * 2.0::f32 + lh, gy, ctx.theme.text);
    ret @open != 0;
}

# a caret filling the k-pixel square at (x, y), pointing right when closed
# and down when open
#
# the triangle is one quad per pixel row, like a rounded corner, so it needs
# nothing of the renderer and clips like any quad.
# ---
# ctx:  context
# x:    square left in local pixels
# y:    square top in local pixels
# k:    square side in pixels
# open: true to point down
# c:    fill color
pub fun caret(ctx: *context.Context, x: f32, y: f32, k: f32, open: bool, c: draw.Color) {
    if (k <= 0.0::f32) { ret; }
    # closed: a vertical edge k tall at the quarter, its tip half as far right.
    # open:   a horizontal edge k wide at the quarter, its tip half as far down.
    val depth: f32 = k / 2.0::f32;
    val edge:  f32 = k / 4.0::f32;
    var span:  f32 = k;
    if (open) { span = depth; }
    var rows: usize = span::usize;
    if (rows::f32 < span) { rows = rows + 1; }
    var r: usize = 0;
    for (r < rows) {
        val a: f32 = r::f32;
        val b: f32 = minf(a + 1.0::f32, span);
        val t: f32 = (a + b) / 2.0::f32 / span;
        if (open) {
            val half: f32 = k * (1.0::f32 - t) / 2.0::f32;
            context.quad(ctx, x + k / 2.0::f32 - half, y + edge + a, x + k / 2.0::f32 + half, y + edge + b, c);
        }
        or {
            var off: f32 = t - 0.5::f32;
            if (off < 0.0::f32) { off = 0.0::f32 - off; }
            val len: f32 = depth * (1.0::f32 - off * 2.0::f32);
            context.quad(ctx, x + edge, y + a, x + edge + len, y + b, c);
        }
        r = r + 1;
    }
}

# consumer-owned state of a panel docked to a screen edge
# ---
# side:   the edge the dock attaches to
# size:   width (left, right) or height (top, bottom) in pixels
# scroll: the dock body's scroll state
pub rec Dock {
    side:   context.Side;
    size:   f32;
    scroll: Scroll;
}

# the handle begin_dock returns for end_dock
# ---
# area:  the dock's rect in screen pixels
# claim: the dock's claim, beneath its widgets
# body:  the scroll region the dock's widgets are laid out in
pub rec DockArea {
    area:  context.Area;
    claim: usize;
    body:  ScrollArea;
}

# dock a panel to a screen edge and start its scrolling body column
#
# the dock takes a strip of the free area (see context.carve), so docks
# opened in turn stack inward and context.free_area reports what they leave
# for the rest of the screen. its whole rect stops input to what it covers,
# and its body scrolls when its widgets are taller than it. call it at the
# root, outside surfaces and layers, and pair it with end_dock. its body is
# the id scope of the dock's key, so a label path through the dock is
# "<key>/<label>".
# ---
# ctx: context
# key: the dock's key in the current id scope
# d:   the dock's state
# ret: a handle for end_dock
pub fun begin_dock(ctx: *context.Context, key: str, d: *Dock) DockArea {
    var r: DockArea;
    r.area = context.carve(ctx, d.side, d.size);

    val a: context.Area = r.area;
    r.claim = context.reserve_claim(ctx, 0);
    context.fill_claim(ctx, r.claim, a.x0, a.y0, a.x1, a.y1);

    val ew: f32        = context.px(ctx, ctx.theme.edge_w);
    val ec: draw.Color = ctx.theme.edge;
    context.quad(ctx, a.x0, a.y0, a.x1, a.y1, ctx.theme.dock);
    if (sel d.side.left)  { context.quad(ctx, a.x1 - ew, a.y0, a.x1, a.y1, ec); }
    or (sel d.side.right) { context.quad(ctx, a.x0, a.y0, a.x0 + ew, a.y1, ec); }
    or (sel d.side.top)   { context.quad(ctx, a.x0, a.y1 - ew, a.x1, a.y1, ec); }
    or                    { context.quad(ctx, a.x0, a.y0, a.x1, a.y0 + ew, ec); }

    val in: f32 = pad(ctx);
    open_column(ctx, a.x0 + in, a.y0 + in, a.x1 - a.x0 - in * 2.0::f32, maxf(a.y1 - a.y0 - in * 2.0::f32, 0.0::f32));
    r.body = scroll_at(ctx, context.id_of(ctx, key), ?d.scroll, a.y1 - a.y0 - in * 2.0::f32);
    ret r;
}

# close a dock: end its body and close its column
# ---
# ctx: context
# d:   the dock's state
# r:   the value returned by begin_dock
pub fun end_dock(ctx: *context.Context, d: *Dock, r: DockArea) {
    end_scroll(ctx, ?d.scroll, r.body);
    context.pop_layout(ctx);
}

# consumer-owned state of a list, kept across frames
# ---
# selected: index of the selected item, at least the item count for none
# scroll:   the list's scroll state
pub rec List {
    selected: usize;
    scroll:   Scroll;
}

# an ascii letter folded to lower case, any other byte unchanged
fun fold(b: u8) u8 {
    if (b >= 'A' && b <= 'Z') { ret b + 32; }
    ret b;
}

# whether s holds query, ignoring ascii case; an empty or nil query matches all
# ---
# s:     the text searched, nil holding nothing
# query: the text looked for
# ret:   true if s holds query
pub fun matches(s: str, query: str) bool {
    if (query == nil || query[0] == 0) { ret true; }
    if (s == nil)                      { ret false; }
    var i: usize = 0;
    for (s[i] != 0) {
        var j: usize = 0;
        for (query[j] != 0 && s[i + j] != 0 && fold(s[i + j]) == fold(query[j])) { j = j + 1; }
        if (query[j] == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a scrolling list of items, h pixels tall, one of which can be selected
#
# only the items holding query (ignoring ascii case) are shown, so a search
# box the caller keeps narrows the list. clicking a shown item selects it and
# the selected one is drawn in the accent. the list scrolls by the wheel and a
# scrollbar like any scroll region. an item's id is its index under the
# list's, so an item keeps its hit identity as the query changes. items
# scrolled out of view are skipped rather than emitted.
# ---
# ctx:   context
# key:   the list's key in the current id scope
# l:     the list's state
# items: pointer to an array of count item strings (pass ?items[0])
# count: number of items
# query: text an item must hold to be shown, nil or empty for all
# h:     list height in pixels
# ret:   true if the selection changed this frame
pub fun list(ctx: *context.Context, key: str, l: *List, items: *str, count: usize, query: str, h: f32) bool {
    val r:       ScrollArea = begin_scroll(ctx, key, ?l.scroll, h);
    val rh:      f32        = row_h(ctx);
    val top:     f32        = l.scroll.offset;
    var changed: bool       = false;
    var i:       usize      = 0;
    for (i < count) {
        val id: u64 = bid.child_int(r.id, i::u64);
        if (matches(items[i], query)) {
            val a:  context.Area = place(ctx, wide(), layout.fit(), context.text_width(ctx, items[i]) + pad(ctx) * 2.0::f32, rh);
            val x0: f32          = a.x0;
            val y0: f32          = a.y0;
            val x1: f32          = a.x1;
            val y1: f32          = a.y1;
            if (y1 > top && y0 < top + r.h) {
                val hi: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
                if (hi.clicked && l.selected != i) {
                    l.selected = i;
                    changed    = true;
                }

                var ink: draw.Color = ctx.theme.text;
                if (l.selected == i) {
                    face(ctx, x0, y0, x1, y1, ctx.theme.accent);
                    ink = ctx.theme.accent_text;
                }
                or (hi.active) { face(ctx, x0, y0, x1, y1, ctx.theme.control_on); }
                or (hi.hot)    { face(ctx, x0, y0, x1, y1, ctx.theme.control_hot); }
                val ty: f32 = y0 + (rh - context.line_height(ctx)) / 2.0::f32;
                context.text_at(ctx, items[i], x0 + pad(ctx), ty, ink);
            }
        }
        i = i + 1;
    }
    end_scroll(ctx, ?l.scroll, r);
    ret changed;
}

# one frame's input with the cursor at (mx, my) and the button in state down
#[testing]
fun input_at(mx: f32, my: f32, down: u8) input.Input {
    var in: input.Input;
    in.mx      = mx;
    in.my      = my;
    in.present = 1;
    in.down    = down;
    ret in;
}

# a frame holding one panel with one button
#[testing]
fun frame_button(ctx: *context.Context, in: input.Input) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, "ok");
    end_panel(ctx, p);
    context.end(ctx);
    ret clicked;
}

# whether the context asks for a frame now
#[testing]
fun asks_now(ctx: *context.Context) bool {
    val nf: opt[f64] = context.next_frame(ctx);
    ret sel nf.some && nf.some == 0.0::f64;
}

test button__clicks_on_presses_and_releases_between_frames {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    val id: u64 = context.id_of(?ctx, "ok");

    var in: input.Input = input_at(10.0::f32, 5.0::f32, 0);
    input.init(?in, ?a);
    frame_button(?ctx, in);

    # a press and release on the button, the cursor gone by the frame: a
    # press, then a release that clicks where it happened
    in.mx = 500.0::f32;
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.release_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 2; }
    if (!asks_now(?ctx))                                     { ret 3; }
    input.clear_keys(?in);
    if (frame_button(?ctx, in) != true) { ret 4; }
    if (!asks_now(?ctx))                { ret 5; }
    frame_button(?ctx, in);
    if (asks_now(?ctx) || ctx.in.mx != 500.0::f32) { ret 6; }

    # press, release, press: a click, then the button held
    in.mx = 10.0::f32;
    frame_button(?ctx, in);
    in.down = input.BUTTON_LEFT;
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.release_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 7; }
    input.clear_keys(?in);
    if (frame_button(?ctx, in) != true)                      { ret 8; }
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 9; }
    if (input.pressed(ctx.in, input.BUTTON_LEFT) != 1)       { ret 10; }
    if (asks_now(?ctx))                                      { ret 11; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# whether the dropdown with header id is open
#[testing]
fun dropdown_open(ctx: *context.Context, id: u64) u8 {
    ret state.get[DropdownState](ctx, id).open;
}

# open or close the dropdown with header id
#[testing]
fun set_dropdown_open(ctx: *context.Context, id: u64, open: u8) {
    val st: *DropdownState = state.get[DropdownState](ctx, id);
    st.open = open;
}

# what the probe panel's widgets reported, across frames
# ---
# clicks: times the ok button clicked
# on:     the checkbox's state
# flip:   the toggle's state
# flips:  times the toggle flipped
# choice: the segmented choice
# chosen: times the segmented choice changed
# v:      the slider's value, in [0, 10]
# pick:   the dropdown's selection
# picked: times the dropdown's selection changed
#[testing]
rec Probe {
    clicks: usize;
    on:     u8;
    flip:   u8;
    flips:  usize;
    choice: usize;
    chosen: usize;
    v:      f32;
    pick:   usize;
    picked: usize;
}

# a 100 pixel panel of one of each control, the dropdown last so its options
# cover nothing
#[testing]
fun probe_ui(ctx: *context.Context, user: ptr) {
    val p:    *Probe = user::*Probe;
    var segs: [3]str;
    segs[0] = "a";
    segs[1] = "b";
    segs[2] = "c";
    var opts: [3]str;
    opts[0] = "one";
    opts[1] = "two";
    opts[2] = "three";
    val b: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    if (button(ctx, "ok")) { p.clicks = p.clicks + 1; }
    checkbox(ctx, "on", ?p.on);
    if (toggle(ctx, "flip", ?p.flip))           { p.flips = p.flips + 1; }
    if (segmented(ctx, ?segs[0], 3, ?p.choice)) { p.chosen = p.chosen + 1; }
    slider_f(ctx, "x", ?p.v, 0.0::f32, 10.0::f32);
    if (dropdown(ctx, "pick", ?p.pick, ?opts[0], 3) != 0) { p.picked = p.picked + 1; }
    end_panel(ctx, b);
}

# a driver over the probe panel on a 200 pixel screen, laid out once
#[testing]
fun probe(d: *driver.Driver, a: *allo.Allocator, p: *Probe) u8 {
    val e: err[allo.Error] = driver.init(d, a, 200.0::f32, 200.0::f32, probe_ui, p::ptr);
    if (sel e.err) { ret 0; }
    driver.step(d);
    ret 1;
}

test button__clicks_on_release_inside_after_press {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # pressed it is active, and it clicks on the release
    val ok: u64 = driver.find(?d, "ok");
    if (!str_equals(driver.text_of(?d, ok), "ok")) { ret 2; }
    driver.hover(?d, ok);
    driver.press(?d, input.BUTTON_LEFT);
    if (p.clicks != 0 || !driver.active(?d, ok)) { ret 3; }
    driver.release(?d, input.BUTTON_LEFT);
    if (p.clicks != 1) { ret 4; }

    # a release outside after a press inside is no click
    driver.hover(?d, ok);
    driver.press(?d, input.BUTTON_LEFT);
    driver.move(?d, 150.0::f32, 150.0::f32);
    driver.release(?d, input.BUTTON_LEFT);
    if (p.clicks != 1 || driver.active(?d, ok)) { ret 5; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test checkbox__and_toggle_flip_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    driver.click(?d, driver.find(?d, "on"));
    if (p.on != 1) { ret 2; }
    val flip: u64 = driver.find(?d, "flip");
    driver.click(?d, flip);
    if (p.flip != 1 || p.flips != 1) { ret 3; }

    # a press dragged off the row and released there does not flip it back
    driver.drag(?d, flip, 150.0::f32, 150.0::f32);
    if (p.flip != 1 || p.flips != 1) { ret 4; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test segmented__chooses_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    driver.click(?d, driver.find(?d, "c"));
    if (p.choice != 2 || p.chosen != 1) { ret 2; }
    # choosing the chosen segment again is no change
    driver.click(?d, driver.find(?d, "c"));
    if (p.chosen != 1) { ret 3; }
    # a press on the first released over the second chooses nothing
    driver.drag_onto(?d, driver.find(?d, "a"), driver.find(?d, "b"));
    if (p.choice != 2 || p.chosen != 1) { ret 4; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test slider__maps_cursor_linearly {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # the track spans the panel's width: its left end is lo, its right end hi
    val x: u64               = driver.find(?d, "x");
    val r: opt[context.Area] = driver.rect(?d, x);
    if (sel r.none) { ret 2; }
    val y: f32 = (r.some.y0 + r.some.y1) / 2.0::f32;
    driver.drag(?d, x, r.some.x0, y);
    if (p.v != 0.0::f32) { ret 3; }
    driver.drag(?d, x, (r.some.x0 + r.some.x1) / 2.0::f32, y);
    if (p.v != 5.0::f32) { ret 4; }
    driver.drag(?d, x, r.some.x1 + 50.0::f32, y);
    if (p.v != 10.0::f32) { ret 5; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test dropdown__opens_and_selects {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # the header opens it without changing the selection
    val pick: u64 = driver.find(?d, "pick");
    val two:  u64 = bid.child_int(bid.child(pick, "#popup"), 1);
    if (driver.drawn(?d, two)) { ret 2; }
    driver.click(?d, pick);
    if (p.picked != 0 || dropdown_open(?d.ctx, pick) == 0) { ret 3; }
    if (!str_equals(driver.text_of(?d, two), "two"))       { ret 4; }

    # an option selects and closes it
    driver.click(?d, two);
    if (p.pick != 1 || p.picked != 1)     { ret 5; }
    if (dropdown_open(?d.ctx, pick) != 0) { ret 6; }
    # the frame that chose still drew the options, the next one does not
    driver.step(?d);
    if (driver.drawn(?d, two)) { ret 7; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a dock and a window, each holding a widget a label path names
# ---
# side: the dock, holding "ok" above more than it can show
# win:  the "Settings" window, holding the "name" field
# f:    the field's state
#[testing]
rec Nest {
    side: Dock;
    win:  Window;
    f:    field.Field;
}

#[testing]
fun nest_ui(ctx: *context.Context, user: ptr) {
    val n:  *Nest    = user::*Nest;
    val dk: DockArea = begin_dock(ctx, "side", ?n.side);
    button(ctx, "ok");
    space(ctx, 1000.0::f32);
    end_dock(ctx, ?n.side, dk);
    val b: Block = begin_window(ctx, ?n.win);
    text_field(ctx, "name", ?n.f, nil);
    end_window(ctx, ?n.win, b);
}

test driver__paths_keys_and_wheel_reach_nested_widgets {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var buf: [64]u8;
    var n:   Nest;
    n.side.side = context.Side.left{};
    n.side.size = 80.0::f32;
    n.win       = Window{x: 100.0::f32, y: 10.0::f32, w: 120.0::f32, open: 1, title: "Settings"};
    field.init(?n.f, ?buf[0], 64, 0, nil);
    var d:  driver.Driver;
    val ie: err[allo.Error] = driver.init(?d, ?a, 300.0::f32, 200.0::f32, nest_ui, (?n)::ptr);
    if (sel ie.err) { ret 1; }
    driver.step(?d);

    # a dock's and a window's widgets sit under their keys
    val ok:   u64 = driver.find(?d, "side/ok");
    val name: u64 = driver.find(?d, "Settings/name");
    if (!driver.drawn(?d, ok) || !driver.drawn(?d, name)) { ret 2; }
    val r: opt[context.Area] = driver.rect(?d, name);
    if (sel r.none)                                                            { ret 3; }
    if (r.some.x0 < 100.0::f32)                                                { ret 3; }
    if (driver.at(?d, r.some.x0 + 1.0::f32, r.some.y0 + 1.0::f32) != name)     { ret 4; }
    if (driver.inside(?d, r.some.x0, r.some.y0, r.some.x1, r.some.y1) != name) { ret 5; }
    driver.hover(?d, ok);
    if (!driver.hot(?d, ok) || driver.hot(?d, name)) { ret 6; }

    # a clicked field takes typed text and keys
    driver.click(?d, name);
    if (!driver.focused(?d, name)) { ret 7; }
    driver.type_text(?d, "hey");
    driver.key(?d, input.KEY_BACKSPACE, 0);
    if (!str_equals(field.text(?n.f), "he"))         { ret 8; }
    if (!str_equals(driver.text_of(?d, name), "he")) { ret 9; }

    # the wheel over the dock scrolls its body
    driver.scroll(?d, ok, 0.0::f32, -30.0::f32);
    driver.step(?d);
    if (n.side.scroll.offset != 30.0::f32) { ret 10; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding one panel with one three-option dropdown
#[testing]
fun frame_dropdown(ctx: *context.Context, in: input.Input, picked: *usize, opts: *str) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val changed: u8    = dropdown(ctx, "pick", picked, opts, 3);
    end_panel(ctx, p);
    context.end(ctx);
    ret changed;
}

test dropdown__open_overlays_later_widgets {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    set_dropdown_open(?ctx, context.id_of(?ctx, "pick"), 1);
    context.begin(?ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    begin_panel(?ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    dropdown(?ctx, "pick", ?picked, ?opts[0], 3);
    # the layout continues right under the header
    val next: context.Area = avail(?ctx);
    if (next.y0 != control_row_height(?ctx)) { ret 2; }
    if (next.x0 != 0.0::f32)                 { ret 3; }
    if (next.x1 - next.x0 != 100.0::f32)     { ret 4; }
    if (ctx.layer != 0)                      { ret 5; }
    context.end(?ctx);

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test dropdown__open_keeps_ids_apart {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var first:  usize = 0;
    var second: usize = 0;
    var in:     input.Input;

    # two open dropdowns with the same options claim no id twice, and the open
    # one stays open whichever is drawn first
    set_dropdown_open(?ctx, context.id_of(?ctx, "first"), 1);
    var k: usize = 0;
    for (k < 2) {
        context.begin(?ctx, in, 200.0::f32, 200.0::f32);
        begin_panel(?ctx, 0.0::f32, 0.0::f32, 100.0::f32);
        if (k == 0) { dropdown(?ctx, "first", ?first, ?opts[0], 3); }
        dropdown(?ctx, "second", ?second, ?opts[0], 3);
        if (k == 1) { dropdown(?ctx, "first", ?first, ?opts[0], 3); }
        context.end(?ctx);
        if (context.collisions(?ctx) != 0)                           { ret 2; }
        if (dropdown_open(?ctx, context.id_of(?ctx, "first")) == 0)  { ret 3; }
        if (dropdown_open(?ctx, context.id_of(?ctx, "second")) != 0) { ret 4; }
        k = k + 1;
    }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding one region_clicked rect, clipped to (0,0)-(10,10) when clip is set
#[testing]
fun frame_region(ctx: *context.Context, in: input.Input, clip: u8) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    if (clip != 0) { context.push_clip(ctx, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32); }
    val clicked: u8 = region_clicked(ctx, "r", 40.0::f32, 40.0::f32, 60.0::f32, 60.0::f32);
    if (clip != 0) { context.pop_clip(ctx); }
    context.end(ctx);
    ret clicked;
}

# a frame holding one window with nothing in it
#[testing]
fun frame_window(ctx: *context.Context, in: input.Input, win: *Window) {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    val b: Block = begin_window(ctx, win);
    end_window(ctx, win, b);
    context.end(ctx);
}

test window__drags_by_titlebar_and_collapses {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var win: Window;
    win.x     = 50.0::f32;
    win.y     = 50.0::f32;
    win.w     = 120.0::f32;
    win.open  = 1;
    win.title = "w";

    # hover then press the drag region, right of the collapse box
    frame_window(?ctx, input_at(100.0::f32, 58.0::f32, 0), ?win);
    frame_window(?ctx, input_at(100.0::f32, 58.0::f32, 1), ?win);

    # move while held -> the window follows the cursor
    frame_window(?ctx, input_at(150.0::f32, 90.0::f32, 1), ?win);
    if (win.x != 100.0::f32) { ret 2; }
    if (win.y != 82.0::f32)  { ret 3; }

    # release, then press and release the collapse box (now [100,116] x [82,98])
    frame_window(?ctx, input_at(150.0::f32, 90.0::f32, 0), ?win);
    frame_window(?ctx, input_at(108.0::f32, 90.0::f32, 0), ?win);
    frame_window(?ctx, input_at(108.0::f32, 90.0::f32, 1), ?win);
    frame_window(?ctx, input_at(108.0::f32, 90.0::f32, 0), ?win);
    if (win.open != 0) { ret 4; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with a three-option dropdown, then a window called
# after it whose titlebar crosses the option rows
#[testing]
fun frame_dropdown_window(ctx: *context.Context, in: input.Input, picked: *usize, opts: *str, win: *Window) u8 {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val changed: u8    = dropdown(ctx, "pick", picked, opts, 3);
    end_panel(ctx, p);
    val w: Block = begin_window(ctx, win);
    end_window(ctx, win, w);
    context.end(ctx);
    ret changed;
}

# where in paint order a vertex at exactly (x, y) is first drawn: the first
# composed index naming one, or the index count when none is drawn
#[testing]
fun vert_at(ctx: *context.Context, x: f32, y: f32) usize {
    val p:  *draw.Vert = context.draw_verts(ctx);
    val ix: *u32       = context.draw_indices(ctx);
    val n:  usize      = context.index_count(ctx);
    var i:  usize      = 0;
    for (i < n) {
        if (p[ix[i]].x == x && p[ix[i]].y == y) { ret i; }
        i = i + 1;
    }
    ret n;
}

# where in paint order a solid vertex of color c is first drawn, or the index
# count when none is
#[testing]
fun paint_of(ctx: *context.Context, c: draw.Color) usize {
    val p:  *draw.Vert = context.draw_verts(ctx);
    val ix: *u32       = context.draw_indices(ctx);
    val n:  usize      = context.index_count(ctx);
    var i:  usize      = 0;
    for (i < n) {
        val v: draw.Vert = p[ix[i]];
        if (v.r == c.r && v.g == c.g && v.b == c.b && v.a == c.a) { ret i; }
        i = i + 1;
    }
    ret n;
}

test routing__open_dropdown_beats_later_window {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    # the titlebar spans y [30, 46) and crosses option rows [20, 36) and [40, 56)
    var win: Window;
    win.x     = 0.0::f32;
    win.y     = 30.0::f32;
    win.w     = 150.0::f32;
    win.open  = 1;
    win.title = "w";

    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], ?win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?picked, ?opts[0], ?win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], ?win);
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) == 0) { ret 2; }

    # the option rows paint after the window despite being called before it
    if (vert_at(?ctx, 0.0::f32, 30.0::f32) >= vert_at(?ctx, 0.0::f32, 40.0::f32)) { ret 3; }
    if (vert_at(?ctx, 0.0::f32, 40.0::f32) >= context.index_count(?ctx))          { ret 4; }

    # hover, press and release where option 1 and the drag region overlap
    val opt1: u64 = bid.child_int(bid.child(context.id_of(?ctx, "pick"), "#popup"), 1);
    frame_dropdown_window(?ctx, input_at(50.0::f32, 42.0::f32, 0), ?picked, ?opts[0], ?win);
    if (ctx.hot != opt1) { ret 5; }
    frame_dropdown_window(?ctx, input_at(50.0::f32, 42.0::f32, 1), ?picked, ?opts[0], ?win);
    if (ctx.active != opt1)                                                                           { ret 6; }
    if (frame_dropdown_window(?ctx, input_at(50.0::f32, 42.0::f32, 0), ?picked, ?opts[0], ?win) != 1) { ret 7; }
    if (picked != 1)                                                                                  { ret 8; }
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) != 0)                                        { ret 9; }
    if (win.x != 0.0::f32 || win.y != 30.0::f32 || win.open != 1)                                     { ret 10; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test dropdown__outside_press_closes_and_is_swallowed {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    var win: Window;
    win.x     = 0.0::f32;
    win.y     = 30.0::f32;
    win.w     = 150.0::f32;
    win.open  = 1;
    win.title = "w";

    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], ?win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?picked, ?opts[0], ?win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], ?win);
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) == 0) { ret 2; }

    # press on the titlebar right of the option rows: the dropdown closes and
    # the window beneath does not start a drag
    frame_dropdown_window(?ctx, input_at(120.0::f32, 38.0::f32, 0), ?picked, ?opts[0], ?win);
    frame_dropdown_window(?ctx, input_at(120.0::f32, 38.0::f32, 1), ?picked, ?opts[0], ?win);
    val outside: u64 = bid.child(bid.child(context.id_of(?ctx, "pick"), "#popup"), "#outside");
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) != 0) { ret 3; }
    if (ctx.active != outside)                                 { ret 4; }
    frame_dropdown_window(?ctx, input_at(130.0::f32, 38.0::f32, 1), ?picked, ?opts[0], ?win);
    frame_dropdown_window(?ctx, input_at(130.0::f32, 38.0::f32, 0), ?picked, ?opts[0], ?win);
    if (win.x != 0.0::f32 || win.y != 30.0::f32) { ret 5; }
    if (picked != 0)                             { ret 6; }

    # the next press there goes to the window
    frame_dropdown_window(?ctx, input_at(130.0::f32, 38.0::f32, 1), ?picked, ?opts[0], ?win);
    if (ctx.active != bid.child(context.id_of(?ctx, "w"), "#drag")) { ret 7; }
    frame_dropdown_window(?ctx, input_at(140.0::f32, 38.0::f32, 1), ?picked, ?opts[0], ?win);
    if (win.x != 10.0::f32) { ret 8; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding two windows side by side, each with a three-option dropdown
# whose header id lands in @ida and @idb
#[testing]
fun frame_two_dropdowns(ctx: *context.Context, in: input.Input, wa: *Window, wb: *Window, picked: *usize, opts: *str, ida: *u64, idb: *u64) {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    val ba: Block = begin_window(ctx, wa);
    @ida = context.id_of(ctx, "a");
    dropdown(ctx, "a", picked, opts, 3);
    end_window(ctx, wa, ba);
    val bb: Block = begin_window(ctx, wb);
    @idb = context.id_of(ctx, "b");
    dropdown(ctx, "b", picked, opts, 3);
    end_window(ctx, wb, bb);
    context.end(ctx);
}

test dropdown__two_open_in_two_windows {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    var wa: Window;
    wa.x     = 0.0::f32;
    wa.w     = 100.0::f32;
    wa.open  = 1;
    wa.title = "a";
    var wb: Window;
    wb.x     = 200.0::f32;
    wb.w     = 100.0::f32;
    wb.open  = 1;
    wb.title = "b";

    var ida: u64 = 0;
    var idb: u64 = 0;
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 0), ?wa, ?wb, ?picked, ?opts[0], ?ida, ?idb);
    if (ida == idb) { ret 2; }

    # both popups open at once, each in its own entry
    set_dropdown_open(?ctx, ida, 1);
    set_dropdown_open(?ctx, idb, 1);
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 0), ?wa, ?wb, ?picked, ?opts[0], ?ida, ?idb);
    if (dropdown_open(?ctx, ida) == 0 || dropdown_open(?ctx, idb) == 0) { ret 3; }

    # a press on bare screen reaches only the topmost popup: b closes, a stays
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 1), ?wa, ?wb, ?picked, ?opts[0], ?ida, ?idb);
    if (dropdown_open(?ctx, ida) == 0) { ret 4; }
    if (dropdown_open(?ctx, idb) != 0) { ret 5; }

    # the next press closes a
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 0), ?wa, ?wb, ?picked, ?opts[0], ?ida, ?idb);
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 1), ?wa, ?wb, ?picked, ?opts[0], ?ida, ?idb);
    if (dropdown_open(?ctx, ida) != 0) { ret 6; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding popup A with a button, and popup B opened inside A, whose
# button covers part of A's
#[testing]
fun frame_nested(ctx: *context.Context, in: input.Input, a_hit: *u8, b_hit: *u8, a_gone: *u8, b_gone: *u8) {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val pa: Popup = begin_popup(ctx, "A", 1, 0.0::f32, 0.0::f32, 100.0::f32);
    @a_hit = button(ctx, "a");
    val pb: Popup = begin_popup(ctx, "B", 1, 0.0::f32, 10.0::f32, 100.0::f32);
    @b_hit = button(ctx, "b");
    end_popup(ctx, pb);
    end_popup(ctx, pa);
    @a_gone = pa.dismissed;
    @b_gone = pb.dismissed;
    context.end(ctx);
}

test popup__nested_resolve_to_innermost {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var ah: u8 = 0;
    var bh: u8 = 0;
    var ag: u8 = 0;
    var bg: u8 = 0;

    # button a spans y [0, 16), button b spans y [10, 26): click the overlap
    frame_nested(?ctx, input_at(50.0::f32, 12.0::f32, 0), ?ah, ?bh, ?ag, ?bg);
    frame_nested(?ctx, input_at(50.0::f32, 12.0::f32, 1), ?ah, ?bh, ?ag, ?bg);
    frame_nested(?ctx, input_at(50.0::f32, 12.0::f32, 0), ?ah, ?bh, ?ag, ?bg);
    if (bh != 1 || ah != 0) { ret 2; }
    if (ag != 0 || bg != 0) { ret 3; }

    # B paints above A, and the frame ends on B's layer
    if (vert_at(?ctx, 0.0::f32, 0.0::f32) >= vert_at(?ctx, 0.0::f32, 10.0::f32)) { ret 4; }
    val top: context.Run = context.run_at(?ctx, context.run_count(?ctx) - 1);
    if (top.layer != 2) { ret 5; }

    # a press on A alone dismisses only the innermost popup and is consumed by
    # it, so A's button under it does not activate. B nests in A's scope
    val pb: u64 = bid.of_label(context.id_of(?ctx, "A"), "B");
    frame_nested(?ctx, input_at(50.0::f32, 5.0::f32, 0), ?ah, ?bh, ?ag, ?bg);
    frame_nested(?ctx, input_at(50.0::f32, 5.0::f32, 1), ?ah, ?bh, ?ag, ?bg);
    if (bg != 1 || ag != 0)                      { ret 6; }
    if (ctx.active != bid.child(pb, "#outside")) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with a button at y [30, 46), then a window over it
# whose body holds only text
#[testing]
fun frame_covered(ctx: *context.Context, in: input.Input, win: *Window) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 30.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, "under");
    end_panel(ctx, p);
    val w: Block = begin_window(ctx, win);
    text(ctx, "one");
    text(ctx, "two");
    end_window(ctx, win, w);
    context.end(ctx);
    ret clicked;
}

test window__body_blocks_input_beneath {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # the window body spans y [16, 44)
    var win: Window;
    win.x     = 0.0::f32;
    win.y     = 0.0::f32;
    win.w     = 120.0::f32;
    win.open  = 1;
    win.title = "w";

    frame_covered(?ctx, input_at(50.0::f32, 35.0::f32, 0), ?win);
    if (ctx.hot != 0) { ret 2; }
    frame_covered(?ctx, input_at(50.0::f32, 35.0::f32, 1), ?win);
    if (ctx.hot != 0 || ctx.active != 0)                                       { ret 3; }
    if (frame_covered(?ctx, input_at(50.0::f32, 35.0::f32, 0), ?win) != false) { ret 4; }

    # below the window the button is reachable
    frame_covered(?ctx, input_at(50.0::f32, 45.0::f32, 0), ?win);
    if (ctx.hot != context.id_of(?ctx, "under")) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel button at y [0, 16) and, when shown, a popup whose
# button covers it
#[testing]
fun frame_vanish(ctx: *context.Context, in: input.Input, show: u8) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, "base");
    end_panel(ctx, p);
    val pop: Popup = begin_popup(ctx, "pop", show, 0.0::f32, 0.0::f32, 100.0::f32);
    if (pop.open != 0) { button(ctx, "top"); }
    end_popup(ctx, pop);
    context.end(ctx);
    ret clicked;
}

test routing__vanished_claimant_leaves_one_dead_frame {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 0), 1);
    frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 0), 1);
    if (ctx.hot != bid.of_label(context.id_of(?ctx, "pop"), "top")) { ret 2; }

    # the popup is gone and a press lands where it was: it reaches nobody
    frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 1), 0);
    if (ctx.hot != 0 || ctx.active != 0) { ret 3; }

    # the next frame routes to the base button, and the earlier press never clicks it
    if (frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 0), 0) != false) { ret 4; }
    if (ctx.hot != context.id_of(?ctx, "base"))                           { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test routing__interactive_from_frame_after_first_claim {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # a press in the very first frame does nothing
    frame_button(?ctx, input_at(10.0::f32, 5.0::f32, 1));
    if (ctx.hot != 0 || ctx.active != 0) { ret 2; }
    frame_button(?ctx, input_at(10.0::f32, 5.0::f32, 1));
    if (ctx.hot != context.id_of(?ctx, "ok")) { ret 3; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding two overlapping regions, returning which was clicked
