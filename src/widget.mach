# the widgets: panel, window, popup, dock, scroll region, section, text, note,
# button, button rows and grids, segmented choice, checkbox, toggle, slider,
# dropdown, list, image, grid, text field
#
# the layout helpers place rows by hand: space and advance move the cursor
# down, cell_x0 and cell_x1 split the column into equal cells for widgets that
# take a rect (button_at), and begin_columns lays whole widgets side by side.
#
# each widget places itself at the layout cursor, advances the cursor for the
# next one, emits its geometry through the context painter, and claims its
# interactive rect through interact.hit, the same call a custom control makes,
# so hover, press, click and drag mean the same thing everywhere. a widget is
# hot while it is the topmost claimant under the cursor (see blit.context), and
# active while it owns the pointer after a press on it, until the button
# releases.
#
# a widget's id is its label hashed in the current id scope (see blit.id and
# context.id_of), so widgets appearing or vanishing before it never move it.
# text after "##" in a label is hashed but not drawn, and "###" keys a label by
# what follows alone. widgets without a label (text fields, regions, popups,
# scroll regions, docks, lists, charts) take a key the same way. windows,
# open popups and scroll regions (so docks and lists too) open an id scope of
# their own for what is placed inside them, and a widget's parts (a window's
# collapse box, a scrollbar thumb, a dropdown's options) take ids derived from
# its id.
#
# containers (panels, windows, popups) claim their whole rect beneath their
# children, so input over their empty areas stops at them instead of reaching
# whatever they cover. docks, windows and popups each paint and claim in a
# band of their own (see blit.band): docks above the base content, windows
# above docks in the z order the context keeps, popups above windows. a press anywhere outside an open popup dismisses it, and that
# press is consumed rather than delivered to what lies beneath.
#
# a text field takes the keyboard (see context.focus) when pressed and edits a
# blit.field.Field with the frame's keyboard events while it holds it.
#
# a window keeps its place, size, stack order and open and collapsed state in
# the context's store under its title's id (see WindowState), and moves,
# resizes, collapses and closes from its own chrome.
#
# alongside floating windows, a dock attaches a panel to a screen edge and
# takes it from the free area (see context.carve) the rest of the screen is
# laid out in. a dock's body is a scroll region, which clips its column and
# scrolls it by wheel and scrollbar when it is taller than the region, and a
# section is a collapsible heading that groups the rows beneath it.
#
# every color and length a widget draws with comes from the context's theme
# (see blit.theme), each length multiplied by the context's interface scale,
# so a theme or a scale changes the whole interface and no widget holds a
# color or a size of its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use blit.band;
use blit.context;
use blit.draw;
use blit.driver;
use blit.field;
use blit.font;
use gly: blit.glyph;
use bid: blit.id;
use blit.input;
use blit.interact;
use blit.state;
use rich_text: blit.text;
use blit.theme;
use allo: std.allocator;
use std.allocator.page;
use std.data.toml;

# the theme's space inside chrome, at the context's scale
fun pad(ctx: *context.Context) f32 {
    ret context.px(ctx, ctx.theme.pad);
}

# the theme's space between layout rows, at the context's scale
fun gap(ctx: *context.Context) f32 {
    ret context.px(ctx, ctx.theme.gap);
}

# the theme's corner radius, at the context's scale
fun corner(ctx: *context.Context) f32 {
    ret context.px(ctx, ctx.theme.corner);
}

# height of an interactive row: the theme's row height, grown to fit a line of
# text with padding above and below
fun row_h(ctx: *context.Context) f32 {
    ret maxf(context.px(ctx, ctx.theme.row), context.line_height(ctx) + pad(ctx) * 2.0::f32);
}

# vertical space consumed by one text row, including the following gap
pub fun text_row_height(ctx: *context.Context) f32 {
    ret context.line_height(ctx) + gap(ctx);
}

# vertical space consumed by one control row, including the following gap
pub fun control_row_height(ctx: *context.Context) f32 {
    ret row_h(ctx) + gap(ctx);
}

# spacing between adjacent layout rows, at the context's theme and scale
pub fun row_gap(ctx: *context.Context) f32 {
    ret gap(ctx);
}

# spacing between adjacent layout rows in the default theme at scale 1.0
#[deprecated("use row_gap(ctx), which follows the theme and scale")]
pub fun layout_gap() f32 {
    ret theme.default().gap;
}

# a control-shaped fill: rounded to the theme's corner on every side
fun face(ctx: *context.Context, x0: f32, y0: f32, x1: f32, y1: f32, c: draw.Color) {
    context.fill(ctx, x0, y0, x1, y1, corner(ctx), context.CORNERS_ALL, c);
}

# the drawn part of a label, everything before "##", at (x, y)
fun label_at(ctx: *context.Context, label: str, x: f32, y: f32, c: draw.Color) {
    context.text_span(ctx, label, bid.shown(label), x, y, c);
}

# the width of the drawn part of a label
fun label_width(ctx: *context.Context, label: str) f32 {
    ret context.text_width_n(ctx, label, bid.shown(label));
}

# clamp v to [lo, hi]
fun clampf(v: f32, lo: f32, hi: f32) f32 {
    if (v < lo) { ret lo; }
    if (v > hi) { ret hi; }
    ret v;
}

# the larger of two f32 values
fun maxf(a: f32, b: f32) f32 {
    if (a > b) { ret a; }
    ret b;
}

# the smaller of two f32 values
fun minf(a: f32, b: f32) f32 {
    if (a < b) { ret a; }
    ret b;
}

# drop the cursor past a row h tall and the gap below it, back at the column's
# left edge
#
# every widget ends with this. call it after placing a row by hand, such as
# cells of button_at.
# ---
# ctx: context
# h:   the row's height in pixels
pub fun advance(ctx: *context.Context, h: f32) {
    ctx.cx = ctx.ox;
    ctx.cy = ctx.cy + h + gap(ctx);
}

# leave h pixels of vertical space in the column
# ---
# ctx: context
# h:   space in pixels, context.px scales an authored length to match
pub fun space(ctx: *context.Context, h: f32) {
    ctx.cx = ctx.ox;
    ctx.cy = ctx.cy + h;
}

# the width of one of n equal cells across w pixels, g pixels between them
fun cell_width(w: f32, g: f32, n: usize) f32 {
    if (n == 0) { ret 0.0::f32; }
    ret maxf((w - g * (n - 1)::f32) / n::f32, 0.0::f32);
}

# the left edge of cell i of n equal cells across w pixels from x
fun cell_left(x: f32, w: f32, g: f32, i: usize, n: usize) f32 {
    ret x + i::f32 * (cell_width(w, g, n) + g);
}

# the left edge of cell i of n equal cells across the column, with the theme's
# gap between cells
# ---
# ctx: context
# i:   the cell, from 0 at the left
# n:   how many cells share the column
# ret: the cell's left x in local pixels
pub fun cell_x0(ctx: *context.Context, i: usize, n: usize) f32 {
    ret cell_left(ctx.ox, ctx.pw, gap(ctx), i, n);
}

# the right edge of cell i of n equal cells across the column
# ---
# ctx: context
# i:   the cell, from 0 at the left
# n:   how many cells share the column
# ret: the cell's right x in local pixels
pub fun cell_x1(ctx: *context.Context, i: usize, n: usize) f32 {
    ret cell_x0(ctx, i, n) + cell_width(ctx.pw, gap(ctx), n);
}

# the handle begin_columns returns for next_column and end_columns
# ---
# n:      how many columns share the row
# i:      the column being laid out
# top:    the cursor y the columns start at
# bottom: the lowest cursor y a finished column reached
# ox:     the parent layout's origin x, restored by end_columns
# pw:     the parent layout's width
pub rec Columns {
    n:      usize;
    i:      usize;
    top:    f32;
    bottom: f32;
    ox:     f32;
    pw:     f32;
}

# narrow the layout to the first of n equal columns starting at the cursor
#
# widgets placed until next_column lay out in that column. next_column moves
# to the next one, back at the top, and end_columns restores the parent
# column with the cursor below the tallest. pair it with end_columns.
# ---
# ctx: context
# n:   how many columns share the row, at least 1
# ret: a handle for next_column and end_columns
pub fun begin_columns(ctx: *context.Context, n: usize) Columns {
    var c: Columns;
    c.n      = n;
    c.i      = 0;
    c.top    = ctx.cy;
    c.bottom = ctx.cy;
    c.ox     = ctx.ox;
    c.pw     = ctx.pw;
    if (c.n == 0) { c.n = 1; }
    enter_column(ctx, ?c);
    ret c;
}

# lay out column c.i of the parent's row
fun enter_column(ctx: *context.Context, c: *Columns) {
    val x0: f32 = cell_left(c.ox, c.pw, gap(ctx), c.i, c.n);
    ctx.ox = x0;
    ctx.cx = x0;
    ctx.cy = c.top;
    ctx.pw = cell_width(c.pw, gap(ctx), c.n);
}

# move to the next column, back at the columns' top
#
# past the last column it stays in the last one.
# ---
# ctx: context
# c:   the handle begin_columns returned
pub fun next_column(ctx: *context.Context, c: *Columns) {
    c.bottom = maxf(c.bottom, ctx.cy);
    if (c.i + 1 < c.n) { c.i = c.i + 1; }
    enter_column(ctx, c);
}

# restore the parent column, with the cursor below the tallest column
# ---
# ctx: context
# c:   the handle begin_columns returned
pub fun end_columns(ctx: *context.Context, c: *Columns) {
    c.bottom = maxf(c.bottom, ctx.cy);
    ctx.ox   = c.ox;
    ctx.cx   = c.ox;
    ctx.pw   = c.pw;
    ctx.cy   = c.bottom;
}

# ask for the hand pointer over a clickable widget while it is hovered
fun hand(ctx: *context.Context, h: interact.Hit) {
    if (h.hot) { context.set_cursor(ctx, input.CURSOR_HAND); }
}

# the handle begin_panel and begin_window return for their matching end
# ---
# ch:    the channels the body's background and children draw in
# claim: the container's reserved claim, context.NO_CLAIM when refused
pub rec Block {
    ch:    context.Channels;
    claim: usize;
}

# start a layout column at (x, y) of width w
#
# the background height is unknown until the panel's widgets are placed, so
# the widgets draw in a channel above the background's, which end_panel paints
# once it knows the height. the panel's claim is reserved now, beneath its
# widgets, and given its rect then.
# ---
# ctx: context
# x:   panel left in pixels
# y:   panel top in pixels
# w:   panel width in pixels
# ret: a handle for end_panel
pub fun begin_panel(ctx: *context.Context, x: f32, y: f32, w: f32) Block {
    ctx.ox = x;
    ctx.oy = y;
    ctx.cx = x;
    ctx.cy = y;
    ctx.pw = w;

    var b: Block;
    b.claim = context.reserve_claim(ctx, 0);
    b.ch    = context.split(ctx, 2);
    context.set_channel(ctx, b.ch, 1);
    ret b;
}

# paint the panel background beneath, and give the claim the rect of, every
# widget placed since begin_panel
# ---
# ctx: context
# b:   the value returned by begin_panel
pub fun end_panel(ctx: *context.Context, b: Block) {
    val x0: f32 = ctx.ox;
    val y0: f32 = ctx.oy;
    val x1: f32 = ctx.ox + ctx.pw;
    val y1: f32 = ctx.cy + pad(ctx);
    context.set_channel(ctx, b.ch, 0);
    context.fill(ctx, x0, y0, x1, y1, corner(ctx), context.CORNERS_ALL, ctx.theme.panel);
    context.merge(ctx, b.ch);
    context.fill_claim(ctx, b.claim, x0, y0, x1, y1);
}

# draw a line of text at the cursor and advance to the next row
# ---
# ctx: context
# s:   string to draw
pub fun text(ctx: *context.Context, s: str) {
    context.text_at(ctx, s, ctx.cx, ctx.cy, ctx.theme.text);
    advance(ctx, context.line_height(ctx));
}

# draw a rich line of spans at the cursor and advance to the next row
#
# each span draws in its own style and color, all on one baseline (see
# blit.text.Span).
# ---
# ctx: context
# sp:  the spans
# n:   how many
pub fun rich(ctx: *context.Context, sp: *rich_text.Span, n: usize) {
    val m: gly.LineMetrics = rich_text.spans_line(ctx, sp, n);
    val w: f32             = rich_text.spans_at(ctx, sp, n, ctx.cx, ctx.cy);
    advance(ctx, m.ascent + m.descent + m.gap);
}

# where the line of s starting at byte i ends when wrapped to w pixels
#
# a line breaks at a newline, else after the last space that keeps it within
# w, else before the codepoint that would overflow, so a word wider than the
# column is split rather than drawn past it. a line always takes at least one
# codepoint.
# ---
# ret: the byte the line ends at, with @resume set to where the next line starts
fun wrap_line(ctx: *context.Context, s: str, n: usize, i: usize, w: f32, resume: *usize) usize {
    var width: f32   = 0.0::f32;
    var prev:  u32   = 0;
    var space: usize = n;
    var j:     usize = i;
    for (j < n) {
        var cp:   u32   = 0;
        val used: usize = font.next(s, j, n, ?cp);
        if (cp == font.NEWLINE) {
            @resume = j + used;
            ret j;
        }
        val adv: f32 = context.glyph_advance(ctx, prev, cp);
        if (width + adv > w && j > i) {
            if (cp == ' ') {
                @resume = j + used;
                ret j;
            }
            if (space < n) {
                @resume = space + 1;
                ret space;
            }
            @resume = j;
            ret j;
        }
        if (cp == ' ') { space = j; }
        width = width + adv;
        prev  = cp;
        j     = j + used;
    }
    @resume = n;
    ret n;
}

# dim text wrapped at spaces to the column's width, and advance past it
#
# a newline starts a new line, and a word wider than the column breaks where
# it overflows.
# ---
# ctx: context
# s:   utf-8 text
pub fun note(ctx: *context.Context, s: str) {
    val lh: f32   = context.line_height(ctx);
    var n:  usize = 0;
    if (s != nil) { n = str_len(s); }
    var y:     f32   = ctx.cy;
    var i:     usize = 0;
    var lines: usize = 0;
    for (i < n || lines == 0) {
        var next: usize = n;
        val end:  usize = wrap_line(ctx, s, n, i, ctx.pw, ?next);
        if (end > i) { context.text_span(ctx, ?s[i], end - i, ctx.cx, y, ctx.theme.text_dim); }
        y     = y + lh;
        lines = lines + 1;
        i     = next;
    }
    advance(ctx, y - ctx.cy);
}

# a clickable button filling a rect, with a centered label
#
# the rect is in local coordinates, so rows and grids of buttons place it
# with cell_x0 and cell_x1. it does not move the layout cursor. returns true
# on the frame the button is released while hovered, after having been
# pressed on it.
# ---
# ctx:   context
# label: button text, and its key (see context.id_of)
# x0:    left x in pixels
# y0:    top y in pixels
# x1:    right x in pixels
# y1:    bottom y in pixels
# on:    true to draw the button chosen, in the theme's accent
# ret:   true if the button was clicked this frame
pub fun button_at(ctx: *context.Context, label: str, x0: f32, y0: f32, x1: f32, y1: f32, on: bool) bool {
    val h: interact.Hit = interact.hit(ctx, context.id_of(ctx, label), x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, h);

    var bg:  draw.Color = ctx.theme.control;
    var ink: draw.Color = ctx.theme.text;
    if (h.hot)    { bg = ctx.theme.control_hot; }
    if (h.active) { bg = ctx.theme.control_on; }
    if (on) {
        bg  = ctx.theme.accent;
        ink = ctx.theme.accent_text;
    }
    face(ctx, x0, y0, x1, y1, bg);

    val tw: f32 = label_width(ctx, label);
    val tx: f32 = x0 + (x1 - x0 - tw) / 2.0::f32;
    val ty: f32 = y0 + (y1 - y0 - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, tx, ty, ink);
    ret h.clicked;
}

# a full-width clickable button with a centered label
#
# returns true on the frame the button is released while hovered, after having
# been pressed on it.
# ---
# ctx:   context
# label: button text
# ret:   true if the button was clicked this frame
pub fun button(ctx: *context.Context, label: str) bool {
    val h:       f32  = row_h(ctx);
    val clicked: bool = button_at(ctx, label, ctx.cx, ctx.cy, ctx.cx + ctx.pw, ctx.cy + h, false);
    advance(ctx, h);
    ret clicked;
}

# a grid of n buttons, cols to a row, filling the column
#
# each button is keyed by its label, so labels that repeat need "##" to tell
# them apart.
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many buttons
# cols:   buttons to a row, at least 1
# on:     the button drawn chosen, n for none
# ret:    the index clicked this frame, n for none
pub fun button_grid(ctx: *context.Context, labels: *str, n: usize, cols: usize, on: usize) usize {
    var per: usize = cols;
    if (per == 0) { per = 1; }
    val h:   f32   = row_h(ctx);
    var got: usize = n;
    var i:   usize = 0;
    for (i < n) {
        val c: usize = i % per;
        if (button_at(ctx, labels[i], cell_x0(ctx, c, per), ctx.cy, cell_x1(ctx, c, per), ctx.cy + h, i == on)) { got = i; }
        if (c + 1 == per || i + 1 == n)                                                                         { advance(ctx, h); }
        i = i + 1;
    }
    ret got;
}

# a row of n buttons sharing the column equally
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many buttons
# ret:    the index clicked this frame, n for none
pub fun buttons(ctx: *context.Context, labels: *str, n: usize) usize {
    ret button_grid(ctx, labels, n, n, n);
}

# a row choosing one of n options, the chosen one drawn in the accent
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many options
# choice: pointer to the chosen index, updated in place
# ret:    true if the choice changed this frame
pub fun segmented(ctx: *context.Context, labels: *str, n: usize, choice: *usize) bool {
    val got: usize = button_grid(ctx, labels, n, n, @choice);
    if (got >= n || got == @choice) { ret false; }
    @choice = got;
    ret true;
}

# a labeled toggle that flips @state when clicked
# ---
# ctx:   context
# label: text drawn to the right of the box
# state: pointer to the 0/1 toggle state, updated in place
# ret:   true if the state changed this frame
pub fun checkbox(ctx: *context.Context, label: str, state: *u8) bool {
    val id:  u64 = context.id_of(ctx, label);
    val x0:  f32 = ctx.cx;
    val y0:  f32 = ctx.cy;
    val box: f32 = row_h(ctx);
    val bx1: f32 = x0 + box;
    val y1:  f32 = y0 + box;

    val tw:  f32          = label_width(ctx, label);
    val rx1: f32          = bx1 + pad(ctx) + tw;
    val hc:  interact.Hit = interact.hit(ctx, id, x0, y0, rx1, y1, input.BUTTON_LEFT);
    hand(ctx, hc);

    var toggled: bool = false;
    if (hc.clicked) {
        var nv: u8 = 1;
        if (@state != 0) { nv = 0; }
        @state  = nv;
        toggled = true;
    }

    var bg: draw.Color = ctx.theme.control;
    if (hc.hot) { bg = ctx.theme.control_hot; }
    face(ctx, x0, y0, bx1, y1, bg);
    if (@state != 0) {
        val in: f32 = pad(ctx);
        face(ctx, x0 + in, y0 + in, bx1 - in, y1 - in, ctx.theme.accent);
    }

    val ty: f32 = y0 + (box - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, bx1 + pad(ctx), ty, ctx.theme.text);

    advance(ctx, box);
    ret toggled;
}

# a labeled on/off switch across the column that flips @state when clicked
#
# the label sits on the left and the switch on the right, its knob at the
# right end on an accent track when on. the whole row takes the click.
# ---
# ctx:   context
# label: text drawn on the left
# state: pointer to the 0/1 switch state, updated in place
# ret:   true if the state changed this frame
pub fun toggle(ctx: *context.Context, label: str, state: *u8) bool {
    val id: u64 = context.id_of(ctx, label);
    val x0: f32 = ctx.cx;
    val y0: f32 = ctx.cy;
    val h:  f32 = row_h(ctx);
    val x1: f32 = ctx.cx + ctx.pw;
    val y1: f32 = y0 + h;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, hs);

    var flipped: bool = false;
    if (hs.clicked) {
        var nv: u8 = 1;
        if (@state != 0) { nv = 0; }
        @state  = nv;
        flipped = true;
    }

    val ty: f32 = y0 + (h - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, x0, ty, ctx.theme.text);

    # the switch is a track twice as wide as it is tall, inset from the row by pad
    val in: f32        = pad(ctx);
    val sh: f32        = maxf(h - in, 0.0::f32);
    val sw: f32        = sh * 2.0::f32;
    val sx: f32        = x1 - sw;
    val sy: f32        = y0 + (h - sh) / 2.0::f32;
    var tc: draw.Color = ctx.theme.track;
    var kc: draw.Color = ctx.theme.handle;
    if (hs.hot) {
        tc = ctx.theme.control_hot;
        kc = ctx.theme.handle_on;
    }
    if (@state != 0) {
        tc = ctx.theme.accent;
        kc = ctx.theme.accent_text;
    }
    face(ctx, sx, sy, sx + sw, sy + sh, tc);

    val ki: f32 = in / 2.0::f32;
    val k:  f32 = maxf(sh - ki * 2.0::f32, 0.0::f32);
    var kx: f32 = sx + ki;
    if (@state != 0) { kx = sx + sw - ki - k; }
    face(ctx, kx, sy + ki, kx + k, sy + ki + k, kc);

    advance(ctx, h);
    ret flipped;
}

# a horizontal slider mapping @v linearly onto [lo, hi]
#
# while the handle is held, @v tracks the cursor's x within the track, wherever
# the cursor goes. the label is drawn on the left of the track.
# ---
# ctx:   context
# label: slider text
# v:     pointer to the value, updated in place while dragging
# lo:    minimum value (left end)
# hi:    maximum value (right end)
# ret:   true if the value changed this frame
pub fun slider_f(ctx: *context.Context, label: str, v: *f32, lo: f32, hi: f32) bool {
    ret slider(ctx, label, nil, v, lo, hi);
}

# a horizontal slider mapping @v linearly onto [lo, hi], with a reading of its
# value beside the label
#
# like slider_f, and the reading, which the caller formats from @v however it
# likes (a unit, a percentage, "off"), is drawn dim at the right end of the
# track. format it before the call from the value as it stands, and the next
# frame shows a drag's result.
# ---
# ctx:     context
# label:   slider text, drawn on the left
# reading: the value as text, drawn on the right, nil for none
# v:       pointer to the value, updated in place while dragging
# lo:      minimum value (left end)
# hi:      maximum value (right end)
# ret:     true if the value changed this frame
pub fun slider(ctx: *context.Context, label: str, reading: str, v: *f32, lo: f32, hi: f32) bool {
    val id: u64 = context.id_of(ctx, label);
    val x0: f32 = ctx.cx;
    val y0: f32 = ctx.cy;
    val h:  f32 = row_h(ctx);
    val x1: f32 = ctx.cx + ctx.pw;
    val y1: f32 = y0 + h;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);

    var changed: bool = false;
    if (hs.held) {
        val track: f32 = x1 - x0;
        var t:     f32 = 0.0::f32;
        if (track > 0.0::f32) { t = clampf((hs.mx - x0) / track, 0.0::f32, 1.0::f32); }
        val nv: f32 = lo + t * (hi - lo);
        if (nv != @v) {
            @v      = nv;
            changed = true;
        }
    }

    face(ctx, x0, y0, x1, y1, ctx.theme.track);

    var t_out: f32 = 0.0::f32;
    if (hi != lo) { t_out = clampf((@v - lo) / (hi - lo), 0.0::f32, 1.0::f32); }
    val hw:   f32 = context.px(ctx, ctx.theme.handle_w);
    var span: f32 = (x1 - x0) - hw;
    if (span < 0.0::f32) { span = 0.0::f32; }
    val hx: f32 = x0 + t_out * span;

    var hc: draw.Color = ctx.theme.handle;
    if (hs.active) { hc = ctx.theme.handle_on; }
    face(ctx, hx, y0, hx + hw, y1, hc);

    val ty: f32 = y0 + (h - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, x0 + pad(ctx), ty, ctx.theme.text);
    if (reading != nil) {
        val rw: f32 = context.text_width(ctx, reading);
        context.text_at(ctx, reading, x1 - pad(ctx) - rw, ty, ctx.theme.text_dim);
    }

    advance(ctx, h);
    ret changed;
}

# the handle begin_popup returns for end_popup
# ---
# open:      1 if the popup is drawn this frame, else 0
# dismissed: 1 if a press outside the popup dismissed it this frame
# ch:        the channels the body's background and children draw in
# claim:     the popup body's reserved claim
# ox:        the parent layout's origin x, restored by end_popup
# oy:        the parent layout's origin y
# cx:        the parent layout's cursor x
# cy:        the parent layout's cursor y
# pw:        the parent layout's width
pub rec Popup {
    open:      u8;
    dismissed: u8;
    ch:        context.Channels;
    claim:     usize;
    ox:        f32;
    oy:        f32;
    cx:        f32;
    cy:        f32;
    pw:        f32;
}

# open a popup column at (x, y) of width w in the popup band, when @open is
# nonzero
#
# the popup paints and takes input above the base content, docks, windows and
# overlays (see blit.band), and a popup opened inside another stacks one layer
# above it, so a submenu always covers its menu. popups opened side by side
# share a layer and stack by call order.
#
# (x, y) is in the caller's local coordinates. inside the popup the layout cursor
# is in screen pixels, so widgets placed between begin_popup and end_popup land in
# the popup and paint and claim above what they overlap. the popup also claims
# the whole screen beneath its body: a press outside the body sets `dismissed`
# and is consumed, so it never activates what lies under it. the caller owns the
# open state and closes it on dismissal. while open, the popup is an id scope
# for the widgets inside it. pair every begin_popup with an end_popup.
# ---
# ctx:  context
# key:  the popup's key in the current id scope
# open: nonzero to draw the popup this frame
# x:    popup left in local pixels
# y:    popup top in local pixels
# w:    popup width in pixels
# ret:  a handle for end_popup
pub fun begin_popup(ctx: *context.Context, key: str, open: u8, x: f32, y: f32, w: f32) Popup {
    ret popup_at(ctx, context.id_of(ctx, key), open, x, y, w);
}

# begin_popup for a popup whose id is already known
fun popup_at(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32) Popup {
    var p: Popup;
    p.claim = context.NO_CLAIM;
    if (open == 0) { ret p; }
    p.open = 1;
    p.ox   = ctx.ox;
    p.oy   = ctx.oy;
    p.cx   = ctx.cx;
    p.cy   = ctx.cy;
    p.pw   = ctx.pw;

    val sx: f32 = x + ctx.lx;
    val sy: f32 = y + ctx.ly;
    context.push_band(ctx, band.POPUPS, 0);
    context.push_id(ctx, id);

    val out: interact.Hit = interact.hit(ctx, bid.child(id, "#outside"), 0.0::f32, 0.0::f32, ctx.sw, ctx.sh, input.BUTTON_LEFT);
    if (out.pressed) { p.dismissed = 1; }

    p.claim = context.reserve_claim(ctx, 0);
    ctx.ox  = sx;
    ctx.oy  = sy;
    ctx.cx  = sx;
    ctx.cy  = sy;
    ctx.pw  = w;
    p.ch    = context.split(ctx, 2);
    context.set_channel(ctx, p.ch, 1);
    ret p;
}

# close a popup opened by begin_popup: paint its background beneath its
# widgets, give its claim their rect, leave its layer and restore the parent
# layout
# ---
# ctx: context
# p:   the value returned by begin_popup
pub fun end_popup(ctx: *context.Context, p: Popup) {
    if (p.open == 0) { ret; }

    val x0: f32 = ctx.ox;
    val y0: f32 = ctx.oy;
    val x1: f32 = ctx.ox + ctx.pw;
    val y1: f32 = ctx.cy + pad(ctx);
    context.set_channel(ctx, p.ch, 0);
    context.fill(ctx, x0, y0, x1, y1, corner(ctx), context.CORNERS_ALL, ctx.theme.window);
    context.merge(ctx, p.ch);
    context.fill_claim(ctx, p.claim, x0, y0, x1, y1);
    context.pop_id(ctx);
    context.pop_band(ctx);

    ctx.ox = p.ox;
    ctx.oy = p.oy;
    ctx.cx = p.cx;
    ctx.cy = p.cy;
    ctx.pw = p.pw;
}

# the state a dropdown keeps in the context's store under its header's id
# ---
# open: 1 while the option list is shown, else 0
pub rec DropdownState {
    open: u8;
}

# a select: shows the current option and, while open, lists the options in a
# popup directly beneath it
#
# clicking the header opens it. the open state is a DropdownState the context's
# state store keeps under the header's id (see blit.state), so each dropdown
# opens and closes on its own. clicking an option sets @selected and closes it,
# and a press anywhere else closes it without reaching what lies beneath. the
# option list overlays later widgets rather than pushing them down.
# ---
# ctx:      context
# label:    text drawn on the left of the header, and its key
# selected: pointer to the selected index, updated in place
# options:  pointer to an array of option strings (pass ?opts[0])
# count:    number of options
# ret:      1 if the selection changed this frame, else 0
pub fun dropdown(ctx: *context.Context, label: str, selected: *usize, options: *str, count: usize) u8 {
    val id: u64            = context.id_of(ctx, label);
    val st: *DropdownState = state.get[DropdownState](ctx, id);
    val x0: f32            = ctx.cx;
    val y0: f32            = ctx.cy;
    val h:  f32            = row_h(ctx);
    val x1: f32            = ctx.cx + ctx.pw;
    val y1: f32            = y0 + h;

    val hd: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, hd);
    if (hd.clicked) {
        if (st.open != 0) { st.open = 0; }
        or                { st.open = 1; }
    }

    var bg: draw.Color = ctx.theme.control;
    if (hd.hot)       { bg = ctx.theme.control_hot; }
    if (st.open != 0) { bg = ctx.theme.control_on; }
    face(ctx, x0, y0, x1, y1, bg);

    val ty: f32 = y0 + (h - context.line_height(ctx)) / 2.0::f32;
    label_at(ctx, label, x0 + pad(ctx), ty, ctx.theme.text);
    if (@selected < count) {
        val cur: str = options[@selected];
        val cw:  f32 = context.text_width(ctx, cur);
        context.text_at(ctx, cur, x1 - pad(ctx) - cw, ty, ctx.theme.text);
    }

    advance(ctx, h);

    val pid: u64   = bid.child(id, "#popup");
    val pop: Popup = popup_at(ctx, pid, st.open, ctx.cx, ctx.cy, ctx.pw);

    var changed: u8    = 0;
    var i:       usize = 0;
    for (i < count) {
        val oid: u64 = bid.child_int(pid, i::u64);
        if (pop.open != 0) {
            val ox0: f32 = ctx.cx;
            val oy0: f32 = ctx.cy;
            val ox1: f32 = ctx.cx + ctx.pw;
            val oy1: f32 = oy0 + h;

            val ho: interact.Hit = interact.hit(ctx, oid, ox0, oy0, ox1, oy1, input.BUTTON_LEFT);
            hand(ctx, ho);
            if (ho.clicked) {
                @selected = i;
                st.open   = 0;
                changed   = 1;
            }

            var obg: draw.Color = ctx.theme.track;
            if (ho.hot) { obg = ctx.theme.control_hot; }
            face(ctx, ox0, oy0, ox1, oy1, obg);
            context.text_at(ctx, options[i], ox0 + pad(ctx), oy0 + (h - context.line_height(ctx)) / 2.0::f32, ctx.theme.text);

            advance(ctx, h);
        }
        i = i + 1;
    }
    end_popup(ctx, pop);

    if (pop.dismissed != 0) { st.open = 0; }
    ret changed;
}

# width of the utf-8 bytes [lo, hi) of s laid out on one line in the current style
fun bytes_width(ctx: *context.Context, s: *u8, lo: usize, hi: usize) f32 {
    if (hi <= lo) { ret 0.0::f32; }
    ret context.text_width_n(ctx, ?s[lo], hi - lo);
}

# width of the field's bytes [lo, hi) laid out on one line in the current style
fun span(ctx: *context.Context, f: *field.Field, lo: usize, hi: usize) f32 {
    ret bytes_width(ctx, f.buf, lo, hi);
}

# scroll the field's shown text so the caret is in view in w pixels, showing
# as much of the text as fits
fun keep_in_view(ctx: *context.Context, f: *field.Field, w: f32) {
    if (f.first > f.caret) { f.first = f.caret; }
    for (f.first < f.caret && span(ctx, f, f.first, f.caret) > w) { f.first = field.after(f, f.first); }
    for (f.first > 0 && span(ctx, f, field.before(f, f.first), f.len) <= w) { f.first = field.before(f, f.first); }
}

# the character boundary nearest x pixels right of the field's shown text start
fun caret_at(ctx: *context.Context, f: *field.Field, x: f32) usize {
    var at: f32   = 0.0::f32;
    var i:  usize = f.first;
    for (i < f.len) {
        val n: usize = field.after(f, i);
        val w: f32   = span(ctx, f, i, n);
        if (x < at + w / 2.0::f32) { brk; }
        at = at + w;
        i  = n;
    }
    ret i;
}

# hand the frame's paste and keyboard events, in order, to a focused field
#
# copy and cut go to the context's clipboard hand-off and paste asks it for
# the clipboard. enter or escape drop the focus, and events after them are
# left alone.
fun feed(ctx: *context.Context, f: *field.Field) u8 {
    var out: u8 = 0;
    if (field.paste(f, ctx.in.paste)) { out = out | field.EDITED; }
    var i: usize = 0;
    for (i < ctx.in.events.len) {
        val e: input.Event = ctx.in.events.data[i];
        i = i + 1;
        if (sel e.text) {
            if (field.insert(f, e.text)) { out = out | field.EDITED; }
            cnt;
        }
        if (!sel e.key) { cnt; }
        val k:   input.Key = e.key;
        val cmd: bool      = input.shortcut(k.mods);
        if (cmd && (k.code == 'C' || k.code == 'X')) {
            if (field.selected(f)) {
                val lo: usize = field.sel_lo(f);
                context.set_copied(ctx, ?f.buf[lo], field.sel_hi(f) - lo);
                if (k.code == 'X' && field.erase(f)) { out = out | field.EDITED; }
            }
            cnt;
        }
        if (cmd && k.code == 'V') {
            context.request_paste(ctx);
            cnt;
        }
        val r: u8 = field.key(f, k);
        out = out | r;
        if ((r & (field.ENTERED | field.ESCAPED)) != 0) {
            context.unfocus(ctx);
            brk;
        }
    }
    ret out;
}

# a full-width, one-line text field editing @f
#
# a press on it gives it the keyboard (see context.focus) and puts the caret
# under the cursor; a press elsewhere, or a frame it is not drawn in, takes the
# keyboard back. while it holds the keyboard it takes the frame's typed text
# and editing keys (see field.key) in order: shortcut C and X copy and cut the
# selection to the clipboard hand-off (see context.copied), shortcut V asks for
# the clipboard (see context.wants_paste) and takes the next frame's
# input.paste, and enter or escape end the edit and give the keyboard back.
# the text scrolls to keep the caret in view. while it holds the keyboard it
# shows the IME's composition (see context.preedit) inline at the caret,
# underlined, and places the IME's candidate window at the caret (see
# context.ime_rect). it asks for the text pointer while hovered.
# ---
# ctx:  context
# key:  the field's key in the current id scope, so id_of(ctx, key) gives it the
#       keyboard with context.focus
# f:    the field's state, edited in place
# hint: dim text shown while it is empty and unfocused, nil for none
# ret:  this frame's outcome bits: field.EDITED, field.ENTERED, field.ESCAPED
pub fun text_field(ctx: *context.Context, key: str, f: *field.Field, hint: str) u8 {
    val id: u64 = context.id_of(ctx, key);
    val x0: f32 = ctx.cx;
    val y0: f32 = ctx.cy;
    val h:  f32 = row_h(ctx);
    val x1: f32 = ctx.cx + ctx.pw;
    val y1: f32 = y0 + h;
    val tx: f32 = x0 + pad(ctx);
    val tw: f32 = maxf(x1 - x0 - pad(ctx) * 2.0::f32, 0.0::f32);

    val hf: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    if (hf.hot) { context.set_cursor(ctx, input.CURSOR_TEXT); }
    if (hf.pressed) {
        context.focus(ctx, id);
        keep_in_view(ctx, f, tw);
        val at: usize = caret_at(ctx, f, hf.mx - tx);
        f.caret  = at;
        f.anchor = at;
    }
    var out: u8 = 0;
    if (context.focused(ctx, id)) { out = feed(ctx, f); }
    val on: bool = ctx.focus == id;

    var bg: draw.Color = ctx.theme.track;
    if (hf.hot && !on) { bg = ctx.theme.control_hot; }
    if (on) {
        val ew: f32 = context.px(ctx, ctx.theme.edge_w);
        face(ctx, x0, y0, x1, y1, ctx.theme.accent);
        face(ctx, x0 + ew, y0 + ew, x1 - ew, y1 - ew, bg);
    }
    or { face(ctx, x0, y0, x1, y1, bg); }

    keep_in_view(ctx, f, tw);
    val lh: f32 = context.line_height(ctx);
    val ty: f32 = y0 + (h - lh) / 2.0::f32;
    context.push_clip(ctx, tx, y0, tx + tw, y1);
    if (f.len == 0 && !on) { context.text_at(ctx, hint, tx, ty, ctx.theme.text_faint); }
    if (on && field.selected(f)) {
        var lo: usize = field.sel_lo(f);
        if (lo < f.first) { lo = f.first; }
        val sx0: f32 = tx + span(ctx, f, f.first, lo);
        val sx1: f32 = tx + span(ctx, f, f.first, field.sel_hi(f));
        context.quad(ctx, sx0, ty, sx1, ty + lh, ctx.theme.select);
    }
    val cw:  f32 = context.px(ctx, ctx.theme.caret_w);
    val pre: str = context.preedit(ctx, id);
    var cx:  f32 = tx + span(ctx, f, f.first, f.caret);
    if (pre == nil) { context.text_at(ctx, ?f.buf[f.first], tx, ty, ctx.theme.text); }
    or {
        val pw: f32 = bytes_width(ctx, pre, 0, str_len(pre));
        context.text_span(ctx, ?f.buf[f.first], f.caret - f.first, tx, ty, ctx.theme.text);
        context.text_at(ctx, pre, cx, ty, ctx.theme.text);
        context.quad(ctx, cx, ty + lh - cw, cx + pw, ty + lh, ctx.theme.text);
        context.text_at(ctx, ?f.buf[f.caret], cx + pw, ty, ctx.theme.text);
        cx = cx + bytes_width(ctx, pre, 0, context.preedit_caret(ctx));
    }
    context.pop_clip(ctx);
    if (on) {
        context.quad(ctx, cx, ty, cx + cw, ty + lh, ctx.theme.text);
        context.set_ime_rect(ctx, cx, ty, cx + cw, ty + lh);
    }

    advance(ctx, h);
    ret out;
}

# hit-test an arbitrary rect with button click semantics
#
# returns 1 on the frame the primary button releases while the rect is hovered,
# after being pressed on it. emits no geometry, the consumer draws the affordance
# (an icon, a corner toggle) itself. the rect is in local coordinates and is
# clipped and layered like geometry.
# ---
# ctx: context
# key: the region's key in the current id scope
# x0:  left x in pixels
# y0:  top y in pixels
# x1:  right x in pixels
# y1:  bottom y in pixels
# ret: 1 if the rect was clicked this frame, else 0
pub fun region_clicked(ctx: *context.Context, key: str, x0: f32, y0: f32, x1: f32, y1: f32) u8 {
    val h: interact.Hit = interact.hit(ctx, context.id_of(ctx, key), x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, h);
    if (h.clicked) { ret 1; }
    ret 0;
}

# draw a region of a consumer texture w by h at the cursor and advance to the
# next row
#
# the region stretches to fill the rect, drawn with its texels as they are.
# see context.image_at to draw one into an arbitrary rect or tinted.
# ---
# ctx: context
# img: the texture region and its sampling filter
# w:   width in pixels
# h:   height in pixels
pub fun image(ctx: *context.Context, img: draw.Image, w: f32, h: f32) {
    val white: draw.Color = draw.rgba(1.0::f32, 1.0::f32, 1.0::f32, 1.0::f32);
    context.image_at(ctx, img, ctx.cx, ctx.cy, ctx.cx + w, ctx.cy + h, white);
    advance(ctx, h);
}

# colors that values from lo to hi map onto in count equal steps
# ---
# colors: the steps, lowest value first
# count:  number of colors
# lo:     value mapped to the first color, and everything below it
# hi:     value mapped to the last color, and everything above it
pub rec Palette {
    colors: *draw.Color;
    count:  usize;
    lo:     f32;
    hi:     f32;
}

# the palette step a value falls in
#
# the range divides into count equal steps, clamped at both ends, so a value
# never blends between colors. an empty palette gives transparent black.
# ---
# p:   palette
# v:   value
# ret: the step's color
pub fun palette_color(p: Palette, v: f32) draw.Color {
    if (p.count == 0 || p.colors == nil) { ret draw.rgba(0.0::f32, 0.0::f32, 0.0::f32, 0.0::f32); }
    var i: usize = 0;
    if (p.hi > p.lo) {
        val t: f32 = (v - p.lo) / (p.hi - p.lo);
        if (t >= 1.0::f32) { i = p.count - 1; }
        or (t > 0.0::f32)  { i = (t * p.count::f32)::usize; }
    }
    if (i >= p.count) { i = p.count - 1; }
    ret p.colors[i];
}

# a discrete field of cols by rows cells, stored row-major from the top left
#
# each cell's color is the consumer's colors[i] when colors is set, else
# values[i] mapped through palette. a field with neither draws nothing.
# ---
# cols:    cells across
# rows:    cells down
# colors:  cols * rows consumer-mapped colors, or nil to map values
# values:  cols * rows values mapped through palette when colors is nil
# palette: the steps values map onto
pub rec Grid {
    cols:    usize;
    rows:    usize;
    colors:  *draw.Color;
    values:  *f32;
    palette: Palette;
}

# draw a field as solid colored cells filling a rect
#
# cells tile the rect edge to edge with no seams and sample the atlas, so a
# small field needs no consumer texture. a field too large to draw cell by
# cell belongs in a texture drawn with image and FILTER_NEAREST instead.
# ---
# ctx: context
# g:   the field
# x0:  left x in pixels
# y0:  top y in pixels
# x1:  right x in pixels
# y1:  bottom y in pixels
pub fun grid_at(ctx: *context.Context, g: Grid, x0: f32, y0: f32, x1: f32, y1: f32) {
    if (g.cols == 0 || g.rows == 0)         { ret; }
    if (g.colors == nil && g.values == nil) { ret; }
    val w: f32   = x1 - x0;
    val h: f32   = y1 - y0;
    var r: usize = 0;
    for (r < g.rows) {
        val cy0: f32   = y0 + h * r::f32 / g.rows::f32;
        val cy1: f32   = y0 + h * (r + 1)::f32 / g.rows::f32;
        var c:   usize = 0;
        for (c < g.cols) {
            val cx0: f32   = x0 + w * c::f32 / g.cols::f32;
            val cx1: f32   = x0 + w * (c + 1)::f32 / g.cols::f32;
            val i:   usize = r * g.cols + c;
            var col: draw.Color;
            if (g.colors != nil) { col = g.colors[i]; }
            or                   { col = palette_color(g.palette, g.values[i]); }
            context.quad(ctx, cx0, cy0, cx1, cy1, col);
            c = c + 1;
        }
        r = r + 1;
    }
}

# draw a field w by h at the cursor and advance to the next row
# ---
# ctx: context
# g:   the field
# w:   width in pixels
# h:   height in pixels
pub fun grid(ctx: *context.Context, g: Grid, w: f32, h: f32) {
    grid_at(ctx, g, ctx.cx, ctx.cy, ctx.cx + w, ctx.cy + h);
    advance(ctx, h);
}

# window flags a call declares, combined with |
# ---
# WINDOW_NO_TITLE:      no titlebar, so no collapse box, close button or title drag
# WINDOW_NO_RESIZE:     no resize grips
# WINDOW_NO_MOVE:       the titlebar does not drag the window
# WINDOW_NO_BACKGROUND: the body is not painted, though it still stops input
# WINDOW_NO_CLOSE:      no close button
# WINDOW_AUTO_SIZE:     the height follows the content instead of scrolling it
pub val WINDOW_NO_TITLE:      u32 = 1;
pub val WINDOW_NO_RESIZE:     u32 = 2;
pub val WINDOW_NO_MOVE:       u32 = 4;
pub val WINDOW_NO_BACKGROUND: u32 = 8;
pub val WINDOW_NO_CLOSE:      u32 = 16;
pub val WINDOW_AUTO_SIZE:     u32 = 32;

# the edges a resize grip moves, combined with |
val EDGE_L: u32 = 1;
val EDGE_R: u32 = 2;
val EDGE_T: u32 = 4;
val EDGE_B: u32 = 8;

# every resize grip by the edges it moves: four edges, then four corners
val GRIPS: [8]u32 = [8]u32{1, 2, 4, 8, 5, 6, 9, 10};

# added to a pinned window's z for its slot, so it stays above every unpinned one
val PIN_SLOT: u64 = 0x800000;

# what a call declares about a window, every frame it is drawn
#
# the rect is where the window first opens. from then on its state in the
# context's store (WindowState) holds where it is, so moving, resizing and
# reloading are never undone by the call. a size bound of 0 is no bound.
# ---
# title: titlebar text, and the window's key (see context.id_of)
# x:     left the window first opens at, in screen pixels
# y:     top the window first opens at, in screen pixels
# w:     width the window first opens with
# h:     height the window first opens with, titlebar included
# min_w: least width, raised to fit the titlebar's boxes
# min_h: least height, raised to the titlebar's
# max_w: greatest width, 0 for none
# max_h: greatest height, 0 for none
# flags: WINDOW_* flags
pub rec Window {
    title: str;
    x:     f32;
    y:     f32;
    w:     f32;
    h:     f32;
    min_w: f32;
    min_h: f32;
    max_w: f32;
    max_h: f32;
    flags: u32;
}

# where a dragged part stood when the press on it began, kept in the state
# store under the part's id
# ---
# x: the window's x, unused by a scrollbar thumb
# y: the window's y, or the scroll offset under a scrollbar thumb
# w: the window's width, for a resize grip
# h: the window's height, for a resize grip
rec Grab {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

# a window declaration with no size bounds and no flags
# ---
# title: titlebar text, and the window's key
# x:     left it first opens at, in screen pixels
# y:     top it first opens at, in screen pixels
# w:     width it first opens with
# h:     height it first opens with, titlebar included
# ret:   the declaration
pub fun window(title: str, x: f32, y: f32, w: f32, h: f32) Window {
    ret Window{
        title: title, x: x, y: y, w: w, h: h,
        min_w: 0.0::f32, min_h: 0.0::f32, max_w: 0.0::f32, max_h: 0.0::f32, flags: 0
    };
}

# the state a window keeps in the context's store under its id
#
# zeroed, it is a window that has not opened yet: open, expanded, unpinned and
# unlocked. persist_windows makes it saved and loaded with the rest of the
# store. reach it with window_state to open, close, pin or lock a window.
# ---
# x:         window left in screen pixels
# y:         window top in screen pixels
# w:         window width in pixels
# h:         window height in pixels, titlebar included
# z:         place in the window stack, higher in front (see context.raise)
# placed:    1 once the window took its first rect, else 0
# closed:    1 once the close button or the caller closed it, else 0
# collapsed: 1 if only the titlebar shows, else 0
# pinned:    1 to keep the window above every unpinned window, else 0
# locked:    1 to keep the window from moving or resizing, else 0
pub rec WindowState {
    x:         f32;
    y:         f32;
    w:         f32;
    h:         f32;
    z:         u64;
    placed:    u8;
    closed:    u8;
    collapsed: u8;
    pinned:    u8;
    locked:    u8;
}

# the handle begin_window returns for end_window
# ---
# id:     the window's id
# st:     the window's state, valid until end
# flags:  the WINDOW_* flags declared
# shown:  1 if the window is drawn this frame, 0 while it is closed
# body:   1 if its body takes widgets this frame, 0 while closed or collapsed
# th:     titlebar height, 0 without one
# ch:     the channels the body's background and children draw in
# claim:  the window's reserved claim, beneath everything in it
# scroll: the scroll region the body is laid out in, unless auto-sized
# sc:     the body's scroll state
# ox:     the caller's layout origin x, restored by end_window
# oy:     the caller's layout origin y
# cx:     the caller's layout cursor x
# cy:     the caller's layout cursor y
# pw:     the caller's layout width
pub rec WindowArea {
    id:     u64;
    st:     *WindowState;
    flags:  u32;
    shown:  u8;
    body:   u8;
    th:     f32;
    ch:     context.Channels;
    claim:  usize;
    scroll: ScrollArea;
    sc:     *Scroll;
    ox:     f32;
    oy:     f32;
    cx:     f32;
    cy:     f32;
    pw:     f32;
}

# the state of the window titled or keyed key in the current id scope
#
# set closed to 0 to reopen a window, or pinned and locked to pin or lock one.
# ---
# ctx: context
# key: the window's title or key
# ret: its state, valid until end
pub fun window_state(ctx: *context.Context, key: str) *WindowState {
    ret state.get[WindowState](ctx, context.id_of(ctx, key));
}

# save and load every window's place, size, open and collapsed state, stack
# order, pin and lock with the context's store (see blit.state.save and load)
#
# windows are saved as [window.<id>] tables.
# ---
# ctx: context
# ret: ok, or the registry's refusal
pub fun persist_windows(ctx: *context.Context) err[state.Error] {
    ret state.register[WindowState](ctx, "window", window_save, window_load);
}

# write a window's state into its table
fun window_save(st: *WindowState, w: *state.Writer) {
    state.put_float(w, "x", st.x::f64);
    state.put_float(w, "y", st.y::f64);
    state.put_float(w, "w", st.w::f64);
    state.put_float(w, "h", st.h::f64);
    state.put_int(w, "z", st.z::i64);
    state.put_bool(w, "closed", st.closed);
    state.put_bool(w, "collapsed", st.collapsed);
    state.put_bool(w, "pinned", st.pinned);
    state.put_bool(w, "locked", st.locked);
}

# read a window's state from its table, placed once it holds a rect
fun window_load(st: *WindowState, t: *toml.Table) {
    val x: opt[f64]  = toml.get_float(t, "x");
    val y: opt[f64]  = toml.get_float(t, "y");
    val w: opt[f64]  = toml.get_float(t, "w");
    val h: opt[f64]  = toml.get_float(t, "h");
    val z: opt[i64]  = toml.get_int(t, "z");
    val c: opt[bool] = toml.get_bool(t, "closed");
    val f: opt[bool] = toml.get_bool(t, "collapsed");
    val p: opt[bool] = toml.get_bool(t, "pinned");
    val l: opt[bool] = toml.get_bool(t, "locked");
    if (sel x.some) {
        if (sel y.some) {
            if (sel w.some) {
                if (sel h.some) {
                    st.x      = x.some::f32;
                    st.y      = y.some::f32;
                    st.w      = w.some::f32;
                    st.h      = h.some::f32;
                    st.placed = 1;
                }
            }
        }
    }
    if (sel z.some) {
        if (z.some > 0) { st.z = z.some::u64; }
    }
    if (sel c.some) { st.closed = c.some; }
    if (sel f.some) { st.collapsed = f.some; }
    if (sel p.some) { st.pinned = p.some; }
    if (sel l.some) { st.locked = l.some; }
}

# a window's slot in the windows band
fun window_slot(st: *WindowState) u32 {
    var s: u64 = st.z;
    if (st.pinned != 0)         { s = s + PIN_SLOT; }
    if (s > band.SLOT_MAX::u64) { s = band.SLOT_MAX::u64; }
    ret s::u32;
}

# the id of a window's resize grip moving the edges in mask
fun grip_id(id: u64, mask: u32) u64 {
    ret bid.child_int(bid.child(id, "#grip"), mask::u64);
}

# the pointer shape over a grip moving the edges in mask
fun grip_cursor(mask: u32) u8 {
    if (mask == EDGE_L || mask == EDGE_R)                       { ret input.CURSOR_RESIZE_EW; }
    if (mask == EDGE_T || mask == EDGE_B)                       { ret input.CURSOR_RESIZE_NS; }
    if (mask == (EDGE_L | EDGE_T) || mask == (EDGE_R | EDGE_B)) { ret input.CURSOR_RESIZE_NWSE; }
    ret input.CURSOR_RESIZE_NESW;
}

# a size bound declared as 0 for none, as a bound
fun bound(v: f32) f32 {
    if (v > 0.0::f32) { ret v; }
    ret 1.0e30::f32;
}

# whether a window's grips move it vertically: not while its height follows
# its content
fun grip_allowed(flags: u32, mask: u32) bool {
    if ((flags & WINDOW_AUTO_SIZE) != 0 && (mask & (EDGE_T | EDGE_B)) != 0) { ret false; }
    ret true;
}

# draw a window's chrome and, when open and expanded, start its body column
#
# a window is identified by its title's id (see context.id_of), and keeps its
# place, size, stack order and open and collapsed state under it in the
# context's store, so reordering the calls never moves or restacks it. it
# opens at the declared rect, in front of every other window.
#
# windows paint and take input in the windows band (see blit.band), stacked by
# the z order the context keeps: a press anywhere on a window brings it to the
# front, whatever order the windows are called in, and pinned windows stay
# above unpinned ones. its whole rect stops input to what it covers.
#
# the titlebar drags the window and holds a collapse box on the left and a
# close button on the right. grips along every edge and corner resize it
# within its size bounds, asking for the matching resize cursor. a locked
# window neither moves nor resizes. the body is a scroll region below the
# titlebar, or with WINDOW_AUTO_SIZE a column the window's height follows.
# widgets placed while the returned body is 1 fill it, in screen pixels. the
# window is an id scope for them. pair every begin_window with an end_window,
# closed or not.
# ---
# ctx: context
# win: what the call declares about the window
# ret: a handle for end_window
pub fun begin_window(ctx: *context.Context, win: Window) WindowArea {
    var r: WindowArea;
    r.claim = context.NO_CLAIM;
    r.ox    = ctx.ox;
    r.oy    = ctx.oy;
    r.cx    = ctx.cx;
    r.cy    = ctx.cy;
    r.pw    = ctx.pw;
    r.flags = win.flags;
    r.id    = context.id_of(ctx, win.title);

    val st: *WindowState = state.get[WindowState](ctx, r.id);
    r.st = st;
    if (st.placed == 0) {
        st.x      = win.x;
        st.y      = win.y;
        st.w      = win.w;
        st.h      = win.h;
        st.z      = context.raise(ctx);
        st.placed = 1;
    }
    context.track_z(ctx, ?st.z);
    if (st.closed != 0) { ret r; }
    r.shown = 1;

    var th: f32 = row_h(ctx);
    if ((win.flags & WINDOW_NO_TITLE) != 0) { th = 0.0::f32; }
    r.th = th;
    val min_w: f32 = maxf(win.min_w, th * 3.0::f32);
    val min_h: f32 = maxf(win.min_h, th);
    val max_w: f32 = maxf(bound(win.max_w), min_w);
    val max_h: f32 = maxf(bound(win.max_h), min_h);

    # a press on the window's own layer brings it to the front this frame
    if (input.pressed(ctx.in, input.BUTTON_LEFT) != 0 && ctx.hover != 0
        && context.hovered_layer(ctx) == band.layer(band.WINDOWS, window_slot(st))) {
        st.z = context.raise(ctx);
    }
    context.push_band(ctx, band.WINDOWS, window_slot(st));
    context.push_id(ctx, r.id);

    val drag_id:  u64 = bid.child(r.id, "#drag");
    val col_id:   u64 = bid.child(r.id, "#collapse");
    val close_id: u64 = bid.child(r.id, "#close");
    val movable:  u8  = ((win.flags & WINDOW_NO_MOVE) == 0 && st.locked == 0);
    val sizable:  u8  = ((win.flags & WINDOW_NO_RESIZE) == 0 && st.locked == 0);

    # follow a drag or a resize from where the window stood at the press,
    # before claiming, so the claims match where the window paints
    var dx: f32;
    var dy: f32;
    if (movable != 0 && interact.drag(ctx, drag_id, ?dx, ?dy)) {
        val grab: *Grab = state.get[Grab](ctx, drag_id);
        st.x = grab.x + dx;
        st.y = grab.y + dy;
    }
    var g: usize = 0;
    for (sizable != 0 && g < 8) {
        val m:   u32 = GRIPS[g];
        val gid: u64 = grip_id(r.id, m);
        if (interact.drag(ctx, gid, ?dx, ?dy)) {
            val grab: *Grab = state.get[Grab](ctx, gid);
            if ((m & EDGE_L) != 0) {
                st.w = clampf(grab.w - dx, min_w, max_w);
                st.x = grab.x + grab.w - st.w;
            }
            if ((m & EDGE_R) != 0) { st.w = clampf(grab.w + dx, min_w, max_w); }
            if ((m & EDGE_T) != 0) {
                st.h = clampf(grab.h - dy, min_h, max_h);
                st.y = grab.y + grab.h - st.h;
            }
            if ((m & EDGE_B) != 0) { st.h = clampf(grab.h + dy, min_h, max_h); }
        }
        g = g + 1;
    }
    st.w = clampf(st.w, min_w, max_w);
    if ((win.flags & WINDOW_AUTO_SIZE) == 0) { st.h = clampf(st.h, min_h, max_h); }

    r.claim = context.reserve_claim(ctx, r.id);

    val x0: f32 = st.x;
    val x1: f32 = st.x + st.w;
    val y0: f32 = st.y;
    if (th > 0.0::f32) {
        val ty1:   f32 = y0 + th;
        var dx1:   f32 = x1;
        val close: u8  = (win.flags & WINDOW_NO_CLOSE) == 0;
        if (close != 0) { dx1 = x1 - th; }

        val hc: interact.Hit = interact.hit(ctx, col_id, x0, y0, x0 + th, ty1, input.BUTTON_LEFT);
        hand(ctx, hc);
        if (hc.clicked) {
            if (st.collapsed == 0) { st.collapsed = 1; }
            or                     { st.collapsed = 0; }
        }

        var hx: interact.Hit;
        if (close != 0) {
            hx = interact.hit(ctx, close_id, dx1, y0, x1, ty1, input.BUTTON_LEFT);
            hand(ctx, hx);
            if (hx.clicked) { st.closed = 1; }
        }

        val hd: interact.Hit = interact.hit(ctx, drag_id, x0 + th, y0, dx1, ty1, input.BUTTON_LEFT);
        if (movable != 0) {
            if (hd.pressed) {
                val grab: *Grab = state.get[Grab](ctx, drag_id);
                grab.x = st.x;
                grab.y = st.y;
            }
            if (hd.hot || hd.active) { context.set_cursor(ctx, input.CURSOR_MOVE); }
        }

        var tbg: draw.Color = ctx.theme.header;
        if (hd.hot || hc.hot || hx.hot) { tbg = ctx.theme.header_hot; }
        var ends: u8 = context.CORNERS_ALL;
        if (st.collapsed == 0) { ends = context.CORNERS_TOP; }
        context.fill(ctx, x0, y0, x1, ty1, corner(ctx), ends, tbg);

        val gy:  f32 = y0 + (th - context.line_height(ctx)) / 2.0::f32;
        var gch: u32 = '+';
        if (st.collapsed == 0) { gch = '-'; }
        context.glyph(ctx, gch, x0 + pad(ctx), gy, ctx.theme.text_dim);
        label_at(ctx, win.title, x0 + th + pad(ctx), gy, ctx.theme.text);
        if (close != 0) {
            var xc: draw.Color = ctx.theme.text_dim;
            if (hx.hot) { xc = ctx.theme.text; }
            context.glyph(ctx, 'x', dx1 + pad(ctx), gy, xc);
        }
    }
    if (st.collapsed != 0 && th > 0.0::f32) { ret r; }

    r.body = 1;
    r.ch   = context.split(ctx, 2);
    context.set_channel(ctx, r.ch, 1);
    ctx.ox = x0;
    ctx.oy = y0 + th;
    ctx.cx = x0;
    ctx.cy = y0 + th;
    ctx.pw = st.w;
    if ((win.flags & WINDOW_AUTO_SIZE) == 0) {
        val body_id: u64 = bid.child(r.id, "#body");
        r.sc     = state.get[Scroll](ctx, body_id);
        r.scroll = scroll_open(ctx, body_id, r.sc, st.h - th, 0);
    }
    ret r;
}

# close a window: paint its body beneath its widgets, give its claim its rect
# (the titlebar alone while collapsed), claim its resize grips above
# everything in it and restore the caller's layout
#
# an auto-sized window takes the height its widgets reached.
# ---
# ctx: context
# r:   the value returned by begin_window
pub fun end_window(ctx: *context.Context, r: WindowArea) {
    if (r.shown == 0) { ret; }
    val st: *WindowState = r.st;
    val x0: f32          = st.x;
    val x1: f32          = st.x + st.w;
    val y0: f32          = st.y;
    var y1: f32          = st.y + r.th;
    if (r.body != 0) {
        if ((r.flags & WINDOW_AUTO_SIZE) != 0) {
            y1   = maxf(ctx.cy + pad(ctx), y0 + r.th);
            st.h = y1 - y0;
        }
        or {
            end_scroll(ctx, r.sc, r.scroll);
            y1 = y0 + st.h;
        }
        context.set_channel(ctx, r.ch, 0);
        if ((r.flags & WINDOW_NO_BACKGROUND) == 0) {
            var ends: u8 = context.CORNERS_BOTTOM;
            if (r.th == 0.0::f32) { ends = context.CORNERS_ALL; }
            context.fill(ctx, x0, y0 + r.th, x1, y1, corner(ctx), ends, ctx.theme.window);
        }
        context.merge(ctx, r.ch);
    }
    context.fill_claim(ctx, r.claim, x0, y0, x1, y1);

    # the grips run just outside the edges, so they never cover the window's
    # own widgets, and meet in squares at the corners
    if (r.body != 0 && (r.flags & WINDOW_NO_RESIZE) == 0 && st.locked == 0) {
        val g: f32   = pad(ctx);
        var k: usize = 0;
        for (k < 8) {
            val m: u32 = GRIPS[k];
            if (grip_allowed(r.flags, m)) {
                var gx0: f32 = x0;
                var gx1: f32 = x1;
                var gy0: f32 = y0;
                var gy1: f32 = y1;
                if ((m & EDGE_L) != 0) {
                    gx0 = x0 - g;
                    gx1 = x0;
                }
                if ((m & EDGE_R) != 0) {
                    gx0 = x1;
                    gx1 = x1 + g;
                }
                if ((m & EDGE_T) != 0) {
                    gy0 = y0 - g;
                    gy1 = y0;
                }
                if ((m & EDGE_B) != 0) {
                    gy0 = y1;
                    gy1 = y1 + g;
                }
                val gid: u64          = grip_id(r.id, m);
                val gh:  interact.Hit = interact.hit(ctx, gid, gx0, gy0, gx1, gy1, input.BUTTON_LEFT);
                if (gh.pressed) {
                    val grab: *Grab = state.get[Grab](ctx, gid);
                    grab.x = x0;
                    grab.y = y0;
                    grab.w = x1 - x0;
                    grab.h = y1 - y0;
                }
                if (gh.hot || gh.active) { context.set_cursor(ctx, grip_cursor(m)); }
            }
            k = k + 1;
        }
    }

    context.pop_id(ctx);
    context.pop_band(ctx);
    ctx.ox = r.ox;
    ctx.oy = r.oy;
    ctx.cx = r.cx;
    ctx.cy = r.cy;
    ctx.pw = r.pw;
}

# consumer-owned state of a scroll region, kept across frames
# ---
# offset:  content scrolled out above the region, in pixels
# content: content height measured when the region last ended, in pixels
pub rec Scroll {
    offset:  f32;
    content: f32;
}

# the handle begin_scroll returns for end_scroll
# ---
# id:    the region's id, which its empty area claims
# thumb: the scrollbar thumb's id
# scope: 1 if the region opened an id scope of its own, else 0
# seen:  the context's hover_seen when the region opened
# claim: the region's reserved claim
# surf:  the clipped, scrolled surface the content is laid out in
# x:     region left in the parent's local pixels
# y:     region top in the parent's local pixels
# w:     region width in pixels
# h:     region height in pixels
# ox:    the parent layout's origin x, restored by end_scroll
# oy:    the parent layout's origin y
# cx:    the parent layout's cursor x
# cy:    the parent layout's cursor y
# pw:    the parent layout's width
pub rec ScrollArea {
    id:    u64;
    thumb: u64;
    scope: u8;
    seen:  u64;
    claim: usize;
    surf:  context.Surface;
    x:     f32;
    y:     f32;
    w:     f32;
    h:     f32;
    ox:    f32;
    oy:    f32;
    cx:    f32;
    cy:    f32;
    pw:    f32;
}

# the most a region of height h can scroll over content of height content
fun scroll_most(content: f32, h: f32) f32 {
    ret maxf(content - h, 0.0::f32);
}

# open a scroll region h tall at the layout cursor, spanning the column
#
# widgets placed until end_scroll lay out in a column inside it, clipped to
# it and shifted up by s.offset. when the content measured last frame is
# taller than the region, the column narrows to leave room for a scrollbar.
# the region's empty area claims input beneath its widgets, which is how the
# wheel finds it. the region is an id scope for its widgets. pair every
# begin_scroll with an end_scroll.
# ---
# ctx: context
# key: the region's key in the current id scope
# s:   the region's state, clamped to its content here
# h:   region height in pixels
# ret: a handle for end_scroll
pub fun begin_scroll(ctx: *context.Context, key: str, s: *Scroll, h: f32) ScrollArea {
    ret scroll_at(ctx, context.id_of(ctx, key), s, h);
}

# begin_scroll for a region whose id is already known
fun scroll_at(ctx: *context.Context, id: u64, s: *Scroll, h: f32) ScrollArea {
    ret scroll_open(ctx, id, s, h, 1);
}

# open a scroll region, in an id scope of its own when scope is 1, else in
# its container's, as a window's body is
fun scroll_open(ctx: *context.Context, id: u64, s: *Scroll, h: f32, scope: u8) ScrollArea {
    var r: ScrollArea;
    r.id    = id;
    r.scope = scope;
    r.thumb = bid.child(id, "#thumb");
    r.seen  = ctx.hover_seen;
    r.x     = ctx.cx;
    r.y     = ctx.cy;
    r.w     = ctx.pw;
    r.h     = maxf(h, 0.0::f32);
    r.ox    = ctx.ox;
    r.oy    = ctx.oy;
    r.cx    = ctx.cx;
    r.cy    = ctx.cy;
    r.pw    = ctx.pw;

    r.claim = context.reserve_claim(ctx, r.id);
    context.fill_claim(ctx, r.claim, r.x, r.y, r.x + r.w, r.y + r.h);
    if (scope != 0) { context.push_id(ctx, r.id); }

    s.offset = clampf(s.offset, 0.0::f32, scroll_most(s.content, r.h));
    r.surf   = context.begin_surface(ctx, r.x, r.y, r.w, r.h, 0.0::f32, s.offset);

    ctx.ox = 0.0::f32;
    ctx.oy = 0.0::f32;
    ctx.cx = 0.0::f32;
    ctx.cy = 0.0::f32;
    ctx.pw = r.w;
    if (s.content > r.h) { ctx.pw = maxf(r.w - context.px(ctx, ctx.theme.bar_w) - pad(ctx), 0.0::f32); }
    ret r;
}

# close a scroll region: measure its content, take the wheel, draw and drag
# its scrollbar, restore the parent layout and advance past the region
#
# the wheel goes to the innermost region holding the topmost claim under the
# cursor, so a region under a popup or a window does not scroll, and a region
# nested in another scrolls before its parent. scrolling applies from the next
# frame, like all input.
# ---
# ctx: context
# s:   the region's state, updated with its content, the wheel and any drag
# r:   the value returned by begin_scroll
pub fun end_scroll(ctx: *context.Context, s: *Scroll, r: ScrollArea) {
    if (r.scope != 0) { context.pop_id(ctx); }
    s.content = ctx.cy;
    context.end_surface(ctx, r.surf);
    ctx.ox = r.ox;
    ctx.oy = r.oy;
    ctx.cx = r.cx;
    ctx.cy = r.cy;
    ctx.pw = r.pw;

    # the hovered widget claimed inside this region, or the region itself
    if (ctx.wheel_taken == 0 && ctx.in.wheel != 0.0::f32 && ctx.hover_seen > r.seen) {
        s.offset        = s.offset - ctx.in.wheel;
        ctx.wheel_taken = 1;
    }
    val most: f32 = scroll_most(s.content, r.h);
    s.offset = clampf(s.offset, 0.0::f32, most);

    if (most > 0.0::f32) {
        val tx0:     f32   = r.x + r.w - context.px(ctx, ctx.theme.bar_w);
        val tx1:     f32   = r.x + r.w;
        val thumb_h: f32   = clampf(r.h * r.h / s.content, context.px(ctx, ctx.theme.thumb_min), r.h);
        val travel:  f32   = r.h - thumb_h;
        val grab:    *Grab = state.get[Grab](ctx, r.thumb);
        var dx:      f32;
        var dy:      f32;

        if (interact.drag(ctx, r.thumb, ?dx, ?dy) && travel > 0.0::f32) {
            s.offset = clampf(grab.y + dy * most / travel, 0.0::f32, most);
        }
        val ty: f32          = r.y + travel * s.offset / most;
        val ht: interact.Hit = interact.hit(ctx, r.thumb, tx0, ty, tx1, ty + thumb_h, input.BUTTON_LEFT);
        if (ht.pressed) { grab.y = s.offset; }

        var tc: draw.Color = ctx.theme.handle;
        if (ht.active) { tc = ctx.theme.handle_on; }
        face(ctx, tx0, r.y, tx1, r.y + r.h, ctx.theme.track);
        face(ctx, tx0, ty, tx1, ty + thumb_h, tc);
    }

    advance(ctx, r.h);
}

# a collapsible heading across the column that toggles @open when clicked
#
# the rows that belong to the section are the caller's to place, and only
# while this returns true.
# ---
# ctx:   context
# title: heading text, and its key
# open:  pointer to the 0/1 open state, updated in place
# ret:   true while the section is open
pub fun section(ctx: *context.Context, title: str, open: *u8) bool {
    val id: u64 = context.id_of(ctx, title);
    val x0: f32 = ctx.cx;
    val y0: f32 = ctx.cy;
    val h:  f32 = row_h(ctx);
    val x1: f32 = ctx.cx + ctx.pw;
    val y1: f32 = y0 + h;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, hs);
    if (hs.clicked) {
        if (@open == 0) { @open = 1; }
        or              { @open = 0; }
    }

    var bg:  draw.Color = ctx.theme.header;
    var ink: draw.Color = ctx.theme.text_dim;
    if (hs.hot) {
        bg  = ctx.theme.header_hot;
        ink = ctx.theme.text;
    }
    face(ctx, x0, y0, x1, y1, bg);

    val lh: f32 = context.line_height(ctx);
    val gy: f32 = y0 + (h - lh) / 2.0::f32;
    caret(ctx, x0 + pad(ctx), gy, lh, @open != 0, ink);
    label_at(ctx, title, x0 + pad(ctx) * 2.0::f32 + lh, gy, ctx.theme.text);

    advance(ctx, h);
    ret @open != 0;
}

# a caret filling the k-pixel square at (x, y), pointing right when closed
# and down when open
#
# the triangle is one quad per pixel row, like a rounded corner, so it needs
# nothing of the renderer and clips like any quad.
# ---
# ctx:  context
# x:    square left in local pixels
# y:    square top in local pixels
# k:    square side in pixels
# open: true to point down
# c:    fill color
fun caret(ctx: *context.Context, x: f32, y: f32, k: f32, open: bool, c: draw.Color) {
    if (k <= 0.0::f32) { ret; }
    # closed: a vertical edge k tall at the quarter, its tip half as far right.
    # open:   a horizontal edge k wide at the quarter, its tip half as far down.
    val depth: f32 = k / 2.0::f32;
    val edge:  f32 = k / 4.0::f32;
    var span:  f32 = k;
    if (open) { span = depth; }
    var rows: usize = span::usize;
    if (rows::f32 < span) { rows = rows + 1; }
    var r: usize = 0;
    for (r < rows) {
        val a: f32 = r::f32;
        val b: f32 = minf(a + 1.0::f32, span);
        val t: f32 = (a + b) / 2.0::f32 / span;
        if (open) {
            val half: f32 = k * (1.0::f32 - t) / 2.0::f32;
            context.quad(ctx, x + k / 2.0::f32 - half, y + edge + a, x + k / 2.0::f32 + half, y + edge + b, c);
        }
        or {
            var off: f32 = t - 0.5::f32;
            if (off < 0.0::f32) { off = 0.0::f32 - off; }
            val len: f32 = depth * (1.0::f32 - off * 2.0::f32);
            context.quad(ctx, x + edge, y + a, x + edge + len, y + b, c);
        }
        r = r + 1;
    }
}

# consumer-owned state of a panel docked to a screen edge
# ---
# side:   the edge the dock attaches to
# size:   width (left, right) or height (top, bottom) in pixels
# scroll: the dock body's scroll state
pub rec Dock {
    side:   context.Side;
    size:   f32;
    scroll: Scroll;
}

# the handle begin_dock returns for end_dock
# ---
# area:  the dock's rect in screen pixels
# claim: the dock's claim, beneath its widgets
# body:  the scroll region the dock's widgets are laid out in
# ox:    the parent layout's origin x, restored by end_dock
# oy:    the parent layout's origin y
# cx:    the parent layout's cursor x
# cy:    the parent layout's cursor y
# pw:    the parent layout's width
pub rec DockArea {
    area:  context.Area;
    claim: usize;
    body:  ScrollArea;
    ox:    f32;
    oy:    f32;
    cx:    f32;
    cy:    f32;
    pw:    f32;
}

# dock a panel to a screen edge and start its scrolling body column
#
# the dock takes a strip of the free area (see context.carve), so docks
# opened in turn stack inward and context.free_area reports what they leave
# for the rest of the screen. it paints and takes input in the docked band,
# above the base content and beneath windows (see blit.band). its whole rect
# stops input to what it covers, and its body scrolls when its widgets are
# taller than it. call it at the root, outside surfaces and bands, and pair it
# with end_dock. its body is the id scope of the dock's key, so a label path
# through the dock is "<key>/<label>".
# ---
# ctx: context
# key: the dock's key in the current id scope
# d:   the dock's state
# ret: a handle for end_dock
pub fun begin_dock(ctx: *context.Context, key: str, d: *Dock) DockArea {
    var r: DockArea;
    r.ox = ctx.ox;
    r.oy = ctx.oy;
    r.cx = ctx.cx;
    r.cy = ctx.cy;
    r.pw = ctx.pw;
    context.push_band(ctx, band.DOCKED, 0);
    r.area = context.carve(ctx, d.side, d.size);

    val a: context.Area = r.area;
    r.claim = context.reserve_claim(ctx, 0);
    context.fill_claim(ctx, r.claim, a.x0, a.y0, a.x1, a.y1);

    val ew: f32        = context.px(ctx, ctx.theme.edge_w);
    val ec: draw.Color = ctx.theme.edge;
    context.quad(ctx, a.x0, a.y0, a.x1, a.y1, ctx.theme.dock);
    if (sel d.side.left)  { context.quad(ctx, a.x1 - ew, a.y0, a.x1, a.y1, ec); }
    or (sel d.side.right) { context.quad(ctx, a.x0, a.y0, a.x0 + ew, a.y1, ec); }
    or (sel d.side.top)   { context.quad(ctx, a.x0, a.y1 - ew, a.x1, a.y1, ec); }
    or                    { context.quad(ctx, a.x0, a.y0, a.x1, a.y0 + ew, ec); }

    val in: f32 = pad(ctx);
    ctx.ox = a.x0 + in;
    ctx.oy = a.y0 + in;
    ctx.cx = ctx.ox;
    ctx.cy = ctx.oy;
    ctx.pw = maxf(a.x1 - a.x0 - in * 2.0::f32, 0.0::f32);
    r.body = scroll_at(ctx, context.id_of(ctx, key), ?d.scroll, a.y1 - a.y0 - in * 2.0::f32);
    ret r;
}

# close a dock: end its body and restore the parent layout
# ---
# ctx: context
# d:   the dock's state
# r:   the value returned by begin_dock
pub fun end_dock(ctx: *context.Context, d: *Dock, r: DockArea) {
    end_scroll(ctx, ?d.scroll, r.body);
    context.pop_band(ctx);
    ctx.ox = r.ox;
    ctx.oy = r.oy;
    ctx.cx = r.cx;
    ctx.cy = r.cy;
    ctx.pw = r.pw;
}

# consumer-owned state of a list, kept across frames
# ---
# selected: index of the selected item, at least the item count for none
# scroll:   the list's scroll state
pub rec List {
    selected: usize;
    scroll:   Scroll;
}

# an ascii letter folded to lower case, any other byte unchanged
fun fold(b: u8) u8 {
    if (b >= 'A' && b <= 'Z') { ret b + 32; }
    ret b;
}

# whether s holds query, ignoring ascii case; an empty or nil query matches all
fun matches(s: str, query: str) bool {
    if (query == nil || query[0] == 0) { ret true; }
    if (s == nil)                      { ret false; }
    var i: usize = 0;
    for (s[i] != 0) {
        var j: usize = 0;
        for (query[j] != 0 && s[i + j] != 0 && fold(s[i + j]) == fold(query[j])) { j = j + 1; }
        if (query[j] == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a scrolling list of items, h pixels tall, one of which can be selected
#
# only the items holding query (ignoring ascii case) are shown, so a search
# box the caller keeps narrows the list. clicking a shown item selects it and
# the selected one is drawn in the accent. the list scrolls by the wheel and a
# scrollbar like any scroll region. an item's id is its index under the
# list's, so an item keeps its hit identity as the query changes. items
# scrolled out of view are skipped rather than emitted.
# ---
# ctx:   context
# key:   the list's key in the current id scope
# l:     the list's state
# items: pointer to an array of count item strings (pass ?items[0])
# count: number of items
# query: text an item must hold to be shown, nil or empty for all
# h:     list height in pixels
# ret:   true if the selection changed this frame
pub fun list(ctx: *context.Context, key: str, l: *List, items: *str, count: usize, query: str, h: f32) bool {
    val r:       ScrollArea = begin_scroll(ctx, key, ?l.scroll, h);
    val rh:      f32        = row_h(ctx);
    val top:     f32        = l.scroll.offset;
    var changed: bool       = false;
    var i:       usize      = 0;
    for (i < count) {
        val id: u64 = bid.child_int(r.id, i::u64);
        if (matches(items[i], query)) {
            val x0: f32 = ctx.cx;
            val y0: f32 = ctx.cy;
            val x1: f32 = ctx.cx + ctx.pw;
            val y1: f32 = y0 + rh;
            if (y1 > top && y0 < top + r.h) {
                val hi: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, input.BUTTON_LEFT);
                if (hi.clicked && l.selected != i) {
                    l.selected = i;
                    changed    = true;
                }

                var ink: draw.Color = ctx.theme.text;
                if (l.selected == i) {
                    face(ctx, x0, y0, x1, y1, ctx.theme.accent);
                    ink = ctx.theme.accent_text;
                }
                or (hi.active) { face(ctx, x0, y0, x1, y1, ctx.theme.control_on); }
                or (hi.hot)    { face(ctx, x0, y0, x1, y1, ctx.theme.control_hot); }
                val ty: f32 = y0 + (rh - context.line_height(ctx)) / 2.0::f32;
                context.text_at(ctx, items[i], x0 + pad(ctx), ty, ink);
            }
            advance(ctx, rh);
        }
        i = i + 1;
    }
    end_scroll(ctx, ?l.scroll, r);
    ret changed;
}

# one frame's input with the cursor at (mx, my) and the button in state down
#[testing]
fun input_at(mx: f32, my: f32, down: u8) input.Input {
    var in: input.Input;
    in.mx      = mx;
    in.my      = my;
    in.present = 1;
    in.down    = down;
    ret in;
}

# a frame holding one panel with one button
#[testing]
fun frame_button(ctx: *context.Context, in: input.Input) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, "ok");
    end_panel(ctx, p);
    context.end(ctx);
    ret clicked;
}

# whether the context asks for a frame now
#[testing]
fun asks_now(ctx: *context.Context) bool {
    val nf: opt[f64] = context.next_frame(ctx);
    ret sel nf.some && nf.some == 0.0::f64;
}

test button__clicks_on_presses_and_releases_between_frames {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    val id: u64 = context.id_of(?ctx, "ok");

    var in: input.Input = input_at(10.0::f32, 5.0::f32, 0);
    input.init(?in, ?a);
    frame_button(?ctx, in);

    # a press and release on the button, the cursor gone by the frame: a
    # press, then a release that clicks where it happened
    in.mx = 500.0::f32;
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.release_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 2; }
    if (!asks_now(?ctx))                                     { ret 3; }
    input.clear_keys(?in);
    if (frame_button(?ctx, in) != true) { ret 4; }
    if (!asks_now(?ctx))                { ret 5; }
    frame_button(?ctx, in);
    if (asks_now(?ctx) || ctx.in.mx != 500.0::f32) { ret 6; }

    # press, release, press: a click, then the button held
    in.mx = 10.0::f32;
    frame_button(?ctx, in);
    in.down = input.BUTTON_LEFT;
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.release_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 7; }
    input.clear_keys(?in);
    if (frame_button(?ctx, in) != true)                      { ret 8; }
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 9; }
    if (input.pressed(ctx.in, input.BUTTON_LEFT) != 1)       { ret 10; }
    if (asks_now(?ctx))                                      { ret 11; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# whether the dropdown with header id is open
#[testing]
fun dropdown_open(ctx: *context.Context, id: u64) u8 {
    ret state.get[DropdownState](ctx, id).open;
}

# open or close the dropdown with header id
#[testing]
fun set_dropdown_open(ctx: *context.Context, id: u64, open: u8) {
    val st: *DropdownState = state.get[DropdownState](ctx, id);
    st.open = open;
}

# what the probe panel's widgets reported, across frames
# ---
# clicks: times the ok button clicked
# on:     the checkbox's state
# flip:   the toggle's state
# flips:  times the toggle flipped
# choice: the segmented choice
# chosen: times the segmented choice changed
# v:      the slider's value, in [0, 10]
# pick:   the dropdown's selection
# picked: times the dropdown's selection changed
#[testing]
rec Probe {
    clicks: usize;
    on:     u8;
    flip:   u8;
    flips:  usize;
    choice: usize;
    chosen: usize;
    v:      f32;
    pick:   usize;
    picked: usize;
}

# a 100 pixel panel of one of each control, the dropdown last so its options
# cover nothing
#[testing]
fun probe_ui(ctx: *context.Context, user: ptr) {
    val p:    *Probe = user::*Probe;
    var segs: [3]str;
    segs[0] = "a";
    segs[1] = "b";
    segs[2] = "c";
    var opts: [3]str;
    opts[0] = "one";
    opts[1] = "two";
    opts[2] = "three";
    val b: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    if (button(ctx, "ok")) { p.clicks = p.clicks + 1; }
    checkbox(ctx, "on", ?p.on);
    if (toggle(ctx, "flip", ?p.flip))           { p.flips = p.flips + 1; }
    if (segmented(ctx, ?segs[0], 3, ?p.choice)) { p.chosen = p.chosen + 1; }
    slider_f(ctx, "x", ?p.v, 0.0::f32, 10.0::f32);
    if (dropdown(ctx, "pick", ?p.pick, ?opts[0], 3) != 0) { p.picked = p.picked + 1; }
    end_panel(ctx, b);
}

# a driver over the probe panel on a 200 pixel screen, laid out once
#[testing]
fun probe(d: *driver.Driver, a: *allo.Allocator, p: *Probe) u8 {
    val e: err[allo.Error] = driver.init(d, a, 200.0::f32, 200.0::f32, probe_ui, p::ptr);
    if (sel e.err) { ret 0; }
    driver.step(d);
    ret 1;
}

test button__clicks_on_release_inside_after_press {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # pressed it is active, and it clicks on the release
    val ok: u64 = driver.find(?d, "ok");
    if (!str_equals(driver.text_of(?d, ok), "ok")) { ret 2; }
    driver.hover(?d, ok);
    driver.press(?d, input.BUTTON_LEFT);
    if (p.clicks != 0 || !driver.active(?d, ok)) { ret 3; }
    driver.release(?d, input.BUTTON_LEFT);
    if (p.clicks != 1) { ret 4; }

    # a release outside after a press inside is no click
    driver.hover(?d, ok);
    driver.press(?d, input.BUTTON_LEFT);
    driver.move(?d, 150.0::f32, 150.0::f32);
    driver.release(?d, input.BUTTON_LEFT);
    if (p.clicks != 1 || driver.active(?d, ok)) { ret 5; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test checkbox__and_toggle_flip_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    driver.click(?d, driver.find(?d, "on"));
    if (p.on != 1) { ret 2; }
    val flip: u64 = driver.find(?d, "flip");
    driver.click(?d, flip);
    if (p.flip != 1 || p.flips != 1) { ret 3; }

    # a press dragged off the row and released there does not flip it back
    driver.drag(?d, flip, 150.0::f32, 150.0::f32);
    if (p.flip != 1 || p.flips != 1) { ret 4; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test segmented__chooses_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    driver.click(?d, driver.find(?d, "c"));
    if (p.choice != 2 || p.chosen != 1) { ret 2; }
    # choosing the chosen segment again is no change
    driver.click(?d, driver.find(?d, "c"));
    if (p.chosen != 1) { ret 3; }
    # a press on the first released over the second chooses nothing
    driver.drag_onto(?d, driver.find(?d, "a"), driver.find(?d, "b"));
    if (p.choice != 2 || p.chosen != 1) { ret 4; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test slider__maps_cursor_linearly {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # the track spans the panel's width: its left end is lo, its right end hi
    val x: u64               = driver.find(?d, "x");
    val r: opt[context.Area] = driver.rect(?d, x);
    if (sel r.none) { ret 2; }
    val y: f32 = (r.some.y0 + r.some.y1) / 2.0::f32;
    driver.drag(?d, x, r.some.x0, y);
    if (p.v != 0.0::f32) { ret 3; }
    driver.drag(?d, x, (r.some.x0 + r.some.x1) / 2.0::f32, y);
    if (p.v != 5.0::f32) { ret 4; }
    driver.drag(?d, x, r.some.x1 + 50.0::f32, y);
    if (p.v != 10.0::f32) { ret 5; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test dropdown__opens_and_selects {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # the header opens it without changing the selection
    val pick: u64 = driver.find(?d, "pick");
    val two:  u64 = bid.child_int(bid.child(pick, "#popup"), 1);
    if (driver.drawn(?d, two)) { ret 2; }
    driver.click(?d, pick);
    if (p.picked != 0 || dropdown_open(?d.ctx, pick) == 0) { ret 3; }
    if (!str_equals(driver.text_of(?d, two), "two"))       { ret 4; }

    # an option selects and closes it
    driver.click(?d, two);
    if (p.pick != 1 || p.picked != 1)     { ret 5; }
    if (dropdown_open(?d.ctx, pick) != 0) { ret 6; }
    # the frame that chose still drew the options, the next one does not
    driver.step(?d);
    if (driver.drawn(?d, two)) { ret 7; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a dock and a window, each holding a widget a label path names
# ---
# side: the dock, holding "ok" above more than it can show
# win:  the "Settings" window, holding the "name" field
# f:    the field's state
#[testing]
rec Nest {
    side: Dock;
    win:  Window;
    f:    field.Field;
}

#[testing]
fun nest_ui(ctx: *context.Context, user: ptr) {
    val n:  *Nest    = user::*Nest;
    val dk: DockArea = begin_dock(ctx, "side", ?n.side);
    button(ctx, "ok");
    space(ctx, 1000.0::f32);
    end_dock(ctx, ?n.side, dk);
    val b: WindowArea = begin_window(ctx, n.win);
    text_field(ctx, "name", ?n.f, nil);
    end_window(ctx, b);
}

test driver__paths_keys_and_wheel_reach_nested_widgets {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var buf: [64]u8;
    var n:   Nest;
    n.side.side = context.Side.left{};
    n.side.size = 80.0::f32;
    n.win       = auto_window("Settings", 100.0::f32, 10.0::f32, 120.0::f32);
    field.init(?n.f, ?buf[0], 64, 0, nil);
    var d:  driver.Driver;
    val ie: err[allo.Error] = driver.init(?d, ?a, 300.0::f32, 200.0::f32, nest_ui, (?n)::ptr);
    if (sel ie.err) { ret 1; }
    driver.step(?d);

    # a dock's and a window's widgets sit under their keys
    val ok:   u64 = driver.find(?d, "side/ok");
    val name: u64 = driver.find(?d, "Settings/name");
    if (!driver.drawn(?d, ok) || !driver.drawn(?d, name)) { ret 2; }
    val r: opt[context.Area] = driver.rect(?d, name);
    if (sel r.none)                                                            { ret 3; }
    if (r.some.x0 < 100.0::f32)                                                { ret 3; }
    if (driver.at(?d, r.some.x0 + 1.0::f32, r.some.y0 + 1.0::f32) != name)     { ret 4; }
    if (driver.inside(?d, r.some.x0, r.some.y0, r.some.x1, r.some.y1) != name) { ret 5; }
    driver.hover(?d, ok);
    if (!driver.hot(?d, ok) || driver.hot(?d, name)) { ret 6; }

    # a clicked field takes typed text and keys
    driver.click(?d, name);
    if (!driver.focused(?d, name)) { ret 7; }
    driver.type_text(?d, "hey");
    driver.key(?d, input.KEY_BACKSPACE, 0);
    if (!str_equals(field.text(?n.f), "he"))         { ret 8; }
    if (!str_equals(driver.text_of(?d, name), "he")) { ret 9; }

    # the wheel over the dock scrolls its body
    driver.scroll(?d, ok, 0.0::f32, -30.0::f32);
    driver.step(?d);
    if (n.side.scroll.offset != 30.0::f32) { ret 10; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding one panel with one three-option dropdown
#[testing]
fun frame_dropdown(ctx: *context.Context, in: input.Input, picked: *usize, opts: *str) u8 {
