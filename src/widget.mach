}

test segmented__chooses_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # the third segment spans x [69.3, 100)
    var choice: usize = 0;
    frame_segmented(?ctx, input_at(80.0::f32, 8.0::f32, 0), ?choice);
    if (frame_segmented(?ctx, input_at(80.0::f32, 8.0::f32, 1), ?choice) != false) { ret 2; }
    if (ctx.active != context.id_of(?ctx, "c"))                                    { ret 3; }
    if (frame_segmented(?ctx, input_at(80.0::f32, 8.0::f32, 0), ?choice) != true)  { ret 4; }
    if (choice != 2)                                                               { ret 5; }

    # choosing the chosen segment again is no change
    frame_segmented(?ctx, input_at(80.0::f32, 8.0::f32, 1), ?choice);
    if (frame_segmented(?ctx, input_at(80.0::f32, 8.0::f32, 0), ?choice) != false) { ret 6; }

    # a press on the first released over the second chooses nothing
    frame_segmented(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?choice);
    frame_segmented(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?choice);
    frame_segmented(?ctx, input_at(50.0::f32, 8.0::f32, 0), ?choice);
    if (choice != 2) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

