    var f: u8 = 0;
    var s: u8 = 0;
    frame_pair(?ctx, input_at(30.0::f32, 30.0::f32, 0), ?f, ?s);
    frame_pair(?ctx, input_at(30.0::f32, 30.0::f32, 1), ?f, ?s);
    if (ctx.hot != 2) { ret 2; }
    frame_pair(?ctx, input_at(30.0::f32, 30.0::f32, 0), ?f, ?s);
    if (s != 1 || f != 0) { ret 3; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel slider at y [0, 16), then a window whose titlebar
# spans y [30, 46)
#[testing]
fun frame_slider_window(ctx: *context.Context, in: input.Input, v: *f32, win: *Window) {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    slider_f(ctx, "v", v, 0.0::f32, 10.0::f32);
    end_panel(ctx, p);
    val w: Block = begin_window(ctx, win);
    end_window(ctx, win, w);
    context.end(ctx);
}

test routing__drag_holds_and_clipped_rects_stay_cold {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var win: Window;
    win.x     = 0.0::f32;
    win.y     = 30.0::f32;
    win.w     = 100.0::f32;
    win.open  = 1;
    win.title = "w";
    var v: f32 = 0.0::f32;

    frame_slider_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?v, ?win);
    frame_slider_window(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?v, ?win);
    if (ctx.active != 1) { ret 2; }
    frame_slider_window(?ctx, input_at(50.0::f32, 38.0::f32, 1), ?v, ?win);
    if (v != 5.0::f32)                           { ret 3; }
    if (ctx.active != 1)                         { ret 4; }
    if (win.x != 0.0::f32 || win.y != 30.0::f32) { ret 5; }
    frame_slider_window(?ctx, input_at(50.0::f32, 38.0::f32, 0), ?v, ?win);

    # a region clipped away cannot be hovered or clicked
    frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 0), 1);
    frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 1), 1);
    if (ctx.hot != 0 || ctx.active != 0)                               { ret 6; }
    if (frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 0), 1) != 0) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a region at local (0, 0)-(10, 10) inside surface B nested in
# surface A, which paints at screen (60, 60)-(70, 70)
#[testing]
fun frame_nested_region(ctx: *context.Context, in: input.Input) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val sa:      context.Surface = context.begin_surface(ctx, 50.0::f32, 50.0::f32, 100.0::f32, 100.0::f32, 10.0::f32, 10.0::f32);
    val sb:      context.Surface = context.begin_surface(ctx, 20.0::f32, 20.0::f32, 30.0::f32, 30.0::f32, 0.0::f32, 0.0::f32);
    val clicked: u8              = region_clicked(ctx, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32);
    context.end_surface(ctx, sb);
    context.end_surface(ctx, sa);
    context.end(ctx);
    ret clicked;
}

test surface__nested_widget_clicked_where_painted {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 0));
    frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 1));
    if (frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 0)) != 1) { ret 2; }

    # where screen-space arithmetic would have put it, (20, 20)-(30, 30), is dead
    frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 0));
    frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 1));
    if (frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 0)) != 0) { ret 3; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame with a left dock of 20 text rows and a right dock, holding a slider
# and a section heading
#[testing]
fun frame_docks(ctx: *context.Context, in: input.Input, left: *Dock, right: *Dock, v: *f32, open: *u8) context.Area {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val l: DockArea = begin_dock(ctx, left);
    var i: usize    = 0;
    for (i < 20) {
        text(ctx, "row");
        i = i + 1;
    }
    end_dock(ctx, left, l);
    val r: DockArea = begin_dock(ctx, right);
    if (section(ctx, "sec", open)) { slider_f(ctx, "v", v, 0.0::f32, 10.0::f32); }
    end_dock(ctx, right, r);
    val free: context.Area = context.free_area(ctx);
    context.end(ctx);
    ret free;
}

test dock__carves_scrolls_and_sections {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var left:  Dock;
    var right: Dock;
    left.side  = context.Side.left{};
    left.size  = 60.0::f32;
    right.side = context.Side.right{};
    right.size = 50.0::f32;
    var v:    f32 = 0.0::f32;
    var open: u8  = 0;

    # the docks stack inward and leave the middle free
    val free: context.Area = frame_docks(?ctx, input_at(30.0::f32, 100.0::f32, 0), ?left, ?right, ?v, ?open);
    if (free.x0 != 60.0::f32 || free.x1 != 150.0::f32) { ret 2; }
    if (free.y0 != 0.0::f32 || free.y1 != 200.0::f32)  { ret 3; }
    # 20 rows of 12 pixels overflow the 192 pixel body
    if (left.scroll.content != 240.0::f32) { ret 4; }

    # a wheel turned towards the user over the left dock scrolls it, and clamps
    var in: input.Input = input_at(30.0::f32, 100.0::f32, 0);
    in.wheel = -30.0::f32;
    frame_docks(?ctx, in, ?left, ?right, ?v, ?open);
    if (left.scroll.offset != 30.0::f32) { ret 5; }
    in.wheel = -1000.0::f32;
    frame_docks(?ctx, in, ?left, ?right, ?v, ?open);
    if (left.scroll.offset != 48.0::f32) { ret 6; }
    # over the free area the wheel reaches no dock
    in.mx    = 100.0::f32;
    in.wheel = 30.0::f32;
    frame_docks(?ctx, in, ?left, ?right, ?v, ?open);
    if (left.scroll.offset != 48.0::f32 || right.scroll.offset != 0.0::f32) { ret 7; }

    # clicking the right dock's heading opens its section, whose slider then
    # maps the cursor in the dock's local space: its track spans x [154, 196)
    frame_docks(?ctx, input_at(170.0::f32, 10.0::f32, 0), ?left, ?right, ?v, ?open);
    frame_docks(?ctx, input_at(170.0::f32, 10.0::f32, 1), ?left, ?right, ?v, ?open);
    frame_docks(?ctx, input_at(170.0::f32, 10.0::f32, 0), ?left, ?right, ?v, ?open);
    if (open != 1) { ret 8; }
    frame_docks(?ctx, input_at(175.0::f32, 30.0::f32, 0), ?left, ?right, ?v, ?open);
    frame_docks(?ctx, input_at(175.0::f32, 30.0::f32, 1), ?left, ?right, ?v, ?open);
    if (v != 5.0::f32) { ret 9; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a 100 tall scroll region of 20 buttons at the root
#[testing]
fun frame_scroll(ctx: *context.Context, in: input.Input, s: *Scroll) {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    ctx.pw = 100.0::f32;
    val r: ScrollArea = begin_scroll(ctx, s, 100.0::f32);
    var i: usize      = 0;
    for (i < 20) {
        button(ctx, "b");
        i = i + 1;
    }
    end_scroll(ctx, s, r);
    context.end(ctx);
}

test scroll__thumb_drags_and_wheel_passes_buttons {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # 20 rows of 20 pixels in a 100 pixel region: 300 pixels of travel, and a
    # 25 pixel thumb at the right edge, x [94, 100)
    var s: Scroll;
    frame_scroll(?ctx, input_at(50.0::f32, 50.0::f32, 0), ?s);
    if (s.content != 400.0::f32) { ret 2; }

    # the wheel over a button still scrolls the region holding it
    var in: input.Input = input_at(40.0::f32, 50.0::f32, 0);
    frame_scroll(?ctx, in, ?s);
    if (ctx.hot == 0) { ret 3; }
    in.wheel = -20.0::f32;
    frame_scroll(?ctx, in, ?s);
    if (s.offset != 20.0::f32) { ret 4; }

    # drag the thumb from its top to the bottom of the track
    s.offset = 0.0::f32;
    frame_scroll(?ctx, input_at(97.0::f32, 1.0::f32, 0), ?s);
    frame_scroll(?ctx, input_at(97.0::f32, 1.0::f32, 1), ?s);
    frame_scroll(?ctx, input_at(97.0::f32, 90.0::f32, 1), ?s);
    if (s.offset != 300.0::f32) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test scale__doubles_metrics_text_and_hit_rects {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    context.set_scale(?ctx, 2.0::f32);
    if (context.line_height(?ctx) != 16.0::f32)      { ret 2; }
    if (context.text_width(?ctx, "ab") != 32.0::f32) { ret 3; }
    if (control_row_height(?ctx) != 40.0::f32)       { ret 4; }
    if (text_row_height(?ctx) != 24.0::f32)          { ret 5; }
    if (row_gap(?ctx) != 8.0::f32)                   { ret 6; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "bb";
    opts[2] = "ccc";
    var picked: usize = 0;

    # the header spans y [0, 32) and its face ends there
    frame_dropdown(?ctx, input_at(10.0::f32, 16.0::f32, 0), ?picked, ?opts[0]);
    if (vert_at(?ctx, 0.0::f32, 32.0::f32) >= context.draw_count(?ctx)) { ret 7; }
    frame_dropdown(?ctx, input_at(10.0::f32, 16.0::f32, 1), ?picked, ?opts[0]);
    frame_dropdown(?ctx, input_at(10.0::f32, 16.0::f32, 0), ?picked, ?opts[0]);
    if (ctx.open_dropdown != 1) { ret 8; }

    # the second option row spans y [80, 112), twice its place at scale 1.0
    frame_dropdown(?ctx, input_at(10.0::f32, 96.0::f32, 1), ?picked, ?opts[0]);
    if (frame_dropdown(?ctx, input_at(10.0::f32, 96.0::f32, 0), ?picked, ?opts[0]) != 1) { ret 9; }
    if (picked != 1)                                                                     { ret 10; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test theme__drives_colors_and_corners {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var t: theme.Theme = theme.default();
    t.control = draw.rgba(0.9::f32, 0.1::f32, 0.1::f32, 1.0::f32);
    t.corner  = 4.0::f32;
    context.set_theme(?ctx, t);
    if (context.theme_of(?ctx).corner != 4.0::f32) { ret 2; }

    # the button's rounded face: its body starts 4 down, in the theme's control color
    frame_button(?ctx, input_at(150.0::f32, 150.0::f32, 0));
    val p:     *draw.Vert = context.draw_verts(?ctx);
    val n:     usize      = context.draw_count(?ctx);
    var faced: u8         = 0;
    var i:     usize      = 0;
    for (i < n) {
        if (p[i].x == 0.0::f32 && p[i].y == 4.0::f32 && p[i].r == 0.9::f32) { faced = 1; }
        i = i + 1;
    }
    if (faced == 0) { ret 3; }
    # the panel's grown background body ends 4 above its bottom at 24
    if (vert_at(?ctx, 0.0::f32, 20.0::f32) >= n) { ret 4; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}
