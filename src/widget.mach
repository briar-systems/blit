    frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 1));
    if (frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 0)) != 1) { ret 2; }

    # where screen-space arithmetic would have put it, (20, 20)-(30, 30), is dead
    frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 0));
    frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 1));
    if (frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 0)) != 0) { ret 3; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a 100 tall scroll region of 20 buttons at the root
#[testing]
fun frame_scroll(ctx: *context.Context, in: input.Input, s: *Scroll) {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    size_next(ctx, layout.fixed(100.0::f32), layout.auto());
    val r: ScrollArea = begin_scroll(ctx, "s", s, 100.0::f32);
    var i: usize      = 0;
    for (i < 20) {
        context.push_id_int(ctx, i::u64);
        button(ctx, "b");
        context.pop_id(ctx);
        i = i + 1;
    }
    end_scroll(ctx, s, r);
    context.end(ctx);
}

test scroll__thumb_drags_and_wheel_passes_buttons {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # 20 rows of 20 pixels in a 100 pixel region: 300 pixels of travel, and a
    # 25 pixel thumb at the right edge, x [94, 100)
    var s: Scroll;
    frame_scroll(?ctx, input_at(50.0::f32, 50.0::f32, 0), ?s);
    if (s.content != 400.0::f32) { ret 2; }

    # the wheel over a button still scrolls the region holding it
    var in: input.Input = input_at(40.0::f32, 50.0::f32, 0);
    frame_scroll(?ctx, in, ?s);
    if (ctx.hot == 0) { ret 3; }
    in.wheel = -20.0::f32;
    frame_scroll(?ctx, in, ?s);
    if (s.offset != 20.0::f32) { ret 4; }

    # drag the thumb from its top to the bottom of the track
    s.offset = 0.0::f32;
    frame_scroll(?ctx, input_at(97.0::f32, 1.0::f32, 0), ?s);
    frame_scroll(?ctx, input_at(97.0::f32, 1.0::f32, 1), ?s);
    frame_scroll(?ctx, input_at(97.0::f32, 90.0::f32, 1), ?s);
    if (s.offset != 300.0::f32) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test scale__doubles_metrics_text_and_hit_rects {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    context.set_scale(?ctx, 2.0::f32);
    if (context.line_height(?ctx) != 16.0::f32)      { ret 2; }
    if (context.text_width(?ctx, "ab") != 32.0::f32) { ret 3; }
    if (control_row_height(?ctx) != 40.0::f32)       { ret 4; }
    if (text_row_height(?ctx) != 24.0::f32)          { ret 5; }
    if (row_gap(?ctx) != 8.0::f32)                   { ret 6; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "bb";
    opts[2] = "ccc";
    var picked: usize = 0;

    # the header spans y [0, 32) and its face ends there
    frame_dropdown(?ctx, input_at(10.0::f32, 16.0::f32, 0), ?picked, ?opts[0]);
    if (vert_at(?ctx, 0.0::f32, 32.0::f32) >= context.index_count(?ctx)) { ret 7; }
    frame_dropdown(?ctx, input_at(10.0::f32, 16.0::f32, 1), ?picked, ?opts[0]);
    frame_dropdown(?ctx, input_at(10.0::f32, 16.0::f32, 0), ?picked, ?opts[0]);
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) == 0) { ret 8; }

    # the second option row spans y [80, 112), twice its place at scale 1.0
    frame_dropdown(?ctx, input_at(10.0::f32, 96.0::f32, 1), ?picked, ?opts[0]);
    if (frame_dropdown(?ctx, input_at(10.0::f32, 96.0::f32, 0), ?picked, ?opts[0]) != 1) { ret 9; }
    if (picked != 1)                                                                     { ret 10; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test theme__drives_colors_and_corners {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var t:  theme.Theme;
    val te: err[allo.Error] = theme.init(?t, ?a);
    if (sel te.err) { ret 1; }
    t.control = draw.rgba(0.9::f32, 0.1::f32, 0.1::f32, 1.0::f32);
    t.corner  = 4.0::f32;
    theme.derive(?t);
    val se: err[allo.Error] = context.set_theme(?ctx, ?t);
    if (sel se.err) { ret 1; }
    val tf: err[allo.Error] = theme.free(?t);
    if (context.theme_of(?ctx).corner != 4.0::f32) { ret 2; }

    # the button's face is rounded in the theme's control color: no solid
    # vertex of it sits in its top-left corner
    frame_button(?ctx, input_at(150.0::f32, 150.0::f32, 0));
    val p:      *draw.Vert = context.draw_verts(?ctx);
    val n:      usize      = context.draw_count(?ctx);
    var faced:  u8         = 0;
    var corner: u8         = 0;
    var i:      usize      = 0;
    for (i < n) {
        if (p[i].r == 0.9::f32 && p[i].a == 1.0::f32) {
            faced = 1;
            if (p[i].x < 1.0::f32 && p[i].y < 1.0::f32) { corner = 1; }
        }
        i = i + 1;
    }
    if (faced == 0 || corner != 0) { ret 3; }
    # the panel's background, drawn at end_panel, paints beneath the button
    val bg: draw.Color = draw.premultiply(t.panel);
    if (paint_of(?ctx, bg) >= paint_of(?ctx, draw.premultiply(t.control))) { ret 4; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel laid out by hand: space, advance, then two columns,
# the first with one button and the second with two
#[testing]
fun frame_columns(ctx: *context.Context, in: input.Input, hit: *u8) f32 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    space(ctx, 10.0::f32);
    advance(ctx, 6.0::f32);
    var c: Columns = begin_columns(ctx, 2);
    button(ctx, "left");
    next_column(ctx, ?c);
    button(ctx, "a");
    @hit = 0;
    if (button(ctx, "b")) { @hit = 1; }
    end_columns(ctx, ?c);
    val y: f32 = avail(ctx).y0;
    end_panel(ctx, p);
    context.end(ctx);
    ret y;
}

test layout__cells_space_advance_and_columns {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # two cells across 100 pixels with a 4 pixel gap
    context.begin(?ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    begin_panel(?ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    if (cell_x0(?ctx, 0, 2) != 0.0::f32 || cell_x1(?ctx, 0, 2) != 48.0::f32)   { ret 2; }
    if (cell_x0(?ctx, 1, 2) != 52.0::f32 || cell_x1(?ctx, 1, 2) != 100.0::f32) { ret 3; }
    context.end(?ctx);

    # space 10 and a 6 pixel row put the columns at 20. the left column ends at
    # 40, the right at 60, and the parent resumes below the taller
    var hit: u8 = 0;
    if (frame_columns(?ctx, input_at(70.0::f32, 45.0::f32, 0), ?hit) != 60.0::f32) { ret 4; }
    # button b spans x [52, 100) and y [40, 56)
    frame_columns(?ctx, input_at(70.0::f32, 45.0::f32, 1), ?hit);
    frame_columns(?ctx, input_at(70.0::f32, 45.0::f32, 0), ?hit);
    if (hit != 1) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a window whose body holds a line of text, a panel and
# another line, returning where the window's layout stands before and after
# the panel
#[testing]
fun frame_panel_in_window(ctx: *context.Context, win: Window, before: *context.Area, after: *context.Area) {
    context.begin(ctx, input_at(0.0::f32, 0.0::f32, 0), 300.0::f32, 200.0::f32);
    val w: WindowArea = begin_window(ctx, win);
    text(ctx, "one");
    @before = avail(ctx);
    val p: Block = begin_panel(ctx, 200.0::f32, 100.0::f32, 50.0::f32);
    button(ctx, "inner");
    button(ctx, "inner2");
    end_panel(ctx, p);
    @after = avail(ctx);
    text(ctx, "two");
    end_window(ctx, w);
    context.end(ctx);
}

test layout__panel_in_window_keeps_the_window_layout {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    val win:    Window = auto_window("w", 0.0::f32, 0.0::f32, 120.0::f32);
    var before: context.Area;
    var after:  context.Area;
    frame_panel_in_window(?ctx, win, ?before, ?after);
    # the body continues under its first line, not where the panel ended
    if (before.y0 != row_h(?ctx) + text_row_height(?ctx)) { ret 2; }
    if (after.x0 != before.x0 || after.y0 != before.y0)   { ret 3; }
    if (after.x1 != 120.0::f32)                           { ret 4; }
    if (context.layout_depth(?ctx) != 0)                  { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a row of two buttons sharing the screen's width
#[testing]
fun frame_row(ctx: *context.Context) {
    context.begin(ctx, input_at(50.0::f32, 8.0::f32, 0), 200.0::f32, 200.0::f32);
    begin_stack(ctx, "row", stack(ctx, layout.Axis.horizontal{}));
    button(ctx, "a");
    button(ctx, "b");
    end_stack(ctx);
    context.end(ctx);
}

test layout__unmeasured_row_hides_its_first_frame {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # the shares are not measured yet: nothing drawn, nothing claimed, and
    # the next frame asked for now
    frame_row(?ctx);
    if (context.draw_count(?ctx) != 0 || ctx.claims.len != 0) { ret 2; }
    val again: opt[f64] = context.next_frame(?ctx);
    if (!(sel again.some && again.some == 0.0::f64)) { ret 3; }

    # then the buttons split the 200 pixels evenly, 4 apart
    frame_row(?ctx);
    if (context.draw_count(?ctx) == 0 || ctx.claims.len != 2) { ret 4; }
    val l: hit.Claim = ctx.claims.items[0];
    val r: hit.Claim = ctx.claims.items[1];
    if (l.x0 != 0.0::f32 || l.x1 != 98.0::f32)    { ret 5; }
    if (r.x0 != 102.0::f32 || r.x1 != 200.0::f32) { ret 6; }
    # and are hovered from the frame after they first claimed
    frame_row(?ctx);
    if (ctx.hot != context.id_of(?ctx, "a")) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with a centered row (fit, fit and fill items), a
# stack fitted to its content centered in another, and a same-line row
#[testing]
fun frame_stacks(ctx: *context.Context, r: *context.Area) {
    context.begin(ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    val p: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);

    var bar: layout.Stack = stack(ctx, layout.Axis.horizontal{});
    bar.align = layout.Align.center{};
    begin_stack(ctx, "bar", bar);
    r[0] = place(ctx, layout.fit(), layout.fit(), 20.0::f32, 16.0::f32);
    r[1] = place(ctx, layout.fit(), layout.fit(), 10.0::f32, 8.0::f32);
    r[2] = place(ctx, wide(), layout.fit(), 10.0::f32, 16.0::f32);
    end_stack(ctx);

    var outer: layout.Stack = stack(ctx, layout.Axis.vertical{});
    outer.align = layout.Align.center{};
    begin_stack(ctx, "outer", outer);
    var inner: layout.Stack = stack(ctx, layout.Axis.vertical{});
    inner.w = layout.fit();
    begin_stack(ctx, "inner", inner);
    r[3] = place(ctx, layout.fit(), layout.fit(), 40.0::f32, 8.0::f32);
    end_stack(ctx);
    end_stack(ctx);

    r[4] = place(ctx, layout.fit(), layout.fit(), 30.0::f32, 8.0::f32);
    same_line(ctx);
    r[5] = place(ctx, wide(), layout.fit(), 10.0::f32, 12.0::f32);
    r[6] = avail(ctx);
    end_panel(ctx, p);
    context.end(ctx);
}

test layout__stacks_size_align_and_share_lines {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var r: [7]context.Area;
    frame_stacks(?ctx, ?r[0]);
    # the row's height and the inner stack's width are not measured yet, so
    # both lay out only to measure
    if (r[1].y0 != 0.0::f32)  { ret 2; }
    if (r[3].x0 != 50.0::f32) { ret 3; }

    frame_stacks(?ctx, ?r[0]);
    # 20 and 10 wide, 4 apart, and the fill takes the 62 left
    if (r[0].x0 != 0.0::f32 || r[0].x1 != 20.0::f32)   { ret 4; }
    if (r[1].x0 != 24.0::f32 || r[1].y0 != 4.0::f32)   { ret 5; }
    if (r[2].x0 != 38.0::f32 || r[2].x1 != 100.0::f32) { ret 6; }
    # the row is 16 tall, the 40 wide stack centered under it
    if (r[3].x0 != 30.0::f32 || r[3].y0 != 20.0::f32) { ret 7; }
    # the line holds 30 and the rest of the width, 12 tall
    if (r[4].y0 != 32.0::f32 || r[5].y0 != 32.0::f32)  { ret 8; }
    if (r[5].x0 != 34.0::f32 || r[5].x1 != 100.0::f32) { ret 9; }
    if (r[6].x0 != 0.0::f32 || r[6].y0 != 48.0::f32)   { ret 10; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with one slider showing reading
#[testing]
fun frame_reading(ctx: *context.Context, in: input.Input, v: *f32, reading: str) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val changed: bool  = slider(ctx, "x", reading, v, 0.0::f32, 10.0::f32);
    end_panel(ctx, p);
