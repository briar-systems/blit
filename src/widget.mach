test toggle__flips_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # the whole row takes the click, label included
    var st: u8 = 0;
    frame_toggle(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?st);
    if (frame_toggle(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?st) != false) { ret 2; }
    if (frame_toggle(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?st) != true)  { ret 3; }
    if (st != 1)                                                            { ret 4; }

    # a press dragged off the row and released there does not flip it back
    frame_toggle(?ctx, input_at(90.0::f32, 8.0::f32, 1), ?st);
    frame_toggle(?ctx, input_at(150.0::f32, 150.0::f32, 1), ?st);
    if (frame_toggle(?ctx, input_at(150.0::f32, 150.0::f32, 0), ?st) != false) { ret 5; }
    if (st != 1)                                                               { ret 6; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

