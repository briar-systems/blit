# the widgets: panel, window, popup, scroll region, section, text, note,
# button, button rows and grids, segmented choice, checkbox, toggle, slider,
# dropdown, image, grid, text field
#
# layout is the context's stack of frames (see blit.layout). every container
# pushes the frame its content is laid out in and pops it at its end, and
# begin_stack opens a horizontal or vertical stack as an item of the current
# frame. a widget asks the top frame for its rect with its own size rules and
# the size its content needs, which size_next and a stack's item rules
# override. same_line puts an item beside the last one. the helpers place rows
# by hand: space and advance move the pen, cell_x0 and cell_x1 split the
# column into equal cells for widgets that take a rect (button_at), and
# begin_columns lays whole widgets side by side. the gaps and padding come
# from the theme through gap and pad.
#
# each widget places itself in the current frame, which moves the pen on for
# the next one, emits its geometry through the context painter, and claims its
# interactive rect through interact.hit, the same call a custom control makes,
# so hover, press, click and drag mean the same thing everywhere. a widget is
# hot while it is the topmost claimant under the cursor (see blit.context), and
# active while it owns the pointer after a press on it, until the button
# releases.
#
# a widget's id is its label hashed in the current id scope (see blit.id and
# context.id_of), so widgets appearing or vanishing before it never move it.
# text after "##" in a label is hashed but not drawn, and "###" keys a label by
# what follows alone. widgets without a label (text fields, regions, popups,
# scroll regions, docks, lists, charts) take a key the same way. windows,
# open popups and scroll regions (so docks and lists too) open an id scope of
# their own for what is placed inside them, and a widget's parts (a window's
# collapse box, a scrollbar thumb, a dropdown's options) take ids derived from
# its id.
#
# containers (panels, windows, popups) claim their whole rect beneath their
# children, so input over their empty areas stops at them instead of reaching
# whatever they cover. docks, windows and popups each paint and claim in a
# band of their own (see blit.band): docks above the base content, windows
# above docks in the z order the context keeps, popups above windows. a press
# of any button outside an open popup dismisses it, and that press is consumed
# rather than delivered to what lies beneath. menus, menu bars and context
# menus are popups too, in blit.menu.
#
# a text field takes the keyboard (see context.focus) when pressed and edits a
# blit.field.Field with the frame's keyboard events while it holds it.
#
# a window keeps its place, size, stack order and open and collapsed state in
# the context's store under its title's id (see WindowState), and moves,
# resizes, collapses and closes from its own chrome. its titlebar is a drag
# source of WINDOW_KIND carrying its id, which is how a dock (see blit.dock)
# takes it in. a docked window draws where its dock placed it (see Docked)
# instead, with the same content and the same ids.
#
# a scroll region clips its column and scrolls it by wheel and scrollbar when
# it is taller than the region, and a section is a collapsible heading that
# groups the rows beneath it.
#
# every color and length a widget draws with comes from its kind's style in
# the context's theme (see blit.theme), painted in the state it is in through
# context.box, each length multiplied by the context's interface scale, so a
# theme, an override (see blit.style) or a scale changes the interface and no
# widget holds a color or a size of its own.
#
# a control's face eases between the paints of the states it passes through
# (see blit.anim.box), a toggle's knob slides, a section opened by
# begin_section unfolds, and a scroll region glides to where the wheel or the
# keyboard sent it, each an animated value in the store timed by the theme's
# motion fields.
#
# every control is a tab stop (see blit.interact): tab and shift tab move the
# keyboard through them in call order, enter and space activate the one
# holding it as a click would, and the controls drawn as a row (a button row
# or grid, a segmented choice, a dropdown's options, a window's chrome) form
# a group the arrows move within. a slider takes left and right itself, a
# text field its keys. a scroll region brings the stop the keyboard reached
# into view, and a window the keyboard moved into comes to the front.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use blit.anim;
use blit.band;
use blit.context;
use blit.dnd;
use blit.draw;
use blit.driver;
use blit.edit;
use blit.field;
use blit.font;
use gly: blit.glyph;
use blit.hit;
use bid: blit.id;
use blit.input;
use blit.interact;
use blit.layout;
use blit.state;
use rich_text: blit.text;
use blit.theme;
use allo: std.allocator;
use std.allocator.page;
use std.data.toml;

# a kind's style, overrides included
fun look(ctx: *context.Context, kind: u32) *theme.Style {
    ret context.look_of(ctx, kind);
}

# a kind's paint in a state
fun ink(ctx: *context.Context, kind: u32, state: u8) *theme.Paint {
    ret context.paint_of(ctx, kind, state);
}

# a kind's control inset, at the context's scale
fun inset(ctx: *context.Context, kind: u32) theme.Edges {
    ret context.px_edges(ctx, look(ctx, kind).inset);
}

# a kind's container padding, at the context's scale
fun padding(ctx: *context.Context, kind: u32) theme.Edges {
    ret context.px_edges(ctx, look(ctx, kind).pad);
}

# the layout kind's space between items down a column, at the context's scale
#
# with across, the one place layout reads its spacing from the look.
fun gap(ctx: *context.Context) f32 {
    ret context.px(ctx, look(ctx, theme.LAYOUT).margin.b);
}

# the layout kind's space between cells and columns across a row, at the
# context's scale
fun across(ctx: *context.Context) f32 {
    ret context.px(ctx, look(ctx, theme.LAYOUT).margin.r);
}

# the state a widget paints in: on, then focused, then active, then hot
fun state_of(h: interact.Hit, on: bool, focused: bool) u8 {
    ret theme.pick(h.hot, h.active, on, focused);
}

# height of a kind's row: its least height, grown to fit a line of text with
# its inset above and below
fun row_of(ctx: *context.Context, kind: u32) f32 {
    val i: theme.Edges = inset(ctx, kind);
    ret maxf(context.px(ctx, look(ctx, kind).min_h), context.line_height(ctx) + i.t + i.b);
}

# height of a button row, the row every control takes by default
fun row_h(ctx: *context.Context) f32 {
    ret row_of(ctx, theme.BUTTON);
}

# vertical space consumed by one text row, including the following gap
pub fun text_row_height(ctx: *context.Context) f32 {
    ret context.line_height(ctx) + gap(ctx);
}

# vertical space consumed by one control row, including the following gap
pub fun control_row_height(ctx: *context.Context) f32 {
    ret row_h(ctx) + gap(ctx);
}

# height of a control row without the gap below it: the button style's least
# height, grown to fit a line of text with its inset above and below
pub fun control_height(ctx: *context.Context) f32 {
    ret row_h(ctx);
}

# spacing between adjacent layout rows, at the context's theme and scale
pub fun row_gap(ctx: *context.Context) f32 {
    ret gap(ctx);
}

# spacing between adjacent layout rows in the default theme at scale 1.0
#[deprecated("use row_gap(ctx), which follows the theme and scale")]
pub fun layout_gap() f32 {
    ret 4.0::f32;
}

# the top of a line of text centered in a row from y, h tall
fun text_top(ctx: *context.Context, y: f32, h: f32) f32 {
    ret y + (h - context.line_height(ctx)) / 2.0::f32;
}

# the drawn part of a label, everything before "##", at (x, y)
fun label_at(ctx: *context.Context, label: str, x: f32, y: f32, c: draw.Color) {
    context.text_span(ctx, label, bid.shown(label), x, y, c);
}

# the width of the drawn part of a label
fun label_width(ctx: *context.Context, label: str) f32 {
    ret context.text_width_n(ctx, label, bid.shown(label));
}

# clamp v to [lo, hi]
fun clampf(v: f32, lo: f32, hi: f32) f32 {
    if (v < lo) { ret lo; }
    if (v > hi) { ret hi; }
    ret v;
}

# the larger of two f32 values
fun maxf(a: f32, b: f32) f32 {
    if (a > b) { ret a; }
    ret b;
}

# the smaller of two f32 values
fun minf(a: f32, b: f32) f32 {
    if (a < b) { ret a; }
    ret b;
}

# the frame widgets place themselves in, a column over the screen when no
# container is open
fun top(ctx: *context.Context) *layout.Frame {
    if (context.layout_depth(ctx) == 0) {
        context.push_layout(ctx, layout.column(0.0::f32, 0.0::f32, ctx.sw, ctx.sh, gap(ctx)));
    }
    ret context.top_layout(ctx);
}

# the default width of a widget that spans the space it is given
fun wide() layout.Size {
    ret layout.fill(1.0::f32);
}

# the rules the next item in f takes: size_next's, then the frame's, then the
# widget's own
fun rule_w(f: *layout.Frame, own: layout.Size) layout.Size {
    ret layout.pick(f.next_w, f.item_w, own);
}

fun rule_h(f: *layout.Frame, own: layout.Size) layout.Size {
    ret layout.pick(f.next_h, f.item_h, own);
}

# a placed item's rect
fun area(it: layout.Item) context.Area {
    ret context.Area{x0: it.x, y0: it.y, x1: it.x + it.w, y1: it.y + it.h};
}

# the rect the next item would take, without placing it
fun peek(ctx: *context.Context, dw: layout.Size, dh: layout.Size, nat_w: f32, nat_h: f32) layout.Item {
    val f: *layout.Frame = top(ctx);
    ret layout.resolve(f, rule_w(f, dw), rule_h(f, dh), nat_w, nat_h);
}

# place the next item in the current frame and return its rect
#
# every widget places itself through this, and a control built outside blit
# takes part in the layout the same way. dw and dh are the item's own rules,
# which size_next and the frame's item rules override, and nat_w and nat_h the
# size its content needs.
# ---
# ctx:   context
# dw:    the item's own width rule
# dh:    the item's own height rule
# nat_w: natural width in pixels
# nat_h: natural height in pixels
# ret:   the item's rect in local pixels
pub fun place(ctx: *context.Context, dw: layout.Size, dh: layout.Size, nat_w: f32, nat_h: f32) context.Area {
    val f:  *layout.Frame = top(ctx);
    val it: layout.Item   = layout.resolve(f, rule_w(f, dw), rule_h(f, dh), nat_w, nat_h);
    f.next_w = layout.auto();
    f.next_h = layout.auto();
    layout.commit(f, it);
    ret area(it);
}

# open a frame for a container's content, laid out down a w-wide column from
# (x, y) that grows with its content, or is h tall when h is positive
fun open_column(ctx: *context.Context, x: f32, y: f32, w: f32, h: f32) {
    context.push_layout(ctx, layout.column(x, y, w, h, gap(ctx)));
}

# size the next item placed in the current frame, overriding its own rules and
# the frame's
#
# layout.auto() for a side leaves that side to the item. a nested stack is an
# item too, so this sizes the next begin_stack.
# ---
# ctx: context
# w:   width rule
# h:   height rule
pub fun size_next(ctx: *context.Context, w: layout.Size, h: layout.Size) {
    val f: *layout.Frame = top(ctx);
    f.next_w = w;
    f.next_h = h;
}

# place the next item beside the last one, on the same line, with the gap
# between them
#
# for quick inline rows in a column. the line is as tall as its tallest item,
# and the item after it starts below the line. in a horizontal stack, whose
# items share a line already, it does nothing.
# ---
# ctx: context
pub fun same_line(ctx: *context.Context) {
    layout.same_line(top(ctx));
}

# the space the next item may take, from the pen to the current frame's far
# edges
#
# y1 is the frame's bottom when its height is a limit, and y0 when the frame
# grows with its content.
# ---
# ctx: context
# ret: the space, in local pixels
pub fun avail(ctx: *context.Context) context.Area {
    val f:  *layout.Frame = top(ctx);
    var y0: f32           = f.y;
    if (f.inline != 0 && !layout.across(f)) { y0 = f.line_y0; }
    var y1: f32 = y0;
    if ((f.open & layout.OPEN_H) == 0) { y1 = f.y0 + f.h; }
    ret context.Area{x0: f.x, y0: y0, x1: f.x0 + f.w, y1: y1};
}

# a stack's options, at the theme's gap: start-aligned, filling its parent's
# width and fitting its content's height
# ---
# ctx:  context
# axis: the direction its items advance in
# ret:  options to adjust and pass to begin_stack
pub fun stack(ctx: *context.Context, axis: layout.Axis) layout.Stack {
    ret layout.stack(axis, gap(ctx));
}

# what a stack measured of its content, kept under its id for the next frame
# ---
# w:      natural width of its content
# h:      natural height of its content
# fixed:  pixels along its axis taken by items not filling, and the gaps
# weight: fill weight along its axis
# seen:   1 once a frame has measured it
rec Measure {
    w:      f32;
    h:      f32;
    fixed:  f32;
    weight: f32;
    seen:   u8;
}

# whether a stack opening at it, never measured, would place anything by a
# guess: shares along a known axis need last frame's totals, a side fitted to
# its content has no length to fill, stretch or align across, and centering or
# end-aligning the stack in its parent needs its size
fun guessing(f: *layout.Frame, s: layout.Stack, it: layout.Item) bool {
    var main: u8 = it.fit_h;
    var over: u8 = it.fit_w;
    if (sel s.axis.horizontal) {
        main = it.fit_w;
        over = it.fit_h;
    }
    if (main == 0 || over != 0) { ret true; }
    var cross: u8 = it.fit_w;
    if (layout.across(f)) { cross = it.fit_h; }
    ret cross != 0 && f.inline == 0 && ((sel f.align.center) || (sel f.align.end));
}

# open a stack as the next item of the current frame
#
# the stack's items advance along s.axis, s.gap apart, and sit across it as
# s.align says. the stack itself is sized in its parent by size_next, else by
# s.w and s.h, else by the parent's item rules, else filling the width and
# fitting the content's height. a side fitted to the content, and an
# alignment of the stack in its parent, use the size the stack measured last
# frame, kept in the state store under its id, and its fill shares come from
# last frame's totals the same way. a stack that would place anything by such a
# measure before it has one lays out its first frame only to measure, drawing
# and claiming nothing (see context.push_measure), and asks for the next frame
# at once, as Dear ImGui hides an auto-fit window's first frame. after that, a
# change of content settles one frame late. stacks nest. pair it with
# end_stack.
# ---
# ctx: context
# key: the stack's key in the current id scope
# s:   its options (see stack)
pub fun begin_stack(ctx: *context.Context, key: str, s: layout.Stack) {
    val id: u64           = context.id_of(ctx, key);
    val m:  *Measure      = state.get[Measure](ctx, id);
    val f:  *layout.Frame = top(ctx);
    val rw: layout.Size   = layout.pick(f.next_w, s.w, layout.pick(f.item_w, wide(), wide()));
    val rh: layout.Size   = layout.pick(f.next_h, s.h, layout.pick(f.item_h, layout.fit(), layout.fit()));
    val it: layout.Item   = layout.resolve(f, rw, rh, m.w, m.h);
    f.next_w = layout.auto();
    f.next_h = layout.auto();

    var c: layout.Frame = layout.column(it.x, it.y, it.w, it.h, s.gap);
    c.open = 0;
    if (it.fit_w != 0) { c.open = c.open | layout.OPEN_W; }
    if (it.fit_h != 0) { c.open = c.open | layout.OPEN_H; }
    c.axis        = s.axis;
    c.align       = s.align;
    c.item_w      = s.item_w;
    c.item_h      = s.item_h;
    c.prev_fixed  = m.fixed;
    c.prev_weight = m.weight;
    c.id          = id;
    c.slot        = it;
    c.rule_w      = rw;
    c.rule_h      = rh;
    if (m.seen == 0 && guessing(f, s, it)) { c.hidden = 1; }
    context.push_layout(ctx, c);
    if (c.hidden != 0) {
        context.push_measure(ctx);
        context.wake_at(ctx, ctx.in.time);
    }
}

# close the stack begin_stack opened and place it in its parent
#
# a side fitted to the content takes the size measured this frame, so the
# parent continues below or beside what the stack holds.
# ---
# ctx: context
pub fun end_stack(ctx: *context.Context) {
    val c: layout.Frame = @context.top_layout(ctx);
    context.pop_layout(ctx);
    if (c.hidden != 0) { context.pop_measure(ctx); }
    if (c.id == 0)     { ret; }

    val m: *Measure = state.get[Measure](ctx, c.id);
    m.seen   = 1;
    m.w      = c.need_w;
    m.h      = c.need_h;
    m.fixed  = c.fixed;
    m.weight = c.weight;

    var it: layout.Item = c.slot;
    it.nat_w = layout.natural(c.rule_w, c.need_w);
    it.nat_h = layout.natural(c.rule_h, c.need_h);
    if (it.fit_w != 0) { it.w = it.nat_w; }
    if (it.fit_h != 0) { it.h = it.nat_h; }
    layout.commit(top(ctx), it);
}

# move the pen past an item len pixels long along the current frame's axis,
# and the gap after it
#
# every widget ends with this through its placement. call it after placing a
# row by hand, such as cells of button_at. in a column, len is the row's height.
# ---
# ctx: context
# h:   the row's length in pixels
pub fun advance(ctx: *context.Context, h: f32) {
    layout.skip(top(ctx), h, true);
}

# leave h pixels of space along the current frame's axis
# ---
# ctx: context
# h:   space in pixels, context.px scales an authored length to match
pub fun space(ctx: *context.Context, h: f32) {
    layout.skip(top(ctx), h, false);
}

# the width of one of n equal cells across w pixels, g pixels between them
fun cell_width(w: f32, g: f32, n: usize) f32 {
    if (n == 0) { ret 0.0::f32; }
    ret maxf((w - g * (n - 1)::f32) / n::f32, 0.0::f32);
}

# the left edge of cell i of n equal cells across w pixels from x
fun cell_left(x: f32, w: f32, g: f32, i: usize, n: usize) f32 {
    ret x + i::f32 * (cell_width(w, g, n) + g);
}

# the left edge of cell i of n equal cells across the column, with the theme's
# gap between cells
# ---
# ctx: context
# i:   the cell, from 0 at the left
# n:   how many cells share the column
# ret: the cell's left x in local pixels
pub fun cell_x0(ctx: *context.Context, i: usize, n: usize) f32 {
    val f: *layout.Frame = top(ctx);
    ret cell_left(f.x0, f.w, across(ctx), i, n);
}

# the right edge of cell i of n equal cells across the column
# ---
# ctx: context
# i:   the cell, from 0 at the left
# n:   how many cells share the column
# ret: the cell's right x in local pixels
pub fun cell_x1(ctx: *context.Context, i: usize, n: usize) f32 {
    ret cell_x0(ctx, i, n) + cell_width(top(ctx).w, across(ctx), n);
}

# the handle begin_columns returns for next_column and end_columns
# ---
# n:      how many columns share the row
# i:      the column being laid out
# top:    the y the columns start at
# bottom: the lowest bottom a finished column reached
# need:   the widest natural width a finished column measured
# row:    the rect the row takes in its parent, before its height is known
pub rec Columns {
    n:      usize;
    i:      usize;
    top:    f32;
    bottom: f32;
    need:   f32;
    row:    layout.Item;
}

# split the next item of the current frame into the first of n equal columns
#
# widgets placed until next_column lay out in that column. next_column moves
# to the next one, back at the top, and end_columns places the row in the
# parent as tall as the tallest column. pair it with end_columns.
# ---
# ctx: context
# n:   how many columns share the row, at least 1
# ret: a handle for next_column and end_columns
pub fun begin_columns(ctx: *context.Context, n: usize) Columns {
    var c: Columns;
    c.n = n;
    if (c.n == 0) { c.n = 1; }
    val f: *layout.Frame = top(ctx);
    c.row    = layout.resolve(f, rule_w(f, wide()), rule_h(f, layout.fit()), 0.0::f32, 0.0::f32);
    f.next_w = layout.auto();
    f.next_h = layout.auto();
    c.top    = c.row.y;
    c.bottom = c.row.y;
    enter_column(ctx, ?c);
    ret c;
}

# open the frame of column c.i of the row
fun enter_column(ctx: *context.Context, c: *Columns) {
    val g: f32 = across(ctx);
    open_column(ctx, cell_left(c.row.x, c.row.w, g, c.i, c.n), c.top, cell_width(c.row.w, g, c.n), 0.0::f32);
}

# close the open column, noting how far it reached
fun leave_column(ctx: *context.Context, c: *Columns) {
    val f: *layout.Frame = context.top_layout(ctx);
    if (f.items > 0) { c.bottom = maxf(c.bottom, f.line_y1); }
    c.need = maxf(c.need, f.need_w);
    context.pop_layout(ctx);
}

# move to the next column, back at the columns' top
#
# past the last column it stays in the last one.
# ---
# ctx: context
# c:   the handle begin_columns returned
pub fun next_column(ctx: *context.Context, c: *Columns) {
    leave_column(ctx, c);
    if (c.i + 1 < c.n) { c.i = c.i + 1; }
    enter_column(ctx, c);
}

# close the columns and place the row in the parent, below the tallest column
# ---
# ctx: context
# c:   the handle begin_columns returned
pub fun end_columns(ctx: *context.Context, c: *Columns) {
    leave_column(ctx, c);
    var it: layout.Item = c.row;
    it.h     = c.bottom - c.top;
    it.nat_h = it.h;
    it.nat_w = c.need * c.n::f32 + across(ctx) * (c.n - 1)::f32;
    layout.commit(top(ctx), it);
}

# ask for the hand pointer over a clickable widget while it is hovered
fun hand(ctx: *context.Context, h: interact.Hit) {
    if (h.hot) { context.set_cursor(ctx, input.CURSOR_HAND); }
}

# the buttons a control answers to: the left button, as a tab stop
val PRESS: u8 = input.BUTTON_LEFT | interact.FOCUS;

# the handle begin_panel returns for end_panel
# ---
# ch:    the channels the body's background and children draw in
# claim: the container's reserved claim, context.NO_CLAIM when refused
pub rec Block {
    ch:    context.Channels;
    claim: usize;
}

# start a layout column at (x, y) of width w
#
# the background height is unknown until the panel's widgets are placed, so
# the widgets draw in a channel above the background's, which end_panel paints
# once it knows the height. the panel's claim is reserved now, beneath its
# widgets, and given its rect then.
# ---
# ctx: context
# x:   panel left in pixels
# y:   panel top in pixels
# w:   panel width in pixels
# ret: a handle for end_panel
pub fun begin_panel(ctx: *context.Context, x: f32, y: f32, w: f32) Block {
    val p: theme.Edges = padding(ctx, theme.PANEL);
    open_column(ctx, x + p.l, y + p.t, maxf(w - p.l - p.r, 0.0::f32), 0.0::f32);

    var b: Block;
    b.claim = context.reserve_claim(ctx, 0);
    b.ch    = context.split(ctx, 2);
    context.set_channel(ctx, b.ch, 1);
    ret b;
}

# paint the panel background beneath, and give the claim the rect of, every
# widget placed since begin_panel
# ---
# ctx: context
# b:   the value returned by begin_panel
pub fun end_panel(ctx: *context.Context, b: Block) {
    val f:  *layout.Frame = context.top_layout(ctx);
    val p:  theme.Edges   = padding(ctx, theme.PANEL);
    val x0: f32           = f.x0 - p.l;
    val y0: f32           = f.y0 - p.t;
    val x1: f32           = f.x0 + f.w + p.r;
    val y1: f32           = f.y + p.b;
    context.pop_layout(ctx);
    context.set_channel(ctx, b.ch, 0);
    context.box(ctx, theme.PANEL, theme.NORMAL, x0, y0, x1, y1);
    context.merge(ctx, b.ch);
    context.fill_claim(ctx, b.claim, x0, y0, x1, y1);
}

# draw a line of text at the cursor and advance to the next row
# ---
# ctx: context
# s:   string to draw
pub fun text(ctx: *context.Context, s: str) {
    val r: context.Area = place(ctx, layout.fit(), layout.fit(), context.text_width(ctx, s), context.line_height(ctx));
    context.text_at(ctx, s, r.x0, r.y0, ink(ctx, theme.LABEL, theme.NORMAL).text);
}

# draw a rich line of spans at the cursor and advance to the next row
#
# each span draws in its own style and color, all on one baseline (see
# blit.text.Span).
# ---
# ctx: context
# sp:  the spans
# n:   how many
pub fun rich(ctx: *context.Context, sp: *rich_text.Span, n: usize) {
    val m: gly.LineMetrics = rich_text.spans_line(ctx, sp, n);
    val r: context.Area    = place(ctx, layout.fit(), layout.fit(), rich_text.spans_width(ctx, sp, n), m.ascent + m.descent + m.gap);
    val w: f32             = rich_text.spans_at(ctx, sp, n, r.x0, r.y0);
}

# where the line of s starting at byte i ends when wrapped to w pixels
#
# a line breaks at a newline, else after the last space that keeps it within
# w, else before the codepoint that would overflow, so a word wider than the
# column is split rather than drawn past it. a line always takes at least one
# codepoint.
# ---
# ret: the byte the line ends at, with @resume set to where the next line starts
fun wrap_line(ctx: *context.Context, s: str, n: usize, i: usize, w: f32, resume: *usize) usize {
    var width: f32   = 0.0::f32;
    var prev:  u32   = 0;
    var space: usize = n;
    var j:     usize = i;
    for (j < n) {
        var cp:   u32   = 0;
        val used: usize = font.next(s, j, n, ?cp);
        if (cp == font.NEWLINE) {
            @resume = j + used;
            ret j;
        }
        val adv: f32 = context.glyph_advance(ctx, prev, cp);
        if (width + adv > w && j > i) {
            if (cp == ' ') {
                @resume = j + used;
                ret j;
            }
            if (space < n) {
                @resume = space + 1;
                ret space;
            }
            @resume = j;
            ret j;
        }
        if (cp == ' ') { space = j; }
        width = width + adv;
        prev  = cp;
        j     = j + used;
    }
    @resume = n;
    ret n;
}

# dim text wrapped at spaces to the column's width, and advance past it
#
# a newline starts a new line, and a word wider than the column breaks where
# it overflows.
# ---
# ctx: context
# s:   utf-8 text
pub fun note(ctx: *context.Context, s: str) {
    val lh: f32   = context.line_height(ctx);
    var n:  usize = 0;
    if (s != nil) { n = str_len(s); }
    val nat:   f32   = context.text_width(ctx, s);
    val w:     f32   = peek(ctx, wide(), layout.fit(), nat, lh).w;
    var lines: usize = 0;
    var i:     usize = 0;
    for (i < n || lines == 0) {
        var next: usize = n;
        val end:  usize = wrap_line(ctx, s, n, i, w, ?next);
        lines = lines + 1;
        i     = next;
    }
    val r: context.Area = place(ctx, wide(), layout.fit(), nat, lh * lines::f32);
    var y: f32          = r.y0;
    i = 0;
    var k: usize = 0;
    for (k < lines) {
        var next: usize = n;
        val end:  usize = wrap_line(ctx, s, n, i, w, ?next);
        if (end > i) { context.text_span(ctx, ?s[i], end - i, r.x0, y, ink(ctx, theme.LABEL, theme.NORMAL).mark); }
        y = y + lh;
        i = next;
        k = k + 1;
    }
}

# a clickable button filling a rect, with a centered label
#
# the rect is in local coordinates, so rows and grids of buttons place it
# with cell_x0 and cell_x1. it does not move the layout. returns true
# on the frame the button is released while hovered, after having been
# pressed on it.
# ---
# ctx:   context
# label: button text, and its key (see context.id_of)
# x0:    left x in pixels
# y0:    top y in pixels
# x1:    right x in pixels
# y1:    bottom y in pixels
# on:    true to draw the button chosen, in the theme's accent
# ret:   true if the button was clicked this frame
pub fun button_at(ctx: *context.Context, label: str, x0: f32, y0: f32, x1: f32, y1: f32, on: bool) bool {
    val h: interact.Hit = interact.hit(ctx, context.id_of(ctx, label), x0, y0, x1, y1, PRESS);
    hand(ctx, h);

    val st: u8 = state_of(h, on, false);
    if (on) { context.mark_current(ctx, h.id); }
    val face: theme.Paint = anim.box(ctx, h.id, theme.BUTTON, st, x0, y0, x1, y1);

    val tw: f32 = label_width(ctx, label);
    val tx: f32 = x0 + (x1 - x0 - tw) / 2.0::f32;
    label_at(ctx, label, tx, text_top(ctx, y0, y1 - y0), face.text);
    ret h.clicked;
}

# a full-width clickable button with a centered label
#
# returns true on the frame the button is released while hovered, after having
# been pressed on it.
# ---
# ctx:   context
# label: button text
# ret:   true if the button was clicked this frame
pub fun button(ctx: *context.Context, label: str) bool {
    val in: theme.Edges  = inset(ctx, theme.BUTTON);
    val r:  context.Area = place(ctx, wide(), layout.fit(), label_width(ctx, label) + in.l + in.r, row_h(ctx));
    ret button_at(ctx, label, r.x0, r.y0, r.x1, r.y1, false);
}

# a grid of n buttons, cols to a row, filling the column
#
# each button is keyed by its label, so labels that repeat need "##" to tell
# them apart. the buttons are one group of tab stops, keyed by the first
# label: tab reaches the grid once and the arrows move across it.
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many buttons
# cols:   buttons to a row, at least 1
# on:     the button drawn chosen, n for none
# ret:    the index clicked this frame, n for none
pub fun button_grid(ctx: *context.Context, labels: *str, n: usize, cols: usize, on: usize) usize {
    var per: usize = cols;
    if (per == 0) { per = 1; }
    val h:    f32         = row_h(ctx);
    val g:    f32         = context.px(ctx, look(ctx, theme.BUTTON).margin.r);
    val in:   theme.Edges = inset(ctx, theme.BUTTON);
    var cell: f32         = 0.0::f32;
    var i:    usize       = 0;
    for (i < n) {
        cell = maxf(cell, label_width(ctx, labels[i]) + in.l + in.r);
        i    = i + 1;
    }
    var row: context.Area;
    var got: usize = n;
    var grp: interact.Group;
    if (n > 0) { grp = interact.begin_group(ctx, bid.child(context.id_of(ctx, labels[0]), "#group"), interact.BOTH); }
    i = 0;
    for (i < n) {
        val c: usize = i % per;
        if (c == 0) { row = place(ctx, wide(), layout.fit(), cell * per::f32 + g * (per - 1)::f32, h); }
        val x0: f32 = cell_left(row.x0, row.x1 - row.x0, g, c, per);
        if (button_at(ctx, labels[i], x0, row.y0, x0 + cell_width(row.x1 - row.x0, g, per), row.y1, i == on)) { got = i; }
        i = i + 1;
    }
    if (n > 0) { interact.end_group(ctx, grp); }
    ret got;
}

# a row of n buttons sharing the column equally
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many buttons
# ret:    the index clicked this frame, n for none
pub fun buttons(ctx: *context.Context, labels: *str, n: usize) usize {
    ret button_grid(ctx, labels, n, n, n);
}

# a row choosing one of n options, the chosen one drawn in the accent
# ---
# ctx:    context
# labels: pointer to an array of n labels (pass ?labels[0])
# n:      how many options
# choice: pointer to the chosen index, updated in place
# ret:    true if the choice changed this frame
pub fun segmented(ctx: *context.Context, labels: *str, n: usize, choice: *usize) bool {
    val got: usize = button_grid(ctx, labels, n, n, @choice);
    if (got >= n || got == @choice) { ret false; }
    @choice = got;
    ret true;
}

# a labeled toggle that flips @state when clicked
# ---
# ctx:   context
# label: text drawn to the right of the box
# state: pointer to the 0/1 toggle state, updated in place
# ret:   true if the state changed this frame
pub fun checkbox(ctx: *context.Context, label: str, state: *u8) bool {
    val id:  u64          = context.id_of(ctx, label);
    val box: f32          = row_of(ctx, theme.CHECKBOX);
    val sp:  f32          = inset(ctx, theme.CHECKBOX).l;
    val tw:  f32          = label_width(ctx, label);
    val r:   context.Area = place(ctx, layout.fit(), layout.fit(), box + sp + tw, box);
    val x0:  f32          = r.x0;
    val y0:  f32          = r.y0;
    val bx1: f32          = x0 + box;
    val y1:  f32          = y0 + box;
    val rx1: f32          = bx1 + sp + tw;
    val hc:  interact.Hit = interact.hit(ctx, id, x0, y0, rx1, y1, PRESS);
    hand(ctx, hc);

    var toggled: bool = false;
    if (hc.clicked) {
        var nv: u8 = 1;
        if (@state != 0) { nv = 0; }
        @state  = nv;
        toggled = true;
    }

    val st: u8 = state_of(hc, false, false);
    anim.box(ctx, id, theme.CHECKBOX, st, x0, y0, bx1, y1);
    if (@state != 0) {
        val m: theme.Edges = padding(ctx, theme.CHECKBOX);
        context.box(ctx, theme.CHECKBOX_MARK, theme.ON, x0 + m.l, y0 + m.t, bx1 - m.r, y1 - m.b);
    }
    label_at(ctx, label, bx1 + sp, text_top(ctx, y0, box), ink(ctx, theme.CHECKBOX, st).text);
    ret toggled;
}

# a labeled on/off switch across the column that flips @state when clicked
#
# the label sits on the left and the switch on the right, its knob at the
# right end on an accent track when on. the whole row takes the click.
# ---
# ctx:   context
# label: text drawn on the left
# state: pointer to the 0/1 switch state, updated in place
# ret:   true if the state changed this frame
pub fun toggle(ctx: *context.Context, label: str, state: *u8) bool {
    val id: u64          = context.id_of(ctx, label);
    val rh: f32          = row_of(ctx, theme.TOGGLE);
    val tp: theme.Edges  = padding(ctx, theme.TOGGLE);
    val nw: f32          = label_width(ctx, label) + inset(ctx, theme.TOGGLE).r + maxf(rh - tp.t - tp.b, 0.0::f32) * 2.0::f32;
    val r:  context.Area = place(ctx, wide(), layout.fit(), nw, rh);
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, PRESS);
    hand(ctx, hs);

    var flipped: bool = false;
    if (hs.clicked) {
        var nv: u8 = 1;
        if (@state != 0) { nv = 0; }
        @state  = nv;
        flipped = true;
    }

    val st: u8 = state_of(hs, @state != 0, false);
    label_at(ctx, label, x0, text_top(ctx, y0, h), ink(ctx, theme.TOGGLE, st).text);

    # the switch is a track twice as wide as it is tall, inside the row's padding
    val sh: f32 = maxf(h - tp.t - tp.b, 0.0::f32);
    val sw: f32 = sh * 2.0::f32;
    val sx: f32 = x1 - tp.r - sw;
    val sy: f32 = y0 + tp.t;
    anim.box(ctx, id, theme.TOGGLE, st, sx, sy, sx + sw, sy + sh);

    # the knob slides between its ends
    var to: f32 = 0.0::f32;
    if (@state != 0) { to = 1.0::f32; }
    val on: f32         = anim.value(ctx, bid.child(id, "#slide"), to, theme.MOTION_HOVER);
    val km: theme.Edges = context.px_edges(ctx, look(ctx, theme.TOGGLE_KNOB).margin);
    val k:  f32         = maxf(sh - km.t - km.b, 0.0::f32);
    val kx: f32         = anim.lerp(sx + km.l, sx + sw - km.r - k, on);
    anim.box(ctx, bid.child(id, "#knob"), theme.TOGGLE_KNOB, st, kx, sy + km.t, kx + k, sy + km.t + k);
    ret flipped;
}

# a horizontal slider mapping @v linearly onto [lo, hi]
#
# while the handle is held, @v tracks the cursor's x within the track, wherever
# the cursor goes. the label is drawn on the left of the track.
# ---
# ctx:   context
# label: slider text
# v:     pointer to the value, updated in place while dragging
# lo:    minimum value (left end)
# hi:    maximum value (right end)
# ret:   true if the value changed this frame
pub fun slider_f(ctx: *context.Context, label: str, v: *f32, lo: f32, hi: f32) bool {
    ret slider(ctx, label, nil, v, lo, hi);
}

# a horizontal slider mapping @v linearly onto [lo, hi], with a reading of its
# value beside the label
#
# while it holds the keyboard, left and right step @v by a twentieth of the
# range and home and end take it to either end. like slider_f, and the reading, which the caller formats from @v however it
# likes (a unit, a percentage, "off"), is drawn dim at the right end of the
# track. format it before the call from the value as it stands, and the next
# frame shows a drag's result.
# ---
# ctx:     context
# label:   slider text, drawn on the left
# reading: the value as text, drawn on the right, nil for none
# v:       pointer to the value, updated in place while dragging
# lo:      minimum value (left end)
# hi:      maximum value (right end)
# ret:     true if the value changed this frame
pub fun slider(ctx: *context.Context, label: str, reading: str, v: *f32, lo: f32, hi: f32) bool {
    val id: u64         = context.id_of(ctx, label);
    val in: theme.Edges = inset(ctx, theme.SLIDER);
    val hw: f32         = context.px(ctx, look(ctx, theme.SLIDER_HANDLE).min_w);
    var nw: f32         = label_width(ctx, label) + (in.l + in.r) * 2.0::f32 + hw;
    if (reading != nil) { nw = nw + context.text_width(ctx, reading); }
    val r:  context.Area = place(ctx, wide(), layout.fit(), nw, row_of(ctx, theme.SLIDER));
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, PRESS | interact.ARROWS);

    var changed: bool = false;
    if (hs.focused) {
        val unit: f32 = (hi - lo) / 20.0::f32;
        var nv:   f32 = @v;
        nv = nv + unit * (interact.presses(ctx, input.KEY_RIGHT)::f32 - interact.presses(ctx, input.KEY_LEFT)::f32);
        if (interact.presses(ctx, input.KEY_HOME) != 0) { nv = lo; }
        if (interact.presses(ctx, input.KEY_END) != 0)  { nv = hi; }
        if (lo <= hi)                                   { nv = clampf(nv, lo, hi); }
        or                                              { nv = clampf(nv, hi, lo); }
        if (nv != @v) {
            @v      = nv;
            changed = true;
        }
    }
    if (hs.held) {
        val track: f32 = x1 - x0;
        var t:     f32 = 0.0::f32;
        if (track > 0.0::f32) { t = clampf((hs.mx - x0) / track, 0.0::f32, 1.0::f32); }
        val nv: f32 = lo + t * (hi - lo);
        if (nv != @v) {
            @v      = nv;
            changed = true;
        }
    }

    val st: u8 = state_of(hs, false, false);
    context.box(ctx, theme.SLIDER, st, x0, y0, x1, y1);

    var t_out: f32 = 0.0::f32;
    if (hi != lo) { t_out = clampf((@v - lo) / (hi - lo), 0.0::f32, 1.0::f32); }
    var span: f32 = (x1 - x0) - hw;
    if (span < 0.0::f32) { span = 0.0::f32; }
    val hx: f32 = x0 + t_out * span;
    anim.box(ctx, bid.child(id, "#handle"), theme.SLIDER_HANDLE, st, hx, y0, hx + hw, y1);

    val ty: f32          = text_top(ctx, y0, h);
    val p:  *theme.Paint = ink(ctx, theme.SLIDER, st);
    label_at(ctx, label, x0 + in.l, ty, p.text);
    if (reading != nil) {
        val rw: f32 = context.text_width(ctx, reading);
        context.text_at(ctx, reading, x1 - in.r - rw, ty, p.mark);
    }
    ret changed;
}

# the handle begin_popup returns for end_popup
# ---
# open:      1 if the popup is drawn this frame, else 0
# dismissed: 1 if a press outside the popup dismissed it this frame
# ch:        the channels the body's background and children draw in
# claim:     the popup body's reserved claim
# kind:      the style its body is padded and painted in, theme.POPUP unless
#            begin_popup_as named another
pub rec Popup {
    open:      u8;
    dismissed: u8;
    ch:        context.Channels;
    claim:     usize;
    kind:      u32;
}

# open a popup column at (x, y) of width w in the popup band, when @open is
# nonzero
#
# the popup paints and takes input above the base content, docks, windows and
# overlays (see blit.band), and a popup opened inside another stacks one layer
# above it, so a submenu always covers its menu. popups opened side by side
# share a layer and stack by call order.
#
# (x, y) is in the caller's local coordinates. inside the popup the layout
# is in screen pixels, so widgets placed between begin_popup and end_popup land in
# the popup and paint and claim above what they overlap. the popup also claims
# the whole screen beneath its body: a press of any button outside the body
# sets `dismissed` and is consumed, so it never activates what lies under it.
# the caller owns the open state and closes it on dismissal. while open, the
# popup is an id scope for the widgets inside it. pair every begin_popup with
# an end_popup.
# ---
# ctx:  context
# key:  the popup's key in the current id scope
# open: nonzero to draw the popup this frame
# x:    popup left in local pixels
# y:    popup top in local pixels
# w:    popup width in pixels
# ret:  a handle for end_popup
pub fun begin_popup(ctx: *context.Context, key: str, open: u8, x: f32, y: f32, w: f32) Popup {
    ret popup_at(ctx, context.id_of(ctx, key), open, x, y, w, true, theme.POPUP);
}

# begin_popup for a popup whose id is already known, such as a part of a widget
# ---
# ctx:  context
# id:   the popup's id, which is also the id scope of what it holds
# open: nonzero to draw the popup this frame
# x:    popup left in local pixels
# y:    popup top in local pixels
# w:    popup width in pixels
# ret:  a handle for end_popup
pub fun begin_popup_id(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32) Popup {
    ret popup_at(ctx, id, open, x, y, w, true, theme.POPUP);
}

# open a popup nested in an open popup, which closes with it rather than on a
# press outside itself
#
# it claims nothing beyond its body, so what the enclosing popup holds stays
# under the pointer while it is open, as a submenu needs. `dismissed` is never
# set: the enclosing popup's outside claim takes every press outside both.
# ---
# ctx:  context
# id:   the popup's id, which is also the id scope of what it holds
# open: nonzero to draw the popup this frame
# x:    popup left in local pixels
# y:    popup top in local pixels
# w:    popup width in pixels
# ret:  a handle for end_popup
pub fun begin_popup_nested(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32) Popup {
    ret popup_at(ctx, id, open, x, y, w, false, theme.POPUP);
}

# open a popup whose body is padded and painted in a style of its own, such
# as a menu's
# ---
# ctx:    context
# id:     the popup's id, which is also the id scope of what it holds
# open:   nonzero to draw the popup this frame
# x:      popup left in local pixels
# y:      popup top in local pixels
# w:      popup width in pixels
# nested: true to nest it in the open popup it is opened in, as
#         begin_popup_nested does, false to open it as begin_popup_id does
# kind:   the style, such as theme.MENU
# ret:    a handle for end_popup
pub fun begin_popup_as(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32, nested: bool, kind: u32) Popup {
    ret popup_at(ctx, id, open, x, y, w, !nested, kind);
}

# a popup at (x, y), claiming the screen beneath its body when outside is true
fun popup_at(ctx: *context.Context, id: u64, open: u8, x: f32, y: f32, w: f32, outside: bool, kind: u32) Popup {
    var p: Popup;
    p.claim = context.NO_CLAIM;
    p.kind  = kind;
    if (open == 0) { ret p; }
    p.open = 1;

    val sx: f32 = x + ctx.lx;
    val sy: f32 = y + ctx.ly;
    context.push_band(ctx, band.POPUPS, 0);
    context.push_id(ctx, id);

    if (outside) {
        val every: u8           = input.BUTTON_LEFT | input.BUTTON_RIGHT | input.BUTTON_MIDDLE | input.BUTTON_X1 | input.BUTTON_X2;
        val out:   interact.Hit = interact.hit(ctx, bid.child(id, "#outside"), 0.0::f32, 0.0::f32, ctx.sw, ctx.sh, every);
        if (out.pressed) { p.dismissed = 1; }
    }

    p.claim = context.reserve_claim(ctx, 0);
    val pd: theme.Edges = padding(ctx, kind);
    open_column(ctx, sx + pd.l, sy + pd.t, maxf(w - pd.l - pd.r, 0.0::f32), 0.0::f32);
    p.ch = context.split(ctx, 2);
    context.set_channel(ctx, p.ch, 1);
    ret p;
}

# close a popup opened by begin_popup: paint its background beneath its
# widgets, give its claim their rect, leave its layer and restore the parent
# layout
# ---
# ctx: context
# p:   the value returned by begin_popup
pub fun end_popup(ctx: *context.Context, p: Popup) {
    if (p.open == 0) { ret; }

    val f:  *layout.Frame = context.top_layout(ctx);
    val pd: theme.Edges   = padding(ctx, p.kind);
    val x0: f32           = f.x0 - pd.l;
    val y0: f32           = f.y0 - pd.t;
    val x1: f32           = f.x0 + f.w + pd.r;
    val y1: f32           = f.y + pd.b;
    context.pop_layout(ctx);
    context.set_channel(ctx, p.ch, 0);
    context.box(ctx, p.kind, theme.NORMAL, x0, y0, x1, y1);
    context.merge(ctx, p.ch);
    context.fill_claim(ctx, p.claim, x0, y0, x1, y1);
    context.pop_id(ctx);
    context.pop_band(ctx);
}

# the state a dropdown keeps in the context's store under its header's id
# ---
# open: 1 while the option list is shown, else 0
pub rec DropdownState {
    open: u8;
}

# a select: shows the current option and, while open, lists the options in a
# popup directly beneath it
#
# clicking the header opens it. the open state is a DropdownState the context's
# state store keeps under the header's id (see blit.state), so each dropdown
# opens and closes on its own. clicking an option sets @selected and closes it,
# and a press anywhere else closes it without reaching what lies beneath. the
# option list overlays later widgets rather than pushing them down.
#
# from the keyboard, enter or space on the header opens it with the selected
# option focused, the options are a group the arrows move through, enter or
# space picks one and escape closes it, each handing the keyboard back to the
# header.
# ---
# ctx:      context
# label:    text drawn on the left of the header, and its key
# selected: pointer to the selected index, updated in place
# options:  pointer to an array of option strings (pass ?opts[0])
# count:    number of options
# ret:      1 if the selection changed this frame, else 0
pub fun dropdown(ctx: *context.Context, label: str, selected: *usize, options: *str, count: usize) u8 {
    val id: u64            = context.id_of(ctx, label);
    val st: *DropdownState = state.get[DropdownState](ctx, id);
    var wo: f32            = 0.0::f32;
    var k:  usize          = 0;
    for (k < count) {
        wo = maxf(wo, context.text_width(ctx, options[k]));
        k  = k + 1;
    }
    val rh: f32          = row_of(ctx, theme.DROPDOWN);
    val in: theme.Edges  = inset(ctx, theme.DROPDOWN);
    val r:  context.Area = place(ctx, wide(), layout.fit(), label_width(ctx, label) + wo + in.l * 2.0::f32 + in.r, rh);
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hd: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, PRESS);
    hand(ctx, hd);
    val pid: u64 = bid.child(id, "#popup");
    if (hd.clicked) {
        if (st.open != 0) { st.open = 0; }
        or {
            st.open = 1;
            if (hd.activated) {
                var at: usize = @selected;
                if (at >= count) { at = 0; }
                if (count > 0)   { context.focus(ctx, bid.child_int(pid, at::u64)); }
            }
        }
    }

    val hs: u8 = state_of(hd, st.open != 0, false);
    anim.box(ctx, id, theme.DROPDOWN, hs, x0, y0, x1, y1);

    val ty: f32        = text_top(ctx, y0, h);
    val tc: draw.Color = ink(ctx, theme.DROPDOWN, hs).text;
    label_at(ctx, label, x0 + in.l, ty, tc);
    if (@selected < count) {
        val cur: str = options[@selected];
        val cw:  f32 = context.text_width(ctx, cur);
        context.text_at(ctx, cur, x1 - in.r - cw, ty, tc);
    }

    val below: f32            = context.px(ctx, look(ctx, theme.DROPDOWN).margin.b);
    val pop:   Popup          = popup_at(ctx, pid, st.open, x0, y1 + below, x1 - x0, true, theme.POPUP);
    val oh:    f32            = row_of(ctx, theme.OPTION);
    val oin:   theme.Edges    = inset(ctx, theme.OPTION);
    val grp:   interact.Group = interact.begin_group(ctx, pid, interact.COLUMN);

    var changed: u8    = 0;
    var back:    bool  = false;
    var i:       usize = 0;
    for (i < count) {
        val oid: u64 = bid.child_int(pid, i::u64);
        if (pop.open != 0) {
            val o:   context.Area = place(ctx, wide(), layout.fit(), x1 - x0, oh);
            val ox0: f32          = o.x0;
            val oy0: f32          = o.y0;
            val ox1: f32          = o.x1;
            val oy1: f32          = o.y1;

            val ho: interact.Hit = interact.hit(ctx, oid, ox0, oy0, ox1, oy1, PRESS);
            hand(ctx, ho);
            if (i == @selected) { context.mark_current(ctx, oid); }
            if (ho.clicked) {
                @selected = i;
                changed   = 1;
                st.open   = 0;
                back      = true;
            }
            if (ho.focused && interact.presses(ctx, input.KEY_ESCAPE) != 0) {
                st.open = 0;
                back    = true;
            }

            val os: u8          = state_of(ho, false, false);
            val op: theme.Paint = anim.box(ctx, oid, theme.OPTION, os, ox0, oy0, ox1, oy1);
            context.text_at(ctx, options[i], ox0 + oin.l, text_top(ctx, oy0, oy1 - oy0), op.text);
        }
        i = i + 1;
    }
    interact.end_group(ctx, grp);
    end_popup(ctx, pop);

    if (pop.dismissed != 0) { st.open = 0; }
    if (back)               { context.focus(ctx, id); }
    ret changed;
}

# width of the utf-8 bytes [lo, hi) of s laid out on one line in the current style
fun bytes_width(ctx: *context.Context, s: *u8, lo: usize, hi: usize) f32 {
    if (hi <= lo) { ret 0.0::f32; }
    ret context.text_width_n(ctx, ?s[lo], hi - lo);
}

# width of the field's bytes [lo, hi) laid out on one line in the current style
fun span(ctx: *context.Context, f: *field.Field, lo: usize, hi: usize) f32 {
    ret edit.width(ctx, f, lo, hi);
}

# scroll the field's shown text so the caret is in view in w pixels, showing
# as much of the text as fits
fun keep_in_view(ctx: *context.Context, f: *field.Field, w: f32) {
    if (f.first > f.caret) { f.first = f.caret; }
    for (f.first < f.caret && span(ctx, f, f.first, f.caret) > w) { f.first = field.after(f, f.first); }
    for (f.first > 0 && span(ctx, f, field.before(f, f.first), f.len) <= w) { f.first = field.before(f, f.first); }
}

# the character boundary nearest x pixels right of the field's shown text
# start, one before it when x is left of it so a drag scrolls back
fun caret_at(ctx: *context.Context, f: *field.Field, x: f32) usize {
    if (x < 0.0::f32) { ret field.before(f, f.first); }
    var at: f32   = 0.0::f32;
    var i:  usize = f.first;
    for (i < f.len) {
        val n: usize = field.after(f, i);
        val w: f32   = span(ctx, f, i, n);
        if (x < at + w / 2.0::f32) { brk; }
        at = at + w;
        i  = n;
    }
    ret i;
}

# a full-width, one-line text field editing @f
#
# a press on it gives it the keyboard (see context.focus) and puts the caret
# under the cursor, or extends the selection to it with shift held; a double
# click selects the word and a triple click the line (see blit.edit.click),
# and dragging extends the selection by the same unit. a press elsewhere, or
# a frame it is not drawn in, takes the keyboard back. while it holds the
# keyboard it takes the frame's typed text and editing keys (see field.key)
# in order: shortcut C and X copy and cut the selection to the clipboard
# hand-off (see context.copied), shortcut V asks for the clipboard (see
# context.wants_paste) and takes the next frame's input.paste, and enter or
# escape end the edit and give the keyboard back. the text scrolls to keep
# the caret in view, and the caret blinks (see edit.caret_on). while it holds
# the keyboard it shows the IME's composition (see context.preedit) inline at
# the caret, underlined, and places the IME's candidate window at the caret
# (see context.ime_rect). it asks for the text pointer while hovered.
#
# the field's flags shape it: a MASKED field draws edit.MASK_GLYPH for each
# character, never copies and takes no composition, a READ_ONLY one moves and
# selects but takes no edit or composition, and a COUNT one shows its length
# (see edit.count_text) at its right end.
# ---
# ctx:  context
# key:  the field's key in the current id scope, so id_of(ctx, key) gives it the
#       keyboard with context.focus
# f:    the field's state, edited in place
# hint: dim text shown while it is empty and unfocused, nil for none
# ret:  this frame's outcome bits: field.EDITED, field.ENTERED, field.ESCAPED
pub fun text_field(ctx: *context.Context, key: str, f: *field.Field, hint: str) u8 {
    val in: theme.Edges  = inset(ctx, theme.FIELD);
    val cw: f32          = context.px(ctx, look(ctx, theme.FIELD_CARET).min_w);
    val nw: f32          = context.text_width(ctx, hint) + in.l + in.r + cw;
    val r:  context.Area = place(ctx, wide(), layout.fit(), nw, row_of(ctx, theme.FIELD));
    ret text_field_at(ctx, key, f, hint, r.x0, r.y0, r.x1, r.y1);
}

# a one-line text field editing @f in a rect, placing nothing
#
# the same field as text_field, for a control that lays out its own parts,
# such as a cell of a value editor (see blit.value).
# ---
# ctx:  context
# key:  the field's key in the current id scope
# f:    the field's state, edited in place
# hint: dim text shown while it is empty and unfocused, nil for none
# x0:   left x in pixels
# y0:   top y in pixels
# x1:   right x in pixels
# y1:   bottom y in pixels
# ret:  this frame's outcome bits: field.EDITED, field.ENTERED, field.ESCAPED
pub fun text_field_at(ctx: *context.Context, key: str, f: *field.Field, hint: str, x0: f32, y0: f32, x1: f32, y1: f32) u8 {
    val id: u64         = context.id_of(ctx, key);
    val in: theme.Edges = inset(ctx, theme.FIELD);
    val cw: f32         = context.px(ctx, look(ctx, theme.FIELD_CARET).min_w);
    val h:  f32         = y1 - y0;
    val tx: f32         = x0 + in.l;
    var tw: f32         = maxf(x1 - x0 - in.l - in.r, 0.0::f32);

    var counted: [42]u8;
    var count:   str = nil;
    var count_w: f32 = 0.0::f32;
    if (field.has(f, field.COUNT)) {
        count   = edit.count_text(f, ?counted[0]);
        count_w = context.text_width(ctx, count);
        tw      = maxf(tw - count_w - in.r, 0.0::f32);
    }

    val hf: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, PRESS | interact.ARROWS | interact.TEXT);
    if (hf.hot) { context.set_cursor(ctx, input.CURSOR_TEXT); }
    if (hf.pressed) {
        context.focus(ctx, id);
        keep_in_view(ctx, f, tw);
        edit.press(ctx, id, f, caret_at(ctx, f, hf.mx - tx), hf.clicks);
    }
    or (hf.held && ctx.focus == id) {
        keep_in_view(ctx, f, tw);
        edit.drag(ctx, id, f, caret_at(ctx, f, hf.mx - tx));
    }
    var out: u8 = 0;
    if (context.focused(ctx, id)) { out = edit.feed(ctx, id, f); }
    val on:    bool = ctx.focus == id;
    val quiet: bool = field.has(f, field.MASKED) || field.has(f, field.READ_ONLY);

    val fs: u8           = state_of(hf, false, on);
    val fp: *theme.Paint = ink(ctx, theme.FIELD, fs);
    val cc: draw.Color   = ink(ctx, theme.FIELD_CARET, fs).fill;
    context.box(ctx, theme.FIELD, fs, x0, y0, x1, y1);

    keep_in_view(ctx, f, tw);
    val lh: f32 = context.line_height(ctx);
    val ty: f32 = y0 + (h - lh) / 2.0::f32;
    if (count != nil) { context.text_at(ctx, count, x1 - in.r - count_w, ty, fp.mark); }
    context.push_clip(ctx, tx, y0, tx + tw, y1);
    if (f.len == 0 && !on) { context.text_at(ctx, hint, tx, ty, fp.mark); }
    if (on && field.selected(f)) {
        var lo: usize = field.sel_lo(f);
        if (lo < f.first) { lo = f.first; }
        val sx0: f32 = tx + span(ctx, f, f.first, lo);
        val sx1: f32 = tx + span(ctx, f, f.first, field.sel_hi(f));
        context.quad(ctx, sx0, ty, sx1, ty + lh, ink(ctx, theme.FIELD_SELECT, fs).fill);
    }
    var pre: str = nil;
    if (!quiet) { pre = context.preedit(ctx, id); }
    var cx: f32 = tx + span(ctx, f, f.first, f.caret);
    if (pre == nil) { edit.draw_text(ctx, f, f.first, f.len, tx, ty, fp.text); }
    or {
        val pw: f32 = bytes_width(ctx, pre, 0, str_len(pre));
        edit.draw_text(ctx, f, f.first, f.caret, tx, ty, fp.text);
        context.text_at(ctx, pre, cx, ty, fp.text);
        context.quad(ctx, cx, ty + lh - cw, cx + pw, ty + lh, cc);
        edit.draw_text(ctx, f, f.caret, f.len, cx + pw, ty, fp.text);
        cx = cx + bytes_width(ctx, pre, 0, context.preedit_caret(ctx));
    }
    context.pop_clip(ctx);
    if (on) {
        if (edit.caret_on(ctx, id)) { context.quad(ctx, cx, ty, cx + cw, ty + lh, cc); }
        if (!quiet)                 { context.set_ime_rect(ctx, cx, ty, cx + cw, ty + lh); }
    }
    ret out;
}

# hit-test an arbitrary rect with button click semantics
#
# returns 1 on the frame the primary button releases while the rect is hovered,
# after being pressed on it. emits no geometry, the consumer draws the affordance
# (an icon, a corner toggle) itself. the rect is in local coordinates and is
# clipped and layered like geometry.
# ---
# ctx: context
# key: the region's key in the current id scope
# x0:  left x in pixels
# y0:  top y in pixels
# x1:  right x in pixels
# y1:  bottom y in pixels
# ret: 1 if the rect was clicked this frame, else 0
pub fun region_clicked(ctx: *context.Context, key: str, x0: f32, y0: f32, x1: f32, y1: f32) u8 {
    val h: interact.Hit = interact.hit(ctx, context.id_of(ctx, key), x0, y0, x1, y1, input.BUTTON_LEFT);
    hand(ctx, h);
    if (h.clicked) { ret 1; }
    ret 0;
}

# draw a region of a consumer texture w by h at the cursor and advance to the
# next row
#
# the region stretches to fill the rect, drawn with its texels as they are.
# see context.image_at to draw one into an arbitrary rect or tinted.
# ---
# ctx: context
# img: the texture region and its sampling filter
# w:   width in pixels
# h:   height in pixels
pub fun image(ctx: *context.Context, img: draw.Image, w: f32, h: f32) {
    val white: draw.Color   = draw.rgba(1.0::f32, 1.0::f32, 1.0::f32, 1.0::f32);
    val r:     context.Area = place(ctx, layout.fit(), layout.fit(), w, h);
    context.image_at(ctx, img, r.x0, r.y0, r.x1, r.y1, white);
}

# colors that values from lo to hi map onto in count equal steps
# ---
# colors: the steps, lowest value first
# count:  number of colors
# lo:     value mapped to the first color, and everything below it
# hi:     value mapped to the last color, and everything above it
pub rec Palette {
    colors: *draw.Color;
    count:  usize;
    lo:     f32;
    hi:     f32;
}

# the palette step a value falls in
#
# the range divides into count equal steps, clamped at both ends, so a value
# never blends between colors. an empty palette gives transparent black.
# ---
# p:   palette
# v:   value
# ret: the step's color
pub fun palette_color(p: Palette, v: f32) draw.Color {
    if (p.count == 0 || p.colors == nil) { ret draw.rgba(0.0::f32, 0.0::f32, 0.0::f32, 0.0::f32); }
    var i: usize = 0;
    if (p.hi > p.lo) {
        val t: f32 = (v - p.lo) / (p.hi - p.lo);
        if (t >= 1.0::f32) { i = p.count - 1; }
        or (t > 0.0::f32)  { i = (t * p.count::f32)::usize; }
    }
    if (i >= p.count) { i = p.count - 1; }
    ret p.colors[i];
}

# a discrete field of cols by rows cells, stored row-major from the top left
#
# each cell's color is the consumer's colors[i] when colors is set, else
# values[i] mapped through palette. a field with neither draws nothing.
# ---
# cols:    cells across
# rows:    cells down
# colors:  cols * rows consumer-mapped colors, or nil to map values
# values:  cols * rows values mapped through palette when colors is nil
# palette: the steps values map onto
pub rec Grid {
    cols:    usize;
    rows:    usize;
    colors:  *draw.Color;
    values:  *f32;
    palette: Palette;
}

# draw a field as solid colored cells filling a rect
#
# cells tile the rect edge to edge with no seams and sample the atlas, so a
# small field needs no consumer texture. a field too large to draw cell by
# cell belongs in a texture drawn with image and FILTER_NEAREST instead.
# ---
# ctx: context
# g:   the field
# x0:  left x in pixels
# y0:  top y in pixels
# x1:  right x in pixels
# y1:  bottom y in pixels
pub fun grid_at(ctx: *context.Context, g: Grid, x0: f32, y0: f32, x1: f32, y1: f32) {
    if (g.cols == 0 || g.rows == 0)         { ret; }
    if (g.colors == nil && g.values == nil) { ret; }
    val w: f32   = x1 - x0;
    val h: f32   = y1 - y0;
    var r: usize = 0;
    for (r < g.rows) {
        val cy0: f32   = y0 + h * r::f32 / g.rows::f32;
        val cy1: f32   = y0 + h * (r + 1)::f32 / g.rows::f32;
        var c:   usize = 0;
        for (c < g.cols) {
            val cx0: f32   = x0 + w * c::f32 / g.cols::f32;
            val cx1: f32   = x0 + w * (c + 1)::f32 / g.cols::f32;
            val i:   usize = r * g.cols + c;
            var col: draw.Color;
            if (g.colors != nil) { col = g.colors[i]; }
            or                   { col = palette_color(g.palette, g.values[i]); }
            context.quad(ctx, cx0, cy0, cx1, cy1, col);
            c = c + 1;
        }
        r = r + 1;
    }
}

# draw a field w by h at the cursor and advance to the next row
# ---
# ctx: context
# g:   the field
# w:   width in pixels
# h:   height in pixels
pub fun grid(ctx: *context.Context, g: Grid, w: f32, h: f32) {
    val r: context.Area = place(ctx, layout.fit(), layout.fit(), w, h);
    grid_at(ctx, g, r.x0, r.y0, r.x1, r.y1);
}

# window flags a call declares, combined with |
# ---
# WINDOW_NO_TITLE:      no titlebar, so no collapse box, close button or title drag
# WINDOW_NO_RESIZE:     no resize grips
# WINDOW_NO_MOVE:       the titlebar does not drag the window
# WINDOW_NO_BACKGROUND: the body is not painted, though it still stops input
# WINDOW_NO_CLOSE:      no close button
# WINDOW_AUTO_SIZE:     the size follows the content, within the size bounds,
#                       instead of scrolling it, and the grips are gone
pub val WINDOW_NO_TITLE:      u32 = 1;
pub val WINDOW_NO_RESIZE:     u32 = 2;
pub val WINDOW_NO_MOVE:       u32 = 4;
pub val WINDOW_NO_BACKGROUND: u32 = 8;
pub val WINDOW_NO_CLOSE:      u32 = 16;
pub val WINDOW_AUTO_SIZE:     u32 = 32;

# the payload type a window's titlebar drags, carrying the window's id as a u64
pub val WINDOW_KIND: str = "window";

# bytes of a docked window's title its tab keeps, the NUL included
pub val DOCK_LABEL: usize = 64;

# the edges a resize grip moves, combined with |
val EDGE_L: u32 = 1;
val EDGE_R: u32 = 2;
val EDGE_T: u32 = 4;
val EDGE_B: u32 = 8;

# every resize grip by the edges it moves: four edges, then four corners
val GRIPS: [8]u32 = [8]u32{1, 2, 4, 8, 5, 6, 9, 10};

# added to a pinned window's z for its slot, so it stays above every unpinned one
val PIN_SLOT: u64 = 0x800000;

# what a call declares about a window, every frame it is drawn
#
# the rect is where the window first opens. from then on its state in the
# context's store (WindowState) holds where it is, so moving, resizing and
# reloading are never undone by the call. a size bound of 0 is no bound.
# ---
# title: titlebar text, and the window's key (see context.id_of)
# x:     left the window first opens at, in screen pixels
# y:     top the window first opens at, in screen pixels
# w:     width the window first opens with
# h:     height the window first opens with, titlebar included
# min_w: least width, raised to fit the titlebar's boxes
# min_h: least height, raised to the titlebar's
# max_w: greatest width, 0 for none
# max_h: greatest height, 0 for none
# flags: WINDOW_* flags
pub rec Window {
    title: str;
    x:     f32;
    y:     f32;
    w:     f32;
    h:     f32;
    min_w: f32;
    min_h: f32;
    max_w: f32;
    max_h: f32;
    flags: u32;
}

# where a dragged part stood when the press on it began, kept in the state
# store under the part's id
# ---
# x: the window's x, unused by a scrollbar thumb
# y: the window's y, or the scroll offset under a scrollbar thumb
# w: the window's width, for a resize grip
# h: the window's height, for a resize grip
rec Grab {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

# a window declaration with no size bounds and no flags
# ---
# title: titlebar text, and the window's key
# x:     left it first opens at, in screen pixels
# y:     top it first opens at, in screen pixels
# w:     width it first opens with
# h:     height it first opens with, titlebar included
# ret:   the declaration
pub fun window(title: str, x: f32, y: f32, w: f32, h: f32) Window {
    ret Window{
        title: title, x: x, y: y, w: w, h: h,
        min_w: 0.0::f32, min_h: 0.0::f32, max_w: 0.0::f32, max_h: 0.0::f32, flags: 0
    };
}

# the state a window keeps in the context's store under its id
#
# zeroed, it is a window that has not opened yet: open, expanded, unpinned and
# unlocked. persist_windows makes it saved and loaded with the rest of the
# store. reach it with window_state to open, close, pin or lock a window.
# ---
# x:         window left in screen pixels
# y:         window top in screen pixels
# w:         window width in pixels
# h:         window height in pixels, titlebar included
# z:         place in the window stack, higher in front (see context.raise)
# placed:    1 once the window took its first rect, else 0
# closed:    1 once the close button or the caller closed it, else 0
# collapsed: 1 if only the titlebar shows, else 0
# pinned:    1 to keep the window above every unpinned window, else 0
# locked:    1 to keep the window from moving or resizing, else 0
# slot:      the slot in the windows band it last drew on, which the claims
#            routing this frame's input carry
pub rec WindowState {
    x:         f32;
    y:         f32;
    w:         f32;
    h:         f32;
    z:         u64;
    placed:    u8;
    closed:    u8;
    collapsed: u8;
    pinned:    u8;
    locked:    u8;
    slot:      u32;
}

# where a dock holds a window, kept in the store under the window's id while
# it is docked (see blit.dock)
#
# the dock writes where the window goes and the window writes what its tab
# shows, so neither reaches into the other: begin_window draws a window with a
# Docked whose node is not 0 into the rect its dock last laid out, with no
# chrome of its own, and only while its tab is the selected one.
# ---
# id:       the window's id
# node:     the dock node, a tab stack, the window sits in
# rank:     its place among the node's tabs, lowest first
# anchored: 1 for a dock's own panel, which never floats (see blit.dock.begin_dock)
# front:    1 while its tab is the node's selected one
# placed:   the store frame plus one the dock last laid it out in, 0 before any
# x0:       body left in screen pixels, as last laid out
# y0:       body top
# x1:       body right
# y1:       body bottom
# drawn:    the store frame plus one the window was last drawn in, 0 before any
# min_w:    the least width its declaration asks for
# min_h:    the least height its declaration asks for, titlebar included
# bare:     1 when it is declared without a title, so a node holding it alone
#           shows no tabs
# closable: 1 when its tab may close it
# label:    the drawn part of its title, cut to fit, NUL-terminated
pub rec Docked {
    id:       u64;
    node:     u64;
    rank:     f64;
    anchored: u8;
    front:    u8;
    placed:   u64;
    x0:       f32;
    y0:       f32;
    x1:       f32;
    y1:       f32;
    drawn:    u64;
    min_w:    f32;
    min_h:    f32;
    bare:     u8;
    closable: u8;
    label:    [64]u8;
}

# the store frame plus one, the stamp Docked's placed and drawn take
# ---
# ctx: context
# ret: nonzero, one more each frame
pub fun dock_stamp(ctx: *context.Context) u64 {
    ret ctx.store.frame + 1;
}

# record what a docked window's tab shows and how small its node may get
# ---
# ctx:   context
# dk:    the window's Docked
# label: its title or key, of which the part before "##" is kept
# bare:  1 when it has no title
# close: 1 when its tab may close it
# min_w: least width
# min_h: least height
pub fun dock_note(ctx: *context.Context, dk: *Docked, label: str, bare: u8, close: u8, min_w: f32, min_h: f32) {
    dk.drawn    = dock_stamp(ctx);
    dk.bare     = bare;
    dk.closable = close;
    dk.min_w    = min_w;
    dk.min_h    = min_h;
    var n: usize = bid.shown(label);
    if (n > DOCK_LABEL - 1) {
        n = DOCK_LABEL - 1;
        # never cut a utf-8 sequence in two
        for (n > 0 && (label[n] & 0xC0u8) == 0x80u8) { n = n - 1; }
    }
    var i: usize = 0;
    for (i < n) {
        dk.label[i] = label[i];
        i           = i + 1;
    }
    dk.label[n] = 0;
}

# whether a dock laid a docked window out this frame or the one before, so
# the rect it holds is current
# ---
# ctx: context
# dk:  the window's Docked
# ret: true when its rect is current
pub fun dock_placed(ctx: *context.Context, dk: *Docked) bool {
    ret dk.placed != 0 && dk.placed + 1 >= dock_stamp(ctx);
}

# the handle begin_window returns for end_window
# ---
# id:     the window's id
# st:     the window's state, valid until end
# flags:  the WINDOW_* flags declared
# shown:  1 if the window is drawn this frame, 0 while it is closed
# body:   1 if its body takes widgets this frame, 0 while closed or collapsed
# th:     titlebar height, 0 without one
# ch:     the channels the shadow and body, the titlebar and the children draw in
# claim:  the window's reserved claim, beneath everything in it
# scroll: the scroll region the body is laid out in, unless auto-sized
# sc:     the body's scroll state
# hidden: 1 while an auto-sized window with no width yet lays out only to
#         measure, drawing and claiming nothing
# docked: 1 while it draws where its dock placed it
# need_w: the width the titlebar needs
# min_w:  least width
# max_w:  greatest width
# min_h:  least height
# max_h:  greatest height
pub rec WindowArea {
    id:     u64;
    st:     *WindowState;
    flags:  u32;
    shown:  u8;
    body:   u8;
    th:     f32;
    ch:     context.Channels;
    claim:  usize;
    scroll: ScrollArea;
    sc:     *Scroll;
    hidden: u8;
    docked: u8;
    need_w: f32;
    min_w:  f32;
    max_w:  f32;
    min_h:  f32;
    max_h:  f32;
}

# the state of the window titled or keyed key in the current id scope
#
# set closed to 0 to reopen a window, or pinned and locked to pin or lock one.
# ---
# ctx: context
# key: the window's title or key
# ret: its state, valid until end
pub fun window_state(ctx: *context.Context, key: str) *WindowState {
    ret state.get[WindowState](ctx, context.id_of(ctx, key));
}

# save and load every window's place, size, open and collapsed state, stack
# order, pin and lock with the context's store (see blit.state.save and load)
#
# windows are saved as [window.<id>] tables.
# ---
# ctx: context
# ret: ok, or the registry's refusal
pub fun persist_windows(ctx: *context.Context) err[state.Error] {
    ret state.register[WindowState](ctx, "window", window_save, window_load);
}

# write a window's state into its table
fun window_save(st: *WindowState, w: *state.Writer) {
    state.put_float(w, "x", st.x::f64);
    state.put_float(w, "y", st.y::f64);
    state.put_float(w, "w", st.w::f64);
    state.put_float(w, "h", st.h::f64);
    state.put_int(w, "z", st.z::i64);
    state.put_bool(w, "closed", st.closed);
    state.put_bool(w, "collapsed", st.collapsed);
    state.put_bool(w, "pinned", st.pinned);
    state.put_bool(w, "locked", st.locked);
}

# read a window's state from its table, placed once it holds a rect
fun window_load(st: *WindowState, t: *toml.Table) {
    val x: opt[f64]  = toml.get_float(t, "x");
    val y: opt[f64]  = toml.get_float(t, "y");
    val w: opt[f64]  = toml.get_float(t, "w");
    val h: opt[f64]  = toml.get_float(t, "h");
    val z: opt[i64]  = toml.get_int(t, "z");
    val c: opt[bool] = toml.get_bool(t, "closed");
    val f: opt[bool] = toml.get_bool(t, "collapsed");
    val p: opt[bool] = toml.get_bool(t, "pinned");
    val l: opt[bool] = toml.get_bool(t, "locked");
    if (sel x.some) {
        if (sel y.some) {
            if (sel w.some) {
                if (sel h.some) {
                    st.x      = x.some::f32;
                    st.y      = y.some::f32;
                    st.w      = w.some::f32;
                    st.h      = h.some::f32;
                    st.placed = 1;
                }
            }
        }
    }
    if (sel z.some) {
        if (z.some > 0) { st.z = z.some::u64; }
    }
    if (sel c.some) { st.closed = c.some; }
    if (sel f.some) { st.collapsed = f.some; }
    if (sel p.some) { st.pinned = p.some; }
    if (sel l.some) { st.locked = l.some; }
}

# the windows the store keeps, gathered to be renumbered
# ---
# items: the windows' state, nil while counting
# n:     windows counted or gathered
rec WindowList {
    items: **WindowState;
    n:     usize;
}

# count one window
fun count_window(st: *WindowState, user: ptr) {
    val g: *WindowList = user::*WindowList;
    g.n = g.n + 1;
}

# gather one window
fun gather_window(st: *WindowState, user: ptr) {
    val g: *WindowList = user::*WindowList;
    g.items[g.n] = st;
    g.n          = g.n + 1;
}

# give every window the store keeps, drawn this frame or not, z 1 to n in
# the order they hold, so a window coming back never shares a layer
#
# if the list cannot be allocated, oom is set and the z keep growing.
fun renumber_windows(ctx: *context.Context) {
    var g: WindowList;
    state.each[WindowState](ctx, count_window, (?g)::ptr);
    val n: usize = g.n;
    if (n == 0) { ret; }
    val got: res[**WindowState, allo.Error] = allo.allocate[*WindowState](ctx.a, n);
    if (sel got.err) {
        ctx.oom = 1;
        ret;
    }
    g.items = got.ok;
    g.n     = 0;
    state.each[WindowState](ctx, gather_window, (?g)::ptr);
    var i: usize = 1;
    for (i < g.n) {
        val p: *WindowState = g.items[i];
        var j: usize        = i;
        for (j > 0 && g.items[j - 1].z > p.z) {
            g.items[j] = g.items[j - 1];
            j          = j - 1;
        }
        g.items[j] = p;
        i          = i + 1;
    }
    var k: usize = 0;
    for (k < g.n) {
        if (g.items[k].placed != 0) { g.items[k].z = k::u64 + 1; }
        k = k + 1;
    }
    context.restack(ctx, g.n::u64);
    val freed: err[allo.Error] = allo.deallocate[*WindowState](ctx.a, g.items, n);
    if (sel freed.err) { ctx.oom = 1; }
}

# a window's slot in the windows band
fun window_slot(st: *WindowState) u32 {
    var s: u64 = st.z;
    if (st.pinned != 0)         { s = s + PIN_SLOT; }
    if (s > band.SLOT_MAX::u64) { s = band.SLOT_MAX::u64; }
    ret s::u32;
}

# the id of a window's resize grip moving the edges in mask
fun grip_id(id: u64, mask: u32) u64 {
    ret bid.child_int(bid.child(id, "#grip"), mask::u64);
}

# the pointer shape over a grip moving the edges in mask
fun grip_cursor(mask: u32) u8 {
    if (mask == EDGE_L || mask == EDGE_R)                       { ret input.CURSOR_RESIZE_EW; }
    if (mask == EDGE_T || mask == EDGE_B)                       { ret input.CURSOR_RESIZE_NS; }
    if (mask == (EDGE_L | EDGE_T) || mask == (EDGE_R | EDGE_B)) { ret input.CURSOR_RESIZE_NWSE; }
    ret input.CURSOR_RESIZE_NESW;
}

# a size bound declared as 0 for none, as a bound
fun bound(v: f32) f32 {
    if (v > 0.0::f32) { ret v; }
    ret 1.0e30::f32;
}

# draw a window's chrome and, when open and expanded, start its body column
#
# a window is identified by its title's id (see context.id_of), and keeps its
# place, size, stack order and open and collapsed state under it in the
# context's store, so reordering the calls never moves or restacks it. it
# opens at the declared rect, in front of every other window.
#
# windows paint and take input in the windows band (see blit.band), stacked by
# the z order the context keeps: a press anywhere on a window brings it to the
# front, whatever order the windows are called in, and pinned windows stay
# above unpinned ones. its whole rect stops input to what it covers.
#
# the titlebar drags the window and holds a collapse box on the left and a
# close button on the right. grips along every edge and corner resize it
# within its size bounds, asking for the matching resize cursor. a locked
# window neither moves nor resizes. the body is a scroll region below the
# titlebar, or with WINDOW_AUTO_SIZE a column the window's size follows: its
# width is the widest natural width of its widgets and its titlebar, measured
# the frame before, and its height what its widgets take this frame. an
# auto-sized window declared 0 wide lays out its first frame hidden, only to
# measure.
# the titlebar is a drag source of WINDOW_KIND carrying the window's id, which
# a dock takes in (see blit.dock). a docked window instead draws in the rect
# its dock last laid out (see Docked), in the docked band, with no chrome, its
# body a scroll region whatever its flags, and has no body while another tab
# of its stack is selected. its content and ids are the same either way.
# widgets placed while the returned body is 1 fill it, in screen pixels. the
# window is an id scope for them. pair every begin_window with an end_window,
# closed or not.
# ---
# ctx: context
# win: what the call declares about the window
# ret: a handle for end_window
pub fun begin_window(ctx: *context.Context, win: Window) WindowArea {
    var r: WindowArea;
    r.claim = context.NO_CLAIM;
    r.flags = win.flags;
    r.id    = context.id_of(ctx, win.title);

    val st: *WindowState = state.get[WindowState](ctx, r.id);
    r.st = st;
    if (st.placed == 0) {
        st.x      = win.x;
        st.y      = win.y;
        st.w      = win.w;
        st.h      = win.h;
        st.z      = context.raise(ctx);
        st.placed = 1;
    }
    context.note_z(ctx, st.z);
    if (st.closed != 0) { ret r; }
    val dk: *Docked = state.find[Docked](ctx, r.id);
    if (dk != nil && dk.node != 0) { ret begin_docked(ctx, win, r, dk); }
    r.shown = 1;

    var th: f32 = row_of(ctx, theme.WINDOW_TITLE);
    if ((win.flags & WINDOW_NO_TITLE) != 0) { th = 0.0::f32; }
    r.th = th;
    val min_w: f32 = maxf(win.min_w, th * 3.0::f32);
    val min_h: f32 = maxf(win.min_h, th);
    val max_w: f32 = maxf(bound(win.max_w), min_w);
    val max_h: f32 = maxf(bound(win.max_h), min_h);
    r.min_w = min_w;
    r.max_w = max_w;
    r.min_h = min_h;
    r.max_h = max_h;
    val auto: bool = (win.flags & WINDOW_AUTO_SIZE) != 0;

    # a press on the layer the window last drew on brings it to the front
    # this frame
    # and so does the keyboard moving the focus onto it
    var lift: bool = input.pressed(ctx.in, input.BUTTON_LEFT) != 0 && ctx.hover != 0
        && context.hovered_layer(ctx) == band.layer(band.WINDOWS, st.slot);
    val went: opt[u32] = context.moved_to(ctx);
    if (sel went.some) {
        if (went.some == band.layer(band.WINDOWS, st.slot)) { lift = true; }
    }
    if (lift) {
        if (context.z_top(ctx) >= context.Z_RENUMBER) { renumber_windows(ctx); }
        st.z = context.raise(ctx);
    }
    st.slot = window_slot(st);
    context.push_band(ctx, band.WINDOWS, st.slot);
    context.push_id(ctx, r.id);
    if (auto && st.w <= 0.0::f32) {
        r.hidden = 1;
        context.push_measure(ctx);
        context.wake_at(ctx, ctx.in.time);
    }

    val drag_id:  u64 = bid.child(r.id, "#drag");
    val col_id:   u64 = bid.child(r.id, "#collapse");
    val close_id: u64 = bid.child(r.id, "#close");
    val movable:  u8  = ((win.flags & WINDOW_NO_MOVE) == 0 && st.locked == 0);
    val sizable:  u8  = ((win.flags & (WINDOW_NO_RESIZE | WINDOW_AUTO_SIZE)) == 0 && st.locked == 0);

    # follow a drag or a resize from where the window stood at the press,
    # before claiming, so the claims match where the window paints
    var dx: f32;
    var dy: f32;
    if (movable != 0 && interact.drag(ctx, drag_id, ?dx, ?dy)) {
        val grab: *Grab = state.get[Grab](ctx, drag_id);
        st.x = grab.x + dx;
        st.y = grab.y + dy;
    }
    var g: usize = 0;
    for (sizable != 0 && g < 8) {
        val m:   u32 = GRIPS[g];
        val gid: u64 = grip_id(r.id, m);
        if (interact.drag(ctx, gid, ?dx, ?dy)) {
            val grab: *Grab = state.get[Grab](ctx, gid);
            if ((m & EDGE_L) != 0) {
                st.w = clampf(grab.w - dx, min_w, max_w);
                st.x = grab.x + grab.w - st.w;
            }
            if ((m & EDGE_R) != 0) { st.w = clampf(grab.w + dx, min_w, max_w); }
            if ((m & EDGE_T) != 0) {
                st.h = clampf(grab.h - dy, min_h, max_h);
                st.y = grab.y + grab.h - st.h;
            }
            if ((m & EDGE_B) != 0) { st.h = clampf(grab.h + dy, min_h, max_h); }
        }
        g = g + 1;
    }
    st.w = clampf(st.w, min_w, max_w);
    if ((win.flags & WINDOW_AUTO_SIZE) == 0) { st.h = clampf(st.h, min_h, max_h); }

    r.claim = context.reserve_claim(ctx, r.id);
    # the window's shadow and body draw beneath its titlebar, which draws
    # beneath its widgets
    r.ch = context.split(ctx, 3);
    context.set_channel(ctx, r.ch, 1);

    val x0: f32 = st.x;
    val x1: f32 = st.x + st.w;
    val y0: f32 = st.y;
    if (th > 0.0::f32) {
        val ty1:   f32 = y0 + th;
        var dx1:   f32 = x1;
        val close: u8  = (win.flags & WINDOW_NO_CLOSE) == 0;
        if (close != 0) { dx1 = x1 - th; }
        val tin: theme.Edges = inset(ctx, theme.WINDOW_TITLE);
        r.need_w = th + tin.l + tin.r + label_width(ctx, win.title) + (x1 - dx1);

        val chrome: interact.Group = interact.begin_group(ctx, bid.child(r.id, "#chrome"), interact.ROW);
        val hc:     interact.Hit   = interact.hit(ctx, col_id, x0, y0, x0 + th, ty1, PRESS);
        hand(ctx, hc);
        if (hc.clicked) {
            if (st.collapsed == 0) { st.collapsed = 1; }
            or                     { st.collapsed = 0; }
        }

        var hx: interact.Hit;
        if (close != 0) {
            hx = interact.hit(ctx, close_id, dx1, y0, x1, ty1, PRESS);
            hand(ctx, hx);
            if (hx.clicked) { st.closed = 1; }
        }
        interact.end_group(ctx, chrome);

        val hd: interact.Hit = interact.hit(ctx, drag_id, x0 + th, y0, dx1, ty1, input.BUTTON_LEFT);
        if (movable != 0) {
            if (hd.pressed) {
                val grab: *Grab = state.get[Grab](ctx, drag_id);
                grab.x = st.x;
                grab.y = st.y;
            }
            if (hd.hot || hd.active) { context.set_cursor(ctx, input.CURSOR_MOVE); }
            var wid: u64      = r.id;
            val dg:  dnd.Drag = dnd.source(ctx, hd, WINDOW_KIND, (?wid)::ptr, $size_of(u64), x0, y0, x1, ty1);
        }

        val ts:   u8 = theme.pick(hd.hot || hc.hot || hx.hot, hd.active || hc.active || hx.active, false, false);
        var ends: u8 = context.CORNERS_ALL;
        if (st.collapsed == 0) { ends = context.CORNERS_TOP; }
        context.box_face(ctx, theme.WINDOW_TITLE, ts, x0, y0, x1, ty1, ends, context.SIDES_ALL);

        val tp:  *theme.Paint = ink(ctx, theme.WINDOW_TITLE, ts);
        val gy:  f32          = text_top(ctx, y0, th);
        var gch: u32          = '+';
        if (st.collapsed == 0) { gch = '-'; }
        context.glyph(ctx, gch, x0 + tin.l, gy, tp.mark);
        label_at(ctx, win.title, x0 + th + tin.l, gy, tp.text);
        if (close != 0) {
            var xc: draw.Color = tp.mark;
            if (hx.hot) { xc = tp.text; }
            context.glyph(ctx, 'x', dx1 + tin.l, gy, xc);
        }
    }
    context.set_channel(ctx, r.ch, 2);
    if (st.collapsed != 0 && th > 0.0::f32) { ret r; }

    r.body = 1;
    val p: theme.Edges = padding(ctx, theme.WINDOW);
    if (auto) {
        open_column(ctx, x0 + p.l, y0 + th + p.t, maxf(st.w - p.l - p.r, 0.0::f32), 0.0::f32);
        ret r;
    }
    val body_id: u64          = bid.child(r.id, "#body");
    val inner:   context.Area = context.Area{
        x0: x0 + p.l, y0: y0 + th + p.t, x1: maxf(x1 - p.r, x0 + p.l), y1: maxf(y0 + st.h - p.b, y0 + th + p.t)
    };
    r.sc     = state.get[Scroll](ctx, body_id);
    r.scroll = scroll_in(ctx, body_id, r.sc, inner, 0);
    ret r;
}

# begin_window for a window its dock holds: no chrome, a scroll region over
# the rect the dock laid out, and nothing at all while another tab is selected
fun begin_docked(ctx: *context.Context, win: Window, r: WindowArea, dk: *Docked) WindowArea {
    var out:  WindowArea = r;
    val bare: u8         = (win.flags & WINDOW_NO_TITLE) != 0;
    val shut: u8         = (win.flags & WINDOW_NO_CLOSE) == 0;
    var th:   f32        = row_h(ctx);
    if (bare != 0) { th = 0.0::f32; }
    dock_note(ctx, dk, win.title, bare, shut, maxf(win.min_w, th * 3.0::f32), maxf(win.min_h, th));
    if (dk.front == 0 || !dock_placed(ctx, dk)) { ret out; }

    out.shown  = 1;
    out.docked = 1;
    out.body   = 1;
    context.push_band(ctx, band.DOCKED, 0);
    context.push_id(ctx, out.id);
    out.claim = context.reserve_claim(ctx, out.id);
    out.ch    = context.split(ctx, 2);
    context.set_channel(ctx, out.ch, 1);
    val body_id: u64 = bid.child(out.id, "#body");
    out.sc     = state.get[Scroll](ctx, body_id);
    out.scroll = scroll_in(ctx, body_id, out.sc, context.Area{x0: dk.x0, y0: dk.y0, x1: dk.x1, y1: dk.y1}, 0);
    ret out;
}

# end_window for a window its dock holds
fun end_docked(ctx: *context.Context, r: WindowArea) {
    end_scroll(ctx, r.sc, r.scroll);
    context.set_channel(ctx, r.ch, 0);
    val x0: f32 = r.scroll.x;
    val y0: f32 = r.scroll.y;
    val x1: f32 = r.scroll.x + r.scroll.w;
    val y1: f32 = r.scroll.y + r.scroll.h;
    if ((r.flags & WINDOW_NO_BACKGROUND) == 0) { context.box_face(ctx, theme.DOCK, theme.NORMAL, x0, y0, x1, y1, context.CORNERS_ALL, 0); }
    context.merge(ctx, r.ch);
    context.fill_claim(ctx, r.claim, x0, y0, x1, y1);
    context.pop_id(ctx);
    context.pop_band(ctx);
}

# close a window: paint its body beneath its widgets, give its claim its rect
# (the titlebar alone while collapsed), claim its resize grips above
# everything in it and restore the caller's layout
#
# an auto-sized window takes the height its widgets reached, and from the next
# frame the widest of them.
# ---
# ctx: context
# r:   the value returned by begin_window
pub fun end_window(ctx: *context.Context, r: WindowArea) {
    if (r.shown == 0) { ret; }
    if (r.docked != 0) {
        end_docked(ctx, r);
        ret;
    }
    val st: *WindowState = r.st;
    val x0: f32          = st.x;
    val x1: f32          = st.x + st.w;
    val y0: f32          = st.y;
    var y1: f32          = st.y + r.th;
    if (r.body != 0) {
        if ((r.flags & WINDOW_AUTO_SIZE) != 0) {
            val p: theme.Edges   = padding(ctx, theme.WINDOW);
            val f: *layout.Frame = context.top_layout(ctx);
            y1   = clampf(f.y + p.b, y0 + r.min_h, y0 + r.max_h);
            st.h = y1 - y0;
            st.w = clampf(maxf(f.need_w + p.l + p.r, r.need_w), r.min_w, r.max_w);
            context.pop_layout(ctx);
        }
        or {
            end_scroll(ctx, r.sc, r.scroll);
            y1 = y0 + st.h;
        }
    }
    context.set_channel(ctx, r.ch, 0);
    if ((r.flags & WINDOW_NO_BACKGROUND) == 0) {
        context.box_shadow(ctx, theme.WINDOW, theme.NORMAL, x0, y0, x1, y1, context.CORNERS_ALL);
        if (r.body != 0) {
            var ends: u8 = context.CORNERS_BOTTOM;
            if (r.th == 0.0::f32) { ends = context.CORNERS_ALL; }
            context.box_face(ctx, theme.WINDOW, theme.NORMAL, x0, y0 + r.th, x1, y1, ends, context.SIDES_ALL);
        }
    }
    context.merge(ctx, r.ch);
    context.fill_claim(ctx, r.claim, x0, y0, x1, y1);

    # the grips run just outside the edges, so they never cover the window's
    # own widgets, and meet in squares at the corners
    if (r.body != 0 && (r.flags & (WINDOW_NO_RESIZE | WINDOW_AUTO_SIZE)) == 0 && st.locked == 0) {
        val gm: theme.Edges = context.px_edges(ctx, look(ctx, theme.WINDOW).margin);
        var k:  usize       = 0;
        for (k < 8) {
            val m:   u32 = GRIPS[k];
            var gx0: f32 = x0;
            var gx1: f32 = x1;
            var gy0: f32 = y0;
            var gy1: f32 = y1;
            if ((m & EDGE_L) != 0) {
                gx0 = x0 - gm.l;
                gx1 = x0;
            }
            if ((m & EDGE_R) != 0) {
                gx0 = x1;
                gx1 = x1 + gm.r;
            }
            if ((m & EDGE_T) != 0) {
                gy0 = y0 - gm.t;
                gy1 = y0;
            }
            if ((m & EDGE_B) != 0) {
                gy0 = y1;
                gy1 = y1 + gm.b;
            }
            val gid: u64          = grip_id(r.id, m);
            val gh:  interact.Hit = interact.hit(ctx, gid, gx0, gy0, gx1, gy1, input.BUTTON_LEFT);
            if (gh.pressed) {
                val grab: *Grab = state.get[Grab](ctx, gid);
                grab.x = x0;
                grab.y = y0;
                grab.w = x1 - x0;
                grab.h = y1 - y0;
            }
            if (gh.hot || gh.active) { context.set_cursor(ctx, grip_cursor(m)); }
            k = k + 1;
        }
    }

    if (r.hidden != 0) { context.pop_measure(ctx); }
    context.pop_id(ctx);
    context.pop_band(ctx);
}

# the width a scrollbar takes from a region's column: the bar and the margin
# between it and the content
fun bar_room(ctx: *context.Context) f32 {
    val s: *theme.Style = look(ctx, theme.SCROLLBAR);
    ret context.px(ctx, s.min_w + s.margin.l);
}

# consumer-owned state of a scroll region, kept across frames
# ---
# offset:  content scrolled out above the region, in pixels
# content: content height measured when the region last ended, in pixels
pub rec Scroll {
    offset:  f32;
    content: f32;
}

# the handle begin_scroll returns for end_scroll
# ---
# id:    the region's id, which its empty area claims
# thumb: the scrollbar thumb's id
# scope: 1 if the region opened an id scope of its own, else 0
# seen:  the context's hover_seen when the region opened
# claim: the region's reserved claim
# surf:  the clipped, scrolled surface the content is laid out in
# x:     region left in the parent's local pixels
# y:     region top in the parent's local pixels
# w:     region width in pixels
# h:     region height in pixels
# top:   the offset the content is drawn at this frame, gliding toward the
#        Scroll's offset, which a region drawing only its rows in view reads
# stops: the context's tab stops when the region opened (see context.stop_count)
pub rec ScrollArea {
    id:    u64;
    thumb: u64;
    scope: u8;
    seen:  u64;
    claim: usize;
    surf:  context.Surface;
    x:     f32;
    y:     f32;
    w:     f32;
    h:     f32;
    top:   f32;
    stops: usize;
}

# the most a region of height h can scroll over content of height content
fun scroll_most(content: f32, h: f32) f32 {
    ret maxf(content - h, 0.0::f32);
}

# open a scroll region h tall as the next item of the layout, spanning the column
#
# widgets placed until end_scroll lay out in a column inside it, clipped to
# it and shifted up by s.offset, which the content glides to rather than
# jumping (see ScrollArea.top) while the thumb is not held. when the content measured last frame is
# taller than the region, the column narrows to leave room for a scrollbar.
# the region's empty area claims input beneath its widgets, which is how the
# wheel finds it. the region is an id scope for its widgets. pair every
# begin_scroll with an end_scroll.
# ---
# ctx: context
# key: the region's key in the current id scope
# s:   the region's state, clamped to its content here
# h:   region height in pixels
# ret: a handle for end_scroll
pub fun begin_scroll(ctx: *context.Context, key: str, s: *Scroll, h: f32) ScrollArea {
    ret scroll_at(ctx, context.id_of(ctx, key), s, h);
}

# begin_scroll for a region whose id is already known
fun scroll_at(ctx: *context.Context, id: u64, s: *Scroll, h: f32) ScrollArea {
    val bar: f32          = bar_room(ctx);
    val m:   *Measure     = state.get[Measure](ctx, id);
    val a:   context.Area = place(ctx, wide(), layout.fit(), m.w + bar, maxf(h, 0.0::f32));
    ret scroll_in(ctx, id, s, a, 1);
}

# open a scroll region over a rect already placed, such as one from place
#
# like begin_scroll, but the region takes a, in local pixels, and leaves the
# layout alone. pair it with end_scroll.
# ---
# ctx: context
# key: the region's key in the current id scope
# s:   the region's state, clamped to its content here
# a:   the region's rect
# ret: a handle for end_scroll
pub fun begin_scroll_at(ctx: *context.Context, key: str, s: *Scroll, a: context.Area) ScrollArea {
    ret scroll_in(ctx, context.id_of(ctx, key), s, a, 1);
}

# a scroll region over the rect a, whose id is already known
fun scroll_in(ctx: *context.Context, id: u64, s: *Scroll, a: context.Area, scope: u8) ScrollArea {
    val bar: f32 = bar_room(ctx);
    var r:   ScrollArea;
    r.id    = id;
    r.scope = scope;
    r.thumb = bid.child(id, "#thumb");
    r.seen  = ctx.hover_seen;
    r.x     = a.x0;
    r.y     = a.y0;
    r.w     = a.x1 - a.x0;
    r.h     = a.y1 - a.y0;

    r.claim = context.reserve_claim(ctx, r.id);
    context.fill_claim(ctx, r.claim, r.x, r.y, r.x + r.w, r.y + r.h);
    if (scope != 0) { context.push_id(ctx, r.id); }

    val most:  f32 = scroll_most(s.content, r.h);
    val glide: u64 = bid.child(id, "#glide");
    s.offset = clampf(s.offset, 0.0::f32, most);
    if (ctx.active == r.thumb) { anim.snap(ctx, glide, s.offset); }
    r.top   = clampf(anim.value(ctx, glide, s.offset, theme.MOTION_SCROLL), 0.0::f32, most);
    r.stops = context.stop_count(ctx);
    r.surf  = context.begin_surface(ctx, r.x, r.y, r.w, r.h, 0.0::f32, r.top);

    var cw: f32 = r.w;
    if (s.content > r.h) { cw = maxf(r.w - bar, 0.0::f32); }
    open_column(ctx, 0.0::f32, 0.0::f32, cw, 0.0::f32);
    ret r;
}

# close a scroll region: measure its content, take the wheel, draw and drag
# its scrollbar and close its column
#
# the wheel goes to the innermost region holding the topmost claim under the
# cursor within the same band (see context.push_band), so a region under a
# popup, modal or window does not scroll, even one the popup was opened in,
# and a region nested in another scrolls before its parent. scrolling applies
# from the next frame, like all input. a tab stop inside the region that the
# keyboard moved the focus to this frame is scrolled into view, when it fits.
# ---
# ctx: context
# s:   the region's state, updated with its content, the wheel and any drag
# r:   the value returned by begin_scroll
pub fun end_scroll(ctx: *context.Context, s: *Scroll, r: ScrollArea) {
    if (r.scope != 0) { context.pop_id(ctx); }
    val f: *layout.Frame = context.top_layout(ctx);
    s.content = f.y;
    val m: *Measure = state.get[Measure](ctx, r.id);
    m.w = f.need_w;
    context.pop_layout(ctx);
    context.end_surface(ctx, r.surf);

    # the hovered widget claimed inside this region, or the region itself
    if (ctx.wheel_taken == 0 && ctx.in.wheel != 0.0::f32 && ctx.hover_seen > r.seen) {
        s.offset        = s.offset - ctx.in.wheel;
        ctx.wheel_taken = 1;
    }
    val reach: opt[context.Area] = context.reached(ctx, r.stops);
    if (sel reach.some) {
        val sy: f32 = r.y + ctx.ly;
        val c0: f32 = reach.some.y0 - sy + r.top;
        val c1: f32 = reach.some.y1 - sy + r.top;
        if (c1 - c0 <= r.h) {
            if (c0 < s.offset)       { s.offset = c0; }
            if (c1 > s.offset + r.h) { s.offset = c1 - r.h; }
        }
    }
    val most: f32 = scroll_most(s.content, r.h);
    s.offset = clampf(s.offset, 0.0::f32, most);
    # the content shows the new offset from the next frame
    if (s.offset != r.top) { context.wake_at(ctx, ctx.in.time); }

    if (most > 0.0::f32) {
        val tx0:     f32   = r.x + r.w - context.px(ctx, look(ctx, theme.SCROLLBAR).min_w);
        val tx1:     f32   = r.x + r.w;
        val thumb_h: f32   = clampf(r.h * r.h / s.content, context.px(ctx, look(ctx, theme.SCROLLBAR_THUMB).min_h), r.h);
        val travel:  f32   = r.h - thumb_h;
        val grab:    *Grab = state.get[Grab](ctx, r.thumb);
        var dx:      f32;
        var dy:      f32;

        if (interact.drag(ctx, r.thumb, ?dx, ?dy) && travel > 0.0::f32) {
            s.offset = clampf(grab.y + dy * most / travel, 0.0::f32, most);
        }
        var at: f32 = clampf(r.top, 0.0::f32, most);
        if (ctx.active == r.thumb) { at = s.offset; }
        val ty: f32          = r.y + travel * at / most;
        val ht: interact.Hit = interact.hit(ctx, r.thumb, tx0, ty, tx1, ty + thumb_h, input.BUTTON_LEFT);
        if (ht.pressed) { grab.y = s.offset; }

        context.box(ctx, theme.SCROLLBAR, theme.NORMAL, tx0, r.y, tx1, r.y + r.h);
        anim.box(ctx, r.thumb, theme.SCROLLBAR_THUMB, state_of(ht, false, false), tx0, ty, tx1, ty + thumb_h);
    }
}

# a collapsible heading across the column that toggles @open when clicked
#
# the rows that belong to the section are the caller's to place, and only
# while this returns true. begin_section is the same heading over a body that
# unfolds and folds rather than appearing at once.
# ---
# ctx:   context
# title: heading text, and its key
# open:  pointer to the 0/1 open state, updated in place
# ret:   true while the section is open
pub fun section(ctx: *context.Context, title: str, open: *u8) bool {
    val id: u64 = heading(ctx, title, open);
    ret @open != 0;
}

# a section's heading: the row, its click and its caret, returning its id
fun heading(ctx: *context.Context, title: str, open: *u8) u64 {
    val id: u64          = context.id_of(ctx, title);
    val lh: f32          = context.line_height(ctx);
    val in: theme.Edges  = inset(ctx, theme.SECTION);
    val r:  context.Area = place(ctx, wide(), layout.fit(), label_width(ctx, title) + lh + in.l * 2.0::f32 + in.r, row_of(ctx, theme.SECTION));
    val x0: f32          = r.x0;
    val y0: f32          = r.y0;
    val x1: f32          = r.x1;
    val y1: f32          = r.y1;
    val h:  f32          = y1 - y0;

    val hs: interact.Hit = interact.hit(ctx, id, x0, y0, x1, y1, PRESS);
    hand(ctx, hs);
    if (hs.clicked) {
        if (@open == 0) { @open = 1; }
        or              { @open = 0; }
    }

    val st: u8          = state_of(hs, false, false);
    val p:  theme.Paint = anim.box(ctx, id, theme.SECTION, st, x0, y0, x1, y1);

    val gy: f32 = y0 + (h - lh) / 2.0::f32;
    caret(ctx, x0 + in.l, gy, lh, @open != 0, p.mark);
    label_at(ctx, title, x0 + in.l * 2.0::f32 + lh, gy, p.text);
    ret id;
}

# the height a section's body took when it last showed whole, kept under the
# section's body id
rec Unfold {
    h: f32;
}

# the handle begin_section returns for end_section
# ---
# body: true when the caller places the section's rows this frame, while it
#       is open or still folding
# id:   the body's id, under which its measure and its fold are kept
# clip: 1 while the body is folding, its rows laid out in a clipped surface
# surf: that surface
# y:    the frame's pen when the body began, while it is whole
# h:    the height the body shows while folding
pub rec Section {
    body: bool;
    id:   u64;
    clip: u8;
    surf: context.Surface;
    y:    f32;
    h:    f32;
}

# a collapsible heading as section draws it, over a body that unfolds when
# it opens and folds away when it closes
#
# place the section's rows only while the returned body is true, then call
# end_section with it, whatever body is. opening or closing, the rows show in
# a clip that grows or shrinks to the height they took when last whole, timed
# by the theme's open motion (see blit.anim), and the layout below follows
# the clip. a body never seen whole opens at once.
# ---
# ctx:   context
# title: heading text, and its key
# open:  pointer to the 0/1 open state, updated in place
# ret:   a handle for end_section
pub fun begin_section(ctx: *context.Context, title: str, open: *u8) Section {
    val id: u64 = heading(ctx, title, open);
    var s:  Section;
    s.id = bid.child(id, "#body");
    val m:    *Unfold = state.get[Unfold](ctx, s.id);
    val fold: u64     = bid.child(id, "#fold");
    var to:   f32     = 0.0::f32;
    if (@open != 0)      { to = 1.0::f32; }
    if (m.h <= 0.0::f32) { anim.snap(ctx, fold, to); }
    val t: f32 = anim.value(ctx, fold, to, theme.MOTION_OPEN);
    s.body = t > 0.0::f32;
    if (!s.body) { ret s; }
    if (t >= 1.0::f32) {
        s.y = top(ctx).y;
        ret s;
    }
    val a: context.Area = avail(ctx);
    s.clip = 1;
    s.h    = m.h * t;
    s.surf = context.begin_surface(ctx, a.x0, a.y0, a.x1 - a.x0, s.h, 0.0::f32, 0.0::f32);
    open_column(ctx, 0.0::f32, 0.0::f32, a.x1 - a.x0, 0.0::f32);
    ret s;
}

# close a section begun with begin_section: measure its body while whole, or
# close the folding clip and leave its height in the layout
# ---
# ctx: context
# s:   the value begin_section returned
pub fun end_section(ctx: *context.Context, s: Section) {
    if (!s.body) { ret; }
    val m: *Unfold = state.get[Unfold](ctx, s.id);
    if (s.clip == 0) {
        m.h = top(ctx).y - s.y;
        ret;
    }
    context.pop_layout(ctx);
    context.end_surface(ctx, s.surf);
    space(ctx, s.h);
}

# a caret filling the k-pixel square at (x, y), pointing right when closed
# and down when open
#
# the triangle is one quad per pixel row, like a rounded corner, so it needs
# nothing of the renderer and clips like any quad.
# ---
# ctx:  context
# x:    square left in local pixels
# y:    square top in local pixels
# k:    square side in pixels
# open: true to point down
# c:    fill color
pub fun caret(ctx: *context.Context, x: f32, y: f32, k: f32, open: bool, c: draw.Color) {
    if (k <= 0.0::f32) { ret; }
    # closed: a vertical edge k tall at the quarter, its tip half as far right.
    # open:   a horizontal edge k wide at the quarter, its tip half as far down.
    val depth: f32 = k / 2.0::f32;
    val edge:  f32 = k / 4.0::f32;
    var span:  f32 = k;
    if (open) { span = depth; }
    var rows: usize = span::usize;
    if (rows::f32 < span) { rows = rows + 1; }
    var r: usize = 0;
    for (r < rows) {
        val a: f32 = r::f32;
        val b: f32 = minf(a + 1.0::f32, span);
        val t: f32 = (a + b) / 2.0::f32 / span;
        if (open) {
            val half: f32 = k * (1.0::f32 - t) / 2.0::f32;
            context.quad(ctx, x + k / 2.0::f32 - half, y + edge + a, x + k / 2.0::f32 + half, y + edge + b, c);
        }
        or {
            var off: f32 = t - 0.5::f32;
            if (off < 0.0::f32) { off = 0.0::f32 - off; }
            val len: f32 = depth * (1.0::f32 - off * 2.0::f32);
            context.quad(ctx, x + edge, y + a, x + edge + len, y + b, c);
        }
        r = r + 1;
    }
}

# an ascii letter folded to lower case, any other byte unchanged
fun fold(b: u8) u8 {
    if (b >= 'A' && b <= 'Z') { ret b + 32; }
    ret b;
}

# whether s holds query, ignoring ascii case; an empty or nil query matches all
# ---
# s:     the text searched, nil holding nothing
# query: the text looked for
# ret:   true if s holds query
pub fun matches(s: str, query: str) bool {
    if (query == nil || query[0] == 0) { ret true; }
    if (s == nil)                      { ret false; }
    var i: usize = 0;
    for (s[i] != 0) {
        var j: usize = 0;
        for (query[j] != 0 && s[i + j] != 0 && fold(s[i + j]) == fold(query[j])) { j = j + 1; }
        if (query[j] == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# one frame's input with the cursor at (mx, my) and the button in state down
#[testing]
fun input_at(mx: f32, my: f32, down: u8) input.Input {
    var in: input.Input;
    in.mx      = mx;
    in.my      = my;
    in.present = 1;
    in.down    = down;
    ret in;
}

# a frame holding one panel with one button
#[testing]
fun frame_button(ctx: *context.Context, in: input.Input) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, "ok");
    end_panel(ctx, p);
    context.end(ctx);
    ret clicked;
}

# whether the context asks for a frame now
#[testing]
fun asks_now(ctx: *context.Context) bool {
    val nf: opt[f64] = context.next_frame(ctx);
    ret sel nf.some && nf.some == 0.0::f64;
}

test button__clicks_on_presses_and_releases_between_frames {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    val id: u64 = context.id_of(?ctx, "ok");

    var in: input.Input = input_at(10.0::f32, 5.0::f32, 0);
    input.init(?in, ?a);
    frame_button(?ctx, in);

    # a press and release on the button, the cursor gone by the frame: a
    # press, then a release that clicks where it happened
    in.mx = 500.0::f32;
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.release_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 2; }
    if (!asks_now(?ctx))                                     { ret 3; }
    input.clear_keys(?in);
    if (frame_button(?ctx, in) != true) { ret 4; }
    if (!asks_now(?ctx))                { ret 5; }
    frame_button(?ctx, in);
    if (asks_now(?ctx) || ctx.in.mx != 500.0::f32) { ret 6; }

    # press, release, press: a click, then the button held
    in.mx = 10.0::f32;
    frame_button(?ctx, in);
    in.down = input.BUTTON_LEFT;
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.release_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    input.press_button(?in, input.BUTTON_LEFT, 10.0::f32, 5.0::f32);
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 7; }
    input.clear_keys(?in);
    if (frame_button(?ctx, in) != true)                      { ret 8; }
    if (frame_button(?ctx, in) != false || ctx.active != id) { ret 9; }
    if (input.pressed(ctx.in, input.BUTTON_LEFT) != 1)       { ret 10; }
    if (asks_now(?ctx))                                      { ret 11; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# whether the dropdown with header id is open
#[testing]
fun dropdown_open(ctx: *context.Context, id: u64) u8 {
    ret state.get[DropdownState](ctx, id).open;
}

# open or close the dropdown with header id
#[testing]
fun set_dropdown_open(ctx: *context.Context, id: u64, open: u8) {
    val st: *DropdownState = state.get[DropdownState](ctx, id);
    st.open = open;
}

# what the probe panel's widgets reported, across frames
# ---
# clicks: times the ok button clicked
# on:     the checkbox's state
# flip:   the toggle's state
# flips:  times the toggle flipped
# choice: the segmented choice
# chosen: times the segmented choice changed
# v:      the slider's value, in [0, 10]
# pick:   the dropdown's selection
# picked: times the dropdown's selection changed
#[testing]
rec Probe {
    clicks: usize;
    on:     u8;
    flip:   u8;
    flips:  usize;
    choice: usize;
    chosen: usize;
    v:      f32;
    pick:   usize;
    picked: usize;
}

# a 100 pixel panel of one of each control, the dropdown last so its options
# cover nothing
#[testing]
fun probe_ui(ctx: *context.Context, user: ptr) {
    val p:    *Probe = user::*Probe;
    var segs: [3]str;
    segs[0] = "a";
    segs[1] = "b";
    segs[2] = "c";
    var opts: [3]str;
    opts[0] = "one";
    opts[1] = "two";
    opts[2] = "three";
    val b: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    if (button(ctx, "ok")) { p.clicks = p.clicks + 1; }
    checkbox(ctx, "on", ?p.on);
    if (toggle(ctx, "flip", ?p.flip))           { p.flips = p.flips + 1; }
    if (segmented(ctx, ?segs[0], 3, ?p.choice)) { p.chosen = p.chosen + 1; }
    slider_f(ctx, "x", ?p.v, 0.0::f32, 10.0::f32);
    if (dropdown(ctx, "pick", ?p.pick, ?opts[0], 3) != 0) { p.picked = p.picked + 1; }
    end_panel(ctx, b);
}

# a driver over the probe panel on a 200 pixel screen, laid out once
#[testing]
fun probe(d: *driver.Driver, a: *allo.Allocator, p: *Probe) u8 {
    val e: err[allo.Error] = driver.init(d, a, 200.0::f32, 200.0::f32, probe_ui, p::ptr);
    if (sel e.err) { ret 0; }
    driver.step(d);
    ret 1;
}

test button__clicks_on_release_inside_after_press {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # pressed it is active, and it clicks on the release
    val ok: u64 = driver.find(?d, "ok");
    if (!str_equals(driver.text_of(?d, ok), "ok")) { ret 2; }
    driver.hover(?d, ok);
    driver.press(?d, input.BUTTON_LEFT);
    if (p.clicks != 0 || !driver.active(?d, ok)) { ret 3; }
    driver.release(?d, input.BUTTON_LEFT);
    if (p.clicks != 1) { ret 4; }

    # a release outside after a press inside is no click
    driver.hover(?d, ok);
    driver.press(?d, input.BUTTON_LEFT);
    driver.move(?d, 150.0::f32, 150.0::f32);
    driver.release(?d, input.BUTTON_LEFT);
    if (p.clicks != 1 || driver.active(?d, ok)) { ret 5; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test nav__tab_reaches_every_control_and_keys_act_on_it {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }
    val tab: u32 = input.KEY_TAB;

    # tab starts at the first control, which wears the ring and takes no text
    driver.key(?d, tab, 0);
    if (!driver.focused(?d, driver.find(?d, "ok")))                         { ret 2; }
    if (!context.focus_visible(?d.ctx) || context.typing(?d.ctx))           { ret 3; }
    if (paint_of(?d.ctx, d.ctx.theme.focus) >= context.index_count(?d.ctx)) { ret 4; }
    driver.key(?d, input.KEY_ENTER, 0);
    if (p.clicks != 1) { ret 5; }

    # space and enter activate whatever holds the keyboard
    driver.key(?d, tab, 0);
    driver.key(?d, ' ', 0);
    if (p.on != 1) { ret 6; }
    driver.key(?d, tab, 0);
    driver.key(?d, input.KEY_ENTER, 0);
    if (p.flip != 1 || p.flips != 1) { ret 7; }

    # a segmented row is one stop, and the arrows move within it
    driver.key(?d, tab, 0);
    if (!driver.focused(?d, driver.find(?d, "a"))) { ret 8; }
    driver.key(?d, input.KEY_RIGHT, 0);
    if (!driver.focused(?d, driver.find(?d, "b"))) { ret 9; }
    driver.key(?d, input.KEY_ENTER, 0);
    if (p.choice != 1 || p.chosen != 1) { ret 10; }

    # a slider takes left and right itself
    driver.key(?d, tab, 0);
    driver.key(?d, input.KEY_RIGHT, 0);
    if (p.v != 0.5::f32) { ret 11; }

    # shift tab goes back, entering the group where the keyboard left it
    driver.key(?d, tab, input.MOD_SHIFT);
    if (!driver.focused(?d, driver.find(?d, "b"))) { ret 12; }
    driver.key(?d, tab, 0);
    driver.key(?d, tab, 0);

    # a dropdown opens onto its selected option, the arrows move down its
    # options, enter picks one and hands the keyboard back
    val pick: u64 = driver.find(?d, "pick");
    if (!driver.focused(?d, pick)) { ret 13; }
    driver.key(?d, input.KEY_ENTER, 0);
    val pop: u64 = bid.child(pick, "#popup");
    if (!driver.focused(?d, bid.child_int(pop, 0)) || p.picked != 0) { ret 14; }
    driver.key(?d, input.KEY_DOWN, 0);
    driver.key(?d, input.KEY_ENTER, 0);
    if (p.pick != 1 || p.picked != 1 || !driver.focused(?d, pick)) { ret 15; }

    # past the last control tab wraps to the first, and a press hides the ring
    driver.key(?d, tab, 0);
    if (!driver.focused(?d, driver.find(?d, "ok"))) { ret 16; }
    driver.click(?d, driver.find(?d, "on"));
    if (!driver.focused(?d, driver.find(?d, "on")) || context.focus_visible(?d.ctx)) { ret 17; }
    if (paint_of(?d.ctx, d.ctx.theme.focus) < context.index_count(?d.ctx))           { ret 18; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# clicks of the button in each of two overlapping windows
#[testing]
rec Pair {
    a: usize;
    b: usize;
}

# window A at the left, then B over its right half, each holding a button
#[testing]
fun pair_ui(ctx: *context.Context, user: ptr) {
    val p:  *Pair      = user::*Pair;
    val wa: WindowArea = begin_window(ctx, window("A", 0.0::f32, 0.0::f32, 100.0::f32, 80.0::f32));
    if (wa.body != 0 && button(ctx, "go")) { p.a = p.a + 1; }
    end_window(ctx, wa);
    val wb: WindowArea = begin_window(ctx, window("B", 50.0::f32, 0.0::f32, 100.0::f32, 80.0::f32));
    if (wb.body != 0 && button(ctx, "go")) { p.b = p.b + 1; }
    end_window(ctx, wb);
}

test nav__tab_crosses_windows_and_raises_them {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Pair;
    var d: driver.Driver;
    val e: err[allo.Error] = driver.init(?d, ?a, 300.0::f32, 300.0::f32, pair_ui, (?p)::ptr);
    if (sel e.err) { ret 1; }
    driver.step(?d);
    val tab: u32 = input.KEY_TAB;
    if (window_state(?d.ctx, "A").z >= window_state(?d.ctx, "B").z) { ret 2; }

    # a window's chrome is one stop, then its body's controls follow
    driver.key(?d, tab, 0);
    if (driver.focus_of(?d) != bid.child(driver.find(?d, "A"), "#collapse")) { ret 3; }
    driver.key(?d, input.KEY_RIGHT, 0);
    if (driver.focus_of(?d) != bid.child(driver.find(?d, "A"), "#close")) { ret 4; }

    # reaching the window behind brings it to the front
    driver.key(?d, tab, 0);
    if (!driver.focused(?d, driver.find(?d, "A/go")))               { ret 5; }
    if (window_state(?d.ctx, "A").z <= window_state(?d.ctx, "B").z) { ret 6; }
    driver.key(?d, input.KEY_ENTER, 0);
    if (p.a != 1 || p.b != 0) { ret 7; }

    driver.key(?d, tab, 0);
    driver.key(?d, tab, 0);
    if (!driver.focused(?d, driver.find(?d, "B/go")))               { ret 8; }
    if (window_state(?d.ctx, "B").z <= window_state(?d.ctx, "A").z) { ret 9; }

    # and back across with shift tab
    driver.key(?d, tab, input.MOD_SHIFT);
    driver.key(?d, tab, input.MOD_SHIFT);
    if (!driver.focused(?d, driver.find(?d, "A/go"))) { ret 10; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a section that unfolds over two buttons, then a button below it
#[testing]
fun fold_ui(ctx: *context.Context, user: ptr) {
    val open: *u8     = user::*u8;
    val b:    Block   = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val s:    Section = begin_section(ctx, "sec", open);
    if (s.body) {
        button(ctx, "one");
        button(ctx, "two");
    }
    end_section(ctx, s);
    button(ctx, "after");
    end_panel(ctx, b);
}

# the top of the button below the section
#[testing]
fun after_y(d: *driver.Driver) f32 {
    val r: opt[context.Area] = driver.rect(d, driver.find(d, "after"));
    if (sel r.none) { ret -1.0::f32; }
    ret r.some.y0;
}

test section__folds_over_time_then_sleeps {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var open: u8              = 0;
    var d:    driver.Driver;
    val e:    err[allo.Error] = driver.init(?d, ?a, 200.0::f32, 200.0::f32, fold_ui, (?open)::ptr);
    if (sel e.err) { ret 1; }
    driver.step(?d);
    val shut: f32 = after_y(?d);
    val sec:  u64 = driver.find(?d, "sec");

    # never seen whole, it opens at once
    driver.click(?d, sec);
    driver.settle(?d);
    val whole: f32 = after_y(?d);
    if (open != 1 || whole <= shut) { ret 2; }

    # closing, the body folds over frames and the layout follows it
    driver.click(?d, sec);
    driver.step(?d);
    val mid: f32 = after_y(?d);
    if (mid <= shut || mid >= whole) { ret 3; }
    val busy: opt[f64] = context.next_frame(?d.ctx);
    if (sel busy.none) { ret 4; }
    driver.settle(?d);
    if (after_y(?d) != shut) { ret 5; }
    val idle: opt[f64] = context.next_frame(?d.ctx);
    if (sel idle.some) { ret 6; }

    # opening again unfolds to the measured height
    driver.click(?d, sec);
    driver.step(?d);
    val up: f32 = after_y(?d);
    if (up <= shut || up >= whole) { ret 7; }
    driver.settle(?d);
    if (after_y(?d) != whole) { ret 8; }

    # with reduced motion it jumps
    context.set_reduce_motion(?d.ctx, 1);
    driver.click(?d, sec);
    driver.step(?d);
    if (after_y(?d) != shut) { ret 9; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test checkbox__and_toggle_flip_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    driver.click(?d, driver.find(?d, "on"));
    if (p.on != 1) { ret 2; }
    val flip: u64 = driver.find(?d, "flip");
    driver.click(?d, flip);
    if (p.flip != 1 || p.flips != 1) { ret 3; }

    # a press dragged off the row and released there does not flip it back
    driver.drag(?d, flip, 150.0::f32, 150.0::f32);
    if (p.flip != 1 || p.flips != 1) { ret 4; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test segmented__chooses_on_click {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    driver.click(?d, driver.find(?d, "c"));
    if (p.choice != 2 || p.chosen != 1) { ret 2; }
    # choosing the chosen segment again is no change
    driver.click(?d, driver.find(?d, "c"));
    if (p.chosen != 1) { ret 3; }
    # a press on the first released over the second chooses nothing
    driver.drag_onto(?d, driver.find(?d, "a"), driver.find(?d, "b"));
    if (p.choice != 2 || p.chosen != 1) { ret 4; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test slider__maps_cursor_linearly {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # the track spans the panel's width: its left end is lo, its right end hi
    val x: u64               = driver.find(?d, "x");
    val r: opt[context.Area] = driver.rect(?d, x);
    if (sel r.none) { ret 2; }
    val y: f32 = (r.some.y0 + r.some.y1) / 2.0::f32;
    driver.drag(?d, x, r.some.x0, y);
    if (p.v != 0.0::f32) { ret 3; }
    driver.drag(?d, x, (r.some.x0 + r.some.x1) / 2.0::f32, y);
    if (p.v != 5.0::f32) { ret 4; }
    driver.drag(?d, x, r.some.x1 + 50.0::f32, y);
    if (p.v != 10.0::f32) { ret 5; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test dropdown__opens_and_selects {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    var d: driver.Driver;
    if (probe(?d, ?a, ?p) == 0) { ret 1; }

    # the header opens it without changing the selection
    val pick: u64 = driver.find(?d, "pick");
    val two:  u64 = bid.child_int(bid.child(pick, "#popup"), 1);
    if (driver.drawn(?d, two)) { ret 2; }
    driver.click(?d, pick);
    if (p.picked != 0 || dropdown_open(?d.ctx, pick) == 0) { ret 3; }
    if (!str_equals(driver.text_of(?d, two), "two"))       { ret 4; }

    # an option selects and closes it
    driver.click(?d, two);
    if (p.pick != 1 || p.picked != 1)     { ret 5; }
    if (dropdown_open(?d.ctx, pick) != 0) { ret 6; }
    # the frame that chose still drew the options, the next one does not
    driver.step(?d);
    if (driver.drawn(?d, two)) { ret 7; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a scroll region and a window, each holding a widget a label path names
# ---
# side: the region's state, holding "ok" above more than it can show
# win:  the "Settings" window, holding the "name" field
# f:    the field's state
#[testing]
rec Nest {
    side: Scroll;
    win:  Window;
    f:    field.Field;
}

#[testing]
fun nest_ui(ctx: *context.Context, user: ptr) {
    val n:  *Nest      = user::*Nest;
    val sa: ScrollArea = begin_scroll_at(ctx, "side", ?n.side, context.Area{x0: 0.0::f32, y0: 0.0::f32, x1: 80.0::f32, y1: 200.0::f32});
    button(ctx, "ok");
    space(ctx, 1000.0::f32);
    end_scroll(ctx, ?n.side, sa);
    val b: WindowArea = begin_window(ctx, n.win);
    text_field(ctx, "name", ?n.f, nil);
    end_window(ctx, b);
}

test driver__paths_keys_and_wheel_reach_nested_widgets {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var buf: [64]u8;
    var n:   Nest;
    n.win = auto_window("Settings", 100.0::f32, 10.0::f32, 120.0::f32);
    field.init(?n.f, ?buf[0], 64, 0, nil);
    var d:  driver.Driver;
    val ie: err[allo.Error] = driver.init(?d, ?a, 300.0::f32, 200.0::f32, nest_ui, (?n)::ptr);
    if (sel ie.err) { ret 1; }
    driver.step(?d);

    # a region's and a window's widgets sit under their keys
    val ok:   u64 = driver.find(?d, "side/ok");
    val name: u64 = driver.find(?d, "Settings/name");
    if (!driver.drawn(?d, ok) || !driver.drawn(?d, name)) { ret 2; }
    val r: opt[context.Area] = driver.rect(?d, name);
    if (sel r.none)                                                            { ret 3; }
    if (r.some.x0 < 100.0::f32)                                                { ret 3; }
    if (driver.at(?d, r.some.x0 + 1.0::f32, r.some.y0 + 1.0::f32) != name)     { ret 4; }
    if (driver.inside(?d, r.some.x0, r.some.y0, r.some.x1, r.some.y1) != name) { ret 5; }
    driver.hover(?d, ok);
    if (!driver.hot(?d, ok) || driver.hot(?d, name)) { ret 6; }

    # a clicked field takes typed text and keys
    driver.click(?d, name);
    if (!driver.focused(?d, name)) { ret 7; }
    driver.type_text(?d, "hey");
    driver.key(?d, input.KEY_BACKSPACE, 0);
    if (!str_equals(field.text(?n.f), "he"))         { ret 8; }
    if (!str_equals(driver.text_of(?d, name), "he")) { ret 9; }

    # the wheel over the region scrolls it
    driver.scroll(?d, ok, 0.0::f32, -30.0::f32);
    driver.step(?d);
    if (n.side.offset != 30.0::f32) { ret 10; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding one panel with one three-option dropdown
#[testing]
fun frame_dropdown(ctx: *context.Context, in: input.Input, picked: *usize, opts: *str) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val changed: u8    = dropdown(ctx, "pick", picked, opts, 3);
    end_panel(ctx, p);
    context.end(ctx);
    ret changed;
}

test dropdown__open_overlays_later_widgets {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    set_dropdown_open(?ctx, context.id_of(?ctx, "pick"), 1);
    context.begin(?ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    begin_panel(?ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    dropdown(?ctx, "pick", ?picked, ?opts[0], 3);
    # the layout continues right under the header
    val next: context.Area = avail(?ctx);
    if (next.y0 != control_row_height(?ctx)) { ret 2; }
    if (next.x0 != 0.0::f32)                 { ret 3; }
    if (next.x1 - next.x0 != 100.0::f32)     { ret 4; }
    if (ctx.layer != 0)                      { ret 5; }
    context.end(?ctx);

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test dropdown__open_keeps_ids_apart {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var first:  usize = 0;
    var second: usize = 0;
    var in:     input.Input;

    # two open dropdowns with the same options claim no id twice, and the open
    # one stays open whichever is drawn first
    set_dropdown_open(?ctx, context.id_of(?ctx, "first"), 1);
    var k: usize = 0;
    for (k < 2) {
        context.begin(?ctx, in, 200.0::f32, 200.0::f32);
        begin_panel(?ctx, 0.0::f32, 0.0::f32, 100.0::f32);
        if (k == 0) { dropdown(?ctx, "first", ?first, ?opts[0], 3); }
        dropdown(?ctx, "second", ?second, ?opts[0], 3);
        if (k == 1) { dropdown(?ctx, "first", ?first, ?opts[0], 3); }
        context.end(?ctx);
        if (context.collisions(?ctx) != 0)                           { ret 2; }
        if (dropdown_open(?ctx, context.id_of(?ctx, "first")) == 0)  { ret 3; }
        if (dropdown_open(?ctx, context.id_of(?ctx, "second")) != 0) { ret 4; }
        k = k + 1;
    }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding one region_clicked rect, clipped to (0,0)-(10,10) when clip is set
#[testing]
fun frame_region(ctx: *context.Context, in: input.Input, clip: u8) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    if (clip != 0) { context.push_clip(ctx, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32); }
    val clicked: u8 = region_clicked(ctx, "r", 40.0::f32, 40.0::f32, 60.0::f32, 60.0::f32);
    if (clip != 0) { context.pop_clip(ctx); }
    context.end(ctx);
    ret clicked;
}

# a window at (x, y) sized to its content, at least w wide
#[testing]
fun auto_window(title: str, x: f32, y: f32, w: f32) Window {
    var win: Window = window(title, x, y, w, 0.0::f32);
    win.min_w = w;
    win.flags = WINDOW_AUTO_SIZE;
    ret win;
}

# a frame holding one window with nothing in it
#[testing]
fun frame_window(ctx: *context.Context, in: input.Input, win: Window) {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    val b: WindowArea = begin_window(ctx, win);
    end_window(ctx, b);
    context.end(ctx);
}

test window__drags_by_titlebar_and_collapses {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    val win: Window = auto_window("w", 50.0::f32, 50.0::f32, 120.0::f32);

    # hover then press the drag region, right of the collapse box
    frame_window(?ctx, input_at(100.0::f32, 58.0::f32, 0), win);
    frame_window(?ctx, input_at(100.0::f32, 58.0::f32, 1), win);

    # move while held -> the window follows the cursor
    frame_window(?ctx, input_at(150.0::f32, 90.0::f32, 1), win);
    val st: *WindowState = window_state(?ctx, "w");
    if (st.x != 100.0::f32) { ret 2; }
    if (st.y != 82.0::f32)  { ret 3; }

    # release, then press and release the collapse box (now [100,116] x [82,98])
    frame_window(?ctx, input_at(150.0::f32, 90.0::f32, 0), win);
    frame_window(?ctx, input_at(108.0::f32, 90.0::f32, 0), win);
    frame_window(?ctx, input_at(108.0::f32, 90.0::f32, 1), win);
    frame_window(?ctx, input_at(108.0::f32, 90.0::f32, 0), win);
    if (window_state(?ctx, "w").collapsed != 1) { ret 4; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with a three-option dropdown, then a window called
# after it whose titlebar crosses the option rows
#[testing]
fun frame_dropdown_window(ctx: *context.Context, in: input.Input, picked: *usize, opts: *str, win: Window) u8 {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val changed: u8    = dropdown(ctx, "pick", picked, opts, 3);
    end_panel(ctx, p);
    val w: WindowArea = begin_window(ctx, win);
    end_window(ctx, w);
    context.end(ctx);
    ret changed;
}

# where in paint order a vertex at exactly (x, y) is first drawn: the first
# composed index naming one, or the index count when none is drawn
#[testing]
fun vert_at(ctx: *context.Context, x: f32, y: f32) usize {
    val p:  *draw.Vert = context.draw_verts(ctx);
    val ix: *u32       = context.draw_indices(ctx);
    val n:  usize      = context.index_count(ctx);
    var i:  usize      = 0;
    for (i < n) {
        if (p[ix[i]].x == x && p[ix[i]].y == y) { ret i; }
        i = i + 1;
    }
    ret n;
}

# where in paint order a solid vertex of color c is first drawn, or the index
# count when none is
#[testing]
fun paint_of(ctx: *context.Context, c: draw.Color) usize {
    val p:  *draw.Vert = context.draw_verts(ctx);
    val ix: *u32       = context.draw_indices(ctx);
    val n:  usize      = context.index_count(ctx);
    var i:  usize      = 0;
    for (i < n) {
        val v: draw.Vert = p[ix[i]];
        if (v.r == c.r && v.g == c.g && v.b == c.b && v.a == c.a) { ret i; }
        i = i + 1;
    }
    ret n;
}

test routing__open_dropdown_beats_later_window {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    # the titlebar spans y [30, 46) and crosses option rows [20, 36) and [40, 56)
    val win: Window = auto_window("w", 0.0::f32, 30.0::f32, 150.0::f32);

    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?picked, ?opts[0], win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], win);
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) == 0) { ret 2; }

    # the option rows paint after the window despite being called before it
    if (vert_at(?ctx, 0.0::f32, 30.0::f32) >= vert_at(?ctx, 0.0::f32, 40.0::f32)) { ret 3; }
    if (vert_at(?ctx, 0.0::f32, 40.0::f32) >= context.index_count(?ctx))          { ret 4; }

    # hover, press and release where option 1 and the drag region overlap
    val opt1: u64 = bid.child_int(bid.child(context.id_of(?ctx, "pick"), "#popup"), 1);
    frame_dropdown_window(?ctx, input_at(50.0::f32, 42.0::f32, 0), ?picked, ?opts[0], win);
    if (ctx.hot != opt1) { ret 5; }
    frame_dropdown_window(?ctx, input_at(50.0::f32, 42.0::f32, 1), ?picked, ?opts[0], win);
    if (ctx.active != opt1)                                                                          { ret 6; }
    if (frame_dropdown_window(?ctx, input_at(50.0::f32, 42.0::f32, 0), ?picked, ?opts[0], win) != 1) { ret 7; }
    if (picked != 1)                                                                                 { ret 8; }
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) != 0)                                       { ret 9; }
    val st: *WindowState = window_state(?ctx, "w");
    if (st.x != 0.0::f32 || st.y != 30.0::f32 || st.collapsed != 0 || st.closed != 0) { ret 10; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test dropdown__outside_press_closes_and_is_swallowed {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    val win: Window = auto_window("w", 0.0::f32, 30.0::f32, 150.0::f32);

    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?picked, ?opts[0], win);
    frame_dropdown_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?picked, ?opts[0], win);
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) == 0) { ret 2; }

    # press on the titlebar right of the option rows: the dropdown closes and
    # the window beneath does not start a drag
    frame_dropdown_window(?ctx, input_at(120.0::f32, 38.0::f32, 0), ?picked, ?opts[0], win);
    frame_dropdown_window(?ctx, input_at(120.0::f32, 38.0::f32, 1), ?picked, ?opts[0], win);
    val outside: u64 = bid.child(bid.child(context.id_of(?ctx, "pick"), "#popup"), "#outside");
    if (dropdown_open(?ctx, context.id_of(?ctx, "pick")) != 0) { ret 3; }
    if (ctx.active != outside)                                 { ret 4; }
    frame_dropdown_window(?ctx, input_at(130.0::f32, 38.0::f32, 1), ?picked, ?opts[0], win);
    frame_dropdown_window(?ctx, input_at(130.0::f32, 38.0::f32, 0), ?picked, ?opts[0], win);
    if (window_state(?ctx, "w").x != 0.0::f32 || window_state(?ctx, "w").y != 30.0::f32) { ret 5; }
    if (picked != 0)                                                                     { ret 6; }

    # the next press there goes to the window
    frame_dropdown_window(?ctx, input_at(130.0::f32, 38.0::f32, 1), ?picked, ?opts[0], win);
    if (ctx.active != bid.child(context.id_of(?ctx, "w"), "#drag")) { ret 7; }
    frame_dropdown_window(?ctx, input_at(140.0::f32, 38.0::f32, 1), ?picked, ?opts[0], win);
    if (window_state(?ctx, "w").x != 10.0::f32) { ret 8; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding two windows side by side, each with a three-option dropdown
# whose header id lands in @ida and @idb
#[testing]
fun frame_two_dropdowns(ctx: *context.Context, in: input.Input, wa: Window, wb: Window, picked: *usize, opts: *str, ida: *u64, idb: *u64) {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    val ba: WindowArea = begin_window(ctx, wa);
    @ida = context.id_of(ctx, "a");
    dropdown(ctx, "a", picked, opts, 3);
    end_window(ctx, ba);
    val bb: WindowArea = begin_window(ctx, wb);
    @idb = context.id_of(ctx, "b");
    dropdown(ctx, "b", picked, opts, 3);
    end_window(ctx, bb);
    context.end(ctx);
}

test dropdown__two_open_in_two_windows {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var opts: [3]str;
    opts[0] = "a";
    opts[1] = "b";
    opts[2] = "c";
    var picked: usize = 0;

    val wa: Window = auto_window("a", 0.0::f32, 0.0::f32, 100.0::f32);
    val wb: Window = auto_window("b", 200.0::f32, 0.0::f32, 100.0::f32);

    var ida: u64 = 0;
    var idb: u64 = 0;
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 0), wa, wb, ?picked, ?opts[0], ?ida, ?idb);
    if (ida == idb) { ret 2; }

    # both popups open at once, each in its own entry
    set_dropdown_open(?ctx, ida, 1);
    set_dropdown_open(?ctx, idb, 1);
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 0), wa, wb, ?picked, ?opts[0], ?ida, ?idb);
    if (dropdown_open(?ctx, ida) == 0 || dropdown_open(?ctx, idb) == 0) { ret 3; }

    # a press on bare screen reaches only the topmost popup: b closes, a stays
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 1), wa, wb, ?picked, ?opts[0], ?ida, ?idb);
    if (dropdown_open(?ctx, ida) == 0) { ret 4; }
    if (dropdown_open(?ctx, idb) != 0) { ret 5; }

    # the next press closes a
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 0), wa, wb, ?picked, ?opts[0], ?ida, ?idb);
    frame_two_dropdowns(?ctx, input_at(390.0::f32, 390.0::f32, 1), wa, wb, ?picked, ?opts[0], ?ida, ?idb);
    if (dropdown_open(?ctx, ida) != 0) { ret 6; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding popup A with a button, and popup B opened inside A, whose
# button covers part of A's
#[testing]
fun frame_nested(ctx: *context.Context, in: input.Input, a_hit: *u8, b_hit: *u8, a_gone: *u8, b_gone: *u8) {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val pa: Popup = begin_popup(ctx, "A", 1, 0.0::f32, 0.0::f32, 100.0::f32);
    @a_hit = button(ctx, "a");
    val pb: Popup = begin_popup(ctx, "B", 1, 0.0::f32, 10.0::f32, 100.0::f32);
    @b_hit = button(ctx, "b");
    end_popup(ctx, pb);
    end_popup(ctx, pa);
    @a_gone = pa.dismissed;
    @b_gone = pb.dismissed;
    context.end(ctx);
}

test popup__nested_resolve_to_innermost {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var ah: u8 = 0;
    var bh: u8 = 0;
    var ag: u8 = 0;
    var bg: u8 = 0;

    # button a spans y [0, 16), button b spans y [10, 26): click the overlap
    frame_nested(?ctx, input_at(50.0::f32, 12.0::f32, 0), ?ah, ?bh, ?ag, ?bg);
    frame_nested(?ctx, input_at(50.0::f32, 12.0::f32, 1), ?ah, ?bh, ?ag, ?bg);
    frame_nested(?ctx, input_at(50.0::f32, 12.0::f32, 0), ?ah, ?bh, ?ag, ?bg);
    if (bh != 1 || ah != 0) { ret 2; }
    if (ag != 0 || bg != 0) { ret 3; }

    # B paints above A, and the frame ends on B's layer
    if (vert_at(?ctx, 0.0::f32, 0.0::f32) >= vert_at(?ctx, 0.0::f32, 10.0::f32)) { ret 4; }
    val top: context.Run = context.run_at(?ctx, context.run_count(?ctx) - 1);
    if (top.layer != band.layer(band.POPUPS, 1)) { ret 5; }

    # a press on A alone dismisses only the innermost popup and is consumed by
    # it, so A's button under it does not activate. B nests in A's scope
    val pb: u64 = bid.of_label(context.id_of(?ctx, "A"), "B");
    frame_nested(?ctx, input_at(50.0::f32, 5.0::f32, 0), ?ah, ?bh, ?ag, ?bg);
    frame_nested(?ctx, input_at(50.0::f32, 5.0::f32, 1), ?ah, ?bh, ?ag, ?bg);
    if (bg != 1 || ag != 0)                      { ret 6; }
    if (ctx.active != bid.child(pb, "#outside")) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with a button at y [30, 46), then a window over it
# whose body holds only text
#[testing]
fun frame_covered(ctx: *context.Context, in: input.Input, win: Window) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 30.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, "under");
    end_panel(ctx, p);
    val w: WindowArea = begin_window(ctx, win);
    text(ctx, "one");
    text(ctx, "two");
    end_window(ctx, w);
    context.end(ctx);
    ret clicked;
}

test window__body_blocks_input_beneath {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # the window body spans y [16, 44) and x [0, 60)
    val win: Window = auto_window("w", 0.0::f32, 0.0::f32, 60.0::f32);

    frame_covered(?ctx, input_at(50.0::f32, 35.0::f32, 0), win);
    if (ctx.hot != 0) { ret 2; }
    frame_covered(?ctx, input_at(50.0::f32, 35.0::f32, 1), win);
    if (ctx.hot != 0 || ctx.active != 0)                                      { ret 3; }
    if (frame_covered(?ctx, input_at(50.0::f32, 35.0::f32, 0), win) != false) { ret 4; }

    # beside the window the button is reachable
    frame_covered(?ctx, input_at(80.0::f32, 45.0::f32, 0), win);
    if (ctx.hot != context.id_of(?ctx, "under")) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# draw one window with nothing in it
#[testing]
fun empty_window(ctx: *context.Context, win: Window) {
    val r: WindowArea = begin_window(ctx, win);
    end_window(ctx, r);
}

# a frame holding windows a and b, a called first unless swap is set
#[testing]
fun frame_two_windows(ctx: *context.Context, in: input.Input, a: Window, b: Window, swap: u8) {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    if (swap == 0) {
        empty_window(ctx, a);
        empty_window(ctx, b);
    }
    or {
        empty_window(ctx, b);
        empty_window(ctx, a);
    }
    context.end(ctx);
}

test window__click_raises_whatever_the_call_order {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # A spans x [0, 100) and B x [50, 150), both y [0, 60)
    val wa: Window = window("A", 0.0::f32, 0.0::f32, 100.0::f32, 60.0::f32);
    val wb: Window = window("B", 50.0::f32, 0.0::f32, 100.0::f32, 60.0::f32);
    # the body of each is a scroll region, which is what the cursor finds there
    val ida: u64 = bid.child(context.id_of(?ctx, "A"), "#body");
    val idb: u64 = bid.child(context.id_of(?ctx, "B"), "#body");

    # opened in turn, the later one is in front and takes the overlap
    frame_two_windows(?ctx, input_at(75.0::f32, 40.0::f32, 0), wa, wb, 0);
    frame_two_windows(?ctx, input_at(75.0::f32, 40.0::f32, 0), wa, wb, 0);
    if (ctx.hover != idb)                                                        { ret 2; }
    if (vert_at(?ctx, 0.0::f32, 0.0::f32) >= vert_at(?ctx, 50.0::f32, 0.0::f32)) { ret 3; }

    # a press on A's uncovered body brings it to the front in that same frame
    frame_two_windows(?ctx, input_at(20.0::f32, 40.0::f32, 0), wa, wb, 0);
    frame_two_windows(?ctx, input_at(20.0::f32, 40.0::f32, 1), wa, wb, 0);
    if (vert_at(?ctx, 0.0::f32, 0.0::f32) <= vert_at(?ctx, 50.0::f32, 0.0::f32)) { ret 4; }

    # calling B last no longer puts it in front: A paints over and takes the overlap
    frame_two_windows(?ctx, input_at(75.0::f32, 40.0::f32, 0), wa, wb, 1);
    frame_two_windows(?ctx, input_at(75.0::f32, 40.0::f32, 0), wa, wb, 0);
    if (ctx.hover != ida)                                                        { ret 5; }
    if (vert_at(?ctx, 0.0::f32, 0.0::f32) <= vert_at(?ctx, 50.0::f32, 0.0::f32)) { ret 6; }
    if (window_state(?ctx, "A").z <= window_state(?ctx, "B").z)                  { ret 7; }

    # past Z_RENUMBER a raise renumbers every window kept, drawn or not, in
    # the order they held: C, not drawn, stays between A and B
    window_state(?ctx, "A").z = context.Z_RENUMBER;
    window_state(?ctx, "B").z = context.Z_RENUMBER + 2;
    val sc: *WindowState = window_state(?ctx, "C");
    sc.placed = 1;
    sc.z      = context.Z_RENUMBER + 1;
    frame_two_windows(?ctx, input_at(20.0::f32, 40.0::f32, 0), wa, wb, 0);
    frame_two_windows(?ctx, input_at(20.0::f32, 40.0::f32, 1), wa, wb, 0);
    if (window_state(?ctx, "B").z != 3 || window_state(?ctx, "C").z != 2) { ret 9; }
    if (window_state(?ctx, "A").z != 4 || context.z_top(?ctx) != 4)       { ret 10; }
    frame_two_windows(?ctx, input_at(20.0::f32, 40.0::f32, 0), wa, wb, 0);

    # a pinned window stays in front of one raised after it
    window_state(?ctx, "B").pinned = 1;
    frame_two_windows(?ctx, input_at(20.0::f32, 40.0::f32, 1), wa, wb, 0);
    frame_two_windows(?ctx, input_at(75.0::f32, 40.0::f32, 0), wa, wb, 0);
    if (ctx.hover != idb) { ret 8; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test window__resizes_from_edges_and_corners_within_bounds {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var win: Window = window("w", 50.0::f32, 50.0::f32, 100.0::f32, 80.0::f32);
    win.min_w = 60.0::f32;
    win.max_w = 150.0::f32;
    val st: *WindowState = window_state(?ctx, "w");

    # the right edge's grip spans x [150, 154): hover asks for the resize cursor
    frame_window(?ctx, input_at(152.0::f32, 100.0::f32, 0), win);
    frame_window(?ctx, input_at(152.0::f32, 100.0::f32, 0), win);
    if (context.cursor(?ctx) != input.CURSOR_RESIZE_EW) { ret 2; }
    frame_window(?ctx, input_at(152.0::f32, 100.0::f32, 1), win);
    frame_window(?ctx, input_at(302.0::f32, 100.0::f32, 1), win);
    if (st.x != 50.0::f32 || st.w != 150.0::f32)        { ret 3; }
    if (context.cursor(?ctx) != input.CURSOR_RESIZE_EW) { ret 4; }
    frame_window(?ctx, input_at(302.0::f32, 100.0::f32, 0), win);

    # the top left corner moves both edges it holds, the others stay put
    frame_window(?ctx, input_at(48.0::f32, 48.0::f32, 0), win);
    if (context.cursor(?ctx) != input.CURSOR_RESIZE_NWSE) { ret 5; }
    frame_window(?ctx, input_at(48.0::f32, 48.0::f32, 1), win);
    frame_window(?ctx, input_at(78.0::f32, 68.0::f32, 1), win);
    if (st.x != 80.0::f32 || st.w != 120.0::f32) { ret 6; }
    if (st.y != 70.0::f32 || st.h != 60.0::f32)  { ret 7; }
    frame_window(?ctx, input_at(78.0::f32, 68.0::f32, 0), win);

    # the bottom right corner stops at the least width
    frame_window(?ctx, input_at(202.0::f32, 132.0::f32, 0), win);
    if (context.cursor(?ctx) != input.CURSOR_RESIZE_NWSE) { ret 8; }
    frame_window(?ctx, input_at(202.0::f32, 132.0::f32, 1), win);
    frame_window(?ctx, input_at(92.0::f32, 152.0::f32, 1), win);
    if (st.x != 80.0::f32 || st.w != 60.0::f32 || st.h != 80.0::f32) { ret 9; }
    frame_window(?ctx, input_at(92.0::f32, 152.0::f32, 0), win);

    # locked, the grips are gone and the titlebar no longer drags
    st.locked = 1;
    frame_window(?ctx, input_at(142.0::f32, 120.0::f32, 0), win);
    frame_window(?ctx, input_at(142.0::f32, 120.0::f32, 0), win);
    if (context.cursor(?ctx) != input.CURSOR_ARROW) { ret 10; }
    frame_window(?ctx, input_at(110.0::f32, 78.0::f32, 1), win);
    frame_window(?ctx, input_at(150.0::f32, 98.0::f32, 1), win);
    if (st.x != 80.0::f32 || st.y != 70.0::f32 || st.w != 60.0::f32) { ret 11; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a window with n buttons in its body
#[testing]
fun frame_buttons_window(ctx: *context.Context, in: input.Input, win: Window, n: usize) {
    context.begin(ctx, in, 400.0::f32, 400.0::f32);
    val r: WindowArea = begin_window(ctx, win);
    if (r.body != 0) {
        var i: usize = 0;
        for (i < n) {
            context.push_id_int(ctx, i::u64);
            button(ctx, "b");
            context.pop_id(ctx);
            i = i + 1;
        }
    }
    end_window(ctx, r);
    context.end(ctx);
}

test window__closes_auto_sizes_and_scrolls {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # auto-sized, two rows of 20 under a titlebar of 16 and the bottom pad
    val grow: Window = auto_window("grow", 0.0::f32, 0.0::f32, 100.0::f32);
    frame_buttons_window(?ctx, input_at(300.0::f32, 300.0::f32, 0), grow, 2);
    if (window_state(?ctx, "grow").h != 60.0::f32) { ret 2; }

    # declared 0 wide, it measures its first frame hidden, then takes the
    # widest of its widgets
    var fit: Window = window("fit", 0.0::f32, 100.0::f32, 0.0::f32, 0.0::f32);
    fit.flags = WINDOW_AUTO_SIZE;
    context.begin(?ctx, input_at(300.0::f32, 300.0::f32, 0), 400.0::f32, 400.0::f32);
    val f1: WindowArea = begin_window(?ctx, fit);
    text(?ctx, "a much longer line of text");
    end_window(?ctx, f1);
    context.end(?ctx);
    if (context.draw_count(?ctx) != 0 || ctx.claims.len != 0) { ret 8; }
    val long: f32 = context.text_width(?ctx, "a much longer line of text");
    if (window_state(?ctx, "fit").w != long) { ret 9; }

    # a fixed height scrolls ten rows by the wheel over its body
    val tall: Window = window("tall", 0.0::f32, 0.0::f32, 100.0::f32, 56.0::f32);
    frame_buttons_window(?ctx, input_at(50.0::f32, 30.0::f32, 0), tall, 10);
    var in: input.Input = input_at(50.0::f32, 30.0::f32, 0);
    in.wheel = -30.0::f32;
    frame_buttons_window(?ctx, in, tall, 10);
    val sc: *Scroll = state.get[Scroll](?ctx, bid.child(context.id_of(?ctx, "tall"), "#body"));
    if (sc.content != 200.0::f32 || sc.offset != 30.0::f32) { ret 3; }
    if (window_state(?ctx, "tall").h != 56.0::f32)          { ret 4; }

    # the close button spans x [84, 100) of the titlebar: a click closes the
    # window, which then draws nothing until reopened
    frame_buttons_window(?ctx, input_at(90.0::f32, 8.0::f32, 0), tall, 10);
    frame_buttons_window(?ctx, input_at(90.0::f32, 8.0::f32, 1), tall, 10);
    frame_buttons_window(?ctx, input_at(90.0::f32, 8.0::f32, 0), tall, 10);
    if (window_state(?ctx, "tall").closed != 1) { ret 5; }
    frame_buttons_window(?ctx, input_at(90.0::f32, 8.0::f32, 0), tall, 10);
    if (context.index_count(?ctx) != 0 || context.ok(?ctx) != 1) { ret 6; }
    window_state(?ctx, "tall").closed = 0;
    frame_buttons_window(?ctx, input_at(90.0::f32, 8.0::f32, 0), tall, 10);
    if (context.index_count(?ctx) == 0) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test window__flags_shape_the_chrome {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # no title: the body starts at the top, and nothing drags it
    var bare: Window = window("bare", 0.0::f32, 0.0::f32, 100.0::f32, 60.0::f32);
    bare.flags = WINDOW_NO_TITLE | WINDOW_NO_RESIZE | WINDOW_NO_BACKGROUND;
    context.begin(?ctx, input_at(50.0::f32, 8.0::f32, 0), 400.0::f32, 400.0::f32);
    val r: WindowArea = begin_window(?ctx, bare);
    if (r.body != 1 || r.th != 0.0::f32) { ret 2; }
    end_window(?ctx, r);
    context.end(?ctx);
    # without a background or a title an empty window paints nothing
    if (context.index_count(?ctx) != 0) { ret 3; }
    # without grips its edge keeps the arrow
    frame_window(?ctx, input_at(102.0::f32, 30.0::f32, 0), bare);
    frame_window(?ctx, input_at(102.0::f32, 30.0::f32, 0), bare);
    if (context.cursor(?ctx) != input.CURSOR_ARROW) { ret 4; }

    # no move: a titlebar drag leaves the window where it is
    var fixed: Window = window("fixed", 200.0::f32, 0.0::f32, 100.0::f32, 60.0::f32);
    fixed.flags = WINDOW_NO_MOVE | WINDOW_NO_CLOSE;
    frame_window(?ctx, input_at(280.0::f32, 8.0::f32, 0), fixed);
    frame_window(?ctx, input_at(280.0::f32, 8.0::f32, 1), fixed);
    frame_window(?ctx, input_at(330.0::f32, 40.0::f32, 1), fixed);
    if (window_state(?ctx, "fixed").x != 200.0::f32 || window_state(?ctx, "fixed").y != 0.0::f32) { ret 5; }
    # no close: the right end of the titlebar is the drag region
    if (ctx.active != bid.child(context.id_of(?ctx, "fixed"), "#drag")) { ret 6; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test window__state_survives_save_and_load {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var src: context.Context;
    val ie:  err[allo.Error] = context.init(?src, ?a);
    if (sel ie.err) { ret 1; }
    val rs: err[state.Error] = persist_windows(?src);
    if (sel rs.err) { ret 2; }

    val wa: Window = window("A", 0.0::f32, 0.0::f32, 100.0::f32, 60.0::f32);
    val wb: Window = window("B", 50.0::f32, 0.0::f32, 100.0::f32, 60.0::f32);
    frame_two_windows(?src, input_at(300.0::f32, 300.0::f32, 0), wa, wb, 0);
    val sa: *WindowState = window_state(?src, "A");
    sa.x                           = 12.5::f32;
    sa.y                           = 40.0::f32;
    sa.w                           = 90.0::f32;
    sa.h                           = 70.0::f32;
    sa.collapsed                   = 1;
    sa.locked                      = 1;
    sa.z                           = 9;
    window_state(?src, "B").closed = 1;
    val doc: res[str, allo.Error] = state.save(?src);
    if (sel doc.err) { ret 3; }

    var dst: context.Context;
    val je:  err[allo.Error] = context.init(?dst, ?a);
    if (sel je.err) { ret 1; }
    val rd: err[state.Error] = persist_windows(?dst);
    if (sel rd.err) { ret 2; }
    val ld: err[toml.TomlError] = state.load(?dst, doc.ok);
    if (sel ld.err) { ret 4; }

    # the loaded state wins over the rect the calls declare, and a window
    # opened after the load comes in front of the loaded ones
    val wc: Window = window("C", 0.0::f32, 0.0::f32, 50.0::f32, 50.0::f32);
    context.begin(?dst, input_at(300.0::f32, 300.0::f32, 0), 400.0::f32, 400.0::f32);
    empty_window(?dst, wa);
    empty_window(?dst, wb);
    empty_window(?dst, wc);
    context.end(?dst);
    val la: *WindowState = window_state(?dst, "A");
    if (la.x != 12.5::f32 || la.y != 40.0::f32 || la.w != 90.0::f32 || la.h != 70.0::f32) { ret 5; }
    if (la.collapsed != 1 || la.locked != 1 || la.closed != 0 || la.z != 9)               { ret 6; }
    if (window_state(?dst, "B").closed != 1)                                              { ret 7; }
    if (window_state(?dst, "C").z <= 9)                                                   { ret 8; }

    val f0: err[allo.Error] = context.free(?src);
    if (sel f0.err) { ret 1; }
    val f1: err[allo.Error] = context.free(?dst);
    if (sel f1.err) { ret 1; }
    ret 0;
}

# a frame holding sibling popups P and Q at the root, R nested in Q, and a
# window opened after them, recording each popup's layer
#[testing]
fun frame_popup_layers(ctx: *context.Context, lp: *u32, lq: *u32, lr: *u32) {
    context.begin(ctx, input_at(300.0::f32, 300.0::f32, 0), 400.0::f32, 400.0::f32);
    val p: Popup = begin_popup(ctx, "P", 1, 0.0::f32, 0.0::f32, 50.0::f32);
    @lp = context.layer_of(ctx);
    end_popup(ctx, p);
    val q: Popup = begin_popup(ctx, "Q", 1, 60.0::f32, 0.0::f32, 50.0::f32);
    @lq = context.layer_of(ctx);
    val r: Popup = begin_popup(ctx, "R", 1, 60.0::f32, 10.0::f32, 50.0::f32);
    @lr = context.layer_of(ctx);
    end_popup(ctx, r);
    end_popup(ctx, q);
    empty_window(ctx, window("w", 0.0::f32, 0.0::f32, 200.0::f32, 60.0::f32));
    context.end(ctx);
}

test popup__siblings_share_a_band_layer_above_windows {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var lp: u32 = 0;
    var lq: u32 = 0;
    var lr: u32 = 0;
    frame_popup_layers(?ctx, ?lp, ?lq, ?lr);
    if (lp != band.layer(band.POPUPS, 0) || lq != lp) { ret 2; }
    if (lr != band.layer(band.POPUPS, 1))             { ret 3; }

    # the window called after every popup still paints beneath them all
    val last:  context.Run = context.run_at(?ctx, context.run_count(?ctx) - 1);
    val first: context.Run = context.run_at(?ctx, 0);
    if (last.layer != lr)                          { ret 4; }
    if (band.band_of(first.layer) != band.WINDOWS) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel button at y [0, 16) and, when shown, a popup whose
# button covers it
#[testing]
fun frame_vanish(ctx: *context.Context, in: input.Input, show: u8) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, "base");
    end_panel(ctx, p);
    val pop: Popup = begin_popup(ctx, "pop", show, 0.0::f32, 0.0::f32, 100.0::f32);
    if (pop.open != 0) { button(ctx, "top"); }
    end_popup(ctx, pop);
    context.end(ctx);
    ret clicked;
}

test routing__vanished_claimant_leaves_one_dead_frame {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 0), 1);
    frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 0), 1);
    if (ctx.hot != bid.of_label(context.id_of(?ctx, "pop"), "top")) { ret 2; }

    # the popup is gone and a press lands where it was: it reaches nobody
    frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 1), 0);
    if (ctx.hot != 0 || ctx.active != 0) { ret 3; }

    # the next frame routes to the base button, and the earlier press never clicks it
    if (frame_vanish(?ctx, input_at(50.0::f32, 8.0::f32, 0), 0) != false) { ret 4; }
    if (ctx.hot != context.id_of(?ctx, "base"))                           { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test routing__interactive_from_frame_after_first_claim {
    var a:    allo.Allocator;
