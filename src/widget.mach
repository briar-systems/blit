test routing__drag_holds_and_clipped_rects_stay_cold {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    val win: Window = auto_window("w", 0.0::f32, 30.0::f32, 100.0::f32);
    var v:   f32    = 0.0::f32;

    frame_slider_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?v, win);
    frame_slider_window(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?v, win);
    if (ctx.active != context.id_of(?ctx, "v")) { ret 2; }
    frame_slider_window(?ctx, input_at(50.0::f32, 38.0::f32, 1), ?v, win);
    if (v != 5.0::f32)                                                                   { ret 3; }
    if (ctx.active != context.id_of(?ctx, "v"))                                          { ret 4; }
    if (window_state(?ctx, "w").x != 0.0::f32 || window_state(?ctx, "w").y != 30.0::f32) { ret 5; }
    frame_slider_window(?ctx, input_at(50.0::f32, 38.0::f32, 0), ?v, win);

    # a region clipped away cannot be hovered or clicked
    frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 0), 1);
    frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 1), 1);
    if (ctx.hot != 0 || ctx.active != 0)                               { ret 6; }
    if (frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 0), 1) != 0) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a region at local (0, 0)-(10, 10) inside surface B nested in
# surface A, which paints at screen (60, 60)-(70, 70)
#[testing]
fun frame_nested_region(ctx: *context.Context, in: input.Input) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val sa:      context.Surface = context.begin_surface(ctx, 50.0::f32, 50.0::f32, 100.0::f32, 100.0::f32, 10.0::f32, 10.0::f32);
    val sb:      context.Surface = context.begin_surface(ctx, 20.0::f32, 20.0::f32, 30.0::f32, 30.0::f32, 0.0::f32, 0.0::f32);
    val clicked: u8              = region_clicked(ctx, "r", 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32);
    context.end_surface(ctx, sb);
    context.end_surface(ctx, sa);
    context.end(ctx);
    ret clicked;
}

test surface__nested_widget_clicked_where_painted {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 0));
    frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 1));
    if (frame_nested_region(?ctx, input_at(65.0::f32, 65.0::f32, 0)) != 1) { ret 2; }

    # where screen-space arithmetic would have put it, (20, 20)-(30, 30), is dead
    frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 0));
    frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 1));
    if (frame_nested_region(?ctx, input_at(25.0::f32, 25.0::f32, 0)) != 0) { ret 3; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame with a left dock of 20 text rows and a right dock, holding a slider
# and a section heading
#[testing]
fun frame_docks(ctx: *context.Context, in: input.Input, left: *Dock, right: *Dock, v: *f32, open: *u8) context.Area {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val l: DockArea = begin_dock(ctx, "left", left);
    var i: usize    = 0;
    for (i < 20) {
        text(ctx, "row");
        i = i + 1;
    }
    end_dock(ctx, left, l);
    val r: DockArea = begin_dock(ctx, "right", right);
    if (section(ctx, "sec", open)) { slider_f(ctx, "v", v, 0.0::f32, 10.0::f32); }
    end_dock(ctx, right, r);
    val free: context.Area = context.free_area(ctx);
    context.end(ctx);
    ret free;
}

test dock__carves_scrolls_and_sections {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var left:  Dock;
    var right: Dock;
    left.side  = context.Side.left{};
    left.size  = 60.0::f32;
    right.side = context.Side.right{};
    right.size = 50.0::f32;
    var v:    f32 = 0.0::f32;
    var open: u8  = 0;

    # the docks stack inward and leave the middle free
    val free: context.Area = frame_docks(?ctx, input_at(30.0::f32, 100.0::f32, 0), ?left, ?right, ?v, ?open);
    if (free.x0 != 60.0::f32 || free.x1 != 150.0::f32) { ret 2; }
    if (free.y0 != 0.0::f32 || free.y1 != 200.0::f32)  { ret 3; }
    # 20 rows of 12 pixels overflow the 192 pixel body
    if (left.scroll.content != 240.0::f32) { ret 4; }

    # a wheel turned towards the user over the left dock scrolls it, and clamps
    var in: input.Input = input_at(30.0::f32, 100.0::f32, 0);
    in.wheel = -30.0::f32;
    frame_docks(?ctx, in, ?left, ?right, ?v, ?open);
    if (left.scroll.offset != 30.0::f32) { ret 5; }
    in.wheel = -1000.0::f32;
    frame_docks(?ctx, in, ?left, ?right, ?v, ?open);
    if (left.scroll.offset != 48.0::f32) { ret 6; }
    # over the free area the wheel reaches no dock
    in.mx    = 100.0::f32;
    in.wheel = 30.0::f32;
    frame_docks(?ctx, in, ?left, ?right, ?v, ?open);
    if (left.scroll.offset != 48.0::f32 || right.scroll.offset != 0.0::f32) { ret 7; }

    # clicking the right dock's heading opens its section, whose slider then
    # maps the cursor in the dock's local space: its track spans x [154, 196)
    frame_docks(?ctx, input_at(170.0::f32, 10.0::f32, 0), ?left, ?right, ?v, ?open);
    frame_docks(?ctx, input_at(170.0::f32, 10.0::f32, 1), ?left, ?right, ?v, ?open);
    frame_docks(?ctx, input_at(170.0::f32, 10.0::f32, 0), ?left, ?right, ?v, ?open);
    if (open != 1) { ret 8; }
    frame_docks(?ctx, input_at(175.0::f32, 30.0::f32, 0), ?left, ?right, ?v, ?open);
    frame_docks(?ctx, input_at(175.0::f32, 30.0::f32, 1), ?left, ?right, ?v, ?open);
    if (v != 5.0::f32) { ret 9; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a 100 tall scroll region of 20 buttons at the root
#[testing]
fun frame_scroll(ctx: *context.Context, in: input.Input, s: *Scroll) {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
