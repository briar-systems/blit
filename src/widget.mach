test routing__drag_holds_and_clipped_rects_stay_cold {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var win: Window;
    win.x     = 0.0::f32;
    win.y     = 30.0::f32;
    win.w     = 100.0::f32;
    win.open  = 1;
    win.title = "w";
    var v: f32 = 0.0::f32;

    frame_slider_window(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?v, ?win);
    frame_slider_window(?ctx, input_at(10.0::f32, 8.0::f32, 1), ?v, ?win);
    if (ctx.active != context.id_of(?ctx, "v")) { ret 2; }
    frame_slider_window(?ctx, input_at(50.0::f32, 38.0::f32, 1), ?v, ?win);
    if (v != 5.0::f32)                           { ret 3; }
    if (ctx.active != context.id_of(?ctx, "v"))  { ret 4; }
    if (win.x != 0.0::f32 || win.y != 30.0::f32) { ret 5; }
    frame_slider_window(?ctx, input_at(50.0::f32, 38.0::f32, 0), ?v, ?win);

    # a region clipped away cannot be hovered or clicked
    frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 0), 1);
    frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 1), 1);
    if (ctx.hot != 0 || ctx.active != 0)                               { ret 6; }
    if (frame_region(?ctx, input_at(50.0::f32, 50.0::f32, 0), 1) != 0) { ret 7; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a region at local (0, 0)-(10, 10) inside surface B nested in
# surface A, which paints at screen (60, 60)-(70, 70)
#[testing]
fun frame_nested_region(ctx: *context.Context, in: input.Input) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val sa:      context.Surface = context.begin_surface(ctx, 50.0::f32, 50.0::f32, 100.0::f32, 100.0::f32, 10.0::f32, 10.0::f32);
    val sb:      context.Surface = context.begin_surface(ctx, 20.0::f32, 20.0::f32, 30.0::f32, 30.0::f32, 0.0::f32, 0.0::f32);
    val clicked: u8              = region_clicked(ctx, "r", 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32);
    context.end_surface(ctx, sb);
    context.end_surface(ctx, sa);
    context.end(ctx);
    ret clicked;
}

test surface__nested_widget_clicked_where_painted {
    var a:    allo.Allocator;
