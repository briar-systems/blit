}

test slider__drags_with_a_reading {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # press in the middle, then drag past the right end while held
    var v: f32 = 0.0::f32;
    frame_reading(?ctx, input_at(50.0::f32, 8.0::f32, 0), ?v, "0");
    if (frame_reading(?ctx, input_at(50.0::f32, 8.0::f32, 1), ?v, "0") != true)   { ret 2; }
    if (v != 5.0::f32)                                                            { ret 3; }
    if (frame_reading(?ctx, input_at(300.0::f32, 90.0::f32, 1), ?v, "5") != true) { ret 4; }
    if (v != 10.0::f32)                                                           { ret 5; }
    frame_reading(?ctx, input_at(300.0::f32, 90.0::f32, 0), ?v, "10");

    # the reading is two glyphs more than none
    val shown: usize = context.draw_count(?ctx);
    frame_reading(?ctx, input_at(300.0::f32, 90.0::f32, 0), ?v, nil);
    if (shown != context.draw_count(?ctx) + 8) { ret 6; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a w-wide panel with one note, returning the cursor after it
#[testing]
fun frame_note(ctx: *context.Context, s: str, w: f32) f32 {
    context.begin(ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    val p: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, w);
    note(ctx, s);
    val y: f32 = avail(ctx).y0;
    end_panel(ctx, p);
    context.end(ctx);
    ret y;
}

# the rightmost composed vertex x
#[testing]
fun right_edge(ctx: *context.Context) f32 {
    val p: *draw.Vert = context.draw_verts(ctx);
    val n: usize      = context.draw_count(ctx);
    var x: f32        = 0.0::f32;
    var i: usize      = 0;
    for (i < n) {
        x = maxf(x, p[i].x);
        i = i + 1;
    }
    ret x;
}

test note__wraps_at_spaces_to_the_column {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # lines of 8 pixels and a 4 pixel gap below the note
    if (frame_note(?ctx, "aa bb", 40.0::f32) != 12.0::f32)       { ret 2; }
    if (frame_note(?ctx, "aa bb cc dd", 40.0::f32) != 20.0::f32) { ret 3; }
    if (right_edge(?ctx) > 40.0::f32)                            { ret 4; }
    # a word wider than the column breaks where it overflows
    if (frame_note(?ctx, "abcdefghij", 40.0::f32) != 20.0::f32) { ret 5; }
    if (right_edge(?ctx) > 40.0::f32)                           { ret 6; }
    # a newline starts a line, and an empty note still takes one
    if (frame_note(?ctx, "a\nb", 40.0::f32) != 20.0::f32) { ret 7; }
    if (frame_note(?ctx, "", 40.0::f32) != 12.0::f32)     { ret 8; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with a row of two buttons, then a grid of five two
# to a row with the second drawn chosen
#[testing]
fun frame_grid(ctx: *context.Context, in: input.Input, row: *usize, grid: *usize) {
    var labels: [5]str;
    labels[0] = "a";
    labels[1] = "b";
    labels[2] = "c";
    labels[3] = "d";
    labels[4] = "e";
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    context.push_id_str(ctx, "row");
    @row = buttons(ctx, ?labels[0], 2);
    context.pop_id(ctx);
    context.push_id_str(ctx, "grid");
    @grid = button_grid(ctx, ?labels[0], 5, 2, 1);
    context.pop_id(ctx);
    end_panel(ctx, p);
    context.end(ctx);
}

test buttons__rows_and_grids_report_the_index {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # the row's second button spans x [52, 100) and y [0, 16)
    var row:  usize = 0;
    var grid: usize = 0;
    frame_grid(?ctx, input_at(75.0::f32, 8.0::f32, 0), ?row, ?grid);
    if (row != 2 || grid != 5) { ret 2; }
    frame_grid(?ctx, input_at(75.0::f32, 8.0::f32, 1), ?row, ?grid);
    frame_grid(?ctx, input_at(75.0::f32, 8.0::f32, 0), ?row, ?grid);
    if (row != 1 || grid != 5) { ret 3; }

    # the grid's last row holds item 4 alone, at x [0, 48) and y [60, 76),
    # and the layout continues below it
    frame_grid(?ctx, input_at(20.0::f32, 65.0::f32, 0), ?row, ?grid);
    frame_grid(?ctx, input_at(20.0::f32, 65.0::f32, 1), ?row, ?grid);
    frame_grid(?ctx, input_at(20.0::f32, 65.0::f32, 0), ?row, ?grid);
    if (row != 2 || grid != 4)         { ret 4; }
    if (context.collisions(?ctx) != 0) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test image__quads_carry_handle_rect_and_uvs {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    val white: draw.Color = draw.rgba(1.0::f32, 1.0::f32, 1.0::f32, 1.0::f32);
    val cold:  draw.Color = draw.rgba(0.0::f32, 0.0::f32, 1.0::f32, 1.0::f32);
    val hot:   draw.Color = draw.rgba(1.0::f32, 0.0::f32, 0.0::f32, 1.0::f32);
    var steps: [2]draw.Color;
    steps[0] = cold;
    steps[1] = hot;
    var field: [4]f32;
    field[0] = 0.0::f32;
    field[1] = 1.0::f32;
    field[2] = 0.75::f32;
    field[3] = 0.25::f32;
    val heat: Grid = Grid{
        cols:    2, rows: 2, colors: nil, values: ?field[0],
        palette: Palette{colors: ?steps[0], count: 2, lo: 0.0::f32, hi: 1.0::f32}
    };

    context.begin(?ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    # texels [16, 48) of a 64 texel texture, scaled 60 wide into a clip 30 wide
    context.push_clip(?ctx, 0.0::f32, 0.0::f32, 50.0::f32, 100.0::f32);
    val crop: draw.Image = draw.region(9, 64.0::f32, 64.0::f32, 16.0::f32, 16.0::f32, 32.0::f32, 32.0::f32, draw.FILTER_NEAREST);
    context.image_at(?ctx, crop, 20.0::f32, 10.0::f32, 80.0::f32, 40.0::f32, white);
    context.pop_clip(?ctx);
    # the same texture sampled linearly binds apart
    space(?ctx, 50.0::f32);
    image(?ctx, draw.whole(9, draw.FILTER_LINEAR), 16.0::f32, 8.0::f32);
    grid_at(?ctx, heat, 0.0::f32, 100.0::f32, 20.0::f32, 120.0::f32);
    context.end(?ctx);

    if (context.run_count(?ctx) != 3) { ret 2; }
    val near: context.Run = context.run_at(?ctx, 0);
    if (near.tex != 9 || near.filter != draw.FILTER_NEAREST || near.page != 0) { ret 3; }
    if (near.start != 0 || near.count != 6)                                    { ret 4; }
    val lin: context.Run = context.run_at(?ctx, 1);
    if (lin.tex != 9 || lin.filter != draw.FILTER_LINEAR || lin.count != 6) { ret 5; }
    val cells: context.Run = context.run_at(?ctx, 2);
    if (cells.tex != draw.ATLAS || cells.start != 12 || cells.count != 24) { ret 6; }

    # the clip at x 50 is the cropped image's scissor, and its quad stays whole
    if (near.clip_x1 != 50.0::f32 || lin.clip_x1 != 200.0::f32) { ret 7; }
    val p: *draw.Vert = context.draw_verts(?ctx);
    if (p[0].x != 20.0::f32 || p[0].y != 10.0::f32) { ret 8; }
    if (p[0].u != 0.25::f32 || p[0].v != 0.25::f32) { ret 9; }
    if (p[2].x != 80.0::f32 || p[2].y != 40.0::f32) { ret 10; }
    if (p[2].u != 0.75::f32 || p[2].v != 0.75::f32) { ret 11; }
    # the flow image fills its rect at the cursor with the whole texture
    if (p[4].x != 0.0::f32 || p[4].y != 50.0::f32)  { ret 12; }
    if (p[6].x != 16.0::f32 || p[6].y != 58.0::f32) { ret 13; }
    if (p[6].u != 1.0::f32 || p[6].v != 1.0::f32)   { ret 14; }
    # cells tile row-major from the top left in their palette steps
    if (p[8].x != 0.0::f32 || p[10].x != 10.0::f32)   { ret 15; }
    if (p[8].b != 1.0::f32 || p[12].r != 1.0::f32)    { ret 16; }
    if (p[16].y != 110.0::f32 || p[16].r != 1.0::f32) { ret 17; }
    if (p[20].b != 1.0::f32)                          { ret 18; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding one panel that draws one text field when draw_it is set
#[testing]
fun frame_field(ctx: *context.Context, in: input.Input, f: *field.Field, draw_it: u8) u8 {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:   Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    var out: u8    = 0;
    if (draw_it != 0) { out = text_field(ctx, "name", f, "name"); }
    end_panel(ctx, p);
    context.end(ctx);
    ret out;
}

# hover, press and release on the field at x, which gives it the keyboard
#[testing]
fun click_field(ctx: *context.Context, f: *field.Field, x: f32) {
    frame_field(ctx, input_at(x, 8.0::f32, 0), f, 1);
    frame_field(ctx, input_at(x, 8.0::f32, 1), f, 1);
    frame_field(ctx, input_at(x, 8.0::f32, 0), f, 1);
}

# empty a bound input's events and put the cursor at (mx, my) with the button up
#[testing]
fun refill(in: *input.Input, mx: f32, my: f32) {
    input.clear_keys(in);
    in.mx      = mx;
    in.my      = my;
    in.present = 1;
    in.down    = 0;
}

test text_field__types_edits_and_reports_enter {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    var buf: [64]u8;
    var f:   field.Field;
    field.init(?f, ?buf[0], 64, 0, nil);

    # typing reaches no field until one is clicked
    var in: input.Input;
    input.init(?in, ?a);
    refill(?in, 10.0::f32, 8.0::f32);
    input.type_text(?in, 'q');
    frame_field(?ctx, in, ?f, 1);
    if (f.len != 0 || context.typing(?ctx)) { ret 2; }
    click_field(?ctx, ?f, 10.0::f32);
    if (!context.typing(?ctx)) { ret 3; }

    # typed text, non-ascii included, lands at the caret in arrival order
    refill(?in, 10.0::f32, 8.0::f32);
    input.type_text(?in, 'c');
    input.type_text(?in, 'f');
    input.press_key(?in, input.KEY_LEFT, 0);
    input.type_text(?in, 'a');
    input.press_key(?in, input.KEY_END, 0);
    input.type_text(?in, 0xE9);
    if (frame_field(?ctx, in, ?f, 1) != field.EDITED)               { ret 4; }
    if (!str_equals(field.text(?f), "caf\xC3\xA9") || f.caret != 5) { ret 5; }

    # shift+arrows select, and typing replaces the selection
    refill(?in, 10.0::f32, 8.0::f32);
    input.press_key(?in, input.KEY_LEFT, input.MOD_SHIFT);
    input.press_key(?in, input.KEY_LEFT, input.MOD_SHIFT);
    input.type_text(?in, 'X');
    frame_field(?ctx, in, ?f, 1);
    if (!str_equals(field.text(?f), "caX")) { ret 6; }

    # a click puts the caret under the cursor: the bitmap font's cells are 8
    # wide after 4 of padding, so x = 13 is nearest the boundary after 'c'
    # later than a double click after the first
    frame_timed(?ctx, ?f, 13.0::f32, 0, 0, 5.0::f64);
    frame_timed(?ctx, ?f, 13.0::f32, 1, 0, 5.0::f64);
    frame_timed(?ctx, ?f, 13.0::f32, 0, 0, 5.0::f64);
    if (f.caret != 1 || field.selected(?f)) { ret 7; }

    # select all and cut hands the text to the clipboard, paste asks for it
    # and takes it from the next frame
    refill(?in, 13.0::f32, 8.0::f32);
    input.press_key(?in, 'A', input.MOD_CTRL);
    input.press_key(?in, 'X', input.MOD_CTRL);
    input.press_key(?in, 'V', input.MOD_CTRL);
    if (frame_field(?ctx, in, ?f, 1) != field.EDITED || f.len != 0) { ret 8; }
    if (!str_equals(context.copied(?ctx), "caX"))                   { ret 9; }
    if (!context.wants_paste(?ctx))                                 { ret 10; }
    refill(?in, 13.0::f32, 8.0::f32);
    in.paste = "caX";
    frame_field(?ctx, in, ?f, 1);
    if (!str_equals(field.text(?f), "caX") || context.copied(?ctx) != nil) { ret 11; }

    # enter reports and gives the keyboard back, and what follows it is not taken
    refill(?in, 13.0::f32, 8.0::f32);
    input.press_key(?in, input.KEY_ENTER, 0);
    input.type_text(?in, 'z');
    if (frame_field(?ctx, in, ?f, 1) != field.ENTERED) { ret 12; }
    if (context.typing(?ctx) || f.len != 3)            { ret 13; }

    # a caller refusing the entry hands the keyboard straight back by the field's id
    context.focus(?ctx, context.id_of(?ctx, "name"));
    refill(?in, 13.0::f32, 8.0::f32);
    input.type_text(?in, 'w');
    if (frame_field(?ctx, in, ?f, 1) != field.EDITED) { ret 16; }
    if (!context.typing(?ctx) || f.len != 4)          { ret 17; }

    # escape reports the same way
    click_field(?ctx, ?f, 13.0::f32);
    refill(?in, 13.0::f32, 8.0::f32);
    input.type_text(?in, 'y');
    input.press_key(?in, input.KEY_ESCAPE, 0);
    if (frame_field(?ctx, in, ?f, 1) != (field.EDITED | field.ESCAPED)) { ret 14; }
    if (context.typing(?ctx))                                           { ret 15; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test text_field__focus_lost_when_undrawn_or_clicked_elsewhere {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    var buf: [16]u8;
    var f:   field.Field;
    field.init(?f, ?buf[0], 16, 0, nil);

    # a frame that does not draw the field takes the keyboard back
    click_field(?ctx, ?f, 10.0::f32);
    if (!context.typing(?ctx)) { ret 2; }
    frame_field(?ctx, input_at(10.0::f32, 8.0::f32, 0), ?f, 0);
    if (context.typing(?ctx)) { ret 3; }
    var in: input.Input;
    input.init(?in, ?a);
    refill(?in, 10.0::f32, 8.0::f32);
    input.type_text(?in, 'k');
    frame_field(?ctx, in, ?f, 1);
    if (f.len != 0) { ret 4; }

    # so does a press anywhere else, inside the panel or out of it
    click_field(?ctx, ?f, 10.0::f32);
    frame_field(?ctx, input_at(10.0::f32, 40.0::f32, 1), ?f, 1);
    if (context.typing(?ctx)) { ret 5; }
    frame_field(?ctx, input_at(10.0::f32, 40.0::f32, 0), ?f, 1);
    click_field(?ctx, ?f, 10.0::f32);
    frame_field(?ctx, input_at(150.0::f32, 150.0::f32, 1), ?f, 1);
    if (context.typing(?ctx)) { ret 6; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test text_field__shows_the_composition_at_the_caret {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    var buf: [16]u8;
    var f:   field.Field;
    field.init(?f, ?buf[0], 16, 0, nil);
    var in: input.Input;
    input.init(?in, ?a);

    # nothing takes text, so the candidate window has no place
    refill(?in, 10.0::f32, 8.0::f32);
    frame_field(?ctx, in, ?f, 1);
    val idle: opt[context.Area] = context.ime_rect(?ctx);
    if (!sel idle.none) { ret 2; }

    # the bitmap font's cells are 8 wide after 4 of padding, so after "ab"
    # the caret is at 20, and the composition's caret one cell into it
    click_field(?ctx, ?f, 10.0::f32);
    if (context.cursor(?ctx) != input.CURSOR_TEXT) { ret 3; }
    refill(?in, 10.0::f32, 8.0::f32);
    input.type_text(?in, 'a');
    input.type_text(?in, 'b');
    input.compose(?in, "xyz", 1);
    frame_field(?ctx, in, ?f, 1);
    val r: opt[context.Area] = context.ime_rect(?ctx);
    if (!(sel r.some && r.some.x0 == 28.0::f32)) { ret 4; }
    if (f.len != 2)                              { ret 5; }

    # it stays until a composition ends it, and the field's text is untouched
    refill(?in, 10.0::f32, 8.0::f32);
    frame_field(?ctx, in, ?f, 1);
    if (!str_equals(context.preedit(?ctx, ctx.focus), "xyz")) { ret 6; }
    refill(?in, 10.0::f32, 8.0::f32);
    input.compose(?in, "", 0);
    frame_field(?ctx, in, ?f, 1);
    val ended: opt[context.Area] = context.ime_rect(?ctx);
    if (!(sel ended.some && ended.some.x0 == 20.0::f32)) { ret 7; }
    if (context.preedit(?ctx, ctx.focus) != nil)         { ret 8; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame of the one-field panel with the cursor at x, the button in state
# down, mods held and the clock at t
#[testing]
fun frame_timed(ctx: *context.Context, f: *field.Field, x: f32, down: u8, mods: u8, t: f64) {
    var in: input.Input = input_at(x, 8.0::f32, down);
    in.mods = mods;
    in.time = t;
    frame_field(ctx, in, f, 1);
}

test text_field__selects_by_click_double_click_triple_click_and_drag {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    var buf: [32]u8;
    var f:   field.Field;
    field.init(?f, ?buf[0], 32, 0, nil);
    field.set(?f, "alpha beta");

    # the bitmap font's cells are 8 wide after 4 of padding, so x = 62 is
    # inside 'e' of beta, nearest offset 7
    frame_timed(?ctx, ?f, 62.0::f32, 0, 0, 1.0::f64);
    frame_timed(?ctx, ?f, 62.0::f32, 1, 0, 1.0::f64);
    frame_timed(?ctx, ?f, 62.0::f32, 0, 0, 1.05::f64);
    if (f.caret != 7 || field.selected(?f)) { ret 2; }
    frame_timed(?ctx, ?f, 62.0::f32, 1, 0, 1.1::f64);
    if (field.sel_lo(?f) != 6 || field.sel_hi(?f) != 10) { ret 3; }
    frame_timed(?ctx, ?f, 62.0::f32, 0, 0, 1.15::f64);
    frame_timed(?ctx, ?f, 62.0::f32, 1, 0, 1.2::f64);
    if (field.sel_lo(?f) != 0 || field.sel_hi(?f) != 10) { ret 4; }
    frame_timed(?ctx, ?f, 62.0::f32, 0, 0, 1.25::f64);

    # a later press is a single click again, and dragging extends from it
    frame_timed(?ctx, ?f, 13.0::f32, 0, 0, 3.0::f64);
    frame_timed(?ctx, ?f, 13.0::f32, 1, 0, 3.0::f64);
    frame_timed(?ctx, ?f, 44.0::f32, 1, 0, 3.1::f64);
    if (field.sel_lo(?f) != 1 || field.sel_hi(?f) != 5 || f.caret != 5) { ret 5; }
    frame_timed(?ctx, ?f, 44.0::f32, 0, 0, 3.2::f64);
    if (field.sel_lo(?f) != 1 || field.sel_hi(?f) != 5) { ret 6; }

    # shift extends the selection to a click
    frame_timed(?ctx, ?f, 68.0::f32, 1, input.MOD_SHIFT, 5.0::f64);
    if (field.sel_lo(?f) != 1 || f.caret != 8) { ret 7; }
    frame_timed(?ctx, ?f, 68.0::f32, 0, 0, 5.1::f64);

    # dragging after a double click grows by words
    frame_timed(?ctx, ?f, 13.0::f32, 1, 0, 7.0::f64);
    frame_timed(?ctx, ?f, 13.0::f32, 0, 0, 7.05::f64);
    frame_timed(?ctx, ?f, 13.0::f32, 1, 0, 7.1::f64);
    if (field.sel_lo(?f) != 0 || field.sel_hi(?f) != 5) { ret 8; }
    frame_timed(?ctx, ?f, 62.0::f32, 1, 0, 7.2::f64);
    if (field.sel_lo(?f) != 0 || field.sel_hi(?f) != 10) { ret 9; }
    frame_timed(?ctx, ?f, 62.0::f32, 0, 0, 7.3::f64);

    # the caret blinks off after a while and asks for the frame it turns in
    frame_timed(?ctx, ?f, 62.0::f32, 0, 0, 7.3::f64 + edit.BLINK + 0.01::f64);
    val wake: opt[f64] = context.next_frame(?ctx);
    if (!(sel wake.some && wake.some > 7.3::f64 + edit.BLINK)) { ret 10; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test text_field__masks_counts_and_reads_only {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    var buf: [32]u8;
    var f:   field.Field;
    field.init(?f, ?buf[0], 32, 8, nil);
    field.set(?f, "pw");
    f.flags = field.MASKED | field.COUNT;
    var in: input.Input;
    input.init(?in, ?a);

    # a masked field copies nothing
    click_field(?ctx, ?f, 10.0::f32);
    refill(?in, 10.0::f32, 8.0::f32);
    input.press_key(?in, 'A', input.MOD_CTRL);
    input.press_key(?in, 'C', input.MOD_CTRL);
    input.type_text(?in, 'x');
    frame_field(?ctx, in, ?f, 1);
    if (context.copied(?ctx) != nil || !str_equals(field.text(?f), "x")) { ret 2; }

    # a read-only one copies but takes no edit, paste or composition
    f.flags = field.READ_ONLY;
    refill(?in, 10.0::f32, 8.0::f32);
    input.press_key(?in, 'A', input.MOD_CTRL);
    input.press_key(?in, 'X', input.MOD_CTRL);
    input.press_key(?in, 'V', input.MOD_CTRL);
    input.type_text(?in, 'y');
    input.compose(?in, "ka", 1);
    if (frame_field(?ctx, in, ?f, 1) != 0 || !str_equals(field.text(?f), "x")) { ret 3; }
    if (!str_equals(context.copied(?ctx), "x") || context.wants_paste(?ctx))   { ret 4; }
    val ime: opt[context.Area] = context.ime_rect(?ctx);
    if (!sel ime.none) { ret 5; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding a panel with, when shown, a button above a slider and a text
# field
#[testing]
fun frame_shifted(ctx: *context.Context, in: input.Input, show: u8, v: *f32, f: *field.Field) {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p: Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    if (show != 0) { button(ctx, "extra"); }
    slider_f(ctx, "v", v, 0.0::f32, 10.0::f32);
    text_field(ctx, "name", f, nil);
    end_panel(ctx, p);
    context.end(ctx);
}

test ids__survive_a_widget_appearing_before_them {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    var buf: [16]u8;
    var f:   field.Field;
    field.init(?f, ?buf[0], 16, 0, nil);
    var v: f32 = 0.0::f32;

    # grab the slider at y [0, 16), then show a button above it mid-drag: the
    # drag stays on the slider, now at y [20, 36), and the button under the
    # cursor never activates
    frame_shifted(?ctx, input_at(1.0::f32, 8.0::f32, 0), 0, ?v, ?f);
    frame_shifted(?ctx, input_at(1.0::f32, 8.0::f32, 1), 0, ?v, ?f);
    if (ctx.active != context.id_of(?ctx, "v")) { ret 2; }
    frame_shifted(?ctx, input_at(50.0::f32, 8.0::f32, 1), 1, ?v, ?f);
    if (ctx.active != context.id_of(?ctx, "v")) { ret 3; }
    if (v != 5.0::f32)                          { ret 4; }
    frame_shifted(?ctx, input_at(50.0::f32, 8.0::f32, 0), 1, ?v, ?f);

    # focus the field at y [40, 56), then hide the button: the field moves up
    # to y [20, 36) and keeps the keyboard
    frame_shifted(?ctx, input_at(10.0::f32, 48.0::f32, 0), 1, ?v, ?f);
    frame_shifted(?ctx, input_at(10.0::f32, 48.0::f32, 1), 1, ?v, ?f);
    frame_shifted(?ctx, input_at(10.0::f32, 48.0::f32, 0), 1, ?v, ?f);
    if (ctx.focus != context.id_of(?ctx, "name")) { ret 5; }
    var in: input.Input;
    input.init(?in, ?a);
    refill(?in, 10.0::f32, 28.0::f32);
    input.type_text(?in, 'k');
    frame_shifted(?ctx, in, 0, ?v, ?f);
    if (!context.typing(?ctx) || f.len != 1) { ret 6; }

    val fi: err[allo.Error] = input.free(?in);
    if (sel fi.err) { ret 1; }
    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# a frame holding one panel with one button labelled label
#[testing]
fun frame_label(ctx: *context.Context, in: input.Input, label: str) bool {
    context.begin(ctx, in, 200.0::f32, 200.0::f32);
    val p:       Block = begin_panel(ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    val clicked: bool  = button(ctx, label);
    end_panel(ctx, p);
    context.end(ctx);
    ret clicked;
}

test ids__labels_hide_and_key_by_markers {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # text after "##" is not drawn, so the label paints as "Save" alone
    frame_label(?ctx, input_at(0.0::f32, 0.0::f32, 0), "Save");
    val plain: usize = context.draw_count(?ctx);
    frame_label(?ctx, input_at(0.0::f32, 0.0::f32, 0), "Save##toolbar");
    if (context.draw_count(?ctx) != plain) { ret 2; }

    # but it is hashed: two "Save" buttons apart by "##" never collide
    context.begin(?ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    begin_panel(?ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    button(?ctx, "Save##a");
    button(?ctx, "Save##b");
    context.end(?ctx);
    if (context.collisions(?ctx) != 0)                                    { ret 3; }
    if (context.id_of(?ctx, "Save##a") == context.id_of(?ctx, "Save##b")) { ret 4; }

    # "###" keys by its tail, so the shown text changes under one id: a press
    # on "12" and a release on "13" is a click
    frame_label(?ctx, input_at(10.0::f32, 8.0::f32, 0), "Frames: 12###fps");
    frame_label(?ctx, input_at(10.0::f32, 8.0::f32, 1), "Frames: 12###fps");
    if (!frame_label(?ctx, input_at(10.0::f32, 8.0::f32, 0), "Frames: 13###fps")) { ret 5; }
    if (context.id_of(?ctx, "Frames: 12###fps") != context.id_of(?ctx, "###fps")) { ret 6; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test ids__scopes_nest_through_containers {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    val w1: Window = auto_window("one", 0.0::f32, 0.0::f32, 100.0::f32);
    val w2: Window = auto_window("two", 0.0::f32, 0.0::f32, 100.0::f32);
    var s:  Scroll;

    val root: u64 = context.id_of(?ctx, "ok");
    val one:  u64 = context.id_of(?ctx, "one");
    val pop:  u64 = bid.of_label(one, "pop");
    val reg:  u64 = bid.of_label(pop, "reg");

    context.begin(?ctx, input_at(0.0::f32, 0.0::f32, 0), 400.0::f32, 400.0::f32);
    val b1: WindowArea = begin_window(?ctx, w1);
    button(?ctx, "ok");
    if (context.id_of(?ctx, "ok") != bid.of_label(one, "ok")) { ret 3; }
    val p: Popup = begin_popup(?ctx, "pop", 1, 0.0::f32, 0.0::f32, 50.0::f32);
    if (context.id_of(?ctx, "ok") != bid.of_label(pop, "ok")) { ret 4; }
    val r: ScrollArea = begin_scroll(?ctx, "reg", ?s, 50.0::f32);
    if (context.id_of(?ctx, "ok") != bid.of_label(reg, "ok")) { ret 5; }
    end_scroll(?ctx, ?s, r);
    end_popup(?ctx, p);
    if (context.id_of(?ctx, "ok") != bid.of_label(one, "ok")) { ret 6; }
    end_window(?ctx, b1);
    # a second window holds its own "ok"
    val b2: WindowArea = begin_window(?ctx, w2);
    button(?ctx, "ok");
    end_window(?ctx, b2);
    if (context.id_of(?ctx, "ok") != root) { ret 7; }

    # an unbalanced pop is ignored, at the root and after a balanced pair
    context.pop_id(?ctx);
    context.push_id_int(?ctx, 3);
    if (context.id_of(?ctx, "ok") == root) { ret 8; }
    context.pop_id(?ctx);
    context.pop_id(?ctx);
    if (context.id_of(?ctx, "ok") != root) { ret 9; }
    context.end(?ctx);
    if (context.collisions(?ctx) != 0) { ret 10; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test ids__same_frame_collisions_are_counted {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: context.Context;
    val ie:  err[allo.Error] = context.init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # three "ok" buttons in one scope repeat its id twice
    context.begin(?ctx, input_at(0.0::f32, 0.0::f32, 0), 200.0::f32, 200.0::f32);
    begin_panel(?ctx, 0.0::f32, 0.0::f32, 100.0::f32);
    button(?ctx, "ok");
    button(?ctx, "ok");
    button(?ctx, "ok");
    context.end(?ctx);
    val ok: u64 = context.id_of(?ctx, "ok");
    if (context.collisions(?ctx) != 2)                                              { ret 2; }
    if (context.collision_at(?ctx, 0) != ok || context.collision_at(?ctx, 1) != ok) { ret 3; }
    if (context.collision_at(?ctx, 2) != 0)                                         { ret 4; }

    # the count is per frame
    frame_button(?ctx, input_at(0.0::f32, 0.0::f32, 0));
    if (context.collisions(?ctx) != 0) { ret 5; }

    val freed: err[allo.Error] = context.free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# two windows side by side: a source row in the left, two target rows in the
# right, one accepting the source's type and one another type
# ---
# left:    the "From" window
# right:   the "To" window
# value:   the payload the source drags
# drag:    what the source's drag did this frame
# ons:     frames the source's drag was on
# got:     the payload the accepting row last took, 0 before any
# drops:   drops the accepting row took
# overs:   frames a drag was over the accepting row
# others:  frames a drag was over the row accepting another type
# preview: the last preview rect opened
# px:      the pointer x the last preview opened at
# py:      the pointer y the last preview opened at
# layer:   the layer the last preview drew on
#[testing]
rec DndPair {
    left:    Window;
    right:   Window;
    value:   u64;
    drag:    dnd.Drag;
    ons:     usize;
    got:     u64;
    drops:   usize;
    overs:   usize;
    others:  usize;
    preview: dnd.Preview;
    px:      f32;
    py:      f32;
    layer:   u32;
}

# a row in the current window, claimed for the left button
#[testing]
fun dnd_row(ctx: *context.Context, key: str, x0: *f32, y0: *f32, x1: *f32, y1: *f32) interact.Hit {
    val r: context.Area = place(ctx, layout.fill(1.0::f32), layout.fixed(20.0::f32), 0.0::f32, 20.0::f32);
    @x0 = r.x0;
    @y0 = r.y0;
    @x1 = r.x1;
    @y1 = r.y1;
    val h: interact.Hit = interact.hit(ctx, context.id_of(ctx, key), @x0, @y0, @x1, @y1, input.BUTTON_LEFT);
    ret h;
}

#[testing]
fun dnd_pair_ui(ctx: *context.Context, user: ptr) {
    val p:  *DndPair = user::*DndPair;
    var x0: f32;
    var y0: f32;
    var x1: f32;
    var y1: f32;

    val bl: WindowArea   = begin_window(ctx, p.left);
    val hs: interact.Hit = dnd_row(ctx, "item", ?x0, ?y0, ?x1, ?y1);
    p.drag = dnd.source(ctx, hs, "item", (?p.value)::ptr, $size_of(u64), x0, y0, x1, y1);
    if (p.drag.on) {
        p.ons = p.ons + 1;
        val pv: dnd.Preview = dnd.begin_preview(ctx);
        p.preview = pv;
        p.px      = ctx.in.mx;
        p.py      = ctx.in.my;
        p.layer   = context.layer_of(ctx);
        context.quad(ctx, pv.x0, pv.y0, pv.x1, pv.y1, ctx.theme.control);
        dnd.end_preview(ctx, pv);
    }
    end_window(ctx, bl);

    val br: WindowArea   = begin_window(ctx, p.right);
    val ht: interact.Hit = dnd_row(ctx, "slot", ?x0, ?y0, ?x1, ?y1);
    val d:  dnd.Drop     = dnd.target(ctx, ht, "item", x0, y0, x1, y1);
    if (d.over) { p.overs = p.overs + 1; }
    if (d.dropped && d.n == $size_of(u64)) {
        p.got   = @(d.data::*u64);
        p.drops = p.drops + 1;
    }
    val ho: interact.Hit = dnd_row(ctx, "other", ?x0, ?y0, ?x1, ?y1);
    if (dnd.target(ctx, ho, "file", x0, y0, x1, y1).over) { p.others = p.others + 1; }
    end_window(ctx, br);
}

#[testing]
fun dnd_pair(d: *driver.Driver, a: *allo.Allocator, p: *DndPair) bool {
    p.left        = window("From", 10.0::f32, 10.0::f32, 120.0::f32, 0.0::f32);
    p.left.min_w  = 120.0::f32;
    p.left.flags  = WINDOW_AUTO_SIZE;
    p.right       = p.left;
    p.right.title = "To";
    p.right.x     = 200.0::f32;
    p.value       = 42;
    val e: err[allo.Error] = driver.init(d, a, 400.0::f32, 200.0::f32, dnd_pair_ui, p::ptr);
    if (sel e.err) { ret false; }
    driver.step(d);
    ret true;
}

test dnd__drops_across_windows_and_cancels {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: DndPair;
    var d: driver.Driver;
    if (!dnd_pair(?d, ?a, ?p)) { ret 1; }
    val item:  u64 = driver.find(?d, "From/item");
    val slot:  u64 = driver.find(?d, "To/slot");
    val other: u64 = driver.find(?d, "To/other");
    if (!driver.drawn(?d, item) || !driver.drawn(?d, slot)) { ret 2; }

    # a drag from one window onto a target in the other delivers the payload,
    # and the source learns it was dropped in the frame after
    if (!driver.drag_onto(?d, item, slot))         { ret 3; }
    if (p.drops != 1 || p.got != 42 || p.ons == 0) { ret 4; }
    if (p.overs == 0 || p.others != 0)             { ret 5; }
    driver.step(?d);
    if (!p.drag.dropped || p.drag.on) { ret 6; }
    driver.step(?d);
    if (p.drag.dropped) { ret 7; }

    # the preview keeps the grabbed point under the pointer
    if (!p.preview.on)                               { ret 8; }
    if (p.preview.x1 - p.preview.x0 != 120.0::f32)   { ret 9; }
    if (p.px < p.preview.x0 || p.px >= p.preview.x1) { ret 10; }
    if (p.py < p.preview.y0 || p.py >= p.preview.y1) { ret 11; }
    if (p.layer != band.layer(band.DRAG, 0))         { ret 11; }

    # the other type's target never sees it, and a release over it misses
    p.value = 7;
    if (!driver.drag_onto(?d, item, other)) { ret 12; }
    if (p.others != 0 || p.drops != 1)      { ret 13; }
    driver.step(?d);
    if (!p.drag.missed) { ret 14; }

    # released over no target at all misses too
    if (!driver.drag(?d, item, 380.0::f32, 190.0::f32)) { ret 15; }
    driver.step(?d);
    if (!p.drag.missed || p.drops != 1) { ret 16; }

    # Escape cancels, and the same press does not start it again over a target
    val r: opt[context.Area] = driver.rect(?d, slot);
    if (sel r.none) { ret 17; }
    driver.hover(?d, item);
    driver.press(?d, input.BUTTON_LEFT);
    driver.move(?d, 150.0::f32, 40.0::f32);
    if (!p.drag.on) { ret 18; }
    driver.key(?d, input.KEY_ESCAPE, 0);
    if (!p.drag.cancelled || p.drag.on) { ret 19; }
    driver.move(?d, (r.some.x0 + r.some.x1) / 2.0::f32, (r.some.y0 + r.some.y1) / 2.0::f32);
    driver.move(?d, (r.some.x0 + r.some.x1) / 2.0::f32 + 1.0::f32, (r.some.y0 + r.some.y1) / 2.0::f32);
    if (p.drag.on) { ret 20; }
    driver.release(?d, input.BUTTON_LEFT);
    if (p.drops != 1) { ret 21; }

    # a press that moves less than the threshold is no drag
    val ons: usize = p.ons;
    driver.hover(?d, item);
    driver.press(?d, input.BUTTON_LEFT);
    driver.move(?d, d.in.mx + 2.0::f32, d.in.my);
    driver.release(?d, input.BUTTON_LEFT);
    if (p.ons != ons) { ret 22; }

    val freed: err[allo.Error] = driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}
