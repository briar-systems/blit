# a vector path: contours of lines and quadratic and cubic curves
#
# a path is a list of commands the consumer builds and the context fills or
# strokes (see blit.context.fill_path and stroke_path), the basis for icons.
# move starts a contour, line, quad and cubic extend it, and close ends it
# with a line back to its start. a contour drawn before move starts at the
# origin.
#
# curves stay curves until drawn: the context flattens them at draw time, so
# the segment count follows their size in screen pixels. a fill takes the
# nonzero rule, so a hole is a contour wound against its outline.
#
# building never fails loudly: a command that cannot grow the list sets oom,
# and a path with oom set draws nothing and sets the context's oom.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use allo: std.allocator;
use std.allocator.page;
use vec: std.collections.vector;

# start a contour at (x, y)
pub val MOVE: u8 = 0;

# a line to (x, y)
pub val LINE: u8 = 1;

# a quadratic curve through control (cx0, cy0) to (x, y)
pub val QUAD: u8 = 2;

# a cubic curve through controls (cx0, cy0) and (cx1, cy1) to (x, y)
pub val CUBIC: u8 = 3;

# close the contour with a line back to its start
pub val CLOSE: u8 = 4;

# one path command
# ---
# verb: MOVE, LINE, QUAD, CUBIC or CLOSE
# x:    end point x
# y:    end point y
# cx0:  first control x, for QUAD and CUBIC
# cy0:  first control y, for QUAD and CUBIC
# cx1:  second control x, for CUBIC
# cy1:  second control y, for CUBIC
pub rec Op {
    verb: u8;
    x:    f32;
    y:    f32;
    cx0:  f32;
    cy0:  f32;
    cx1:  f32;
    cy1:  f32;
}

# a list of path commands
# ---
# ops: the commands, in order
# oom: 1 if a command could not be appended, else 0
pub rec Path {
    ops: vec.Vector[Op];
    oom: u8;
}

# an empty path whose commands grow from a
# ---
# a:   allocator backing the commands
# ret: the path, owning nothing until the first command
pub fun init(a: *allo.Allocator) Path {
    ret Path{ops: vec.init[Op](a), oom: 0};
}

# release the commands
# ---
# p:   path to free
# ret: ok, or the allocator's refusal with the path still owning its commands
pub fun free(p: *Path) err[allo.Error] {
    ret vec.dnit[Op](?p.ops);
}

# drop every command and the oom flag, keeping capacity
# ---
# p: path to reset
pub fun reset(p: *Path) {
    vec.clear[Op](?p.ops);
    p.oom = 0;
}

# append one command, setting oom when the list cannot grow
fun add(p: *Path, o: Op) {
    val r: res[usize, allo.Error] = vec.push[Op](?p.ops, o);
    if (sel r.err) { p.oom = 1; }
}

# start a new contour at (x, y)
# ---
# p: path
# x: x in pixels
# y: y in pixels
pub fun move(p: *Path, x: f32, y: f32) {
    add(p, Op{verb: MOVE, x: x, y: y, cx0: x, cy0: y, cx1: x, cy1: y});
}

# extend the contour with a line to (x, y)
# ---
# p: path
# x: x in pixels
# y: y in pixels
pub fun line(p: *Path, x: f32, y: f32) {
    add(p, Op{verb: LINE, x: x, y: y, cx0: x, cy0: y, cx1: x, cy1: y});
}

# extend the contour with a quadratic curve through (cx, cy) to (x, y)
# ---
# p:  path
# cx: control x in pixels
# cy: control y in pixels
# x:  end x in pixels
# y:  end y in pixels
pub fun quad(p: *Path, cx: f32, cy: f32, x: f32, y: f32) {
    add(p, Op{verb: QUAD, x: x, y: y, cx0: cx, cy0: cy, cx1: cx, cy1: cy});
}

# extend the contour with a cubic curve through (cx0, cy0) and (cx1, cy1) to
# (x, y)
# ---
# p:   path
# cx0: first control x in pixels
# cy0: first control y in pixels
# cx1: second control x in pixels
# cy1: second control y in pixels
# x:   end x in pixels
# y:   end y in pixels
pub fun cubic(p: *Path, cx0: f32, cy0: f32, cx1: f32, cy1: f32, x: f32, y: f32) {
    add(p, Op{verb: CUBIC, x: x, y: y, cx0: cx0, cy0: cy0, cx1: cx1, cy1: cy1});
}

# close the contour with a line back to where it started
# ---
# p: path
pub fun close(p: *Path) {
    add(p, Op{verb: CLOSE, x: 0.0::f32, y: 0.0::f32, cx0: 0.0::f32, cy0: 0.0::f32, cx1: 0.0::f32, cy1: 0.0::f32});
}

# number of commands in the path
# ---
# p:   path
# ret: command count
pub fun len(p: *Path) usize {
    ret p.ops.len;
}

# command i of the path
# ---
# p:   path
# i:   command index below len
# ret: the command
pub fun at(p: *Path, i: usize) Op {
    ret p.ops.data[i];
}

test path__records_commands_in_order {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }

    var p: Path = init(?a);
    move(?p, 1.0::f32, 2.0::f32);
    line(?p, 3.0::f32, 4.0::f32);
    quad(?p, 5.0::f32, 6.0::f32, 7.0::f32, 8.0::f32);
    cubic(?p, 9.0::f32, 10.0::f32, 11.0::f32, 12.0::f32, 13.0::f32, 14.0::f32);
    close(?p);
    if (len(?p) != 5 || p.oom != 0)                            { ret 2; }
    if (at(?p, 0).verb != MOVE || at(?p, 1).x != 3.0::f32)     { ret 3; }
    if (at(?p, 2).cx0 != 5.0::f32 || at(?p, 2).y != 8.0::f32)  { ret 4; }
    if (at(?p, 3).cx1 != 11.0::f32 || at(?p, 4).verb != CLOSE) { ret 5; }
    reset(?p);
    if (len(?p) != 0) { ret 6; }

    val freed: err[allo.Error] = free(?p);
    if (sel freed.err) { ret 1; }
    ret 0;
}
