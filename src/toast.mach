# toasts: a stack of timed notifications at an anchor, built on an overlay
#
# a Toasts record owns its notifications and a copy of each one's text and
# key, so post can be called from anywhere, with or without a frame open,
# with a transient buffer. show draws them each frame as cards in one overlay
# anchored to the surface, or show_in to a rect, the newest nearest the anchor
# and the older ones stacked away from it, and drops the ones whose time is
# up. a toast's clock starts the first frame it is shown, and it fades in over
# its first FADE seconds and out over its last.
#
# a toast posted with a key (see post_keyed) is one status that later posts
# under the same key replace in place, such as "identifying..." then the
# result, and withdraw takes it down before its time is up.
#
# show asks for frames only while a toast is fading, and otherwise for the
# moment the next one starts to fade out (see context.wake_at), so an
# interface whose toasts are all gone reports no pending frame.
#
# the overlay claims nothing and neither do the cards, so the world under a
# toast stays interactive.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use blit.context;
use drv: blit.driver;
use blit.layout;
use blit.overlay;
use blit.theme;
use blit.widget;
use allo: std.allocator;
use std.allocator.page;

# seconds a toast takes to fade in, and to fade out
pub val FADE: f64 = 0.2;

# seconds a toast is shown for when its post names none
pub val SECONDS: f64 = 4.0;

# least room a toast list grows to
val INIT_CAP: usize = 8;

# one notification
# ---
# text:    its text, owned, NUL-terminated
# len:     bytes of text before the NUL
# key:     its key, owned, NUL-terminated, nil for none
# klen:    bytes of key before the NUL
# seconds: how long it is shown, fades included
# lead:    seconds of its life behind it when next shown, FADE for one
#          replaced while on screen, which does not fade in again
# born:    the time it was first shown
# shown:   1 once a frame has shown it since it was posted or replaced
# gone:    1 once withdrawn, until a show starts its fade out
rec Toast {
    text:    *u8;
    len:     usize;
    key:     *u8;
    klen:    usize;
    seconds: f64;
    lead:    f64;
    born:    f64;
    shown:   u8;
    gone:    u8;
}

# the notifications a toast stack holds, oldest first
# ---
# a:     allocator backing the list and the texts
# items: the notifications
# cap:   notifications allocated
# len:   notifications held
pub rec Toasts {
    a:     *allo.Allocator;
    items: *Toast;
    cap:   usize;
    len:   usize;
}

# start an empty toast stack
# ---
# t: the stack
# a: allocator backing it
pub fun init(t: *Toasts, a: *allo.Allocator) {
    t.a     = a;
    t.items = nil;
    t.cap   = 0;
    t.len   = 0;
}

# release the stack and every text it holds
# ---
# t:   the stack
# ret: ok, or the first refusal
pub fun free(t: *Toasts) err[allo.Error] {
    for (t.len > 0) {
        val e: err[allo.Error] = drop(t, t.len - 1);
        if (sel e.err) { ret e; }
    }
    val ef: err[allo.Error] = allo.deallocate[Toast](t.a, t.items, t.cap);
    if (sel ef.err) { ret ef; }
    t.items = nil;
    t.cap   = 0;
    ret err[allo.Error].ok{};
}

# remove the toast at i, keeping the others in order
fun drop(t: *Toasts, i: usize) err[allo.Error] {
    var e: err[allo.Error] = allo.deallocate[u8](t.a, t.items[i].text, t.items[i].len + 1);
    if (t.items[i].key != nil) {
        val ek: err[allo.Error] = allo.deallocate[u8](t.a, t.items[i].key, t.items[i].klen + 1);
        if (!sel e.err) { e = ek; }
    }
    var k: usize = i;
    for (k + 1 < t.len) {
        t.items[k] = t.items[k + 1];
        k          = k + 1;
    }
    t.len = t.len - 1;
    ret e;
}

# an owned, NUL-terminated copy of s
fun copy(t: *Toasts, s: str, n: usize) res[*u8, allo.Error] {
    val rb: res[*u8, allo.Error] = allo.allocate[u8](t.a, n + 1);
    if (sel rb.err) { ret rb; }
    var i: usize = 0;
    for (i < n) {
        rb.ok[i] = s[i];
        i        = i + 1;
    }
    rb.ok[n] = 0;
    ret rb;
}

# the seconds a post asks for, SECONDS for 0 or less
fun life(seconds: f64) f64 {
    if (seconds <= 0.0) { ret SECONDS; }
    ret seconds;
}

# where the toast posted under key is, or none
fun find(t: *Toasts, key: str) opt[usize] {
    var i: usize = 0;
    for (i < t.len) {
        if (t.items[i].key != nil && str_equals(t.items[i].key::str, key)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# append a toast, its text and key copied, key nil for none
fun add(t: *Toasts, key: str, text: str, seconds: f64) err[allo.Error] {
    if (t.len == t.cap) {
        var n: usize = t.cap * 2;
        if (n < INIT_CAP) { n = INIT_CAP; }
        val r: res[*Toast, allo.Error] = allo.reallocate[Toast](t.a, t.items, t.cap, n);
        if (sel r.err) { ret err[allo.Error].err{r.err}; }
        t.items = r.ok;
        t.cap   = n;
    }
    val n:  usize                = str_len(text);
    val rb: res[*u8, allo.Error] = copy(t, text, n);
    if (sel rb.err) { ret err[allo.Error].err{rb.err}; }
    var kp: *u8   = nil;
    var kn: usize = 0;
    if (key != nil) {
        kn = str_len(key);
        val rk: res[*u8, allo.Error] = copy(t, key, kn);
        if (sel rk.err) {
            val e: err[allo.Error] = allo.deallocate[u8](t.a, rb.ok, n + 1);
            ret err[allo.Error].err{rk.err};
        }
        kp = rk.ok;
    }

    t.items[t.len] = Toast{text: rb.ok, len: n, key: kp, klen: kn, seconds: life(seconds), lead: 0.0, born: 0.0, shown: 0, gone: 0};
    t.len          = t.len + 1;
    ret err[allo.Error].ok{};
}

# add a notification, shown for seconds once the next show draws it
#
# a caller posting between frames asks for that frame with context.redraw.
# ---
# t:       the stack
# text:    its text, copied
# seconds: how long it is shown, fades included; 0 or less for SECONDS
# ret:     ok, or the allocator's refusal with nothing added
pub fun post(t: *Toasts, text: str, seconds: f64) err[allo.Error] {
    ret add(t, nil, text, seconds);
}

# post a notification under a key, replacing the one the stack holds under
# that key if any
#
# a replaced toast keeps its place in the stack and takes the new text and
# time, its clock starting over at the next show. one already on screen does
# not fade in again, and one withdrawn and fading out comes back. a caller
# posting between frames asks for that frame with context.redraw.
# ---
# t:       the stack
# key:     what names the toast in the stack, copied
# text:    its text, copied
# seconds: how long it is shown from the next show, fades included; 0 or less for SECONDS
# ret:     ok, or the allocator's refusal, the stack unchanged if it refused the copy
pub fun post_keyed(t: *Toasts, key: str, text: str, seconds: f64) err[allo.Error] {
    val at: opt[usize] = find(t, key);
    if (sel at.none) { ret add(t, key, text, seconds); }

    val it: *Toast               = ?t.items[at.some];
    val n:  usize                = str_len(text);
    val rb: res[*u8, allo.Error] = copy(t, text, n);
    if (sel rb.err) { ret err[allo.Error].err{rb.err}; }
    val e: err[allo.Error] = allo.deallocate[u8](t.a, it.text, it.len + 1);
    it.text = rb.ok;
    it.len  = n;
    if (it.shown != 0) { it.lead = FADE; }
    it.seconds = life(seconds) + it.lead;
    it.shown   = 0;
    it.gone    = 0;
    ret e;
}

# take down the toast posted under a key before its time is up
#
# one on screen fades out from the next show, over FADE seconds or what it
# has left if less, and one not yet shown is dropped without showing. a
# caller withdrawing between frames asks for that frame with context.redraw.
# ---
# t:   the stack
# key: the key it was posted under
# ret: true when the stack held a toast under key
pub fun withdraw(t: *Toasts, key: str) bool {
    val at: opt[usize] = find(t, key);
    if (sel at.none) { ret false; }
    t.items[at.some].gone = 1;
    ret true;
}

# how many notifications the stack holds
# ---
# t:   the stack
# ret: the count, shown or still waiting for a show
pub fun count(t: *Toasts) usize {
    ret t.len;
}

# the opacity of a toast age seconds into its life of seconds
fun opacity(age: f64, seconds: f64) f32 {
    var a: f64 = 1.0;
    if (age < FADE) { a = age / FADE; }
    if (seconds - age < FADE) {
        val out: f64 = (seconds - age) / FADE;
        if (out < a) { a = out; }
    }
    if (a < 0.0) { a = 0.0; }
    ret a::f32;
}

# draw one toast as a card at the next place in the overlay's column
fun card(ctx: *context.Context, c: overlay.Chrome, s: str) {
    val tw: f32          = context.text_width(ctx, s);
    val lh: f32          = context.line_height(ctx);
    val r:  context.Area = widget.place(ctx, layout.fit(), layout.fit(), tw + c.pad.l + c.pad.r, lh + c.pad.t + c.pad.b);
    overlay.paint(ctx, c, r.x0, r.y0, r.x1, r.y1);
    context.text_at(ctx, s, r.x0 + c.pad.l, r.y0 + c.pad.t, c.text);
}

# show the stack's toasts at an anchor of the surface, and drop the ones
# whose time is up
#
# the stack grows away from the anchor's edge: up from a bottom anchor, down
# from any other, the newest nearest the anchor, and the cards line up on the
# anchor's side. the toast style's margin keeps it off the edges.
# ---
# ctx: context
# key: the overlay's key in the current id scope
# t:   the stack
# at:  the point of the surface it is anchored at
pub fun show(ctx: *context.Context, key: str, t: *Toasts, at: overlay.Anchor) {
    stack(ctx, key, t, overlay.on_surface(at));
}

# show the stack's toasts at an anchor of a rect, inside it, and drop the
# ones whose time is up
#
# show for a sub-area of the surface, such as a viewport beside a docked
# panel: the stack sits inside r as show's sits inside the surface, kept off
# r's edges by the toast style's margin.
# ---
# ctx: context
# key: the overlay's key in the current id scope
# t:   the stack
# r:   the rect, in the caller's local pixels
# at:  the point of r it is anchored at
pub fun show_in(ctx: *context.Context, key: str, t: *Toasts, r: context.Area, at: overlay.Anchor) {
    stack(ctx, key, t, overlay.on_rect(r, at, at));
}

# start the clocks of new toasts, fade out withdrawn ones, drop the ones
# whose time is up, and draw the rest in o, whose pivot is its anchor
fun stack(ctx: *context.Context, key: str, t: *Toasts, o: overlay.Overlay) {
    val now: f64   = ctx.in.time;
    var i:   usize = 0;
    for (i < t.len) {
        val it: *Toast = ?t.items[i];
        if (it.shown == 0) {
            if (it.gone != 0 && it.lead == 0.0) {
                val ew: err[allo.Error] = drop(t, i);
                if (sel ew.err) { ctx.oom = 1; }
                cnt;
            }
            it.born  = now - it.lead;
            it.shown = 1;
        }
        if (it.gone != 0) {
            val out: f64 = now - it.born + FADE;
            if (out < it.seconds) { it.seconds = out; }
            it.gone = 0;
        }
        if (now - it.born >= it.seconds) {
            val e: err[allo.Error] = drop(t, i);
            if (sel e.err) { ctx.oom = 1; }
            cnt;
        }
        i = i + 1;
    }
    if (t.len == 0) { ret; }

    val at: overlay.Anchor  = o.at;
    val m:  theme.Edges     = context.px_edges(ctx, context.look_of(ctx, theme.TOAST).margin);
    var ov: overlay.Overlay = o;
    ov.dx = m.l * (1.0::f32 - at.x) - m.r * at.x;
    ov.dy = m.t * (1.0::f32 - at.y) - m.b * at.y;
    if (at.x > 0.5::f32)  { ov.align = layout.Align.end{}; }
    or (at.x == 0.5::f32) { ov.align = layout.Align.center{}; }
    val up: bool = at.y > 0.5::f32;

    val c: overlay.Chrome = overlay.chrome(ctx, overlay.KIND_TOAST);
    val s: overlay.Shown  = overlay.begin(ctx, key, ov);
    var k: usize          = 0;
    for (k < t.len) {
        var j: usize = t.len - 1 - k;
        if (up) { j = k; }
        val it:  Toast = t.items[j];
        val age: f64   = now - it.born;
        context.push_alpha(ctx, opacity(age, it.seconds));
        card(ctx, c, it.text::str);
        context.pop_alpha(ctx);
        if (age < FADE || it.seconds - age < FADE) { context.wake_at(ctx, now); }
        or                                         { context.wake_at(ctx, it.born + it.seconds - FADE); }
        k = k + 1;
    }
    overlay.end(ctx, s);
}

# the rect the probe's stack is anchored in when asked
#[testing]
val BOX: context.Area = context.Area{x0: 40.0::f32, y0: 30.0::f32, x1: 160.0::f32, y1: 120.0::f32};

# a toast stack and where the probe shows it
# ---
# t:  the stack
# in: 1 to show it in BOX, 0 in the surface
#[testing]
rec Probe {
    t:  Toasts;
    in: u8;
}

# a toast stack in the bottom right corner of the surface, or of BOX
#[testing]
fun probe_ui(ctx: *context.Context, user: ptr) {
    val p: *Probe = user::*Probe;
    if (p.in != 0) { show_in(ctx, "toasts", ?p.t, BOX, overlay.BOTTOM_RIGHT); }
    or             { show(ctx, "toasts", ?p.t, overlay.BOTTOM_RIGHT); }
}

# the box of the first text line drawn whose text is s, if any
#[testing]
fun line(ctx: *context.Context, s: str) opt[context.Area] {
    var i: usize = 0;
    for (i < context.traced_count(ctx)) {
        val l: context.TextLine = context.traced_at(ctx, i);
        i = i + 1;
        if (l.len != str_len(s)) { cnt; }
        var k: usize = 0;
        for (k < l.len && l.text[k] == s[k]) { k = k + 1; }
        if (k == l.len) { ret opt[context.Area].some{l.box}; }
    }
    ret opt[context.Area].none{};
}

# whether two times are the same up to rounding
#[testing]
fun near(a: f64, b: f64) bool {
    ret a - b < 0.000001 && b - a < 0.000001;
}

# the top of the first text line drawn whose text is s, or -1
#[testing]
fun line_y(ctx: *context.Context, s: str) f32 {
    val b: opt[context.Area] = line(ctx, s);
    if (sel b.none) { ret 0.0::f32 - 1.0::f32; }
    ret b.some.y0;
}

test toast__stacks_fades_and_goes_idle {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    p.in = 0;
    init(?p.t, ?a);
    val t: *Toasts         = ?p.t;
    var d: drv.Driver;
    val e: err[allo.Error] = drv.init(?d, ?a, 300.0::f32, 200.0::f32, probe_ui, (?p)::ptr);
    if (sel e.err) { ret 1; }

    # nothing posted: nothing drawn and nothing pending
    drv.step(?d);
    val none: opt[f64] = context.next_frame(?d.ctx);
    if (!sel none.none) { ret 2; }

    val p1: err[allo.Error] = post(t, "saved", 1.0);
    val p2: err[allo.Error] = post(t, "exported", 1.0);
    if ((sel p1.err) || (sel p2.err) || count(t) != 2) { ret 3; }
    drv.steps(?d, 3);

    # stacked up from the corner, the newest at the bottom, fading in
    val ys: f32 = line_y(?d.ctx, "saved");
    val ye: f32 = line_y(?d.ctx, "exported");
    if (ys < 0.0::f32 || ye <= ys || ye > 200.0::f32) { ret 4; }
    val fading: opt[f64] = context.next_frame(?d.ctx);
    if (!sel fading.some)        { ret 5; }
    if (fading.some != 0.0::f64) { ret 5; }

    # held at full: the next frame wanted is when the fade out starts
    drv.steps(?d, 20);
    val born: f64      = t.items[0].born;
    val hold: opt[f64] = context.next_frame(?d.ctx);
    if (!sel hold.some)                      { ret 6; }
    if (hold.some != born + 1.0::f64 - FADE) { ret 6; }

    # gone once their time is up, and the interface idle again
    drv.steps(?d, 60);
    val idle: opt[f64] = context.next_frame(?d.ctx);
    if (count(t) != 0 || line_y(?d.ctx, "saved") >= 0.0::f32) { ret 7; }
    if (!sel idle.none)                                       { ret 8; }

    val ft: err[allo.Error] = free(t);
    if (sel ft.err) { ret 1; }
    val freed: err[allo.Error] = drv.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test toast__replaces_and_withdraws_by_key {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    p.in = 0;
    init(?p.t, ?a);
    val t: *Toasts         = ?p.t;
    var d: drv.Driver;
    val e: err[allo.Error] = drv.init(?d, ?a, 300.0::f32, 200.0::f32, probe_ui, (?p)::ptr);
    if (sel e.err) { ret 1; }

    # a keyed status under an unkeyed toast, both up at full; the key and
    # text are copied, so the caller's buffer can change after the post
    var buf: [8]u8;
    buf[0] = 0x73;
    buf[1] = 0x74;
    buf[2] = 0x61;
    buf[3] = 0x74;
    buf[4] = 0x75;
    buf[5] = 0x73;
    buf[6] = 0;
    val p1: err[allo.Error] = post_keyed(t, (?buf[0])::str, "identifying", 2.0);
    buf[0] = 0x78;
    val p2: err[allo.Error] = post(t, "saved", 2.0);
    if ((sel p1.err) || (sel p2.err) || count(t) != 2) { ret 2; }
    drv.steps(?d, 20);
    val yi: f32 = line_y(?d.ctx, "identifying");
    if (yi < 0.0::f32 || line_y(?d.ctx, "saved") <= yi) { ret 3; }

    # posting under the key again replaces it in place, at full at once and
    # shown for its new time from the frame that shows it
    val p3: err[allo.Error] = post_keyed(t, "status", "a cat", 1.0);
    if ((sel p3.err) || count(t) != 2) { ret 4; }
    drv.step(?d);
    if (line_y(?d.ctx, "identifying") >= 0.0::f32 || line_y(?d.ctx, "a cat") != yi) { ret 5; }
    if (opacity(d.ctx.in.time - t.items[0].born, t.items[0].seconds) < 0.999::f32)  { ret 6; }
    if (!near(t.items[0].born + t.items[0].seconds, d.ctx.in.time + 1.0))           { ret 6; }

    # withdrawn, it fades out over FADE and goes, leaving the other
    if (!withdraw(t, "status") || withdraw(t, "none")) { ret 7; }
    drv.step(?d);
    if (!near(t.items[0].born + t.items[0].seconds, d.ctx.in.time + FADE)) { ret 8; }
    drv.steps(?d, 13);
    if (count(t) != 1 || line_y(?d.ctx, "a cat") >= 0.0::f32 || line_y(?d.ctx, "saved") < 0.0::f32) { ret 9; }

    # withdrawn before any frame shows it, it never shows
    val p4: err[allo.Error] = post_keyed(t, "status", "never", 0.0);
    if ((sel p4.err) || !withdraw(t, "status")) { ret 10; }
    drv.step(?d);
    if (count(t) != 1 || line_y(?d.ctx, "never") >= 0.0::f32) { ret 11; }

    val ft: err[allo.Error] = free(t);
    if (sel ft.err) { ret 1; }
    val freed: err[allo.Error] = drv.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test toast__anchors_to_a_rect {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var p: Probe;
    p.in = 1;
    init(?p.t, ?a);
    var d: drv.Driver;
    val e: err[allo.Error] = drv.init(?d, ?a, 300.0::f32, 200.0::f32, probe_ui, (?p)::ptr);
    if (sel e.err) { ret 1; }

    # in the rect's bottom right corner, kept off its edges by the margin
    val pt: err[allo.Error] = post(?p.t, "saved", 0.0);
    if (sel pt.err) { ret 1; }
    drv.steps(?d, 3);
    val got: opt[context.Area] = line(?d.ctx, "saved");
    if (!sel got.some) { ret 2; }
    val b: context.Area = got.some;
    val m: theme.Edges  = context.px_edges(?d.ctx, context.look_of(?d.ctx, theme.TOAST).margin);
    if (b.x0 < BOX.x0 || b.y0 < BOX.y0 || b.x1 > BOX.x1 - m.r || b.y1 > BOX.y1 - m.b) { ret 3; }
    if (b.x1 < (BOX.x0 + BOX.x1) / 2.0::f32 || b.y0 < (BOX.y0 + BOX.y1) / 2.0::f32)   { ret 4; }

    val ft: err[allo.Error] = free(?p.t);
    if (sel ft.err) { ret 1; }
    val freed: err[allo.Error] = drv.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}
