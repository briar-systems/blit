    0x0C, 0x0C, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, # U+0060 (`)
    0x00, 0x00, 0x1E, 0x30, 0x3E, 0x33, 0x6E, 0x00, # U+0061 (a)
    0x07, 0x06, 0x06, 0x3E, 0x66, 0x66, 0x3B, 0x00, # U+0062 (b)
