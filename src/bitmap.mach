    0x6E, 0x3B, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, # U+007E (~)
    0x7E, 0x42, 0x42, 0x42, 0x42, 0x42, 0x7E, 0x00 # U+FFFD (replacement, a hollow box)
};

# the glyph source for the built-in font
#
# it keeps no state, so self is nil and one source serves every context.
# ---
# ret: the source
pub fun source() glyph.GlyphSource {
    ret glyph.GlyphSource{
        self: nil, line: bitmap_line, glyph: bitmap_glyph, kern: nil, raster: bitmap_raster, shape: nil
    };
}

# side of the square cell in texels and pixels at a scale, at least one
fun cell(scale: f32) usize {
    val n: f32 = 8.0::f32 * scale + 0.5::f32;
    if (n < 1.0::f32) { ret 1; }
    ret n::usize;
}

# the glyph index of a codepoint, false for one the font lacks
fun index(cp: u32, out: *usize) bool {
    if (cp >= 32 && cp <= 126) {
        @out = (cp - 32)::usize;
        ret true;
    }
    if (cp == 0xFFFD) {
        @out = REPLACEMENT_INDEX;
        ret true;
    }
    ret false;
}

fun bitmap_line(self: ptr, scale: f32) glyph.LineMetrics {
    val n: f32 = cell(scale)::f32;
    ret glyph.LineMetrics{ascent: n * 7.0::f32 / 8.0::f32, descent: n / 8.0::f32, gap: 0.0::f32};
}

fun bitmap_glyph(self: ptr, cp: u32, scale: f32, out: *glyph.Glyph) bool {
    var idx: usize = 0;
    if (!index(cp, ?idx)) { ret false; }
    val n: usize             = cell(scale);
    val m: glyph.LineMetrics = bitmap_line(self, scale);
    out.advance = n::f32;
    out.x0      = 0.0::f32;
    out.y0      = 0.0::f32 - m.ascent;
    out.x1      = n::f32;
    out.y1      = m.descent;
    out.w       = 0;
    out.h       = 0;

    # a blank glyph, the space, has no bitmap to pack
    var r: usize = 0;
    for (r < 8) {
        if (FONT[idx * 8 + r] != 0) {
            out.w = n::u32;
            out.h = n::u32;
            brk;
        }
        r = r + 1;
    }
    ret true;
}

fun bitmap_raster(self: ptr, cp: u32, scale: f32, cov: *u8, stride: usize) bool {
    var idx: usize = 0;
    if (!index(cp, ?idx)) { ret false; }
    val n:  usize = cell(scale);
    var ty: usize = 0;
    for (ty < n) {
        val bits: u8    = FONT[idx * 8 + ty * 8 / n];
        var tx:   usize = 0;
        for (tx < n) {
            var c: u8 = 0;
            if (((bits >> (tx * 8 / n)::u8) & 1) != 0) { c = 255; }
            cov[ty * stride + tx] = c;
            tx                    = tx + 1;
        }
        ty = ty + 1;
    }
    ret true;
}

test source__scales_crisply_and_lacks_non_ascii {
    val src: glyph.GlyphSource = source();
    var g:   glyph.Glyph;
    if (!src.glyph(src.self, 'A', 1.0::f32, ?g))             { ret 1; }
    if (g.advance != 8.0::f32 || g.w != 8 || g.h != 8)       { ret 2; }
    if (g.y0 != -7.0::f32 || g.y1 != 1.0::f32)               { ret 3; }
    if (src.glyph(src.self, 0x00E9, 1.0::f32, ?g))           { ret 4; }
    if (!src.glyph(src.self, 0xFFFD, 1.0::f32, ?g))          { ret 5; }
    if (!src.glyph(src.self, ' ', 1.0::f32, ?g) || g.w != 0) { ret 6; }

    # at 2x every source bit becomes a 2x2 block of full coverage
    if (!src.glyph(src.self, '_', 2.0::f32, ?g) || g.w != 16) { ret 7; }
    var cov: [256]u8;
    if (!src.raster(src.self, '_', 2.0::f32, ?cov[0], 16))  { ret 8; }
    if (cov[15 * 16 + 0] != 255 || cov[14 * 16 + 0] != 255) { ret 9; }
    if (cov[13 * 16 + 0] != 0)                              { ret 10; }
    ret 0;
}
