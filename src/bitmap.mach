    0x00, 0x00, 0x33, 0x33, 0x33, 0x1E, 0x0C, 0x00, # U+0076 (v)
    0x00, 0x00, 0x63, 0x6B, 0x7F, 0x7F, 0x36, 0x00, # U+0077 (w)
    0x00, 0x00, 0x63, 0x36, 0x1C, 0x36, 0x63, 0x00, # U+0078 (x)
