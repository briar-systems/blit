val D_DOCK_TOP: [39]f32 = [39]f32{
    M, 1.5, 1.5,
    L, 14.5, 1.5,
    L, 14.5, 14.5,
    L, 1.5, 14.5,
    Z,
    M, 2.75, 13.25,
    L, 13.25, 13.25,
    L, 13.25, 2.75,
    L, 2.75, 2.75,
    Z,
    M, 3.75, 3.75,
    L, 12.25, 3.75,
    L, 12.25, 8.0,
    L, 3.75, 8.0,
    Z
};

# a drop target that docks to the bottom: a frame with its bottom half filled
val D_DOCK_BOTTOM: [39]f32 = [39]f32{
    M, 1.5, 1.5,
    L, 14.5, 1.5,
    L, 14.5, 14.5,
    L, 1.5, 14.5,
    Z,
    M, 2.75, 13.25,
    L, 13.25, 13.25,
    L, 13.25, 2.75,
    L, 2.75, 2.75,
    Z,
    M, 3.75, 8.0,
    L, 12.25, 8.0,
    L, 12.25, 12.25,
    L, 3.75, 12.25,
    Z
};

test icon__builtins_are_whole {
    var id: u32 = 0;
    for (id < BUILTIN_COUNT) {
        val ic: opt[Icon] = builtin(id);
        if (sel ic.none)     { ret 1; }
        if (!valid(ic.some)) { ret 2; }
        # every point lies on the box
        var i: usize = 0;
        for (i < ic.some.n) {
            var o:    path.Op;
            val took: usize = path.decode(ic.some.data, ic.some.n, i, ?o);
            if (o.verb != path.CLOSE && (o.x < 0.0::f32 || o.x > BOX || o.y < 0.0::f32 || o.y > BOX)) { ret 3; }
            i = i + took;
        }
        id = id + 1;
    }
    val past: opt[Icon] = builtin(BUILTIN_COUNT);
    if (sel past.some) { ret 4; }
    ret 0;
}

test icon__apps_register_their_own {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var set: Set = init(?a);

    var tri: [10]f32  = [10]f32{M, 0.0, 0.0, L, 24.0, 12.0, L, 0.0, 24.0, Z};
    val one: opt[u32] = add(?set, Icon{data: ?tri[0], n: 10, w: 24.0::f32, h: 24.0::f32});
    if (sel one.none)          { ret 2; }
    if (one.some != APP_FIRST) { ret 2; }
    # the set keeps its own copy
    tri[4] = 99.0::f32;
    val got: opt[Icon] = get(?set, one.some);
    if (sel got.none)                                       { ret 3; }
    if (got.some.n != 10 || got.some.data[4] != 24.0::f32)  { ret 4; }
    if (got.some.w != 24.0::f32 || got.some.h != 24.0::f32) { ret 5; }
    # malformed data and an empty box are refused
    val short: opt[u32]  = add(?set, Icon{data: ?tri[0], n: 8, w: 24.0::f32, h: 24.0::f32});
    val flat:  opt[u32]  = add(?set, Icon{data: ?tri[0], n: 10, w: 0.0::f32, h: 24.0::f32});
    val next:  opt[Icon] = get(?set, APP_FIRST + 1);
    val play:  opt[Icon] = get(?set, PLAY);
    if (sel short.some) { ret 6; }
    if (sel flat.some)  { ret 7; }
    if (sel next.some)  { ret 8; }
    if (sel play.none)  { ret 9; }

    # ids are codepoints, and STR_* their utf-8
    var buf: [5]u8;
    if (encode(PIN, ?buf[0], 4) != 4) { ret 10; }
    var k: usize = 0;
    for (k < 4) {
        if (buf[k] != STR_PIN[k]::u8) { ret 11; }
        k = k + 1;
    }
    val back:  opt[u32] = id_of(codepoint(one.some));
    val plain: opt[u32] = id_of(0x41);
    if (sel back.none)         { ret 12; }
    if (back.some != one.some) { ret 12; }
    if (sel plain.some)        { ret 13; }

    val freed: err[allo.Error] = free(?set);
    if (sel freed.err) { ret 1; }
    ret 0;
}
