# icons: shapes drawn from path data, so they scale to any size and take any
# color, with no font or image behind them
#
# an icon is path data (see blit.path: a flat f32 stream of commands) and the
# box it was drawn in, so it is filled by the nonzero rule at whatever size it
# is drawn, scaled from its box. the built-in set is drawn on a box of BOX
# units, its contours meeting without overlapping so no hidden edge shows its
# feather, and an app registers its own icons in the same form, in any box.
#
# icons have ids. the built-ins are the constants below, from 0, and an app's
# icons take ids from APP_FIRST up, in the order they are added, so adding a
# built-in never moves an app's icon. a Set holds the app's icons, copying
# their data, so the caller need not keep it.
#
# every id is also a codepoint, CODEPOINT_BASE plus the id, in supplementary
# private use area A, so an icon sits inline in any text: a label holding an
# icon's codepoint draws the icon in place, sized to the line and tinted like
# the text (see blit.context.text_at). STR_* are the built-ins' codepoints as
# utf-8 strings, and encode writes any id's.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use blit.path;
use allo: std.allocator;
use std.allocator.page;
use vec: std.collections.vector;
use std.text.utf8;

# the side of the square box the built-in icons are drawn on
pub val BOX: f32 = 16.0;

# the codepoint of icon 0
pub val CODEPOINT_BASE: u32 = 0xF0000;

# the first id an app's icon takes
pub val APP_FIRST: u32 = 0x1000;

# the last id an icon can take, so its codepoint stays a character
pub val ID_LAST: u32 = 0xFFFD;

# how many built-in icons there are, their ids running from 0
pub val BUILTIN_COUNT: u32 = 20;

# a triangle pointing right
pub val PLAY: u32 = 0;

# two upright bars
pub val PAUSE: u32 = 1;

# a triangle pointing right against a bar
pub val STEP: u32 = 2;

# a square
pub val STOP: u32 = 3;

# a diagonal cross
pub val CLOSE: u32 = 4;

# a chevron pointing right
pub val CHEVRON_RIGHT: u32 = 5;

# a chevron pointing left
pub val CHEVRON_LEFT: u32 = 6;

# a chevron pointing down
pub val CHEVRON_DOWN: u32 = 7;

# a chevron pointing up
pub val CHEVRON_UP: u32 = 8;

# a plus sign
pub val PLUS: u32 = 9;

# a minus sign
pub val MINUS: u32 = 10;

# a magnifying glass, its lens a ring and its handle running down to the right
pub val SEARCH: u32 = 11;

# a gear of eight teeth around a hole
pub val SETTINGS: u32 = 12;

# a question mark in a ring
pub val HELP: u32 = 13;

# a push pin, point down
pub val PIN: u32 = 14;

# a drop target that docks as a tab: a frame filled whole
pub val DOCK_CENTER: u32 = 15;

# a drop target that docks to the left: a frame with its left half filled
pub val DOCK_LEFT: u32 = 16;

# a drop target that docks to the right: a frame with its right half filled
pub val DOCK_RIGHT: u32 = 17;

# a drop target that docks to the top: a frame with its top half filled
pub val DOCK_TOP: u32 = 18;

# a drop target that docks to the bottom: a frame with its bottom half filled
pub val DOCK_BOTTOM: u32 = 19;

# each built-in's codepoint as a utf-8 string, for a label
pub val STR_PLAY:          str = "\xF3\xB0\x80\x80";
pub val STR_PAUSE:         str = "\xF3\xB0\x80\x81";
pub val STR_STEP:          str = "\xF3\xB0\x80\x82";
pub val STR_STOP:          str = "\xF3\xB0\x80\x83";
pub val STR_CLOSE:         str = "\xF3\xB0\x80\x84";
pub val STR_CHEVRON_RIGHT: str = "\xF3\xB0\x80\x85";
pub val STR_CHEVRON_LEFT:  str = "\xF3\xB0\x80\x86";
pub val STR_CHEVRON_DOWN:  str = "\xF3\xB0\x80\x87";
pub val STR_CHEVRON_UP:    str = "\xF3\xB0\x80\x88";
pub val STR_PLUS:          str = "\xF3\xB0\x80\x89";
pub val STR_MINUS:         str = "\xF3\xB0\x80\x8A";
pub val STR_SEARCH:        str = "\xF3\xB0\x80\x8B";
pub val STR_SETTINGS:      str = "\xF3\xB0\x80\x8C";
pub val STR_HELP:          str = "\xF3\xB0\x80\x8D";
pub val STR_PIN:           str = "\xF3\xB0\x80\x8E";
pub val STR_DOCK_CENTER:   str = "\xF3\xB0\x80\x8F";
pub val STR_DOCK_LEFT:     str = "\xF3\xB0\x80\x90";
pub val STR_DOCK_RIGHT:    str = "\xF3\xB0\x80\x91";
pub val STR_DOCK_TOP:      str = "\xF3\xB0\x80\x92";
pub val STR_DOCK_BOTTOM:   str = "\xF3\xB0\x80\x93";

# an icon: path data and the box it was drawn in
# ---
# data: the path data, a stream of commands (see blit.path)
# n:    floats in data
# w:    width of the box the data was drawn in, above zero
# h:    height of the box, above zero, which the drawn size scales to
pub rec Icon {
    data: *f32;
    n:    usize;
    w:    f32;
    h:    f32;
}

# where an app's icon lives in a set's pool
# ---
# off: offset of its data in the pool
# n:   floats in its data
# w:   box width
# h:   box height
rec Entry {
    off: usize;
    n:   usize;
    w:   f32;
    h:   f32;
}

# the icons an app registered, their data copied into one pool
# ---
# pool:    every icon's data, end to end
# entries: each icon, by id less APP_FIRST
pub rec Set {
    pool:    vec.Vector[f32];
    entries: vec.Vector[Entry];
}

# an empty set whose icons grow from a
# ---
# a:   allocator backing the set
# ret: the set, owning nothing until the first icon
pub fun init(a: *allo.Allocator) Set {
    ret Set{pool: vec.init[f32](a), entries: vec.init[Entry](a)};
}

# release the set's icons
# ---
# set: set to free
# ret: ok, or the allocator's refusal
pub fun free(set: *Set) err[allo.Error] {
    val ep: err[allo.Error] = vec.dnit[f32](?set.pool);
    if (sel ep.err) { ret ep; }
    ret vec.dnit[Entry](?set.entries);
}

# whether an icon can be drawn: whole path data in a box of positive size
# ---
# ic:  icon
# ret: true when it is well formed
pub fun valid(ic: Icon) bool {
    ret ic.w > 0.0::f32 && ic.h > 0.0::f32 && path.valid(ic.data, ic.n);
}

# register an icon, copying its data
# ---
# set: set
# ic:  the icon
# ret: its id, or none for an icon that is not valid, once every id is taken or when the set cannot grow
pub fun add(set: *Set, ic: Icon) opt[u32] {
    if (!valid(ic))                                          { ret opt[u32].none{}; }
    if (set.entries.len >= (ID_LAST - APP_FIRST + 1)::usize) { ret opt[u32].none{}; }
    val off:  usize                  = set.pool.len;
    val room: res[usize, allo.Error] = vec.reserve[f32](?set.pool, ic.n);
    if (sel room.err) { ret opt[u32].none{}; }
    var i: usize = 0;
    for (i < ic.n) {
        val r: res[usize, allo.Error] = vec.push[f32](?set.pool, ic.data[i]);
        i = i + 1;
    }
    val e: res[usize, allo.Error] = vec.push[Entry](?set.entries, Entry{off: off, n: ic.n, w: ic.w, h: ic.h});
    if (sel e.err) {
        set.pool.len = off;
        ret opt[u32].none{};
    }
    ret opt[u32].some{APP_FIRST + (set.entries.len - 1)::u32};
}

# a built-in icon on the BOX square
fun box(data: *f32, n: usize) opt[Icon] {
    ret opt[Icon].some{Icon{data: data, n: n, w: BOX, h: BOX}};
}

# a built-in icon by id
# ---
# id:  icon id
# ret: the icon, or none for an id that is not a built-in
pub fun builtin(id: u32) opt[Icon] {
    if (id == PLAY)          { ret box(?D_PLAY[0], $length_of([10]f32)); }
    if (id == PAUSE)         { ret box(?D_PAUSE[0], $length_of([26]f32)); }
    if (id == STEP)          { ret box(?D_STEP[0], $length_of([23]f32)); }
    if (id == STOP)          { ret box(?D_STOP[0], $length_of([13]f32)); }
    if (id == CLOSE)         { ret box(?D_CLOSE[0], $length_of([37]f32)); }
    if (id == CHEVRON_RIGHT) { ret box(?D_CHEVRON_RIGHT[0], $length_of([19]f32)); }
    if (id == CHEVRON_LEFT)  { ret box(?D_CHEVRON_LEFT[0], $length_of([19]f32)); }
    if (id == CHEVRON_DOWN)  { ret box(?D_CHEVRON_DOWN[0], $length_of([19]f32)); }
    if (id == CHEVRON_UP)    { ret box(?D_CHEVRON_UP[0], $length_of([19]f32)); }
    if (id == PLUS)          { ret box(?D_PLUS[0], $length_of([37]f32)); }
    if (id == MINUS)         { ret box(?D_MINUS[0], $length_of([13]f32)); }
    if (id == SEARCH)        { ret box(?D_SEARCH[0], $length_of([70]f32)); }
    if (id == SETTINGS)      { ret box(?D_SETTINGS[0], $length_of([164]f32)); }
    if (id == HELP)          { ret box(?D_HELP[0], $length_of([157]f32)); }
    if (id == PIN)           { ret box(?D_PIN[0], $length_of([46]f32)); }
    if (id == DOCK_CENTER)   { ret box(?D_DOCK_CENTER[0], $length_of([39]f32)); }
    if (id == DOCK_LEFT)     { ret box(?D_DOCK_LEFT[0], $length_of([39]f32)); }
    if (id == DOCK_RIGHT)    { ret box(?D_DOCK_RIGHT[0], $length_of([39]f32)); }
    if (id == DOCK_TOP)      { ret box(?D_DOCK_TOP[0], $length_of([39]f32)); }
    if (id == DOCK_BOTTOM)   { ret box(?D_DOCK_BOTTOM[0], $length_of([39]f32)); }
    ret opt[Icon].none{};
}

# an icon by id, built in or registered
#
# a registered icon's data lives in the set's pool, valid until the next add.
# ---
# set: set
# id:  icon id
# ret: the icon, or none for an id neither built in nor registered
pub fun get(set: *Set, id: u32) opt[Icon] {
    if (id < APP_FIRST) { ret builtin(id); }
    val k: usize = (id - APP_FIRST)::usize;
    if (k >= set.entries.len) { ret opt[Icon].none{}; }
    val e: Entry = set.entries.data[k];
    ret opt[Icon].some{Icon{data: ?set.pool.data[e.off], n: e.n, w: e.w, h: e.h}};
}

# the codepoint that stands for an icon in text
# ---
# id:  icon id, at most ID_LAST
# ret: CODEPOINT_BASE plus the id
pub fun codepoint(id: u32) u32 {
    ret CODEPOINT_BASE + id;
}

# the icon a codepoint stands for
# ---
# cp:  codepoint
# ret: its icon id, or none for a codepoint outside the icon range
pub fun id_of(cp: u32) opt[u32] {
    if (cp < CODEPOINT_BASE || cp > CODEPOINT_BASE + ID_LAST) { ret opt[u32].none{}; }
    ret opt[u32].some{cp - CODEPOINT_BASE};
}

# write an icon's codepoint as utf-8, to build text holding an app's icon
# ---
# id:  icon id, at most ID_LAST
# buf: destination
# cap: bytes buf holds, 4 for any icon
# ret: bytes written, 0 when buf is too small or the id out of range
pub fun encode(id: u32, buf: *u8, cap: usize) usize {
    if (id > ID_LAST) { ret 0; }
    ret utf8.encode(codepoint(id), buf, cap);
}

