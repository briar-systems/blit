    t.handle_on   = draw.rgba(0.78::f32, 0.78::f32, 0.92::f32, 1.0::f32);
    t.select      = draw.rgba(0.55::f32, 0.85::f32, 0.55::f32, 0.35::f32);
    t.grid        = draw.rgba(0.18::f32, 0.18::f32, 0.22::f32, 1.0::f32);
    t.row         = 16.0::f32;
    t.gap         = 4.0::f32;
    t.pad         = 4.0::f32;
    t.inset       = 4.0::f32;
    t.handle_w    = 6.0::f32;
    t.bar_w       = 6.0::f32;
    t.thumb_min   = 12.0::f32;
    t.corner      = 0.0::f32;
    t.edge_w      = 1.0::f32;
    t.caret_w     = 1.0::f32;
    t.series[0]   = draw.rgba(0.36::f32, 0.62::f32, 0.95::f32, 1.0::f32);
    t.series[1]   = draw.rgba(0.96::f32, 0.62::f32, 0.30::f32, 1.0::f32);
    t.series[2]   = draw.rgba(0.47::f32, 0.80::f32, 0.50::f32, 1.0::f32);
    t.series[3]   = draw.rgba(0.93::f32, 0.43::f32, 0.52::f32, 1.0::f32);
    t.series[4]   = draw.rgba(0.68::f32, 0.56::f32, 0.93::f32, 1.0::f32);
    t.series[5]   = draw.rgba(0.36::f32, 0.80::f32, 0.80::f32, 1.0::f32);
    t.series[6]   = draw.rgba(0.90::f32, 0.80::f32, 0.36::f32, 1.0::f32);
    t.series[7]   = draw.rgba(0.70::f32, 0.70::f32, 0.74::f32, 1.0::f32);
    t.line_w      = 2.0::f32;
    t.tick        = 4.0::f32;
    t.area        = 0.25::f32;
    derive(?t);
    ret t;
}

# lift a kind off what lies beneath with a soft shadow below it
fun elevate(t: *Theme, kind: u32, c: draw.Color, y: f32, blur: f32) {
    val s: *Style = ?t.styles[kind];
    s.shadow_y    = y;
    s.shadow_blur = blur;
    var i: usize = 0;
    for (i < STATES::usize) {
        s.states[i].shadow = c;
        i                  = i + 1;
    }
}

# shade a kind's faces from their color at the top to darker by f at the bottom
fun shade(t: *Theme, kind: u32, f: f32) {
    var i: usize = 0;
    for (i < STATES::usize) {
        val c: draw.Color = t.styles[kind].states[i].fill;
        t.styles[kind].states[i].fill_to = draw.rgba(c.r * f, c.g * f, c.b * f, c.a);
        i                                = i + 1;
    }
}

# outline a kind in every state
fun outline(t: *Theme, kind: u32, c: draw.Color, w: f32) {
    var i: usize = 0;
    for (i < STATES::usize) {
        t.styles[kind].states[i].border   = c;
        t.styles[kind].states[i].border_w = w;
        i                                 = i + 1;
    }
}

# a rounded dark look with raised controls and floating surfaces lifted by
# shadows
# ---
# ret: the theme
pub fun dark() Theme {
    var t: Theme = default();
    t.panel       = draw.hex(0x1B1D23, 0.92::f32);
    t.window      = draw.hex(0x1F2229, 0.98::f32);
    t.dock        = draw.hex(0x181A1F, 1.0::f32);
    t.header      = draw.hex(0x2A2E37, 1.0::f32);
    t.header_hot  = draw.hex(0x343945, 1.0::f32);
    t.edge        = draw.hex(0x2C3039, 1.0::f32);
    t.text        = draw.hex(0xE6E8EE, 1.0::f32);
    t.text_dim    = draw.hex(0x9AA0AD, 1.0::f32);
    t.text_faint  = draw.hex(0x646A77, 1.0::f32);
    t.accent      = draw.hex(0x5B9DFF, 1.0::f32);
    t.accent_text = draw.hex(0x0B1424, 1.0::f32);
    t.control     = draw.hex(0x343944, 1.0::f32);
    t.control_hot = draw.hex(0x414755, 1.0::f32);
    t.control_on  = draw.hex(0x2A2E37, 1.0::f32);
    t.track       = draw.hex(0x23262D, 1.0::f32);
    t.handle      = draw.hex(0x8A93A6, 1.0::f32);
    t.handle_on   = draw.hex(0xC4CBDA, 1.0::f32);
    t.select      = draw.hex(0x5B9DFF, 0.35::f32);
    t.grid        = draw.hex(0x2A2E37, 1.0::f32);
    t.row         = 18.0::f32;
    t.inset       = 5.0::f32;
    t.corner      = 4.0::f32;
    derive(?t);
    shade(?t, BUTTON, 0.85::f32);
    val sh: draw.Color = draw.rgba(0.0::f32, 0.0::f32, 0.0::f32, 0.35::f32);
    elevate(?t, WINDOW, sh, 2.0::f32, 8.0::f32);
    elevate(?t, POPUP, sh, 3.0::f32, 10.0::f32);
    elevate(?t, MENU, sh, 3.0::f32, 10.0::f32);
    elevate(?t, TOOLTIP, sh, 2.0::f32, 6.0::f32);
    elevate(?t, MODAL, sh, 4.0::f32, 16.0::f32);
    ret t;
}

