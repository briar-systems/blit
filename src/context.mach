}

test "context: texture runs divide the draw list in draw order" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: Context;
    val ie:  err[allo.Error] = init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var in: input.Input;
    in.mx        = 0.0::f32;
    in.my        = 0.0::f32;
    in.down      = 0;
    in.prev_down = 0;
    begin(?ctx, in, 100.0::f32, 100.0::f32);

    val white: draw.Color = draw.rgba(1.0::f32, 1.0::f32, 1.0::f32, 1.0::f32);
    var sheet: u64        = 7;

    # atlas span, one image span, then atlas again
    quad(?ctx, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32, white);
    image_at(?ctx, (?sheet)::ptr, 10.0::f32, 0.0::f32, 20.0::f32, 10.0::f32,
        0.0::f32, 0.0::f32, 1.0::f32, 1.0::f32, white);
    quad(?ctx, 20.0::f32, 0.0::f32, 30.0::f32, 10.0::f32, white);
    end(?ctx);

    if (run_count(?ctx) != 3) { ret 1; }
    val head: Run = run_at(?ctx, 0);
    if (head.tex != nil || head.start != 0 || head.count != 6) { ret 1; }
    val mid: Run = run_at(?ctx, 1);
    if (mid.tex != (?sheet)::ptr || mid.start != 6 || mid.count != 6) { ret 1; }
    val tail: Run = run_at(?ctx, 2);
    if (tail.tex != nil || tail.start != 12 || tail.count != 6) { ret 1; }

    val freed: err[allo.Error] = free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "context: images through one texture merge into one span" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: Context;
    val ie:  err[allo.Error] = init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    var in: input.Input;
    in.mx        = 0.0::f32;
    in.my        = 0.0::f32;
    in.down      = 0;
    in.prev_down = 0;
    begin(?ctx, in, 100.0::f32, 100.0::f32);

    val white: draw.Color = draw.rgba(1.0::f32, 1.0::f32, 1.0::f32, 1.0::f32);
    var sheet: u64        = 7;

    # two images through the same texture, nothing on the atlas between
    image_at(?ctx, (?sheet)::ptr, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32,
        0.0::f32, 0.0::f32, 1.0::f32, 1.0::f32, white);
    image_at(?ctx, (?sheet)::ptr, 10.0::f32, 0.0::f32, 20.0::f32, 10.0::f32,
        0.0::f32, 0.0::f32, 1.0::f32, 1.0::f32, white);
    end(?ctx);

    # one span: the second image reopened the first's rather than closing
    # an empty atlas bracket between them
    if (run_count(?ctx) != 1) { ret 1; }
    val whole: Run = run_at(?ctx, 0);
    if (whole.tex != (?sheet)::ptr || whole.start != 0 || whole.count != 12) {
        ret 1;
    }

    val freed: err[allo.Error] = free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# begin a frame with the cursor at (mx, my) and the button up
fun start_at(ctx: *Context, mx: f32, my: f32) {
    var in: input.Input;
    in.mx = mx;
    in.my = my;
    begin(ctx, in, 100.0::f32, 100.0::f32);
}

test "context: layers paint in ascending order and keep emission order within one" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: Context;
    val ie:  err[allo.Error] = init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    start_at(?ctx, 0.0::f32, 0.0::f32);

    val white: draw.Color = draw.rgba(1.0::f32, 1.0::f32, 1.0::f32, 1.0::f32);
    quad(?ctx, 0.0::f32, 0.0::f32, 5.0::f32, 5.0::f32, white);
    push_layer(?ctx);
    quad(?ctx, 10.0::f32, 0.0::f32, 15.0::f32, 5.0::f32, white);
    pop_layer(?ctx);
    quad(?ctx, 20.0::f32, 0.0::f32, 25.0::f32, 5.0::f32, white);
    end(?ctx);

    # the layer-0 quads merge into one span ahead of the layer-1 quad
    val p: *draw.Vert = draw_verts(?ctx);
    if (draw_count(?ctx) != 18)                                            { ret 2; }
    if (p[0].x != 0.0::f32 || p[6].x != 20.0::f32 || p[12].x != 10.0::f32) { ret 3; }
    if (run_count(?ctx) != 2)                                              { ret 4; }
    val low: Run = run_at(?ctx, 0);
    if (low.layer != 0 || low.start != 0 || low.count != 12) { ret 5; }
    val high: Run = run_at(?ctx, 1);
    if (high.layer != 1 || high.start != 12 || high.count != 6) { ret 6; }
    if (ok(?ctx) != 1)                                          { ret 7; }

    val freed: err[allo.Error] = free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "context: push_layer opens a screen-space overlay and pop_layer restores" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: Context;
    val ie:  err[allo.Error] = init(?ctx, ?a);
    if (sel ie.err) { ret 1; }
    start_at(?ctx, 0.0::f32, 0.0::f32);

    val s: Surface = begin_surface(?ctx, 20.0::f32, 20.0::f32, 10.0::f32, 10.0::f32, 5.0::f32, 5.0::f32);
    push_layer(?ctx);
    if (ctx.layer != 1)                                       { ret 2; }
    if (ctx.lx != 0.0::f32 || ctx.ly != 0.0::f32)             { ret 3; }
    if (ctx.clip_x0 != 0.0::f32 || ctx.clip_x1 != 100.0::f32) { ret 4; }
    push_layer(?ctx);
    if (ctx.layer != 2) { ret 5; }
    pop_layer(?ctx);
    pop_layer(?ctx);
    if (ctx.layer != 0 || ctx.layer_sp != 0)             { ret 6; }
    if (ctx.lx != 15.0::f32 || ctx.clip_x0 != 20.0::f32) { ret 7; }
    if (ctx.clip_x1 != 30.0::f32)                        { ret 8; }
    end_surface(?ctx, s);
    # an unmatched pop is ignored
    pop_layer(?ctx);
    if (ctx.layer != 0) { ret 9; }

    val freed: err[allo.Error] = free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "context: hover resolves the previous frame's claims at the current cursor" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: Context;
    val ie:  err[allo.Error] = init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    # frame 1 claims two rects with the cursor on the first
    start_at(?ctx, 5.0::f32, 5.0::f32);
    if (ctx.hover != 0)                                                 { ret 2; }
    if (claim(?ctx, 1, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32) != 0)  { ret 3; }
    if (claim(?ctx, 2, 20.0::f32, 0.0::f32, 30.0::f32, 10.0::f32) != 0) { ret 4; }
    end(?ctx);

    # frame 2 moved onto the second: it is the one hovered, not the stale first
    start_at(?ctx, 25.0::f32, 5.0::f32);
    if (ctx.hover != 2)                                                 { ret 5; }
    if (claim(?ctx, 1, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32) != 0)  { ret 6; }
    if (claim(?ctx, 2, 20.0::f32, 0.0::f32, 30.0::f32, 10.0::f32) != 1) { ret 7; }
    end(?ctx);

    # a claim moved out from under the cursor is not hovered even if resolved
    start_at(?ctx, 25.0::f32, 5.0::f32);
    if (claim(?ctx, 2, 40.0::f32, 0.0::f32, 50.0::f32, 10.0::f32) != 0) { ret 8; }
    end(?ctx);

    val freed: err[allo.Error] = free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "context: a reserved claim sits beneath later claims and takes its rect late" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: Context;
    val ie:  err[allo.Error] = init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    start_at(?ctx, 5.0::f32, 5.0::f32);
    val h: usize = reserve_claim(?ctx, 9);
    val c: u8    = claim(?ctx, 3, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32);
    fill_claim(?ctx, h, 0.0::f32, 0.0::f32, 50.0::f32, 50.0::f32);
    fill_claim(?ctx, NO_CLAIM, 0.0::f32, 0.0::f32, 50.0::f32, 50.0::f32);
    end(?ctx);

    start_at(?ctx, 5.0::f32, 5.0::f32);
    if (ctx.hover != 3) { ret 2; }
    end(?ctx);
    start_at(?ctx, 30.0::f32, 30.0::f32);
    if (ctx.hover != 0) { ret 3; }
    end(?ctx);

    # the rect from two frames back is gone once a frame claims nothing
    start_at(?ctx, 30.0::f32, 30.0::f32);
    if (ctx.hover != 0) { ret 4; }
    end(?ctx);

    val freed: err[allo.Error] = free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "context: claims past the ordinal limit are refused, never wrapped" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var ctx: Context;
    val ie:  err[allo.Error] = init(?ctx, ?a);
    if (sel ie.err) { ret 1; }

    start_at(?ctx, 5.0::f32, 5.0::f32);
    ctx.ordinal = hit.ORDINAL_MAX;
    if (claim(?ctx, 1, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32) != 0) { ret 2; }
    if (ctx.claims.len != 1 || ok(?ctx) != 1)                          { ret 3; }
    if (claim(?ctx, 2, 0.0::f32, 0.0::f32, 10.0::f32, 10.0::f32) != 0) { ret 4; }
    if (reserve_claim(?ctx, 3) != NO_CLAIM)                            { ret 5; }
    if (ctx.claims.len != 1 || ok(?ctx) != 0)                          { ret 6; }

    # a fully clipped claim records nothing and spends no ordinal
    start_at(?ctx, 5.0::f32, 5.0::f32);
    push_clip(?ctx, 0.0::f32, 0.0::f32, 1.0::f32, 1.0::f32);
    if (claim(?ctx, 4, 10.0::f32, 10.0::f32, 20.0::f32, 20.0::f32) != 0) { ret 7; }
    pop_clip(?ctx);
    if (ctx.claims.len != 0 || ctx.ordinal != 0) { ret 8; }

    val freed: err[allo.Error] = free(?ctx);
    if (sel freed.err) { ret 1; }
    ret 0;
}
