# widget ids: hashed keys under a scope seed
#
# an id is the 64-bit FNV-1a hash of a key folded into the seed of the scope
# it is made in, so it depends on what a widget is called and where, never on
# how many widgets came before it. 0 is reserved for "no widget": a hash that
# lands on it is moved to 1.
#
# a label is its own key, with two markers. text after "##" is hashed but not
# drawn, so "Save##toolbar" shows "Save" and differs from another "Save". a
# label holding "###" is keyed by the text from "###" on alone, so the shown
# text can change without changing the id: "Frames: 12###fps" and
# "Frames: 13###fps" are one widget. parts of a widget (a scrollbar thumb, a
# popup's outside claim) are children of its id under a fixed suffix or an
# index.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use fnv: std.crypto.hash.fnv1a;

# the seed of the root scope
pub val ROOT: u64 = fnv.FNV_OFFSET;

# a hash moved off the reserved 0
fun nonzero(h: u64) u64 {
    if (h == 0) { ret 1; }
    ret h;
}

# fold bytes [lo, hi) of s into h
fun fold(h: u64, s: str, lo: usize, hi: usize) u64 {
    var x: u64   = h;
    var i: usize = lo;
    for (i < hi) {
        x = fnv.step_u8(x, s[i]);
        i = i + 1;
    }
    ret x;
}

# the byte "##" or "###" starts at in s, n when it has none
fun find(s: str, n: usize, three: bool) usize {
    var i: usize = 0;
    for (i + 1 < n) {
        if (s[i] == '#' && s[i + 1] == '#') {
            if (!three)                       { ret i; }
            if (i + 2 < n && s[i + 2] == '#') { ret i; }
        }
        i = i + 1;
    }
    ret n;
}

# the id of a string key under a seed, the key hashed as it is
# ---
# seed: the scope's seed
# s:    the key, nil for the empty key
# ret:  a nonzero id
pub fun of_str(seed: u64, s: str) u64 {
    if (s == nil) { ret nonzero(seed); }
    ret nonzero(fold(seed, s, 0, str_len(s)));
}

# the id of an integer key under a seed
# ---
# seed: the scope's seed
# n:    the key
# ret:  a nonzero id
pub fun of_int(seed: u64, n: u64) u64 {
    var x: u64 = seed;
    var k: u64 = 0;
    for (k < 8) {
        x = fnv.step_u8(x, ((n >> (k * 8)) & 0xFF)::u8);
        k = k + 1;
    }
    ret nonzero(x);
}

# the id of a label under a seed, keyed by the text from "###" on when it holds
# one, else by the whole label
# ---
# seed:  the scope's seed
# label: the label, nil for the empty key
# ret:   a nonzero id
pub fun of_label(seed: u64, label: str) u64 {
    if (label == nil) { ret nonzero(seed); }
    val n:  usize = str_len(label);
    val at: usize = find(label, n, true);
    if (at < n) { ret nonzero(fold(seed, label, at, n)); }
    ret nonzero(fold(seed, label, 0, n));
}

# how many leading bytes of a label are drawn: all of it up to the first "##"
# ---
# label: the label, nil for none
# ret:   the drawn byte count
pub fun shown(label: str) usize {
    if (label == nil) { ret 0; }
    val n: usize = str_len(label);
    ret find(label, n, false);
}

# the id of a part of a widget, named by a fixed suffix
# ---
# parent: the widget's id
# suffix: the part's name
# ret:    a nonzero id
pub fun child(parent: u64, suffix: str) u64 {
    ret of_str(parent, suffix);
}

# the id of the n-th of a widget's repeated parts, such as a list's items
# ---
# parent: the widget's id
# n:      the part's index
# ret:    a nonzero id
pub fun child_int(parent: u64, n: u64) u64 {
    ret of_int(parent, n);
}

test id__labels_key_and_show {
    # "##" is hashed but not shown
    if (shown("Save##toolbar") != 4)                               { ret 1; }
    if (of_label(ROOT, "Save##toolbar") == of_label(ROOT, "Save")) { ret 2; }
    if (of_label(ROOT, "Save##a") == of_label(ROOT, "Save##b"))    { ret 3; }
    if (of_label(ROOT, "Save") != of_str(ROOT, "Save"))            { ret 4; }
    # "###" keys by its tail alone, and shows what precedes it
    if (shown("Frames: 12###fps") != 10)                                 { ret 5; }
    if (of_label(ROOT, "Frames: 12###fps") != of_label(ROOT, "x###fps")) { ret 6; }
    if (of_label(ROOT, "a###fps") == of_label(ROOT, "a###ups"))          { ret 7; }
    if (shown("plain") != 5 || shown(nil) != 0)                          { ret 8; }
    # a seed scopes the same key apart, and parts differ from their widget
    if (of_label(1, "ok") == of_label(2, "ok")) { ret 9; }
    val w: u64 = of_label(ROOT, "w");
    if (child(w, "#thumb") == w || child_int(w, 0) == child_int(w, 1)) { ret 10; }
    if (of_int(ROOT, 7) == 0 || of_str(ROOT, nil) == 0)                { ret 11; }
    ret 0;
}
