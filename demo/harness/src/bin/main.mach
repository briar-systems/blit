# drives a headless blit frame through a bare `use blit;` and prints its vertex
# count, spans and atlas pages

use allo: std.allocator;
use std.allocator.page;
use std.print;
use std.runtime;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

use blit;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) {
        print.println("allocator init failed");
        ret 1;
    }

    # the built-in bitmap font is the default glyph source, so no setup is needed
    var ctx: blit.context.Context;
    val ce:  err[allo.Error] = blit.context.init(?ctx, ?a);
    if (sel ce.err) {
        print.println("context init failed");
        ret 1;
    }
    # a target that encodes sRGB gets linear colors
    blit.context.set_srgb(?ctx, 1);
    # a rounder look at 150%: every theme metric and all text scale with it
    var look: blit.theme.Theme = blit.theme.default();
    look.corner = 3.0::f32;
    blit.context.set_theme(?ctx, look);
    blit.context.set_scale(?ctx, 1.5::f32);

    var checked: u8    = 1;
    var amount:  f32   = 0.5::f32;
    var picked:  usize = 0;
    var opts:    [3]str;
    opts[0] = "add";
    opts[1] = "sub";
    opts[2] = "mul";

    # a window that opens at (380, 8), sized to its content
    var win: blit.widget.Window = blit.widget.window("tools", 380.0::f32, 8.0::f32, 180.0::f32, 0.0::f32);
    win.flags = blit.widget.WINDOW_AUTO_SIZE;

    var side: blit.dock.Dock;
    side.side = blit.context.Side.right{};
    side.size = blit.context.px(?ctx, 160.0::f32);
    var view_open: u8 = 1;
    var info_open: u8 = 1;

    # a text field over a buffer the harness owns, holding at most 24 characters
    var name_buf: [64]u8;
    var name:     blit.field.Field;
    blit.field.init(?name, ?name_buf[0], 64, 24, nil);
    blit.field.set(?name, "caf\xC3\xA9");

    # the input's events grow in storage the harness owns through it
    var in: blit.input.Input;
    blit.input.init(?in, ?a);
    in.time    = 0.0::f64;
    in.mx      = 20.0::f32;
    in.my      = 30.0::f32;
    in.present = 1;
    # keyboard events are plain data too, though no field holds the keyboard yet
    blit.input.type_text(?in, '!');

    var steps: [3]blit.draw.Color;
    steps[0] = blit.draw.rgba(0.1::f32, 0.1::f32, 0.4::f32, 1.0::f32);
    steps[1] = blit.draw.rgba(0.9::f32, 0.5::f32, 0.1::f32, 1.0::f32);
    steps[2] = blit.draw.rgba(1.0::f32, 1.0::f32, 0.8::f32, 1.0::f32);
    var field: [8]f32;
    var fi:    usize = 0;
    for (fi < 8) {
        field[fi] = fi::f32 / 7.0::f32;
        fi        = fi + 1;
    }
    val heat: blit.widget.Grid = blit.widget.Grid{
        cols:    4, rows: 2, colors: nil, values: ?field[0],
        palette: blit.widget.Palette{colors: ?steps[0], count: 3, lo: 0.0::f32, hi: 1.0::f32}
    };

    blit.context.begin(?ctx, in, 800.0::f32, 600.0::f32);

    # a side panel docked to the right edge, in collapsible sections
    val dock: blit.dock.DockArea = blit.dock.begin_dock(?ctx, "side", ?side);
    if (blit.widget.section(?ctx, "view", ?view_open)) {
        blit.widget.checkbox(?ctx, "grid", ?checked);
        blit.widget.slider_f(?ctx, "zoom", ?amount, 0.0::f32, 1.0::f32);
    }
    if (blit.widget.section(?ctx, "info", ?info_open)) {
        # utf-8, with a codepoint the bitmap font lacks drawn as its replacement
        blit.widget.text(?ctx, "caf\xC3\xA9");
    }
    blit.dock.end_dock(?ctx, ?side, dock);
    val panel: blit.widget.Block = blit.widget.begin_panel(?ctx, 8.0::f32, 8.0::f32, 200.0::f32);
    blit.widget.text(?ctx, "blit headless smoke");
    blit.widget.button(?ctx, "step");
    blit.widget.checkbox(?ctx, "running", ?checked);
    blit.widget.slider_f(?ctx, "rate", ?amount, 0.0::f32, 1.0::f32);
    val edits: u8 = blit.widget.text_field(?ctx, "name", ?name, "name");
    blit.widget.end_panel(?ctx, panel);

    # sub-surface: a 4x4 grid drawn in local coords, clipped to a short region
    val cell: blit.draw.Color      = blit.draw.rgba(0.4::f32, 0.6::f32, 0.9::f32, 1.0::f32);
    val surf: blit.context.Surface = blit.context.begin_surface(?ctx, 240.0::f32, 8.0::f32, 120.0::f32, 80.0::f32, 0.0::f32, 0.0::f32);
    var gy:   usize                = 0;
    for (gy < 4) {
        var gx: usize = 0;
        for (gx < 4) {
            val px: f32 = gx::f32 * 28.0::f32;
            val py: f32 = gy::f32 * 28.0::f32;
            blit.context.quad(?ctx, px, py, px + 24.0::f32, py + 24.0::f32, cell);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    blit.context.end_surface(?ctx, surf);

    # a dropdown in its own panel, over a consumer texture and a heat field
    val p2: blit.widget.Block = blit.widget.begin_panel(?ctx, 8.0::f32, 220.0::f32, 200.0::f32);
    blit.widget.dropdown(?ctx, "op", ?picked, ?opts[0], 3);
    # handle 1 is whatever texture the renderer knows by it: blit only passes it on
    blit.widget.image(?ctx, blit.draw.region(1, 64.0::f32, 64.0::f32, 0.0::f32, 0.0::f32, 32.0::f32, 32.0::f32, blit.draw.FILTER_NEAREST), 96.0::f32, 96.0::f32);
    blit.widget.grid(?ctx, heat, 96.0::f32, 48.0::f32);
    blit.widget.end_panel(?ctx, p2);

    # a window that drags, resizes, collapses and closes, with a couple of widgets
    val wh: blit.widget.WindowArea = blit.widget.begin_window(?ctx, win);
    if (wh.body != 0) {
        blit.widget.text(?ctx, "drag me");
        blit.widget.button(?ctx, "go");
    }
    blit.widget.end_window(?ctx, wh);

    # charts from plain arrays: two series with the area under one filled, bars
    # either side of zero, and a sparkline for a row
    var energy: [6]f32 = [6]f32{4.0::f32, 6.5::f32, 5.0::f32, 8.0::f32, 7.5::f32, 9.0::f32};
    var income: [6]f32 = [6]f32{1.0::f32, 2.0::f32, 1.5::f32, 3.0::f32, 2.5::f32, 4.0::f32};
    var net:    [6]f32 = [6]f32{2.0::f32, -1.0::f32, 3.5::f32, -2.5::f32, 1.0::f32, 0.5::f32};
    var series: [2]blit.chart.Series;
    series[0]      = blit.chart.series(blit.chart.f32s(?energy[0]), 6);
    series[0].fill = 1;
    series[1]      = blit.chart.series(blit.chart.f32s(?income[0]), 6);
    val lines: blit.chart.Hover = blit.chart.line(?ctx, "load", 240.0::f32, 300.0::f32, 300.0::f32, 150.0::f32, ?series[0], 2, blit.chart.options());
    val bars:  blit.chart.Hover = blit.chart.bars(?ctx, "net", 240.0::f32, 460.0::f32, 200.0::f32, 100.0::f32, blit.chart.f32s(?net[0]), 6, blit.chart.options());
    val spark: blit.chart.Hover = blit.chart.sparkline(?ctx, "energy", 450.0::f32, 460.0::f32, 90.0::f32, 20.0::f32, series[0]);

    # a popup over everything drawn so far
    val pop: blit.widget.Popup = blit.widget.begin_popup(?ctx, "menu", 1, 420.0::f32, 60.0::f32, 120.0::f32);
    blit.widget.text(?ctx, "popup");
    blit.widget.button(?ctx, "close");
    blit.widget.end_popup(?ctx, pop);

    blit.context.end(?ctx);

    print.printf("blit {}: {} vertices, {} indices in {} runs, {} atlas pages, ok={}, field \"{}\", typing={}\n",
        blit.VERSION,
        blit.context.draw_count(?ctx),
        blit.context.index_count(?ctx),
        blit.context.run_count(?ctx),
        blit.atlas.page_count(blit.context.atlas_of(?ctx)),
        blit.context.ok(?ctx)::u64,
        blit.field.text(?name),
        blit.context.typing(?ctx)::u64);

    val freed_in: err[allo.Error] = blit.input.free(?in);
    if (sel freed_in.err) {
        print.println("input free failed");
        ret 1;
    }
    val freed: err[allo.Error] = blit.context.free(?ctx);
    if (sel freed.err) {
        print.println("context free failed");
        ret 1;
    }
    ret 0;
}
