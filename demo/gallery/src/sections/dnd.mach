# drag and drop: any widget can be a drag source or a drop target
#
# both ends take the widget's own interact.Hit. past a small move the drag
# starts with a typed payload the context copies, the source draws its own
# preview in the drag band, and a target naming the type takes it when the
# button comes up over it. escape cancels.

use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;

use blit;

# the layers, reordered by dragging one onto another, and the bin
# ---
# order:  the layer names, top first
# binned: how many were dropped on the bin
pub rec State {
    order:  [4]str;
    binned: usize;
}

pub fun init(s: *State) {
    s.order[0] = "cells";
    s.order[1] = "grid";
    s.order[2] = "trails";
    s.order[3] = "selection";
}

# move the layer at from to stand at to, shifting the ones between
fun reorder(s: *State, from: usize, to: usize) {
    if (from >= 4 || to >= 4) { ret; }
    val moved: str   = s.order[from];
    var i:     usize = from;
    for (i < to) {
        s.order[i] = s.order[i + 1];
        i          = i + 1;
    }
    for (i > to) {
        s.order[i] = s.order[i - 1];
        i          = i - 1;
    }
    s.order[to] = moved;
}

pub fun show(ctx: *blit.context.Context, user: ptr) {
    val s: *State = user::*State;
    blit.widget.note(ctx, "Drag a layer onto another to move it there, or onto the bin.");
    val h:  f32 = blit.widget.control_height(ctx);
    val ty: f32 = (h - blit.context.line_height(ctx)) / 2.0::f32;
    var i:  u64 = 0;
    for (i < 4) {
        val name: str               = s.order[i];
        val r:    blit.context.Area = blit.widget.place(ctx, blit.layout.fill(1.0::f32), blit.layout.fixed(h), 0.0::f32, h);
        val hit:  blit.interact.Hit = blit.interact.hit(ctx, blit.context.id_of(ctx, name), r.x0, r.y0, r.x1, r.y1, blit.input.BUTTON_LEFT);
        blit.context.box(ctx, blit.theme.LIST_ITEM, blit.theme.pick(hit.hot, hit.active, false, false), r.x0, r.y0, r.x1, r.y1);
        blit.context.text_at(ctx, name, r.x0 + blit.context.px(ctx, 6.0::f32), r.y0 + ty, ctx.theme.text);

        # a source carrying its index, drawing its own preview at the pointer
        val drag: blit.dnd.Drag = blit.dnd.source(ctx, hit, "layer", (?i)::ptr, $size_of(u64), r.x0, r.y0, r.x1, r.y1);
        if (drag.on) {
            val pv: blit.dnd.Preview = blit.dnd.begin_preview(ctx);
            blit.context.box(ctx, blit.theme.DRAG_PREVIEW, blit.theme.NORMAL, pv.x0, pv.y0, pv.x1, pv.y1);
            blit.context.text_at(ctx, name, pv.x0 + blit.context.px(ctx, 6.0::f32), pv.y0 + ty, ctx.theme.text);
            blit.dnd.end_preview(ctx, pv);
        }
        val drop: blit.dnd.Drop = blit.dnd.target(ctx, hit, "layer", r.x0, r.y0, r.x1, r.y1);
        if (drop.dropped && drop.n == $size_of(u64)) { reorder(s, (@(drop.data::*u64))::usize, i::usize); }
        i = i + 1;
    }

    # a target with nothing else to do claims its rect with no buttons
    blit.widget.space(ctx, h);
    val b:   blit.context.Area = blit.widget.place(ctx, blit.layout.fill(1.0::f32), blit.layout.fixed(h * 2.0::f32), 0.0::f32, h * 2.0::f32);
    val bin: blit.interact.Hit = blit.interact.hit(ctx, blit.context.id_of(ctx, "bin"), b.x0, b.y0, b.x1, b.y1, 0);
    blit.context.frame(ctx, b.x0, b.y0, b.x1, b.y1, blit.context.px(ctx, 1.0::f32), ctx.theme.edge);
    blit.context.text_at(ctx, "bin", b.x0 + blit.context.px(ctx, 6.0::f32), b.y0 + ty, ctx.theme.text_dim);
    val got: blit.dnd.Drop = blit.dnd.target(ctx, bin, "layer", b.x0, b.y0, b.x1, b.y1);
    if (got.dropped) { s.binned = s.binned + 1; }
    var buf: [48]u8;
    blit.widget.text(ctx, "dropped on the bin:");
    blit.widget.same_line(ctx);
    blit.widget.text(ctx, blit.value.format(blit.value.U64, blit.value.num[u64](s.binned::u64), ?buf[0]));
}
