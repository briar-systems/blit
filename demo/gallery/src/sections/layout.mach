# layout: stacks with sizing rules, same-line rows, columns and controls
# placed by hand
#
# layout is a stack of frames. a stack lays its items along an axis, each
# side sized fixed, fit to its content, filling a share of what is left or a
# fraction of it. same_line puts the next item beside the last, columns lay
# whole widgets side by side, and place hands back a rect for anything drawn
# outside blit's widgets.

use std.types.size.usize;

use blit;

# what the layout's widgets edit
# ---
# query: the search field's text
# buf:   the bytes it lives in
# a:     the first column's toggle
# b:     the second column's toggle
pub rec State {
    query: blit.field.Field;
    buf:   [64]u8;
    a:     u8;
    b:     u8;
}

pub fun init(s: *State) {
    blit.field.init(?s.query, ?s.buf[0], 64, 0, nil);
    s.a = 1;
}

pub fun show(ctx: *blit.context.Context, user: ptr) {
    val s: *State = user::*State;

    # a toolbar: buttons fitted to their labels, then a field taking the rest
    blit.controls.separator_label(ctx, "A horizontal stack");
    var bar: blit.layout.Stack = blit.widget.stack(ctx, blit.layout.Axis.horizontal{});
    bar.align  = blit.layout.Align.center{};
    bar.item_w = blit.layout.fit();
    blit.widget.begin_stack(ctx, "tools", bar);
    blit.widget.button(ctx, "Open");
    blit.widget.button(ctx, "Save");
    blit.widget.size_next(ctx, blit.layout.fill(1.0::f32), blit.layout.auto());
    blit.widget.text_field(ctx, "find", ?s.query, "find");
    blit.widget.end_stack(ctx);

    # shares: one item twice as wide as the other, and one a fixed width
    blit.controls.separator_label(ctx, "Fill weights and fixed sizes");
    var row: blit.layout.Stack = blit.widget.stack(ctx, blit.layout.Axis.horizontal{});
    blit.widget.begin_stack(ctx, "shares", row);
    blit.widget.size_next(ctx, blit.layout.fill(2.0::f32), blit.layout.auto());
    blit.widget.button(ctx, "fill 2");
    blit.widget.size_next(ctx, blit.layout.fill(1.0::f32), blit.layout.auto());
    blit.widget.button(ctx, "fill 1");
    blit.widget.size_next(ctx, blit.layout.fixed(blit.context.px(ctx, 64.0::f32)), blit.layout.auto());
    blit.widget.button(ctx, "64 px");
    blit.widget.end_stack(ctx);

    # a fraction of the width, clamped to a least and a greatest size
    blit.widget.size_next(ctx, blit.layout.limit(blit.layout.frac(0.5::f32), blit.context.px(ctx, 120.0::f32), 0.0::f32), blit.layout.auto());
    blit.widget.button(ctx, "half, at least 120");

    blit.controls.separator_label(ctx, "Same line");
    blit.widget.text(ctx, "label");
    blit.widget.same_line(ctx);
    blit.widget.button(ctx, "beside it");

    blit.controls.separator_label(ctx, "Columns");
    var c: blit.widget.Columns = blit.widget.begin_columns(ctx, 2);
    blit.widget.toggle(ctx, "Left", ?s.a);
    blit.widget.text(ctx, "a taller column");
    blit.widget.next_column(ctx, ?c);
    blit.widget.toggle(ctx, "Right", ?s.b);
    blit.widget.end_columns(ctx, ?c);
    blit.widget.text(ctx, "resumes below the tallest column");

    # a control drawn by hand takes its place in the layout like a widget
    blit.controls.separator_label(ctx, "Placed by hand");
    val t: *blit.theme.Theme = blit.context.theme_of(ctx);
    val h: f32               = blit.context.px(ctx, 24.0::f32);
    val r: blit.context.Area = blit.widget.place(ctx, blit.layout.fill(1.0::f32), blit.layout.fixed(h), 0.0::f32, h);
    val w: f32               = (r.x1 - r.x0) / 8.0::f32;
    var i: usize             = 0;
    for (i < 8) {
        var col: blit.draw.Color = t.track;
        if (i % 2 == 0) { col = t.control_hot; }
        blit.context.quad(ctx, r.x0 + w * i::f32, r.y0, r.x0 + w * (i + 1)::f32, r.y1, col);
        i = i + 1;
    }
}
