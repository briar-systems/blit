# widgets: text, buttons, choices, sliders, a dropdown, sections and grids
#
# every widget places itself at the layout cursor, keyed by its label, and
# reports what the pointer did this frame. its state is the caller's.

use std.types.size.usize;
use std.types.string.str;

use blit;

# what the widgets edit
# ---
# clicks: times the button was clicked
# pick:   the chosen segment
# grid:   the chosen button of the grid
# check:  the checkbox
# on:     the toggle
# speed:  the slider with a reading
# gain:   the plain slider
# size:   the dropdown's choice
# open:   the section is open
# cells:  the grid's values
pub rec State {
    clicks: usize;
    pick:   usize;
    grid:   usize;
    check:  u8;
    on:     u8;
    speed:  f32;
    gain:   f32;
    size:   usize;
    open:   u8;
    cells:  [48]f32;
}

pub fun init(s: *State) {
    s.check = 1;
    s.speed = 30.0::f32;
    s.gain  = 0.5::f32;
    s.open  = 1;
    var i: usize = 0;
    for (i < 48) {
        s.cells[i] = ((i * 7) % 11)::f32 / 10.0::f32;
        i          = i + 1;
    }
}

pub fun show(ctx: *blit.context.Context, user: ptr) {
    val s: *State = user::*State;

    blit.widget.text(ctx, "A line of text");
    blit.widget.note(ctx, "A note is dim text wrapped at spaces to the width of its column, for help under a control.");

    # one line in several colors on one baseline
    val t:  *blit.theme.Theme = blit.context.theme_of(ctx);
    var sp: [4]blit.text.Span;
    sp[0] = blit.text.Span{s: "gen ", style: blit.font.STYLE_BODY, color: t.text_dim};
    sp[1] = blit.text.Span{s: "13", style: blit.font.STYLE_BODY, color: t.accent};
    sp[2] = blit.text.Span{s: "  pop ", style: blit.font.STYLE_BODY, color: t.text_dim};
    sp[3] = blit.text.Span{s: "9,252", style: blit.font.STYLE_BODY, color: t.text};
    blit.widget.rich(ctx, ?sp[0], 4);

    blit.controls.separator_label(ctx, "Buttons");
    if (blit.widget.button(ctx, "Click me")) { s.clicks = s.clicks + 1; }
    var nb: [48]u8;
    blit.widget.text(ctx, blit.value.format(blit.value.U64, blit.value.num[u64](s.clicks::u64), ?nb[0]));
    var row: [3]str;
    row[0] = "Open";
    row[1] = "Save";
    row[2] = "Close";
    blit.widget.buttons(ctx, ?row[0], 3);
    var cells: [6]str;
    cells[0] = "1";
    cells[1] = "2";
    cells[2] = "4";
    cells[3] = "8";
    cells[4] = "16";
    cells[5] = "32";
    val hit: usize = blit.widget.button_grid(ctx, ?cells[0], 6, 3, s.grid);
    if (hit < 6) { s.grid = hit; }

    blit.controls.separator_label(ctx, "Choices");
    var modes: [3]str;
    modes[0] = "Solid";
    modes[1] = "Trails";
    modes[2] = "Age";
    blit.widget.segmented(ctx, ?modes[0], 3, ?s.pick);
    blit.widget.checkbox(ctx, "A checkbox", ?s.check);
    blit.widget.toggle(ctx, "A toggle", ?s.on);
    var sizes: [4]str;
    sizes[0] = "Small";
    sizes[1] = "Medium";
    sizes[2] = "Large";
    sizes[3] = "Huge";
    blit.widget.dropdown(ctx, "Size", ?s.size, ?sizes[0], 4);

    blit.controls.separator_label(ctx, "Sliders");
    var rd: [48]u8;
    blit.widget.slider(ctx, "Speed", blit.value.format(blit.value.U64, blit.value.num[u64]((s.speed + 0.5::f32)::u64), ?rd[0]), ?s.speed, 1.0::f32, 120.0::f32);
    blit.widget.slider_f(ctx, "Gain", ?s.gain, 0.0::f32, 1.0::f32);

    # a section's rows are placed only while it is open, and they unfold
    val sec: blit.widget.Section = blit.widget.begin_section(ctx, "A section", ?s.open);
    if (sec.body) {
        blit.widget.text(ctx, "Rows inside the section");
        var pal: [3]blit.draw.Color;
        pal[0] = t.track;
        pal[1] = t.control_hot;
        pal[2] = t.accent;
        var g: blit.widget.Grid;
        g.cols    = 12;
        g.rows    = 4;
        g.values  = ?s.cells[0];
        g.palette = blit.widget.Palette{colors: ?pal[0], count: 3, lo: 0.0::f32, hi: 1.0::f32};
        blit.widget.grid(ctx, g, blit.context.px(ctx, 192.0::f32), blit.context.px(ctx, 64.0::f32));
    }
    blit.widget.end_section(ctx, sec);
}
